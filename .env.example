# ──────────────────────────────────────────
# FLEET.HQ (fleetshq.com) — Environment
# Copy to .env and fill in values
# ──────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgres://postgres:change-me@localhost:5432/logistics_256_db?sslmode=disable"

# JWT
JWT_SECRET=change-this-to-a-random-32-character-string-minimum
JWT_EXPIRES_IN=8h

# Admin seed (used by `node prisma/seed.js` to create the single director account)
ADMIN_EMAIL=director@fleetshq.com
ADMIN_PASSWORD=set-a-strong-password-here
ADMIN_FIRST=System
ADMIN_LAST=Administrator

# File Storage — set STORAGE_TYPE to 'local' for dev, 's3' for production
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (only required when STORAGE_TYPE=s3)
AWS_REGION=eu-west-2
AWS_BUCKET_NAME=256logistics-docs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRY_SECONDS=900

# Public base URL — used in email links (CTAs, dashboards)
APP_URL=https://fleetshq.com

# Email Alerts (Nodemailer) — production uses Hostinger mail
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerts@fleetshq.com
SMTP_PASS=
ALERT_FROM_EMAIL=alerts@fleetshq.com
# Ops notifications go TO the director and are COPIED to the alerts inbox
ALERT_TO_EMAIL=director@fleetshq.com
ALERT_CC_EMAIL=alerts@fleetshq.com

# Companies House API key (optional) — enables automatic validation of the
# registration number on self-serve sign-ups. Get one free at
# https://developer.company-information.service.gov.uk. Blank = skip check.
CH_API_KEY=

# Alert Thresholds (days before expiry)
ALERT_CRITICAL_DAYS=7
ALERT_WARNING_DAYS=14
ALERT_NOTICE_DAYS=30

# Missed Daily Check — alert fires if no check by this time (24h format, UTC)
MISSED_CHECK_ALERT_TIME=07:30

# Cron Schedule (daily alerts job) — default: 06:00 UTC every day
CRON_DAILY_ALERTS=0 6 * * *

# Compliance Score Weights (must sum to 1.0)
SCORE_WEIGHT_PEOPLE=0.35
SCORE_WEIGHT_FLEET=0.35
SCORE_WEIGHT_DRIVER=0.30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Login Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password Policy
PASSWORD_MIN_LENGTH=8

# Error Tracking — Sentry (optional)
# Sign up at https://sentry.io, create a Node.js project, paste the DSN here.
# Also run: npm install @sentry/node
# Leave blank to disable (default).
SENTRY_DSN=

# Session cookie signing (web sessions)
SESSION_SECRET=change-this-to-a-random-string
