generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  super_admin
  director
  transport_manager
  hr_manager
  operations_manager
  fleet_manager
  finance_officer
  trainer
  driver
  client
  garage
}

enum EmploymentStatus {
  active
  on_leave
  suspended
  terminated
}

enum VehicleStatus {
  active
  vor
  sold
  hired
  awaiting_repair
}

enum DefectSeverity {
  minor
  serious
  dangerous
}

enum DefectStatus {
  reported
  under_review
  repair_booked
  repaired
  signed_off
}

enum TrainingStatus {
  not_started
  in_progress
  completed
  expired
}

enum TrainingType {
  induction
  hgv_induction
  tachograph
  drivers_hours
  walk_around_check
  defect_reporting
  load_security
  health_safety
  accident_reporting
  mobile_phone
  drug_alcohol
  fatigue_management
  fuel_card
  yard_rules
  vehicle_cleanliness
  customer_site
  manual_handling
  fire_safety
  refresher
  cpc
}

enum PolicyType {
  walk_around_duties
  defect_reporting
  tachograph_rules
  drivers_hours
  fatigue_management
  mobile_phone
  drug_alcohol
  accident_reporting
  serious_defects
}

enum DocumentType {
  contract
  offer_letter
  job_description
  passport
  right_to_work
  driving_licence
  cpc_card
  tacho_card
  proof_of_address
  national_insurance
  payroll
  disciplinary
  appraisal
  resignation_termination
  other
}

enum VehicleDocumentType {
  pmi_sheet
  brake_test
  mot_certificate
  service_invoice
  repair_invoice
  tyre_report
  tacho_certificate
  safety_inspection
  roadside_inspection
  prohibition_notice
  rectification_evidence
  other
}

enum CheckItemStatus {
  ok
  defect_found
  not_applicable
}

enum CheckItemType {
  tyres_wheel_nuts
  lights_indicators
  brakes
  steering
  mirrors
  windscreen_wipers
  horn
  number_plates
  bodywork
  fuel_adblue
  warning_lights
  tachograph
  load_security
  leaks
  coupling
  fifth_wheel
  mudguards
  reflectors
}

enum SponsoredChangeType {
  salary
  hours
  job_duties
  work_location
  end_of_employment
}

enum AlertType {
  pmi_due
  mot_expiry
  insurance_expiry
  tacho_calibration
  visa_expiry
  right_to_work_due
  cpc_expiry
  missed_check
  open_defect
  induction_incomplete
  toolbox_unsigned
  policy_unsigned
  licence_check_due
}

enum AlertSeverity {
  critical
  warning
  notice
}

enum TenantStatus {
  active
  suspended
  trial
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model Tenant {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique
  plan     String       @default("starter")
  status   TenantStatus @default(active)
  branding Json?

  companies              Company[]
  branches               Branch[]
  users                  User[]
  employees              Employee[]
  sponsoredWorkers       SponsoredWorker[]
  sponsoredWorkerChanges SponsoredWorkerChange[]
  employeeDocuments      EmployeeDocument[]
  trainingRecords        TrainingRecord[]
  policyAcknowledgements PolicyAcknowledgement[]
  toolboxTalks           ToolboxTalk[]
  toolboxTalkAssignments ToolboxTalkAssignment[]
  vehicles               Vehicle[]
  vehicleDocuments       VehicleDocument[]
  walkAroundChecks       WalkAroundCheck[]
  walkAroundCheckItems   WalkAroundCheckItem[]
  defectCases            DefectCase[]
  defectPhotos           DefectPhoto[]
  vorRecords             VorRecord[]
  auditLogs              AuditLog[]
  alerts                 Alert[]
  complianceScores       ComplianceScore[]
  publicLeads            PublicLead[]
  serviceTypes           ServiceType[]
  systemConfigs          SystemConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id                    String  @id @default(uuid())
  tenant                Tenant  @relation(fields: [tenantId], references: [id])
  tenantId              String  @default("00000000-0000-4000-8000-000000000001")
  name                  String
  legalName             String?
  operatorLicenceNumber String?
  registeredAddress     String?
  timezone              String  @default("Europe/London")
  branding              Json?

  branches Branch[]
  users    User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Branch {
  id           String  @id @default(uuid())
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  tenantId     String  @default("00000000-0000-4000-8000-000000000001")
  company      Company @relation(fields: [companyId], references: [id])
  companyId    String
  name         String
  address      String?
  serviceAreas Json?
  hours        Json?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([companyId])
}

model User {
  id                  String     @id @default(uuid())
  tenant              Tenant     @relation(fields: [tenantId], references: [id])
  tenantId            String     @default("00000000-0000-4000-8000-000000000001")
  company             Company?   @relation(fields: [companyId], references: [id])
  companyId           String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  branchId            String?
  email               String     @unique
  passwordHash        String
  role                UserRole
  roles               UserRole[] @default([])
  branchIds           String[]   @default([])
  firstName           String
  lastName            String
  phone               String?
  isActive            Boolean    @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  resetTokenHash      String?
  resetTokenExpiry    DateTime?

  employee   Employee? @relation("UserEmployee", fields: [employeeId], references: [id])
  employeeId String?   @unique

  auditLogs         AuditLog[]
  uploadedEmpDocs   EmployeeDocument[]      @relation("EmpDocUploadedBy")
  uploadedVehDocs   VehicleDocument[]       @relation("VehDocUploadedBy")
  defectReviews     DefectCase[]            @relation("DefectReviewedBy")
  defectSignoffs    DefectCase[]            @relation("DefectSignedOffBy")
  vorAuthorisations VorRecord[]             @relation("VorAuthorisedBy")
  vorSignoffs       VorRecord[]             @relation("VorSignedOffBy")
  toolboxIssued     ToolboxTalk[]           @relation("TalkIssuedBy")
  toolboxSignoffs   ToolboxTalk[]           @relation("TalkSignedOffBy")
  sponsoredChanges  SponsoredWorkerChange[] @relation("ChangeAuthorisedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
}

model Employee {
  id                    String           @id @default(uuid())
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  tenantId              String           @default("00000000-0000-4000-8000-000000000001")
  fullName              String
  dateOfBirth           DateTime
  homeAddress           String
  phone                 String
  email                 String
  emergencyContactName  String?
  emergencyContactPhone String?
  nextOfKin             String?
  jobTitle              String
  department            String
  startDate             DateTime
  employmentStatus      EmploymentStatus @default(active)
  contractedHours       Decimal          @db.Decimal(5, 2)
  salary                Decimal          @db.Decimal(10, 2)
  workLocation          String
  isDriver              Boolean          @default(false)
  isSponsored           Boolean          @default(false)

  lineManager   Employee?  @relation("ManagerSubordinates", fields: [lineManagerId], references: [id])
  lineManagerId String?
  subordinates  Employee[] @relation("ManagerSubordinates")

  // User account (optional)
  userAccount User? @relation("UserEmployee")

  // Sponsored worker details
  sponsoredWorker SponsoredWorker?

  // Documents and training
  documents          EmployeeDocument[]
  trainingRecords    TrainingRecord[]
  acknowledgements   PolicyAcknowledgement[]
  toolboxAssignments ToolboxTalkAssignment[]

  // Vehicle assignment — Vehicle owns the FK (assignedDriverId on Vehicle)
  drivingVehicle Vehicle? @relation("VehicleDriver")

  // Operations as driver
  checksSubmitted WalkAroundCheck[] @relation("CheckDriver")
  defectsReported DefectCase[]      @relation("DefectReporter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model SponsoredWorker {
  id                      String    @id @default(uuid())
  tenant                  Tenant    @relation(fields: [tenantId], references: [id])
  tenantId                String    @default("00000000-0000-4000-8000-000000000001")
  employee                Employee  @relation(fields: [employeeId], references: [id])
  employeeId              String    @unique
  cosNumber               String
  socCode                 String
  sponsoredJobTitle       String
  salaryOnCos             Decimal   @db.Decimal(10, 2)
  actualSalary            Decimal   @db.Decimal(10, 2)
  contractedHours         Decimal   @db.Decimal(5, 2)
  actualWorkingPattern    String?
  workLocation            String
  visaExpiryDate          DateTime
  rightToWorkCheckDate    DateTime
  rightToWorkFollowupDate DateTime?
  rightToWorkDocumentType String?
  absenceMonitoringNotes  String?

  changes SponsoredWorkerChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model SponsoredWorkerChange {
  id                   String              @id @default(uuid())
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  tenantId             String              @default("00000000-0000-4000-8000-000000000001")
  sponsoredWorker      SponsoredWorker     @relation(fields: [sponsoredWorkerId], references: [id])
  sponsoredWorkerId    String
  changeType           SponsoredChangeType
  previousValue        String
  newValue             String
  effectiveDate        DateTime
  reportedToHomeOffice Boolean             @default(false)
  reportedDate         DateTime?
  authorisedBy         User                @relation("ChangeAuthorisedBy", fields: [authorisedById], references: [id])
  authorisedById       String
  notes                String?

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model EmployeeDocument {
  id            String       @id @default(uuid())
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  tenantId      String       @default("00000000-0000-4000-8000-000000000001")
  employee      Employee     @relation(fields: [employeeId], references: [id])
  employeeId    String
  documentType  DocumentType
  fileName      String
  storageKey    String
  fileSizeBytes Int
  mimeType      String
  expiryDate    DateTime?
  uploadedBy    User         @relation("EmpDocUploadedBy", fields: [uploadedById], references: [id])
  uploadedById  String
  notes         String?

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model TrainingRecord {
  id                 String         @id @default(uuid())
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  tenantId           String         @default("00000000-0000-4000-8000-000000000001")
  employee           Employee       @relation(fields: [employeeId], references: [id])
  employeeId         String
  trainingType       TrainingType
  status             TrainingStatus @default(not_started)
  completedDate      DateTime?
  expiryDate         DateTime?
  trainerName        String?
  certificateNumber  String?
  documentStorageKey String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, trainingType])
  @@index([tenantId])
}

model PolicyAcknowledgement {
  id            String     @id @default(uuid())
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  tenantId      String     @default("00000000-0000-4000-8000-000000000001")
  employee      Employee   @relation(fields: [employeeId], references: [id])
  employeeId    String
  policyType    PolicyType
  policyVersion String
  signedAt      DateTime
  ipAddress     String
  signatureData String
  deviceInfo    String?

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model ToolboxTalk {
  id                 String    @id @default(uuid())
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  tenantId           String    @default("00000000-0000-4000-8000-000000000001")
  topic              String
  description        String
  dateIssued         DateTime
  issuedBy           User      @relation("TalkIssuedBy", fields: [issuedById], references: [id])
  issuedById         String
  managerSignedOff   Boolean   @default(false)
  managerSignoffAt   DateTime?
  managerSignoffBy   User?     @relation("TalkSignedOffBy", fields: [managerSignoffById], references: [id])
  managerSignoffById String?

  assignments ToolboxTalkAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model ToolboxTalkAssignment {
  id            String      @id @default(uuid())
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  tenantId      String      @default("00000000-0000-4000-8000-000000000001")
  toolboxTalk   ToolboxTalk @relation(fields: [toolboxTalkId], references: [id])
  toolboxTalkId String
  employee      Employee    @relation(fields: [employeeId], references: [id])
  employeeId    String
  signedAt      DateTime?
  signatureData String?

  createdAt DateTime @default(now())

  @@unique([toolboxTalkId, employeeId])
  @@index([tenantId])
}

model Vehicle {
  id                  String        @id @default(uuid())
  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  tenantId            String        @default("00000000-0000-4000-8000-000000000001")
  registration        String        @unique
  vinNumber           String        @unique
  make                String
  model               String
  year                Int
  operatorLicenceDisc String?
  motExpiryDate       DateTime
  roadTaxExpiryDate   DateTime?
  insuranceExpiryDate DateTime
  tachoCalibrExpiry   DateTime?
  pmiIntervalWeeks    Int           @default(6)
  lastPmiDate         DateTime?
  nextPmiDate         DateTime?
  currentMileage      Int           @default(0)
  status              VehicleStatus @default(active)

  // Vehicle owns the driver FK — one driver per vehicle at a time
  assignedDriver   Employee? @relation("VehicleDriver", fields: [assignedDriverId], references: [id])
  assignedDriverId String?   @unique

  documents  VehicleDocument[]
  checks     WalkAroundCheck[] @relation("CheckVehicle")
  defects    DefectCase[]      @relation("DefectVehicle")
  vorRecords VorRecord[]       @relation("VorVehicle")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model VehicleDocument {
  id            String              @id @default(uuid())
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  tenantId      String              @default("00000000-0000-4000-8000-000000000001")
  vehicle       Vehicle             @relation(fields: [vehicleId], references: [id])
  vehicleId     String
  documentType  VehicleDocumentType
  fileName      String
  storageKey    String
  fileSizeBytes Int
  mimeType      String
  documentDate  DateTime?
  expiryDate    DateTime?
  uploadedBy    User                @relation("VehDocUploadedBy", fields: [uploadedById], references: [id])
  uploadedById  String
  notes         String?

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model WalkAroundCheck {
  id            String   @id @default(uuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String   @default("00000000-0000-4000-8000-000000000001")
  vehicle       Vehicle  @relation("CheckVehicle", fields: [vehicleId], references: [id])
  vehicleId     String
  driver        Employee @relation("CheckDriver", fields: [driverId], references: [id])
  driverId      String
  checkDate     DateTime @db.Date
  checkTime     DateTime @db.Time
  location      String?
  mileage       Int
  nilDefect     Boolean  @default(false)
  signatureData String
  submittedAt   DateTime @default(now())

  items   WalkAroundCheckItem[]
  defects DefectCase[]          @relation("CheckDefects")

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model WalkAroundCheckItem {
  id       String          @id @default(uuid())
  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  tenantId String          @default("00000000-0000-4000-8000-000000000001")
  check    WalkAroundCheck @relation(fields: [checkId], references: [id])
  checkId  String
  item     CheckItemType
  status   CheckItemStatus
  notes    String?

  @@index([tenantId])
}

model DefectCase {
  id                       String           @id @default(uuid())
  tenant                   Tenant           @relation(fields: [tenantId], references: [id])
  tenantId                 String           @default("00000000-0000-4000-8000-000000000001")
  referenceNumber          String           @unique
  vehicle                  Vehicle          @relation("DefectVehicle", fields: [vehicleId], references: [id])
  vehicleId                String
  reportedBy               Employee         @relation("DefectReporter", fields: [reportedById], references: [id])
  reportedById             String
  walkAroundCheck          WalkAroundCheck? @relation("CheckDefects", fields: [walkAroundCheckId], references: [id])
  walkAroundCheckId        String?
  reportedAt               DateTime         @default(now())
  defectCategory           String
  description              String
  severity                 DefectSeverity
  vehicleAllowedToContinue Boolean
  status                   DefectStatus     @default(reported)
  vorDecision              Boolean          @default(false)
  reviewedBy               User?            @relation("DefectReviewedBy", fields: [reviewedById], references: [id])
  reviewedById             String?
  reviewedAt               DateTime?
  repairAction             String?
  repairGarage             String?
  dateRepaired             DateTime?
  invoiceStorageKey        String?
  finalSignoffBy           User?            @relation("DefectSignedOffBy", fields: [finalSignoffById], references: [id])
  finalSignoffById         String?
  finalSignoffAt           DateTime?

  photos     DefectPhoto[]
  vorRecords VorRecord[]   @relation("VorDefect")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model DefectPhoto {
  id           String     @id @default(uuid())
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  tenantId     String     @default("00000000-0000-4000-8000-000000000001")
  defectCase   DefectCase @relation(fields: [defectCaseId], references: [id])
  defectCaseId String
  storageKey   String
  fileName     String
  uploadedById String

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model VorRecord {
  id                  String      @id @default(uuid())
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  tenantId            String      @default("00000000-0000-4000-8000-000000000001")
  vehicle             Vehicle     @relation("VorVehicle", fields: [vehicleId], references: [id])
  vehicleId           String
  defectCase          DefectCase? @relation("VorDefect", fields: [defectCaseId], references: [id])
  defectCaseId        String?
  takenOffRoadDate    DateTime
  reason              String
  authorisedBy        User        @relation("VorAuthorisedBy", fields: [authorisedById], references: [id])
  authorisedById      String
  repairGarage        String?
  estimatedReturnDate DateTime?
  actualReturnDate    DateTime?
  evidenceStorageKey  String?
  managerSignoffBy    User?       @relation("VorSignedOffBy", fields: [managerSignoffById], references: [id])
  managerSignoffById  String?
  managerSignoffAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model AuditLog {
  id            String  @id @default(uuid())
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  tenantId      String  @default("00000000-0000-4000-8000-000000000001")
  user          User    @relation(fields: [userId], references: [id])
  userId        String
  action        String
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([tenantId])
}

model Alert {
  id           String        @id @default(uuid())
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  tenantId     String        @default("00000000-0000-4000-8000-000000000001")
  alertType    AlertType
  severity     AlertSeverity
  entityType   String
  entityId     String
  entityName   String
  message      String
  daysUntil    Int?
  isResolved   Boolean       @default(false)
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())

  @@index([severity, isResolved])
  @@index([entityType, entityId])
  @@index([tenantId])
}

model ComplianceScore {
  id            String   @id @default(uuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String   @default("00000000-0000-4000-8000-000000000001")
  scoreDate     DateTime @unique @db.Date
  peopleScore   Decimal  @db.Decimal(5, 2)
  fleetScore    Decimal  @db.Decimal(5, 2)
  driverScore   Decimal  @db.Decimal(5, 2)
  overallScore  Decimal  @db.Decimal(5, 2)
  peopleDetails Json
  fleetDetails  Json
  driverDetails Json

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model PublicLead {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String    @default("00000000-0000-4000-8000-000000000001")
  name        String
  email       String
  phone       String?
  company     String?
  enquiryType String    @default("general")
  message     String
  sourcePath  String?
  ipAddress   String?
  userAgent   String?
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([email])
  @@index([createdAt])
}

model ServiceType {
  id          String  @id @default(uuid())
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  tenantId    String  @default("00000000-0000-4000-8000-000000000001")
  name        String
  code        String
  description String?
  baseRate    Decimal @default(0) @db.Decimal(10, 2)
  perMileRate Decimal @default(0) @db.Decimal(10, 2)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
}

model SystemConfig {
  id       String  @id @default(uuid())
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  tenantId String  @default("00000000-0000-4000-8000-000000000001")
  category String
  key      String
  value    Json
  isSecret Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, category, key])
  @@index([tenantId])
  @@index([category])
}

// ─────────────────────────────────────────
// SHIPMENT SPINE (Phase 1)
// New models use a scalar tenantId (FK enforced in migration SQL)
// and are registered in src/config/database.js for tenant scoping.
// ─────────────────────────────────────────

enum ShipmentStatus {
  quote
  booked
  allocated
  collected
  in_transit
  out_for_delivery
  delivered
  failed
  cancelled
}

enum JobStatus {
  offered
  accepted
  rejected
  en_route
  completed
}

enum TrackingEventType {
  booked
  allocated
  collected
  in_transit
  out_for_delivery
  delivered
  exception
  note
}

enum InvoiceStatus {
  draft
  issued
  paid
  overdue
  cancelled
}

model Customer {
  id             String  @id @default(uuid())
  tenantId       String  @default("00000000-0000-4000-8000-000000000001")
  name           String
  contactName    String?
  email          String?
  phone          String?
  billingAddress String?
  accountType    String  @default("payg")
  notes          String?
  createdById    String?

  shipments Shipment[]
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Shipment {
  id            String         @id @default(uuid())
  tenantId      String         @default("00000000-0000-4000-8000-000000000001")
  reference     String         @unique
  customer      Customer?      @relation(fields: [customerId], references: [id])
  customerId    String?
  serviceTypeId String?
  serviceName   String
  status        ShipmentStatus @default(booked)

  pickupContact    String?
  pickupAddress    String
  pickupPostcode   String?
  deliveryContact  String?
  deliveryAddress  String
  deliveryPostcode String?

  parcelCount   Int     @default(1)
  weightKg      Decimal @default(0) @db.Decimal(10, 2)
  distanceMiles Decimal @default(0) @db.Decimal(10, 2)

  priceNet       Decimal @default(0) @db.Decimal(10, 2)
  priceVat       Decimal @default(0) @db.Decimal(10, 2)
  priceTotal     Decimal @default(0) @db.Decimal(10, 2)
  priceBreakdown Json?

  collectionDate DateTime?
  etaWindow      String?
  instructions   String?
  createdById    String?
  branchId       String?

  job     Job?
  pod     ProofOfDelivery?
  invoice Invoice?
  parcels Parcel[]
  events  TrackingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([customerId])
}

model Parcel {
  id          String   @id @default(uuid())
  tenantId    String   @default("00000000-0000-4000-8000-000000000001")
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId  String
  description String?
  weightKg    Decimal  @default(0) @db.Decimal(10, 2)
  qty         Int      @default(1)
  barcode     String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([shipmentId])
}

model TrackingEvent {
  id         String            @id @default(uuid())
  tenantId   String            @default("00000000-0000-4000-8000-000000000001")
  shipment   Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId String
  type       TrackingEventType
  label      String
  detail     String?
  location   String?
  actorId    String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([shipmentId])
}

model Job {
  id            String    @id @default(uuid())
  tenantId      String    @default("00000000-0000-4000-8000-000000000001")
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId    String    @unique
  driverId      String?
  vehicleId     String?
  status        JobStatus @default(offered)
  allocatedById String?
  allocatedAt   DateTime?
  acceptedAt    DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([driverId])
  @@index([vehicleId])
}

model ProofOfDelivery {
  id              String   @id @default(uuid())
  tenantId        String   @default("00000000-0000-4000-8000-000000000001")
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId      String   @unique
  recipientName   String?
  signatureData   String?
  photoStorageKey String?
  otpVerified     Boolean  @default(false)
  notes           String?
  deliveredAt     DateTime @default(now())

  @@index([tenantId])
}

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String        @default("00000000-0000-4000-8000-000000000001")
  number      String        @unique
  customer    Customer?     @relation(fields: [customerId], references: [id])
  customerId  String?
  shipment    Shipment?     @relation(fields: [shipmentId], references: [id])
  shipmentId  String?       @unique
  status      InvoiceStatus @default(issued)
  subtotal    Decimal       @default(0) @db.Decimal(10, 2)
  vat         Decimal       @default(0) @db.Decimal(10, 2)
  total       Decimal       @default(0) @db.Decimal(10, 2)
  lines       Json?
  dueDate     DateTime?
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}
