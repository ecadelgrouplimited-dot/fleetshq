<%- include('../layouts/main', { body: `
<div class="page-head">
  <div class="page-head-main">
    <div class="page-eyebrow">Finance</div>
    <h1>Invoices</h1>
    <p class="page-sub">${invoices.length} invoice${invoices.length === 1 ? '' : 's'} · £${totals.outstanding.toFixed(2)} outstanding.</p>
  </div>
</div>

<div class="stat-grid mb-6">
  <div class="stat-card blue"><div class="stat-icon blue"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m-6 4h6m-2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></div><div><div class="stat-value">£${totals.all.toFixed(2)}</div><div class="stat-label">Total invoiced</div></div></div>
  <div class="stat-card amber"><div class="stat-icon amber"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div><div><div class="stat-value">£${totals.outstanding.toFixed(2)}</div><div class="stat-label">Outstanding</div></div></div>
  <div class="stat-card green"><div class="stat-icon green"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg></div><div><div class="stat-value">£${(totals.all - totals.outstanding).toFixed(2)}</div><div class="stat-label">Paid</div></div></div>
</div>

<div class="card">
  ${invoices.length === 0 ? `<div class="empty-state"><p>No invoices yet</p><div class="empty-hint">Invoices are generated from delivered shipments.</div></div>` : `
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Number</th><th scope="col">Customer</th><th class="inv-ship-col">Shipment</th><th scope="col">Total</th><th scope="col">Status</th><th scope="col">Due</th><th scope="col"></th></tr></thead>
      <tbody>
        ${invoices.map(i => {
          const isOverdue = i.dueDate && new Date(i.dueDate) < new Date() && i.status !== 'paid';
          return `
          <tr>
            <td style="font-family:monospace;font-weight:700">${esc(i.number)}</td>
            <td>${esc(i.customer ? i.customer.name : '—')}</td>
            <td class="inv-ship-col">${i.shipment ? `<a href="/shipments/${i.shipmentId}" style="font-family:monospace">${esc(i.shipment.reference)}</a>` : '—'}</td>
            <td style="font-weight:700">£${Number(i.total).toFixed(2)}</td>
            <td>
              <span class="badge ${i.status === 'paid' ? 'badge-green' : isOverdue ? 'badge-red' : 'badge-amber'}">${isOverdue && i.status !== 'overdue' ? 'overdue' : esc(i.status)}</span>
            </td>
            <td class="cell-muted">${i.dueDate ? formatDate(i.dueDate) : '—'}</td>
            <td>
              ${i.status !== 'paid' ? `
              <div style="display:flex;gap:6px;flex-wrap:wrap">
                <form method="post" action="/invoices/${i.id}/pay"><input type="hidden" name="_csrf" value="${csrfToken}"><button class="btn btn-outline btn-sm">Mark paid</button></form>
                ${i.customer?.email ? `<button class="btn btn-ghost btn-sm" data-remind-invoice="${i.id}" data-csrf="${csrfToken}">Send reminder</button>` : ''}
              </div>` : '<span class="cell-muted">—</span>'}
            </td>
          </tr>`;
        }).join('')}
      </tbody>
    </table>
  </div>`}
</div>

<style>
  @media (max-width:500px) { .inv-ship-col { display:none; } }
</style>

${totalPages > 1 ? `
<div class="pagination">
  ${page > 1 ? `<a href="?page=${page-1}" class="btn btn-ghost btn-sm">← Prev</a>` : ''}
  <span>Page ${page} of ${totalPages} · ${total} invoices</span>
  ${page < totalPages ? `<a href="?page=${page+1}" class="btn btn-primary btn-sm">Next →</a>` : ''}
</div>` : ''}

<script>
(function() {
  document.querySelectorAll('[data-remind-invoice]').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var id = btn.getAttribute('data-remind-invoice');
      var csrf = btn.getAttribute('data-csrf');
      setButtonLoading(btn, true, 'Sending...');
      try {
        var res = await fetch('/invoices/' + id + '/remind', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
          credentials: 'same-origin',
        });
        var data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to send reminder');
        showToast('Reminder sent to customer', 'success');
        setButtonLoading(btn, false);
        btn.disabled = true;
        btn.textContent = 'Sent ✓';
      } catch (err) {
        setButtonLoading(btn, false);
        showToast(err.message || 'Could not send reminder', 'error');
      }
    });
  });
})();
</script>
` }) %>
