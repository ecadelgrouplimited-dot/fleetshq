<%
  const currentPage = typeof page !== 'undefined' ? page : 'home';
  const selectedType = typeof enquiryType !== 'undefined' ? enquiryType : 'general';
  const form = typeof formData !== 'undefined' ? formData : {};
  const nav = [
    ['Track', '/track', 'track', 'nav.track'],
    ['Contact', '/contact', 'contact', 'nav.contact'],
  ];
  const pageTitles = {
    home: ['One Platform. Total Control.', 'The operating system for transport companies. Drivers, vehicles, compliance, tachographs and maintenance — one connected platform that keeps every mile accountable.'],
    contact: ['Talk to the transport team.', 'Send a quote request, partnership enquiry, or service question — it lands straight in the operations hub.'],
    track: ['Track a shipment.', 'Check a reference for live status, ETA and milestone history — no account needed.'],
  };
  const heading = pageTitles[currentPage] || pageTitles.home;
%>
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'FLEETS.HQ — The operating system for transport companies' %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/img/favicon-64.png">
  <link rel="apple-touch-icon" href="/img/favicon-180.png">
  <meta name="description" content="FLEETS.HQ — the operating system for UK transport companies. Drivers, vehicles, compliance, tachographs and maintenance in one connected platform. One platform. Total control.">
  <meta property="og:title" content="FLEETS.HQ — One Platform. Total Control.">
  <meta property="og:description" content="The operating system for transport companies. Drivers, vehicles, compliance, tachographs and maintenance — built by hauliers, for hauliers.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://fleetshq.com">
  <meta property="og:site_name" content="FLEETS.HQ">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="FLEETS.HQ — One Platform. Total Control.">
  <meta name="twitter:description" content="The operating system for transport companies. Built by hauliers, for hauliers.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    (function () {
      var stored = localStorage.getItem('public-theme');
      var cookie = document.cookie.match(/(?:^|; )publicTheme=([^;]+)/);
      var preferred = stored || (cookie && cookie[1]) || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', preferred);
    }());
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root {
      color-scheme: dark;
      /* FLEETS.HQ — black + signal-red + gold */
      --bg: #0a0a0c;
      --bg-2: #111114;
      --panel: rgba(22, 22, 27, .72);
      --panel-2: rgba(28, 28, 34, .5);
      --panel-strong: #15151a;
      --text: #f3f4f6;
      --heading: #ffffff;
      --muted: #a3a7b0;
      --soft: #71757e;
      --line: rgba(255, 255, 255, .09);
      --line-2: rgba(255, 255, 255, .17);
      --brand: #e11d2a;        /* signal red */
      --brand-deep: #a60f1a;
      --brand-2: #f5b301;      /* gold */
      --brand-3: #10b981;      /* keep green for "compliant/clear" semantics */
      --gold-1: #fde68a;
      --gold-2: #f5b301;
      --gold-3: #b45309;
      --danger: #ef4444;
      --amber: #f5b301;
      --shadow: 0 30px 90px rgba(0, 0, 0, .6);
      --shadow-soft: 0 18px 50px rgba(0, 0, 0, .45);
      --radius: 16px;
      --radius-sm: 11px;
    }
    [data-theme="light"] {
      color-scheme: light;
      --bg: #f6f6f4;
      --bg-2: #eeeeec;
      --panel: rgba(255, 255, 255, .85);
      --panel-2: rgba(255, 255, 255, .62);
      --panel-strong: #ffffff;
      --text: #16161a;
      --heading: #0a0a0c;
      --muted: #4a4d55;
      --soft: #71757e;
      --line: rgba(10, 10, 12, .1);
      --line-2: rgba(10, 10, 12, .18);
      --shadow: 0 26px 70px rgba(20, 20, 24, .14);
      --shadow-soft: 0 14px 40px rgba(20, 20, 24, .1);
    }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      color: var(--text);
      background: var(--bg);
      min-height: 100vh;
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    body.loading { overflow: hidden; }
    a { color: inherit; text-decoration: none; }
    button, input, select, textarea { font: inherit; }

    /* Ambient cinematic field */
    .field { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .field .grid {
      position: absolute; inset: -2px;
      background-image:
        linear-gradient(var(--line) 1px, transparent 1px),
        linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 58px 58px; opacity: .5;
      -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 35%, transparent 100%);
              mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 35%, transparent 100%);
    }
    .orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .55; }
    .orb.a { width: 620px; height: 620px; top: -220px; right: -160px; background: radial-gradient(circle, rgba(225,29,42,.5), transparent 68%); }
    .orb.b { width: 460px; height: 460px; top: 36%; left: -200px; background: radial-gradient(circle, rgba(245,179,1,.28), transparent 66%); }
    .orb.c { width: 520px; height: 520px; bottom: -240px; right: 8%; background: radial-gradient(circle, rgba(225,29,42,.22), transparent 66%); }
    [data-theme="light"] .orb { opacity: .4; }
    main, .nav, .footer, .loader { position: relative; z-index: 1; }

    .wrap { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }

    /* Loader */
    .loader { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; background: var(--bg); transition: opacity .4s ease, visibility .4s ease; }
    .loader.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
    .loader-card { display: grid; gap: 18px; place-items: center; }
    .loader-mark { width: 78px; height: 78px; display: grid; place-items: center; }
    .loader-mark img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 10px 24px rgba(37,99,235,.4)); }
    .loader-line { width: 180px; height: 3px; border-radius: 999px; background: var(--line-2); overflow: hidden; }
    .loader-line span { display: block; height: 100%; width: 42%; background: linear-gradient(90deg, var(--brand), var(--brand-2)); animation: load 1.1s ease-in-out infinite; }
    @keyframes load { 0% { transform: translateX(-130%); } 100% { transform: translateX(320%); } }

    /* Brand mark */
    .brand { display: inline-flex; align-items: center; gap: 12px; font-weight: 900; letter-spacing: -.02em; color: var(--heading); }
    .brand-mark { width: 40px; height: 40px; display: grid; place-items: center; flex-shrink: 0; }
    .brand-mark img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 8px 18px rgba(37,99,235,.4)); }
    .brand small { display: block; color: var(--soft); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .brand b { color: var(--brand); font-weight: 900; }

    /* Nav */
    .nav { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: saturate(150%) blur(16px); }
    .nav-inner { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
    .nav-links { display: flex; align-items: center; gap: 4px; margin-left: auto; }
    .nav-links > a {
      border: 0; background: transparent; color: var(--muted);
      border-radius: 9px; padding: 9px 13px; cursor: pointer; font-weight: 600; font-size: 14.5px; transition: all .15s;
    }
    .nav-links > a:hover, .nav-links > a.is-active { color: var(--heading); background: color-mix(in srgb, var(--panel-strong) 70%, transparent); }
    .nav-sep { width: 1px; height: 22px; background: var(--line-2); margin: 0 6px; }
    /* Icon-only theme + language controls (no "Theme"/"Language" text) */
    .ctrl-btn {
      display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; flex-shrink: 0;
      border-radius: 50%; border: 1px solid var(--line-2); background: transparent; color: var(--muted);
      cursor: pointer; font-size: 15px; line-height: 1; transition: color .15s, border-color .15s, background .15s;
    }
    .ctrl-btn:hover { color: var(--heading); background: color-mix(in srgb, var(--panel-strong) 70%, transparent); }
    .ctrl-btn svg { width: 16px; height: 16px; }
    .lang-switch { position: relative; }
    .lang-menu {
      position: absolute; top: calc(100% + 8px); right: 0; z-index: 10; display: none; flex-direction: column; gap: 2px;
      padding: 6px; min-width: 46px; border-radius: 12px; border: 1px solid var(--line-2); background: var(--panel-strong);
      box-shadow: var(--shadow);
    }
    .lang-menu.is-open { display: flex; }
    .lang-menu button {
      display: flex; align-items: center; justify-content: center; padding: 8px; border-radius: 8px; border: 0;
      background: transparent; cursor: pointer; font-size: 19px; line-height: 1; transition: background .15s;
    }
    .lang-menu button:hover { background: color-mix(in srgb, var(--panel-strong) 70%, transparent); }
    .lang-menu button.is-active { box-shadow: inset 0 0 0 1.5px var(--brand-2); }
    .cta {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      min-height: 44px; padding: 11px 20px; border-radius: 10px; font-weight: 700; font-size: 14.5px;
      background: linear-gradient(135deg, var(--brand), var(--brand-deep)); color: #fff;
      border: 1px solid rgba(255,255,255,.14); box-shadow: 0 14px 34px rgba(59,130,246,.36); transition: transform .18s, box-shadow .18s;
    }
    .cta:hover { transform: translateY(-2px); box-shadow: 0 20px 44px rgba(59,130,246,.5); }
    .cta.secondary { background: var(--panel); color: var(--heading); box-shadow: none; border-color: var(--line-2); backdrop-filter: blur(8px); }
    .cta.secondary:hover { border-color: var(--brand); }
    .cta.ghost { background: transparent; color: var(--heading); box-shadow: none; border-color: var(--line-2); }

    /* Hero */
    .hero { padding: 70px 0 48px; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(340px, .82fr); gap: 48px; align-items: center; }
    .eyebrow { display: inline-flex; align-items: center; gap: 9px; color: var(--brand-2); font-weight: 700; letter-spacing: .12em; font-size: 12px; text-transform: uppercase; padding: 7px 14px; border: 1px solid var(--line-2); border-radius: 100px; background: var(--panel-2); }
    .eyebrow .pip { width: 7px; height: 7px; border-radius: 50%; background: var(--brand-2); box-shadow: 0 0 10px var(--brand-2); animation: pip 2s infinite; }
    @keyframes pip { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.4)} }
    h1 { margin: 20px 0 18px; max-width: 740px; font-size: clamp(40px, 6vw, 70px); line-height: 1.02; letter-spacing: -.035em; color: var(--heading); font-weight: 900; }
    h1 .grad { color: var(--brand); -webkit-text-fill-color: var(--brand); }
    .intro { max-width: 600px; color: var(--muted); font-size: 18.5px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
    .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 40px; padding-top: 30px; border-top: 1px solid var(--line); }
    .metric strong { display: block; color: var(--heading); font-size: 27px; font-weight: 800; letter-spacing: -.02em; }
    .metric span { color: var(--soft); font-size: 13px; }

    /* Hero console art */
    .hero-art { position: relative; min-height: 420px; display: grid; place-items: center; }
    .console {
      width: 100%; border: 1px solid var(--line-2); border-radius: var(--radius); overflow: hidden;
      background: linear-gradient(180deg, var(--panel-strong), var(--panel)); box-shadow: var(--shadow); backdrop-filter: blur(8px);
    }
    .console-bar { display: flex; align-items: center; gap: 8px; padding: 13px 16px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--panel-strong) 60%, transparent); }
    .console-bar i { width: 11px; height: 11px; border-radius: 50%; display: block; }
    .console-bar i.r { background: #ff5f57; } .console-bar i.y { background: #febc2e; } .console-bar i.g { background: #28c840; }
    .console-bar span { margin-left: 8px; font-size: 12px; color: var(--soft); font-weight: 600; }
    .console-body { padding: 18px; display: grid; gap: 12px; }
    .con-row { display: flex; align-items: center; gap: 13px; padding: 13px 15px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--panel-2); }
    .con-ic { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; flex-shrink: 0; }
    .con-ic svg { width: 19px; height: 19px; }
    .con-row .meta { min-width: 0; flex: 1; }
    .con-row .meta strong { display: block; font-size: 13.5px; color: var(--heading); font-weight: 700; }
    .con-row .meta span { font-size: 12px; color: var(--soft); }
    .con-pill { font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 100px; white-space: nowrap; }
    .con-pill.green { color: #34d399; background: rgba(16,185,129,.14); }
    .con-pill.blue { color: #60a5fa; background: rgba(59,130,246,.16); }
    .con-pill.amber { color: #fbbf24; background: rgba(245,158,11,.16); }
    .float-chip {
      position: absolute; display: flex; align-items: center; gap: 9px; padding: 11px 14px; border-radius: 13px;
      background: color-mix(in srgb, var(--panel-strong) 92%, transparent); border: 1px solid var(--line-2);
      box-shadow: var(--shadow-soft); font-size: 13px; font-weight: 700; color: var(--heading); backdrop-filter: blur(10px); animation: floaty 5.5s ease-in-out infinite;
    }
    .float-chip small { display: block; font-size: 11px; font-weight: 500; color: var(--soft); }
    .float-chip .dot { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; flex-shrink: 0; }
    .float-chip.one { top: 18px; left: -14px; }
    .float-chip.two { bottom: 30px; right: -16px; animation-delay: -2.6s; }
    @keyframes floaty { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }

    /* Sections */
    section { padding: 60px 0; position: relative; }
    .section-head { max-width: 680px; margin-bottom: 36px; }
    .section-head.center { margin-inline: auto; text-align: center; }
    .section-head h2 { margin: 14px 0 0; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.06; letter-spacing: -.03em; color: var(--heading); font-weight: 800; }
    .section-head p { margin: 14px 0 0; color: var(--muted); font-size: 17px; }
    .kicker { color: var(--brand-2); font-weight: 700; font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; }

    .grid { display: grid; gap: 18px; }
    .grid.three { grid-template-columns: repeat(3, 1fr); }
    .grid.two { grid-template-columns: repeat(2, 1fr); }
    .card {
      position: relative; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel);
      padding: 26px; box-shadow: var(--shadow-soft); backdrop-filter: blur(8px); transition: transform .25s, border-color .25s, box-shadow .25s;
    }
    .card.lift:hover { transform: translateY(-4px); border-color: var(--line-2); box-shadow: var(--shadow); }
    .card-ic { width: 52px; height: 52px; border-radius: 13px; display: grid; place-items: center; margin-bottom: 18px; background: linear-gradient(135deg, rgba(225,29,42,.18), rgba(245,179,1,.1)); border: 1px solid var(--line-2); }
    .card-ic svg { width: 25px; height: 25px; color: #f5b301; }
    .card h3 { margin: 0 0 9px; font-size: 19px; color: var(--heading); font-weight: 700; overflow-wrap: anywhere; }
    .card p, .card li { color: var(--muted); font-size: 14.5px; }
    .card ul { padding-left: 18px; margin: 12px 0 0; display: grid; gap: 6px; }
    .card .more { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; color: var(--brand); font-weight: 700; font-size: 14px; }

    .band { border-block: 1px solid var(--line); background: color-mix(in srgb, var(--bg-2) 60%, transparent); }

    /* Service cards */
    .service-card { display: grid; gap: 12px; }
    .service-top { display: flex; justify-content: space-between; gap: 12px; align-items: start; }
    .tag { display: inline-flex; align-items: center; min-height: 26px; border-radius: 999px; padding: 4px 11px; color: var(--brand-2); background: rgba(34,211,238,.12); border: 1px solid rgba(34,211,238,.26); font-size: 12px; font-weight: 800; white-space: nowrap; }

    /* Stats band */
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .stat { text-align: center; padding: 26px 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
    .stat strong { display: block; font-size: clamp(30px, 4vw, 44px); font-weight: 900; letter-spacing: -.03em; background: linear-gradient(120deg, #f5b301, #e11d2a); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .stat .stat-ic { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; margin: 0 auto 12px; background: linear-gradient(135deg, rgba(225,29,42,.16), rgba(245,179,1,.1)); border: 1px solid var(--line-2); }
    .stat .stat-ic svg { width: 20px; height: 20px; color: var(--brand-2); }
    .stat span { color: var(--soft); font-size: 13.5px; font-weight: 600; }

    /* CTA band */
    .cta-band { position: relative; overflow: hidden; border: 1px solid var(--line-2); border-radius: 26px; padding: 60px 40px; text-align: center;
      background: radial-gradient(ellipse 70% 130% at 50% -10%, rgba(59,130,246,.28), transparent 70%), linear-gradient(180deg, var(--panel-strong), var(--panel)); box-shadow: var(--shadow); }
    .cta-band h2 { margin: 0; font-size: clamp(28px, 4vw, 46px); letter-spacing: -.03em; color: var(--heading); font-weight: 900; }
    .cta-band p { margin: 16px auto 28px; max-width: 540px; color: var(--muted); font-size: 17px; }
    .cta-band .hero-actions { justify-content: center; }

    /* Forms */
    .split { display: grid; grid-template-columns: .85fr 1.15fr; gap: 28px; align-items: start; }
    .form { display: grid; gap: 15px; }
    .field-row { display: grid; gap: 7px; }
    label { color: var(--heading); font-weight: 700; font-size: 13.5px; }
    input, select, textarea {
      width: 100%; border: 1px solid var(--line-2); border-radius: 10px;
      background: color-mix(in srgb, var(--panel-strong) 80%, transparent); color: var(--text); padding: 12px 14px; outline: none; min-height: 46px;
    }
    textarea { min-height: 140px; resize: vertical; }
    input:focus, select:focus, textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(59,130,246,.22); }
    .notice { border-radius: 11px; padding: 13px 15px; border: 1px solid var(--line-2); background: var(--panel); color: var(--muted); }
    .notice.success { border-color: rgba(16,185,129,.5); color: var(--heading); background: rgba(16,185,129,.08); }
    .notice.error { border-color: rgba(239,68,68,.5); color: var(--heading); background: rgba(239,68,68,.08); }
    .contact-aside { display: grid; gap: 14px; }
    .info-line { display: flex; align-items: center; gap: 12px; }
    .info-line .ii { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: var(--panel-2); border: 1px solid var(--line); flex-shrink: 0; }
    .info-line .ii svg { width: 18px; height: 18px; color: var(--brand-2); }
    .info-line small { display: block; color: var(--soft); font-size: 12px; }
    .info-line strong { color: var(--heading); font-size: 14.5px; }

    /* Track */
    .track-shell { display: grid; grid-template-columns: .82fr 1.18fr; gap: 24px; align-items: start; }
    .track-form { position: sticky; top: 100px; }
    .quick-refs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .quick-refs a { border: 1px solid var(--line-2); border-radius: 999px; padding: 7px 12px; color: var(--muted); background: var(--panel-2); font-size: 13px; font-weight: 600; }
    .quick-refs a:hover { color: var(--heading); border-color: var(--brand); }
    .track-board { display: grid; gap: 18px; }
    .status-card { padding: 0; overflow: hidden; }
    .status-head { display: flex; justify-content: space-between; gap: 16px; padding: 24px; border-bottom: 1px solid var(--line); background: linear-gradient(135deg, rgba(59,130,246,.16), transparent 58%); }
    .status-ref span { color: var(--soft); font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .status-ref strong { display: block; margin-top: 5px; font-size: clamp(24px, 5vw, 36px); line-height: 1; letter-spacing: -.04em; color: var(--heading); }
    .status-pill { align-self: start; border-radius: 999px; padding: 8px 14px; color: #052012; background: linear-gradient(135deg, #34d399, #10b981); font-size: 13px; font-weight: 800; white-space: nowrap; }
    .track-map { position: relative; min-height: 150px; margin: 20px 24px 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
      background: linear-gradient(0deg, rgba(59,130,246,.1), transparent), color-mix(in srgb, var(--panel-strong) 70%, transparent); }
    .route-line { position: absolute; left: 11%; right: 11%; top: 52%; height: 4px; border-radius: 999px; background: linear-gradient(90deg, var(--brand-3), var(--brand), var(--line-2)); }
    .route-pin { position: absolute; top: calc(52% - 13px); width: 27px; height: 27px; border-radius: 999px; background: var(--panel-strong); border: 2px solid var(--brand-3); box-shadow: 0 12px 30px rgba(0,0,0,.3); }
    .route-pin.start { left: 9%; } .route-pin.mid { left: 45%; border-color: var(--brand); } .route-pin.end { right: 9%; border-color: var(--line-2); }
    .route-label { position: absolute; top: 18px; color: var(--soft); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
    .route-label.start { left: 24px; } .route-label.end { right: 24px; }
    .track-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 20px; border-top: 1px solid var(--line); background: var(--line); }
    .track-stat { padding: 17px 20px; background: var(--panel); }
    .track-stat span { display: block; color: var(--soft); font-size: 12px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
    .track-stat strong { display: block; margin-top: 5px; color: var(--heading); font-size: 16px; }
    .timeline { display: grid; gap: 12px; }
    .step { position: relative; display: flex; gap: 14px; align-items: start; padding: 17px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
    .step::after { content: ""; position: absolute; left: 22px; top: 40px; bottom: -16px; width: 2px; background: var(--line); }
    .step:last-child::after { display: none; }
    .dot { flex: 0 0 13px; width: 13px; height: 13px; border-radius: 999px; margin-top: 6px; background: var(--soft); box-shadow: 0 0 0 5px color-mix(in srgb, var(--soft) 14%, transparent); z-index: 1; }
    .step.is-done .dot { background: var(--brand-3); box-shadow: 0 0 0 5px rgba(16,185,129,.18); }
    .step.is-active { border-color: rgba(59,130,246,.46); }
    .step.is-active .dot { background: var(--brand); box-shadow: 0 0 0 5px rgba(59,130,246,.2); }
    .step strong { color: var(--heading); }
    .step-meta { display: flex; justify-content: space-between; gap: 14px; margin-bottom: 4px; }
    .step-time { color: var(--soft); font-size: 13px; font-weight: 700; }
    .step p { margin: 0; color: var(--muted); font-size: 14px; }

    /* Footer */
    .footer { padding: 54px 0 36px; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--bg-2) 60%, transparent); margin-top: 30px; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr repeat(2, 1fr); gap: 28px; }
    .footer a, .footer p { color: var(--muted); }
    .footer a:hover { color: var(--heading); }
    .footer h4 { margin: 0 0 12px; color: var(--heading); font-size: 14px; }
    .footer-links { display: grid; gap: 9px; font-size: 14.5px; }
    .footer p { max-width: 280px; }
    .foot-bottom { margin-top: 36px; padding-top: 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; color: var(--soft); font-size: 13px; }
    .foot-bottom b { color: #fcd34d; font-weight: 700; }

    /* FLEETS.HQ — red+gold signature ribbon */
    .ribbon { position: absolute; right: -5%; bottom: -10%; width: 70%; height: 280px; pointer-events: none; z-index: 0; opacity: .85;
      background:
        radial-gradient(120% 60% at 80% 60%, rgba(225,29,42,.32), transparent 60%),
        radial-gradient(120% 60% at 95% 80%, rgba(245,179,1,.22), transparent 55%);
      -webkit-mask-image: radial-gradient(120% 80% at 80% 70%, #000 30%, transparent 75%); mask-image: radial-gradient(120% 80% at 80% 70%, #000 30%, transparent 75%); }
    .ribbon::before, .ribbon::after { content: ""; position: absolute; left: 0; right: 0; height: 3px; border-radius: 999px; }
    .ribbon::before { top: 46%; background: linear-gradient(90deg, transparent, #e11d2a 60%, #ff6b73); box-shadow: 0 0 30px rgba(225,29,42,.6); transform: rotate(-7deg); }
    .ribbon::after { top: 58%; background: linear-gradient(90deg, transparent, #f5b301 60%, #fde68a); box-shadow: 0 0 26px rgba(245,179,1,.5); transform: rotate(-7deg); }

    /* Pillars (Drivers / Vehicles / Compliance / Tachographs / Maintenance) */
    .pillars { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin-top: 36px; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--panel-2); }
    .pillar { padding: 22px 18px; text-align: center; border-right: 1px solid var(--line); }
    .pillar:last-child { border-right: 0; }
    .pillar-ic { width: 46px; height: 46px; margin: 0 auto 12px; border-radius: 12px; display: grid; place-items: center; border: 1px solid var(--line-2); background: rgba(255,255,255,.03); }
    .pillar-ic svg { width: 24px; height: 24px; color: var(--brand-2); }
    .pillar:nth-child(3) .pillar-ic svg { color: var(--brand); }
    .pillar h4 { margin: 0 0 5px; font-size: 14px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--heading); }
    .pillar p { margin: 0; font-size: 12.5px; color: var(--soft); line-height: 1.5; }

    /* Hero art: real road photo, network map overlaid as a live-tracking motif */
    .hero-photo {
      position: relative; width: 100%; aspect-ratio: 4 / 3.4; border-radius: var(--radius);
      overflow: hidden; border: 1px solid var(--line-2); box-shadow: var(--shadow);
      background: url('/img/road-skyline.jpeg') center 60% / cover no-repeat;
    }
    .hero-photo::before {
      content: ""; position: absolute; inset: 0;
      background:
        linear-gradient(195deg, rgba(10,10,12,.1) 0%, rgba(10,10,12,.72) 100%),
        linear-gradient(125deg, rgba(225,29,42,.24), transparent 55%);
    }
    [data-theme="light"] .hero-photo::before {
      background:
        linear-gradient(195deg, rgba(10,10,12,.04) 0%, rgba(10,10,12,.5) 100%),
        linear-gradient(125deg, rgba(225,29,42,.18), transparent 55%);
    }
    .netmap { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .8; }
    .netmap svg { width: 100%; height: 100%; display: block; }
    .netmap .node { fill: var(--brand-2); }
    .netmap .node.hot { fill: var(--brand); }
    @keyframes nodepulse { 0%,100% { opacity: .55; r: 2.4px; } 50% { opacity: 1; r: 3.4px; } }
    .netmap .node { animation: nodepulse 3.4s ease-in-out infinite; }
    .netmap .route { stroke: rgba(245,179,1,.55); stroke-width: 1; fill: none; }
    .netmap .route.hot { stroke: rgba(225,29,42,.75); }
    .netmap .uk { fill: none; stroke: none; }

    /* Built-by-hauliers band */
    .builtby { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 22px; margin-top: 30px; padding-top: 26px; border-top: 1px solid var(--line); }
    .builtby .bold-gold { color: var(--brand-2); font-weight: 900; letter-spacing: .06em; font-size: clamp(15px, 2.2vw, 20px); text-transform: uppercase; }
    .builtby .bold-white { color: var(--heading); font-weight: 800; letter-spacing: .12em; font-size: clamp(13px, 1.8vw, 16px); text-transform: uppercase; }

    /* Trust line */
    .trust { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: space-between; padding: 22px 26px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
    .trust-left { display: flex; align-items: center; gap: 14px; }
    .trust-shield { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.3); flex-shrink: 0; }
    .trust-shield svg { width: 21px; height: 21px; color: var(--brand-3); }
    .trust-left p { margin: 0; font-size: 13.5px; color: var(--muted); }
    .trust-left p b { color: var(--heading); }
    .trust-powered { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--soft); }
    .trust-powered b { color: var(--brand); }

    /* Reveal */
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
    .reveal.in { opacity: 1; transform: none; }

    @media (max-width: 940px) {
      .hero-grid, .split, .track-shell { grid-template-columns: 1fr; }
      .hero-art { order: -1; min-height: 0; }
      .grid.three { grid-template-columns: repeat(2, 1fr); }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .pillars { grid-template-columns: repeat(2, 1fr); }
      .pillar { border-bottom: 1px solid var(--line); }
      .pillar:nth-child(even) { border-right: 0; }
      .trust { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 680px) {
      .wrap { width: min(100% - 28px, 620px); }
      .nav-inner { flex-direction: column; align-items: stretch; padding: 12px 0; gap: 10px; }
      .nav-links { overflow-x: auto; scrollbar-width: none; }
      .nav-links::-webkit-scrollbar { display: none; }
      .nav-links > a { white-space: nowrap; flex: 0 0 auto; }
      .nav-sep { display: none; }
      .grid.two, .grid.three, .stats, .footer-grid, .track-summary { grid-template-columns: 1fr; }
      .pillars { grid-template-columns: 1fr; }
      .pillar { border-right: 0; }
      .hero { padding: 44px 0 30px; }
      .hero-actions { display: grid; } .cta { width: 100%; }
      .float-chip { display: none; }
      section { padding: 44px 0; }
      .cta-band { padding: 44px 22px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>
