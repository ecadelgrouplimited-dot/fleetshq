  <script>
    // Scroll reveal
    (function(){
      var els = document.querySelectorAll('.reveal:not(.in)');
      if (!('IntersectionObserver' in window)) { els.forEach(function(e){e.classList.add('in');}); return; }
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){ if (en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.16 });
      els.forEach(function(e){ io.observe(e); });
    })();

    // Animated compliance gauge — fills when scrolled into view
    (function(){
      var target = 94, R = 112, C = 2 * Math.PI * R;
      var ring = document.getElementById('ring');
      var num = document.getElementById('scoreNum');
      var gauge = document.getElementById('gauge');
      var done = false;
      function run(){
        if (done) return; done = true;
        ring.style.strokeDashoffset = C * (1 - target/100);
        var t0 = performance.now(), dur = 1900;
        function tick(now){
          var p = Math.min((now - t0)/dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          num.textContent = Math.round(eased * target);
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }
      if (!('IntersectionObserver' in window)) { run(); return; }
      var io = new IntersectionObserver(function(e){ if (e[0].isIntersecting) run(); }, { threshold: 0.5 });
      io.observe(gauge);
    })();
  </script>
