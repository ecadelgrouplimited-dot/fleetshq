<%
  const currentPage = typeof page !== 'undefined' ? page : 'home';
  const selectedType = typeof enquiryType !== 'undefined' ? enquiryType : 'general';
  const form = typeof formData !== 'undefined' ? formData : {};
  const nav = [
    ['Services', '/services', 'services'],
    ['About', '/about', 'about'],
    ['Track', '/track', 'track'],
    ['Contact', '/contact', 'contact'],
  ];
  const pageTitles = {
    home: ['The operating system for modern logistics.', 'Booking, dispatch, fleet, people, finance and DVSA / Home Office compliance — one connected platform that keeps every mile accountable.'],
    services: ['Transport services with compliance built in.', 'From same-day couriers to palletised freight, the same operating spine keeps work visible from first enquiry to signed-off delivery.'],
    about: ['A logistics platform built for proof.', '256 Logistics connects daily transport work to the evidence that protects your operator licence, your sponsorship, and your business.'],
    contact: ['Talk to the transport team.', 'Send a quote request, partnership enquiry, or service question — it lands straight in the operations hub.'],
    track: ['Track a shipment.', 'Check a reference for live status, ETA and milestone history — no account needed.'],
  };
  const heading = pageTitles[currentPage] || pageTitles.home;
%>
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || '256 Logistics' %></title>
  <meta name="description" content="256 Logistics — the operating platform for UK logistics operators. Booking, dispatch, fleet, people, finance and compliance in one connected system.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    (function () {
      var stored = localStorage.getItem('public-theme');
      var cookie = document.cookie.match(/(?:^|; )publicTheme=([^;]+)/);
      var preferred = stored || (cookie && cookie[1]) || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', preferred);
    }());
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root {
      color-scheme: dark;
      --bg: #070f1c;
      --bg-2: #0b1828;
      --panel: rgba(15, 31, 51, .72);
      --panel-2: rgba(18, 37, 60, .55);
      --panel-strong: #102337;
      --text: #f4f9ff;
      --heading: #ffffff;
      --muted: #aebfd2;
      --soft: #6f879b;
      --line: rgba(174, 191, 210, .15);
      --line-2: rgba(174, 191, 210, .28);
      --brand: #3b82f6;
      --brand-deep: #1d4ed8;
      --brand-2: #22d3ee;
      --brand-3: #10b981;
      --gold-1: #fde68a;
      --gold-2: #f59e0b;
      --gold-3: #b45309;
      --danger: #ef4444;
      --amber: #f59e0b;
      --shadow: 0 30px 90px rgba(0, 0, 0, .42);
      --shadow-soft: 0 18px 50px rgba(3, 12, 26, .35);
      --radius: 16px;
      --radius-sm: 11px;
    }
    [data-theme="light"] {
      color-scheme: light;
      --bg: #eef3f9;
      --bg-2: #e3edf6;
      --panel: rgba(255, 255, 255, .82);
      --panel-2: rgba(255, 255, 255, .6);
      --panel-strong: #ffffff;
      --text: #0d1b2c;
      --heading: #07101e;
      --muted: #46586d;
      --soft: #65788c;
      --line: rgba(15, 41, 71, .12);
      --line-2: rgba(15, 41, 71, .2);
      --shadow: 0 26px 70px rgba(20, 47, 84, .16);
      --shadow-soft: 0 14px 40px rgba(20, 47, 84, .1);
    }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      color: var(--text);
      background: var(--bg);
      min-height: 100vh;
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    body.loading { overflow: hidden; }
    a { color: inherit; text-decoration: none; }
    button, input, select, textarea { font: inherit; }

    /* Ambient cinematic field */
    .field { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .field .grid {
      position: absolute; inset: -2px;
      background-image:
        linear-gradient(var(--line) 1px, transparent 1px),
        linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 58px 58px; opacity: .5;
      -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 35%, transparent 100%);
              mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 35%, transparent 100%);
    }
    .orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .55; }
    .orb.a { width: 620px; height: 620px; top: -220px; right: -160px; background: radial-gradient(circle, rgba(59,130,246,.5), transparent 68%); }
    .orb.b { width: 460px; height: 460px; top: 36%; left: -200px; background: radial-gradient(circle, rgba(34,211,238,.32), transparent 66%); }
    .orb.c { width: 520px; height: 520px; bottom: -240px; right: 8%; background: radial-gradient(circle, rgba(16,185,129,.26), transparent 66%); }
    [data-theme="light"] .orb { opacity: .4; }
    main, .nav, .footer, .loader { position: relative; z-index: 1; }

    .wrap { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }

    /* Loader */
    .loader { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; background: var(--bg); transition: opacity .4s ease, visibility .4s ease; }
    .loader.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
    .loader-card { display: grid; gap: 18px; place-items: center; }
    .loader-mark { width: 78px; height: 78px; border-radius: 22px; display: grid; place-items: center; box-shadow: var(--shadow); }
    .loader-line { width: 180px; height: 3px; border-radius: 999px; background: var(--line-2); overflow: hidden; }
    .loader-line span { display: block; height: 100%; width: 42%; background: linear-gradient(90deg, var(--brand), var(--brand-2)); animation: load 1.1s ease-in-out infinite; }
    @keyframes load { 0% { transform: translateX(-130%); } 100% { transform: translateX(320%); } }

    /* Brand mark */
    .brand { display: inline-flex; align-items: center; gap: 12px; font-weight: 900; letter-spacing: -.02em; color: var(--heading); }
    .brand-mark, .loader-mark {
      position: relative; background: linear-gradient(145deg, #3b82f6, #1d4ed8);
      border: 1px solid rgba(255,255,255,.22); color: #fff; isolation: isolate; overflow: hidden;
    }
    .brand-mark { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; box-shadow: 0 10px 30px rgba(59,130,246,.4); }
    .brand-mark::before, .loader-mark::before { content: ""; position: absolute; inset: 7px; border: 2px solid var(--brand-2); clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); opacity: .9; z-index: -1; }
    .brand-mark::after, .loader-mark::after { content: "256"; font-size: 11px; font-weight: 900; letter-spacing: -.06em; }
    .loader-mark::after { font-size: 18px; }
    .brand small { display: block; color: var(--soft); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }

    /* Nav */
    .nav { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: saturate(150%) blur(16px); }
    .nav-inner { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
    .nav-links { display: flex; align-items: center; gap: 4px; margin-left: auto; }
    .nav-links > a, .nav-action {
      border: 0; background: transparent; color: var(--muted);
      border-radius: 9px; padding: 9px 13px; cursor: pointer; font-weight: 600; font-size: 14.5px; transition: all .15s;
    }
    .nav-links > a:hover, .nav-links > a.is-active, .nav-action:hover { color: var(--heading); background: color-mix(in srgb, var(--panel-strong) 70%, transparent); }
    .nav-action { display: inline-flex; align-items: center; gap: 7px; }
    .nav-sep { width: 1px; height: 22px; background: var(--line-2); margin: 0 6px; }
    .cta {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      min-height: 44px; padding: 11px 20px; border-radius: 10px; font-weight: 700; font-size: 14.5px;
      background: linear-gradient(135deg, var(--brand), var(--brand-deep)); color: #fff;
      border: 1px solid rgba(255,255,255,.14); box-shadow: 0 14px 34px rgba(59,130,246,.36); transition: transform .18s, box-shadow .18s;
    }
    .cta:hover { transform: translateY(-2px); box-shadow: 0 20px 44px rgba(59,130,246,.5); }
    .cta.secondary { background: var(--panel); color: var(--heading); box-shadow: none; border-color: var(--line-2); backdrop-filter: blur(8px); }
    .cta.secondary:hover { border-color: var(--brand); }
    .cta.ghost { background: transparent; color: var(--heading); box-shadow: none; border-color: var(--line-2); }

    /* Hero */
    .hero { padding: 70px 0 48px; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(340px, .82fr); gap: 48px; align-items: center; }
    .eyebrow { display: inline-flex; align-items: center; gap: 9px; color: var(--brand-2); font-weight: 700; letter-spacing: .12em; font-size: 12px; text-transform: uppercase; padding: 7px 14px; border: 1px solid var(--line-2); border-radius: 100px; background: var(--panel-2); }
    .eyebrow .pip { width: 7px; height: 7px; border-radius: 50%; background: var(--brand-2); box-shadow: 0 0 10px var(--brand-2); animation: pip 2s infinite; }
    @keyframes pip { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.4)} }
    h1 { margin: 20px 0 18px; max-width: 740px; font-size: clamp(40px, 6vw, 70px); line-height: 1.02; letter-spacing: -.035em; color: var(--heading); font-weight: 900; }
    h1 .grad { background: linear-gradient(110deg, #60a5fa, #22d3ee 55%, #34d399); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .intro { max-width: 600px; color: var(--muted); font-size: 18.5px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
    .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 40px; padding-top: 30px; border-top: 1px solid var(--line); }
    .metric strong { display: block; color: var(--heading); font-size: 27px; font-weight: 800; letter-spacing: -.02em; }
    .metric span { color: var(--soft); font-size: 13px; }

    /* Hero console art */
    .hero-art { position: relative; min-height: 420px; display: grid; place-items: center; }
    .console {
      width: 100%; border: 1px solid var(--line-2); border-radius: var(--radius); overflow: hidden;
      background: linear-gradient(180deg, var(--panel-strong), var(--panel)); box-shadow: var(--shadow); backdrop-filter: blur(8px);
    }
    .console-bar { display: flex; align-items: center; gap: 8px; padding: 13px 16px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--panel-strong) 60%, transparent); }
    .console-bar i { width: 11px; height: 11px; border-radius: 50%; display: block; }
    .console-bar i.r { background: #ff5f57; } .console-bar i.y { background: #febc2e; } .console-bar i.g { background: #28c840; }
    .console-bar span { margin-left: 8px; font-size: 12px; color: var(--soft); font-weight: 600; }
    .console-body { padding: 18px; display: grid; gap: 12px; }
    .con-row { display: flex; align-items: center; gap: 13px; padding: 13px 15px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--panel-2); }
    .con-ic { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; flex-shrink: 0; }
    .con-ic svg { width: 19px; height: 19px; }
    .con-row .meta { min-width: 0; flex: 1; }
    .con-row .meta strong { display: block; font-size: 13.5px; color: var(--heading); font-weight: 700; }
    .con-row .meta span { font-size: 12px; color: var(--soft); }
    .con-pill { font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 100px; white-space: nowrap; }
    .con-pill.green { color: #34d399; background: rgba(16,185,129,.14); }
    .con-pill.blue { color: #60a5fa; background: rgba(59,130,246,.16); }
    .con-pill.amber { color: #fbbf24; background: rgba(245,158,11,.16); }
    .float-chip {
      position: absolute; display: flex; align-items: center; gap: 9px; padding: 11px 14px; border-radius: 13px;
      background: color-mix(in srgb, var(--panel-strong) 92%, transparent); border: 1px solid var(--line-2);
      box-shadow: var(--shadow-soft); font-size: 13px; font-weight: 700; color: var(--heading); backdrop-filter: blur(10px); animation: floaty 5.5s ease-in-out infinite;
    }
    .float-chip small { display: block; font-size: 11px; font-weight: 500; color: var(--soft); }
    .float-chip .dot { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; flex-shrink: 0; }
    .float-chip.one { top: 18px; left: -14px; }
    .float-chip.two { bottom: 30px; right: -16px; animation-delay: -2.6s; }
    @keyframes floaty { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }

    /* Sections */
    section { padding: 60px 0; position: relative; }
    .section-head { max-width: 680px; margin-bottom: 36px; }
    .section-head.center { margin-inline: auto; text-align: center; }
    .section-head h2 { margin: 14px 0 0; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.06; letter-spacing: -.03em; color: var(--heading); font-weight: 800; }
    .section-head p { margin: 14px 0 0; color: var(--muted); font-size: 17px; }
    .kicker { color: var(--brand-2); font-weight: 700; font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; }

    .grid { display: grid; gap: 18px; }
    .grid.three { grid-template-columns: repeat(3, 1fr); }
    .grid.two { grid-template-columns: repeat(2, 1fr); }
    .card {
      position: relative; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel);
      padding: 26px; box-shadow: var(--shadow-soft); backdrop-filter: blur(8px); transition: transform .25s, border-color .25s, box-shadow .25s;
    }
    .card.lift:hover { transform: translateY(-4px); border-color: var(--line-2); box-shadow: var(--shadow); }
    .card-ic { width: 52px; height: 52px; border-radius: 13px; display: grid; place-items: center; margin-bottom: 18px; background: linear-gradient(135deg, rgba(59,130,246,.18), rgba(34,211,238,.1)); border: 1px solid var(--line-2); }
    .card-ic svg { width: 25px; height: 25px; color: #60a5fa; }
    .card h3 { margin: 0 0 9px; font-size: 19px; color: var(--heading); font-weight: 700; overflow-wrap: anywhere; }
    .card p, .card li { color: var(--muted); font-size: 14.5px; }
    .card ul { padding-left: 18px; margin: 12px 0 0; display: grid; gap: 6px; }
    .card .more { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; color: var(--brand); font-weight: 700; font-size: 14px; }

    .band { border-block: 1px solid var(--line); background: color-mix(in srgb, var(--bg-2) 60%, transparent); }

    /* Service cards */
    .service-card { display: grid; gap: 12px; }
    .service-top { display: flex; justify-content: space-between; gap: 12px; align-items: start; }
    .tag { display: inline-flex; align-items: center; min-height: 26px; border-radius: 999px; padding: 4px 11px; color: var(--brand-2); background: rgba(34,211,238,.12); border: 1px solid rgba(34,211,238,.26); font-size: 12px; font-weight: 800; white-space: nowrap; }

    /* Stats band */
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .stat { text-align: center; padding: 26px 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
    .stat strong { display: block; font-size: clamp(30px, 4vw, 44px); font-weight: 900; letter-spacing: -.03em; background: linear-gradient(120deg, #60a5fa, #34d399); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .stat span { color: var(--soft); font-size: 13.5px; font-weight: 600; }

    /* Steps flow */
    .flow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; counter-reset: step; }
    .flow .node { position: relative; padding: 26px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
    .flow .node .n { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-weight: 800; color: #fff; background: linear-gradient(135deg, var(--brand), var(--brand-deep)); margin-bottom: 14px; }
    .flow .node h3 { margin: 0 0 7px; font-size: 17px; color: var(--heading); }
    .flow .node p { margin: 0; color: var(--muted); font-size: 14px; }

    /* CTA band */
    .cta-band { position: relative; overflow: hidden; border: 1px solid var(--line-2); border-radius: 26px; padding: 60px 40px; text-align: center;
      background: radial-gradient(ellipse 70% 130% at 50% -10%, rgba(59,130,246,.28), transparent 70%), linear-gradient(180deg, var(--panel-strong), var(--panel)); box-shadow: var(--shadow); }
    .cta-band h2 { margin: 0; font-size: clamp(28px, 4vw, 46px); letter-spacing: -.03em; color: var(--heading); font-weight: 900; }
    .cta-band p { margin: 16px auto 28px; max-width: 540px; color: var(--muted); font-size: 17px; }
    .cta-band .hero-actions { justify-content: center; }

    /* Forms */
    .split { display: grid; grid-template-columns: .85fr 1.15fr; gap: 28px; align-items: start; }
    .form { display: grid; gap: 15px; }
    .field-row { display: grid; gap: 7px; }
    label { color: var(--heading); font-weight: 700; font-size: 13.5px; }
    input, select, textarea {
      width: 100%; border: 1px solid var(--line-2); border-radius: 10px;
      background: color-mix(in srgb, var(--panel-strong) 80%, transparent); color: var(--text); padding: 12px 14px; outline: none; min-height: 46px;
    }
    textarea { min-height: 140px; resize: vertical; }
    input:focus, select:focus, textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(59,130,246,.22); }
    .notice { border-radius: 11px; padding: 13px 15px; border: 1px solid var(--line-2); background: var(--panel); color: var(--muted); }
    .notice.success { border-color: rgba(16,185,129,.5); color: var(--heading); background: rgba(16,185,129,.08); }
    .notice.error { border-color: rgba(239,68,68,.5); color: var(--heading); background: rgba(239,68,68,.08); }
    .contact-aside { display: grid; gap: 14px; }
    .info-line { display: flex; align-items: center; gap: 12px; }
    .info-line .ii { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: var(--panel-2); border: 1px solid var(--line); flex-shrink: 0; }
    .info-line .ii svg { width: 18px; height: 18px; color: #60a5fa; }
    .info-line small { display: block; color: var(--soft); font-size: 12px; }
    .info-line strong { color: var(--heading); font-size: 14.5px; }

    /* Track */
    .track-shell { display: grid; grid-template-columns: .82fr 1.18fr; gap: 24px; align-items: start; }
    .track-form { position: sticky; top: 100px; }
    .quick-refs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .quick-refs a { border: 1px solid var(--line-2); border-radius: 999px; padding: 7px 12px; color: var(--muted); background: var(--panel-2); font-size: 13px; font-weight: 600; }
    .quick-refs a:hover { color: var(--heading); border-color: var(--brand); }
    .track-board { display: grid; gap: 18px; }
    .status-card { padding: 0; overflow: hidden; }
    .status-head { display: flex; justify-content: space-between; gap: 16px; padding: 24px; border-bottom: 1px solid var(--line); background: linear-gradient(135deg, rgba(59,130,246,.16), transparent 58%); }
    .status-ref span { color: var(--soft); font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .status-ref strong { display: block; margin-top: 5px; font-size: clamp(24px, 5vw, 36px); line-height: 1; letter-spacing: -.04em; color: var(--heading); }
    .status-pill { align-self: start; border-radius: 999px; padding: 8px 14px; color: #052012; background: linear-gradient(135deg, #34d399, #10b981); font-size: 13px; font-weight: 800; white-space: nowrap; }
    .track-map { position: relative; min-height: 150px; margin: 20px 24px 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
      background: linear-gradient(0deg, rgba(59,130,246,.1), transparent), color-mix(in srgb, var(--panel-strong) 70%, transparent); }
    .route-line { position: absolute; left: 11%; right: 11%; top: 52%; height: 4px; border-radius: 999px; background: linear-gradient(90deg, var(--brand-3), var(--brand), var(--line-2)); }
    .route-pin { position: absolute; top: calc(52% - 13px); width: 27px; height: 27px; border-radius: 999px; background: var(--panel-strong); border: 2px solid var(--brand-3); box-shadow: 0 12px 30px rgba(0,0,0,.3); }
    .route-pin.start { left: 9%; } .route-pin.mid { left: 45%; border-color: var(--brand); } .route-pin.end { right: 9%; border-color: var(--line-2); }
    .route-label { position: absolute; top: 18px; color: var(--soft); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
    .route-label.start { left: 24px; } .route-label.end { right: 24px; }
    .track-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 20px; border-top: 1px solid var(--line); background: var(--line); }
    .track-stat { padding: 17px 20px; background: var(--panel); }
    .track-stat span { display: block; color: var(--soft); font-size: 12px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
    .track-stat strong { display: block; margin-top: 5px; color: var(--heading); font-size: 16px; }
    .timeline { display: grid; gap: 12px; }
    .step { position: relative; display: flex; gap: 14px; align-items: start; padding: 17px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
    .step::after { content: ""; position: absolute; left: 22px; top: 40px; bottom: -16px; width: 2px; background: var(--line); }
    .step:last-child::after { display: none; }
    .dot { flex: 0 0 13px; width: 13px; height: 13px; border-radius: 999px; margin-top: 6px; background: var(--soft); box-shadow: 0 0 0 5px color-mix(in srgb, var(--soft) 14%, transparent); z-index: 1; }
    .step.is-done .dot { background: var(--brand-3); box-shadow: 0 0 0 5px rgba(16,185,129,.18); }
    .step.is-active { border-color: rgba(59,130,246,.46); }
    .step.is-active .dot { background: var(--brand); box-shadow: 0 0 0 5px rgba(59,130,246,.2); }
    .step strong { color: var(--heading); }
    .step-meta { display: flex; justify-content: space-between; gap: 14px; margin-bottom: 4px; }
    .step-time { color: var(--soft); font-size: 13px; font-weight: 700; }
    .step p { margin: 0; color: var(--muted); font-size: 14px; }

    /* ECADEL credit */
    .credit-band { margin-top: 14px; }
    .credit-card { position: relative; overflow: hidden; display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center; padding: 30px 34px; border-radius: 22px;
      background: radial-gradient(ellipse 70% 150% at 10% 0%, rgba(245,158,11,.14), transparent 60%), linear-gradient(180deg, var(--panel-strong), var(--panel)); border: 1px solid rgba(245,158,11,.24); box-shadow: var(--shadow-soft); }
    .credit-seal { width: 70px; height: 70px; filter: drop-shadow(0 8px 22px rgba(245,158,11,.4)); }
    .credit-eyebrow { display: inline-flex; align-items: center; gap: 9px; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #fcd34d; margin-bottom: 9px; }
    .credit-eyebrow .ln { width: 22px; height: 1px; background: linear-gradient(90deg, #f59e0b, transparent); }
    .credit-name { font-size: clamp(20px, 2.6vw, 27px); font-weight: 900; letter-spacing: -.02em; line-height: 1.05; background: linear-gradient(100deg, #fffbeb, #fcd34d 55%, #f59e0b); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .credit-tag { font-size: 14px; color: var(--muted); max-width: 520px; margin-top: 8px; }
    .credit-cta { display: inline-flex; align-items: center; gap: 9px; white-space: nowrap; font-weight: 700; font-size: 14px; color: #1a1205; background: linear-gradient(135deg, #fde68a, #f59e0b); padding: 12px 20px; border-radius: 11px; box-shadow: 0 10px 26px rgba(245,158,11,.34); transition: transform .18s; }
    .credit-cta:hover { transform: translateY(-2px); }

    /* Footer */
    .footer { padding: 54px 0 36px; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--bg-2) 60%, transparent); margin-top: 30px; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 28px; }
    .footer a, .footer p { color: var(--muted); }
    .footer a:hover { color: var(--heading); }
    .footer h4 { margin: 0 0 12px; color: var(--heading); font-size: 14px; }
    .footer-links { display: grid; gap: 9px; font-size: 14.5px; }
    .footer p { max-width: 280px; }
    .foot-bottom { margin-top: 36px; padding-top: 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; color: var(--soft); font-size: 13px; }
    .foot-bottom b { color: #fcd34d; font-weight: 700; }

    /* Reveal */
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
    .reveal.in { opacity: 1; transform: none; }

    @media (max-width: 940px) {
      .hero-grid, .split, .track-shell { grid-template-columns: 1fr; }
      .hero-art { order: -1; min-height: 0; }
      .grid.three, .flow { grid-template-columns: repeat(2, 1fr); }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .credit-card { grid-template-columns: 1fr; text-align: center; gap: 18px; }
      .credit-seal { margin: 0 auto; } .credit-eyebrow { justify-content: center; } .credit-tag { margin-inline: auto; }
    }
    @media (max-width: 680px) {
      .wrap { width: min(100% - 28px, 620px); }
      .nav-inner { flex-direction: column; align-items: stretch; padding: 12px 0; gap: 10px; }
      .nav-links { overflow-x: auto; scrollbar-width: none; }
      .nav-links::-webkit-scrollbar { display: none; }
      .nav-links > a, .nav-action { white-space: nowrap; flex: 0 0 auto; }
      .nav-sep { display: none; }
      .grid.two, .grid.three, .flow, .stats, .footer-grid, .track-summary { grid-template-columns: 1fr; }
      .hero { padding: 44px 0 30px; }
      .hero-actions { display: grid; } .cta { width: 100%; }
      .float-chip { display: none; }
      section { padding: 44px 0; }
      .cta-band { padding: 44px 22px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>
<body class="loading">

  <div class="field" aria-hidden="true">
    <div class="grid"></div>
    <span class="orb a"></span><span class="orb b"></span><span class="orb c"></span>
  </div>

  <div class="loader" id="loader" aria-live="polite">
    <div class="loader-card">
      <div class="loader-mark" aria-hidden="true"></div>
      <strong>256 Logistics</strong>
      <div class="loader-line" aria-hidden="true"><span></span></div>
    </div>
  </div>

  <nav class="nav">
    <div class="wrap nav-inner">
      <a href="/welcome" class="brand" aria-label="256 Logistics home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>256 Logistics<small>Logistics platform</small></span>
      </a>
      <div class="nav-links">
        <% nav.forEach(([label, href, key]) => { %>
          <a href="<%= href %>" class="<%= currentPage === key ? 'is-active' : '' %>"><%= label %></a>
        <% }) %>
        <button class="nav-action" type="button" id="themeToggle" aria-label="Toggle theme"><span aria-hidden="true">◐</span> Theme</button>
        <span class="nav-sep" aria-hidden="true"></span>
        <a href="/login">Sign in</a>
        <a class="cta" href="/contact?type=quote">Get a quote</a>
      </div>
    </div>
  </nav>

  <main>
    <header class="hero">
      <div class="wrap hero-grid">
        <div>
          <span class="eyebrow"><span class="pip"></span>UK logistics operations platform</span>
          <h1><%= heading[0].includes('.') ? heading[0].replace(/\.([^.]*)$/, '') : heading[0] %><span class="grad">.</span></h1>
          <p class="intro"><%= heading[1] %></p>
          <div class="hero-actions">
            <a class="cta" href="/contact?type=quote">Request a quote
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a class="cta secondary" href="/track">Track a shipment</a>
          </div>
          <div class="metrics">
            <div class="metric"><strong>10</strong><span>connected panels</span></div>
            <div class="metric"><strong>DVSA</strong><span>evidence-ready</span></div>
            <div class="metric"><strong>24/7</strong><span>request intake</span></div>
          </div>
        </div>
        <div class="hero-art">
          <div class="console" aria-hidden="true">
            <div class="console-bar"><i class="r"></i><i class="y"></i><i class="g"></i><span>256 · operations</span></div>
            <div class="console-body">
              <div class="con-row">
                <span class="con-ic" style="background:rgba(59,130,246,.16)"><svg fill="none" viewBox="0 0 24 24" stroke="#60a5fa"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM20 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10m10 0H9m4 0h3m0 0V9h3l3 4v3"/></svg></span>
                <div class="meta"><strong>Shipment 256-LANE-042</strong><span>Out for delivery · ETA 14:20</span></div>
                <span class="con-pill blue">In transit</span>
              </div>
              <div class="con-row">
                <span class="con-ic" style="background:rgba(16,185,129,.16)"><svg fill="none" viewBox="0 0 24 24" stroke="#34d399"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7"/></svg></span>
                <div class="meta"><strong>Fleet roadworthy</strong><span>38 / 38 vehicles compliant</span></div>
                <span class="con-pill green">Clear</span>
              </div>
              <div class="con-row">
                <span class="con-ic" style="background:rgba(245,158,11,.16)"><svg fill="none" viewBox="0 0 24 24" stroke="#fbbf24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/></svg></span>
                <div class="meta"><strong>Driver CPC expiring</strong><span>Flagged · 21 days · 1 driver</span></div>
                <span class="con-pill amber">Action</span>
              </div>
            </div>
          </div>
          <div class="float-chip one">
            <span class="dot" style="background:rgba(16,185,129,.18)"><svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#34d399"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></span>
            <div>Compliance 94%<small>People · Fleet · Driver</small></div>
          </div>
          <div class="float-chip two">
            <span class="dot" style="background:rgba(59,130,246,.18)"><svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#60a5fa"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3"/></svg></span>
            <div>Live dispatch<small>12 jobs in motion</small></div>
          </div>
        </div>
      </div>
    </header>

    <% if (currentPage === 'home') { %>
      <section class="band">
        <div class="wrap">
          <div class="section-head reveal"><span class="kicker">One connected system</span><h2>Move, prove, improve — without the spreadsheets.</h2><p>Customer booking, dispatch, driver delivery, fleet maintenance, HR, finance and compliance stop being separate tools. They become one source of truth.</p></div>
          <div class="grid three">
            <article class="card lift reveal">
              <div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM20 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10m10 0H9m4 0h3m0 0V9h3l3 4v3"/></svg></div>
              <h3>Deliver</h3><p>Same-day, next-day, scheduled and multi-drop movements — booked by customers, allocated by dispatch, run by drivers with proof of delivery.</p>
            </article>
            <article class="card lift reveal">
              <div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg></div>
              <h3>Prove</h3><p>Every check, defect, document and training record becomes DVSA and Home-Office audit evidence — assembled in one click when an inspector knocks.</p>
            </article>
            <article class="card lift reveal">
              <div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
              <h3>Improve</h3><p>A live compliance score and cross-domain KPIs show exactly where you stand — and where the next risk is, before it costs you.</p>
            </article>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <div class="stats">
            <div class="stat reveal"><strong data-count="10">10</strong><span>Role-based panels</span></div>
            <div class="stat reveal"><strong data-count="2">2</strong><span>Licences protected</span></div>
            <div class="stat reveal"><strong data-count="1" data-suffix="-click">1-click</strong><span>Audit evidence packs</span></div>
            <div class="stat reveal"><strong data-count="100" data-suffix="%">100%</strong><span>Records, one place</span></div>
          </div>
        </div>
      </section>

      <section class="band">
        <div class="wrap">
          <div class="section-head reveal"><span class="kicker">From quote to settled</span><h2>How a job flows through 256.</h2></div>
          <div class="flow">
            <div class="node reveal"><div class="n">1</div><h3>Book</h3><p>A customer requests a quote and books a shipment from the client portal.</p></div>
            <div class="node reveal"><div class="n">2</div><h3>Dispatch</h3><p>Operations allocates the right driver and roadworthy vehicle, and plans the route.</p></div>
            <div class="node reveal"><div class="n">3</div><h3>Deliver</h3><p>The driver collects, navigates, and delivers with signature, OTP and photo proof.</p></div>
            <div class="node reveal"><div class="n">4</div><h3>Settle</h3><p>The shipment is invoiced, paid, and its evidence is filed automatically.</p></div>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <div class="grid two">
            <article class="card lift reveal"><div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></div><h3>For shippers</h3><p>Request a quote, book a collection, track a parcel and download proof of delivery — without needing an account to get started.</p><a class="more" href="/services">See services →</a></article>
            <article class="card lift reveal"><div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0H5m14 0h2M5 21H3m4-4h2m6 0h2M9 9h2m4 0h2M9 13h2m4 0h2"/></svg></div><h3>For operators</h3><p>Run dispatch, fleet, people, finance and compliance from one tenant-aware platform — with role-based panels for every team.</p><a class="more" href="/login">Enter the platform →</a></article>
          </div>
        </div>
      </section>
    <% } %>

    <% if (currentPage === 'services') { %>
      <section class="band">
        <div class="wrap">
          <div class="section-head reveal"><span class="kicker">Service catalogue</span><h2>Pick the lane that fits the load.</h2><p>Clear service lanes today, with deeper booking and fulfilment as the platform expands.</p></div>
          <div class="grid three">
            <% [
              ['Same-day delivery','Urgent','Time-sensitive collections and deliveries with direct operational oversight and live tracking.'],
              ['Next-day delivery','Planned','Reliable business-to-business movement across regular lanes with confirmed windows.'],
              ['Economy freight','Value','Cost-conscious consignments planned around efficient capacity and shared routes.'],
              ['Pallet & freight','Freight','Commercial loads, palletised freight and larger consignment handling.'],
              ['Courier work','Light','Smaller urgent movements with clear contact and delivery expectations.'],
              ['Returns & contracts','Recurring','Reverse logistics, recurring routes and contract transport patterns.'],
            ].forEach(([name, tag, body]) => { %>
              <article class="card lift service-card reveal">
                <div class="service-top"><h3><%= name %></h3><span class="tag"><%= tag %></span></div>
                <p><%= body %></p>
                <a class="more" href="/contact?type=quote">Request this service →</a>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
      <section>
        <div class="wrap"><div class="cta-band reveal"><h2>Not sure which service you need?</h2><p>Tell us what you're moving and where — we'll recommend the right lane and price it up.</p><div class="hero-actions"><a class="cta" href="/contact?type=quote">Get a quote</a><a class="cta secondary" href="/track">Track a shipment</a></div></div></div>
      </section>
    <% } %>

    <% if (currentPage === 'about') { %>
      <section class="band">
        <div class="wrap split">
          <div class="section-head reveal" style="margin:0"><span class="kicker">Mission &amp; vision</span><h2>Logistics you can prove.</h2><p>Our mission is to make transport operations reliable, auditable and easier to run — by connecting daily logistics work to the evidence that protects the business.</p></div>
          <div class="grid two" style="grid-template-columns:1fr">
            <article class="card reveal"><h3>Mission</h3><p>Give UK operators one system to run the whole operation, where every shipment, driver, vehicle and document is connected — never scattered across tools.</p></article>
            <article class="card reveal"><h3>Vision</h3><p>A logistics platform where compliance isn't paperwork chased after the fact, but evidence produced automatically by the work itself.</p></article>
          </div>
        </div>
      </section>
      <section>
        <div class="wrap">
          <div class="section-head center reveal"><span class="kicker">What we stand for</span><h2>Built for accountability.</h2></div>
          <div class="grid three">
            <article class="card lift reveal"><div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div><h3>Accountable</h3><p>Every enquiry, shipment and record belongs to a tenant and can be followed end to end.</p></article>
            <article class="card lift reveal"><div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg></div><h3>Compliant</h3><p>Designed around operator-licence obligations, document trails and reviewable records.</p></article>
            <article class="card lift reveal"><div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div><h3>Responsive</h3><p>Clients get a clear, fast route to request work and reach the team — without friction.</p></article>
          </div>
        </div>
      </section>
    <% } %>

    <% if (currentPage === 'contact') { %>
      <section class="band">
        <div class="wrap split">
          <div>
            <div class="section-head reveal" style="margin:0 0 24px"><span class="kicker">Get in touch</span><h2>Send an enquiry.</h2><p>Quotes, service questions, partnerships or support — it lands straight in the operations queue.</p></div>
            <div class="card contact-aside reveal">
              <div class="info-line"><span class="ii"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></span><div><small>Email</small><strong>director@256logisticsltd.com</strong></div></div>
              <div class="info-line"><span class="ii"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span><div><small>Hours</small><strong>Mon–Fri · 08:00–18:00</strong></div></div>
              <div class="info-line"><span class="ii"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span><div><small>Urgent work</small><strong>Submit any time — visible in intake</strong></div></div>
            </div>
          </div>
          <form class="card form reveal" method="post" action="/contact" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (leadSent) { %><div class="notice success">Thanks — your enquiry has been received. We'll be in touch shortly.</div><% } %>
            <% if (leadError) { %><div class="notice error"><%= leadError %></div><% } %>
            <div class="grid two">
              <div class="field-row"><label for="name">Name</label><input id="name" name="name" autocomplete="name" value="<%= form.name || '' %>" required></div>
              <div class="field-row"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" value="<%= form.email || '' %>" required></div>
            </div>
            <div class="grid two">
              <div class="field-row"><label for="phone">Phone</label><input id="phone" name="phone" autocomplete="tel" value="<%= form.phone || '' %>"></div>
              <div class="field-row"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" value="<%= form.company || '' %>"></div>
            </div>
            <div class="field-row">
              <label for="enquiryType">Enquiry type</label>
              <select id="enquiryType" name="enquiryType">
                <option value="quote" <%= selectedType === 'quote' ? 'selected' : '' %>>Quote request</option>
                <option value="service" <%= selectedType === 'service' ? 'selected' : '' %>>Service question</option>
                <option value="tracking" <%= selectedType === 'tracking' ? 'selected' : '' %>>Tracking support</option>
                <option value="partnership" <%= selectedType === 'partnership' ? 'selected' : '' %>>Partnership</option>
                <option value="general" <%= selectedType === 'general' ? 'selected' : '' %>>General enquiry</option>
              </select>
            </div>
            <div class="field-row"><label for="message">Message</label><textarea id="message" name="message" required><%= form.message || '' %></textarea></div>
            <button class="cta" type="submit">Send enquiry
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </button>
          </form>
        </div>
      </section>
    <% } %>

    <% if (currentPage === 'track') { %>
      <section class="band">
        <div class="wrap track-shell">
          <aside class="card track-form reveal">
            <form class="form" method="get" action="/track">
              <div class="field-row"><label for="ref">Tracking reference</label><input id="ref" name="ref" value="<%= trackingRef || '' %>" placeholder="e.g. 256-LANE-042" required></div>
              <button class="cta" type="submit">Check status</button>
            </form>
            <div class="quick-refs" aria-label="Example tracking references">
              <a href="/track?ref=256-DEMO-184">256-DEMO-184</a>
              <a href="/track?ref=256-LANE-042">256-LANE-042</a>
            </div>
            <p class="notice" style="margin-top:16px">Enter a reference for live status, ETA and milestone history. Need help? <a href="/contact?type=tracking" style="color:var(--brand);font-weight:700">Contact the desk</a>.</p>
          </aside>
          <div class="track-board">
            <% if (trackingResult) { %>
              <article class="card status-card reveal">
                <div class="status-head">
                  <div class="status-ref"><span>Tracking reference</span><strong><%= trackingResult.reference %></strong></div>
                  <div class="status-pill"><%= trackingResult.status %></div>
                </div>
                <div class="track-map" aria-hidden="true">
                  <span class="route-label start">Collection</span><span class="route-label end">Delivery</span>
                  <span class="route-line"></span><span class="route-pin start"></span><span class="route-pin mid"></span><span class="route-pin end"></span>
                </div>
                <div class="track-summary">
                  <div class="track-stat"><span>Service</span><strong><%= trackingResult.service %></strong></div>
                  <div class="track-stat"><span>ETA window</span><strong><%= trackingResult.etaWindow %></strong></div>
                  <div class="track-stat"><span>Vehicle slot</span><strong><%= trackingResult.vehicle %></strong></div>
                </div>
              </article>
              <div class="notice success reveal"><strong>Next action:</strong> <%= trackingResult.nextAction %></div>
              <div class="timeline reveal" aria-label="Shipment milestones">
                <% trackingResult.checkpoints.forEach((checkpoint) => { %>
                  <div class="step is-<%= checkpoint.state %>">
                    <span class="dot"></span>
                    <div><div class="step-meta"><strong><%= checkpoint.label %></strong><span class="step-time"><%= checkpoint.time %></span></div><p><%= checkpoint.detail %></p></div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <article class="card status-card reveal">
                <div class="status-head">
                  <div class="status-ref"><span>Awaiting reference</span><strong>Ready to track</strong></div>
                  <div class="status-pill">Live tracking</div>
                </div>
                <div class="track-map" aria-hidden="true">
                  <span class="route-label start">Collection</span><span class="route-label end">Delivery</span>
                  <span class="route-line"></span><span class="route-pin start"></span><span class="route-pin mid"></span><span class="route-pin end"></span>
                </div>
                <div class="track-summary">
                  <div class="track-stat"><span>Status</span><strong>Enter a reference</strong></div>
                  <div class="track-stat"><span>Milestones</span><strong>Preview enabled</strong></div>
                  <div class="track-stat"><span>Support</span><strong><a href="/contact?type=tracking" style="color:var(--brand)">Contact desk</a></strong></div>
                </div>
              </article>
              <div class="notice reveal">Enter a public reference to preview status, ETA, vehicle slot and shipment milestones.</div>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (currentPage !== 'contact') { %>
    <section>
      <div class="wrap">
        <div class="credit-band">
          <div class="credit-card reveal">
            <img class="credit-seal" src="/img/ecadel-mark.svg" alt="ECADEL Group emblem">
            <div>
              <div class="credit-eyebrow"><span class="ln"></span>Developed &amp; managed by</div>
              <div class="credit-name">ECADEL GROUP LIMITED</div>
              <p class="credit-tag">The soul architects behind 256 Logistics — we design, engineer and run the platform end to end.</p>
            </div>
            <a class="credit-cta" href="https://ecadelgroup.com" target="_blank" rel="noopener">ecadelgroup.com
              <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5v5m0-5L10 14M19 13v6a1 1 0 01-1 1H6a1 1 0 01-1-1V7a1 1 0 011-1h6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
    <% } %>
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a href="/welcome" class="brand"><span class="brand-mark" aria-hidden="true"></span><span>256 Logistics<small>Logistics platform</small></span></a>
          <p style="margin-top:16px">One connected platform for booking, dispatch, fleet, people, finance and compliance.</p>
        </div>
        <div><h4>Platform</h4><div class="footer-links"><a href="/services">Services</a><a href="/track">Track a shipment</a><a href="/contact?type=quote">Get a quote</a><a href="/login">Sign in</a></div></div>
        <div><h4>Company</h4><div class="footer-links"><a href="/about">About us</a><a href="/about">Mission &amp; vision</a><a href="/contact">Contact</a></div></div>
        <div><h4>Legal</h4><div class="footer-links"><a href="/privacy">Privacy</a><a href="/contact?type=partnership">Partnerships</a><a href="https://ecadelgroup.com" target="_blank" rel="noopener">ECADEL Group</a></div></div>
      </div>
      <div class="foot-bottom">
        <span>© <%= new Date().getFullYear() %> 256 Logistics Ltd · UK logistics operations</span>
        <span>A signature work by <b>ECADEL GROUP LIMITED</b></span>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var root = document.documentElement;
      var loader = document.getElementById('loader');
      var toggle = document.getElementById('themeToggle');
      function hideLoader() { document.body.classList.remove('loading'); loader && loader.classList.add('is-hidden'); }
      function setTheme(theme) {
        root.setAttribute('data-theme', theme);
        localStorage.setItem('public-theme', theme);
        document.cookie = 'publicTheme=' + theme + '; Path=/; Max-Age=31536000; SameSite=Lax';
      }
      toggle && toggle.addEventListener('click', function () { setTheme(root.getAttribute('data-theme') === 'light' ? 'dark' : 'light'); });
      window.addEventListener('load', hideLoader);
      setTimeout(hideLoader, 850);

      // Scroll reveal
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) { els.forEach(function(e){ e.classList.add('in'); }); }
      else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en, i) { if (en.isIntersecting) { en.target.style.transitionDelay = (Math.min(i, 4) * 60) + 'ms'; en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { threshold: 0.14 });
        els.forEach(function (e) { io.observe(e); });
      }

      // Count-up stats
      var counters = document.querySelectorAll('[data-count]');
      var seen = false;
      function runCounts() {
        if (seen) return; seen = true;
        counters.forEach(function (el) {
          var target = parseInt(el.getAttribute('data-count'), 10) || 0;
          var suffix = el.getAttribute('data-suffix') || '';
          var t0 = performance.now(), dur = 1100;
          function tick(now) {
            var p = Math.min((now - t0) / dur, 1), eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(eased * target) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        });
      }
      var statWrap = document.querySelector('.stats');
      if (statWrap && 'IntersectionObserver' in window) {
        var io2 = new IntersectionObserver(function (e) { if (e[0].isIntersecting) runCounts(); }, { threshold: 0.5 });
        io2.observe(statWrap);
      } else { runCounts(); }
    }());
  </script>
</body>
</html>
