            <div class="stat reveal">
              <span class="stat-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span>
              <strong data-count="1" data-suffix="-click">1-click</strong><span data-i18n="stats2.auditPacks">DVSA audit evidence packs</span>
            </div>
            <div class="stat reveal">
              <span class="stat-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span>
              <strong>24/7</strong><span data-i18n="stats2.realTimeMonitoring">Real-time monitoring</span>
            </div>
          </div>
          <div class="trust reveal" style="margin-top:18px">
            <div class="trust-left">
              <span class="trust-shield"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg></span>
              <p><b data-i18n="trust.security.title">Enterprise-grade security.</b> <span data-i18n="trust.security.desc">Your data is protected, encrypted in transit and at rest, on UK-hosted infrastructure.</span></p>
            </div>
            <span class="trust-powered"><span data-i18n="trust.powered">Powered by</span> <b>256 Digital Technologies</b></span>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <div class="grid two">
            <article class="card lift reveal"><div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></div><h3 data-i18n="card.shippers.title">For shippers</h3><p data-i18n="card.shippers.desc">Request a quote, book a collection, track a parcel and download proof of delivery — without needing an account to get started.</p><a class="more" href="/contact?type=quote" data-i18n="card.shippers.link">Get a quote →</a></article>
            <article class="card lift reveal"><div class="card-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0H5m14 0h2M5 21H3m4-4h2m6 0h2M9 9h2m4 0h2M9 13h2m4 0h2"/></svg></div><h3 data-i18n="card.operators.title">For operators</h3><p data-i18n="card.operators.desc">Run dispatch, fleet, people, finance and compliance from one tenant-aware platform — with role-based panels for every team.</p><a class="more" href="/login" data-i18n="card.operators.link">Enter the platform →</a></article>
          </div>
        </div>
      </section>
    <% } %>

    <% if (currentPage === 'contact') { %>
      <section class="band">
        <div class="wrap split">
          <div>
            <div class="section-head reveal" style="margin:0 0 24px"><span class="kicker" data-i18n="contact.form.kicker">Get in touch</span><h2 data-i18n="contact.form.title">Send an enquiry.</h2><p data-i18n="contact.form.sub">Quotes, service questions, partnerships or support — it lands straight in the operations queue.</p></div>
            <div class="card contact-aside reveal">
              <div class="info-line"><span class="ii"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></span><div><small data-i18n="contact.info.emailLabel">Email</small><strong>director@fleetshq.com</strong></div></div>
              <div class="info-line"><span class="ii"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span><div><small data-i18n="contact.info.hoursLabel">Hours</small><strong data-i18n="contact.info.hoursValue">Mon–Fri · 08:00–18:00</strong></div></div>
              <div class="info-line"><span class="ii"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span><div><small data-i18n="contact.info.urgentLabel">Urgent work</small><strong data-i18n="contact.info.urgentValue">Submit any time — visible in intake</strong></div></div>
            </div>
          </div>
          <form class="card form reveal" method="post" action="/contact" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (leadSent) { %><div class="notice success" data-i18n="contact.form.successNotice">Thanks — your enquiry has been received. We'll be in touch shortly.</div><% } %>
            <% if (leadError) { %><div class="notice error"><%= leadError %></div><% } %>
            <div class="grid two">
              <div class="field-row"><label for="name" data-i18n="contact.form.nameLabel">Name</label><input id="name" name="name" autocomplete="name" value="<%= form.name || '' %>" required></div>
              <div class="field-row"><label for="email" data-i18n="contact.form.emailLabel">Email</label><input id="email" name="email" type="email" autocomplete="email" value="<%= form.email || '' %>" required></div>
            </div>
            <div class="grid two">
              <div class="field-row"><label for="phone" data-i18n="contact.form.phoneLabel">Phone</label><input id="phone" name="phone" autocomplete="tel" value="<%= form.phone || '' %>"></div>
              <div class="field-row"><label for="company" data-i18n="contact.form.companyLabel">Company</label><input id="company" name="company" autocomplete="organization" value="<%= form.company || '' %>"></div>
            </div>
            <div class="field-row">
              <label for="enquiryType" data-i18n="contact.form.typeLabel">Enquiry type</label>
              <select id="enquiryType" name="enquiryType">
                <option value="quote" data-i18n="contact.form.type.quote" <%= selectedType === 'quote' ? 'selected' : '' %>>Quote request</option>
                <option value="service" data-i18n="contact.form.type.service" <%= selectedType === 'service' ? 'selected' : '' %>>Service question</option>
                <option value="tracking" data-i18n="contact.form.type.tracking" <%= selectedType === 'tracking' ? 'selected' : '' %>>Tracking support</option>
                <option value="partnership" data-i18n="contact.form.type.partnership" <%= selectedType === 'partnership' ? 'selected' : '' %>>Partnership</option>
                <option value="general" data-i18n="contact.form.type.general" <%= selectedType === 'general' ? 'selected' : '' %>>General enquiry</option>
              </select>
            </div>
            <div class="field-row"><label for="message" data-i18n="contact.form.messageLabel">Message</label><textarea id="message" name="message" required><%= form.message || '' %></textarea></div>
            <button class="cta" type="submit"><span data-i18n="contact.form.submit">Send enquiry</span>
              <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </button>
          </form>
        </div>
      </section>
    <% } %>

    <% if (currentPage === 'track') { %>
      <section class="band">
        <div class="wrap track-shell">
          <aside class="card track-form reveal">
            <form class="form" method="get" action="/track">
              <div class="field-row"><label for="ref" data-i18n="track.form.refLabel">Tracking reference</label><input id="ref" name="ref" value="<%= trackingRef || '' %>" placeholder="e.g. 256-LANE-042" data-i18n-attr="placeholder" data-i18n="track.form.refPlaceholder" required></div>
              <button class="cta" type="submit" data-i18n="track.form.submit">Check status</button>
            </form>
            <div class="quick-refs" aria-label="Example tracking references">
              <a href="/track?ref=256-DEMO-184">256-DEMO-184</a>
              <a href="/track?ref=256-LANE-042">256-LANE-042</a>
            </div>
            <p class="notice" style="margin-top:16px"><span data-i18n="track.help">Enter a reference for live status, ETA and milestone history. Need help?</span> <a href="/contact?type=tracking" style="color:var(--brand);font-weight:700" data-i18n="track.help.contactDesk">Contact the desk</a>.</p>
          </aside>
          <div class="track-board">
            <% if (trackingResult) { %>
              <article class="card status-card reveal">
                <div class="status-head">
                  <div class="status-ref"><span data-i18n="track.result.refLabel">Tracking reference</span><strong><%= trackingResult.reference %></strong></div>
                  <div class="status-pill"><%= trackingResult.status %></div>
                </div>
                <div class="track-map" aria-hidden="true">
                  <span class="route-label start" data-i18n="track.result.collection">Collection</span><span class="route-label end" data-i18n="track.result.delivery">Delivery</span>
                  <span class="route-line"></span><span class="route-pin start"></span><span class="route-pin mid"></span><span class="route-pin end"></span>
                </div>
                <div class="track-summary">
                  <div class="track-stat"><span data-i18n="track.result.serviceLabel">Service</span><strong><%= trackingResult.service %></strong></div>
                  <div class="track-stat"><span data-i18n="track.result.etaLabel">ETA window</span><strong><%= trackingResult.etaWindow %></strong></div>
                  <div class="track-stat"><span data-i18n="track.result.vehicleLabel">Vehicle slot</span><strong><%= trackingResult.vehicle %></strong></div>
                </div>
              </article>
              <div class="notice success reveal"><strong data-i18n="track.result.nextAction">Next action:</strong> <%= trackingResult.nextAction %></div>
              <div class="timeline reveal" aria-label="Shipment milestones">
                <% trackingResult.checkpoints.forEach((checkpoint) => { %>
                  <div class="step is-<%= checkpoint.state %>">
                    <span class="dot"></span>
                    <div><div class="step-meta"><strong><%= checkpoint.label %></strong><span class="step-time"><%= checkpoint.time %></span></div><p><%= checkpoint.detail %></p></div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <article class="card status-card reveal">
                <div class="status-head">
                  <div class="status-ref"><span data-i18n="track.empty.awaitingRef">Awaiting reference</span><strong data-i18n="track.empty.readyToTrack">Ready to track</strong></div>
                  <div class="status-pill" data-i18n="track.empty.liveTracking">Live tracking</div>
                </div>
                <div class="track-map" aria-hidden="true">
                  <span class="route-label start" data-i18n="track.result.collection">Collection</span><span class="route-label end" data-i18n="track.result.delivery">Delivery</span>
                  <span class="route-line"></span><span class="route-pin start"></span><span class="route-pin mid"></span><span class="route-pin end"></span>
                </div>
                <div class="track-summary">
                  <div class="track-stat"><span data-i18n="track.empty.statusLabel">Status</span><strong data-i18n="track.empty.statusValue">Enter a reference</strong></div>
                  <div class="track-stat"><span data-i18n="track.empty.milestonesLabel">Milestones</span><strong data-i18n="track.empty.milestonesValue">Preview enabled</strong></div>
                  <div class="track-stat"><span data-i18n="track.empty.supportLabel">Support</span><strong><a href="/contact?type=tracking" style="color:var(--brand)" data-i18n="track.empty.contactDesk">Contact desk</a></strong></div>
                </div>
              </article>
              <div class="notice reveal" data-i18n="track.empty.notice">Enter a public reference to preview status, ETA, vehicle slot and shipment milestones.</div>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a href="/welcome" class="brand" data-i18n="aria.brandHome" data-i18n-attr="aria-label" aria-label="FLEETS.HQ home"><span class="brand-mark"><img src="/img/logo-fleetshq-icon.png" alt=""></span><span>FLEETS<b>.HQ</b><small data-i18n="brand.tagline">The operating system for transport companies</small></span></a>
          <p style="margin-top:16px" data-i18n="footer.tagline">The operating system for transport companies — drivers, vehicles, compliance, tachographs and maintenance in one connected platform.</p>
        </div>
        <div><h4 data-i18n="footer.platformHeading">Platform</h4><div class="footer-links"><a href="/track" data-i18n="footer.track">Track a shipment</a><a href="/contact?type=quote" data-i18n="nav.getQuote">Get a quote</a><a href="/register" data-i18n="form.registerLink">Register your company</a><a href="/login" data-i18n="nav.signIn">Sign in</a></div></div>
        <div><h4 data-i18n="footer.legalHeading">Legal</h4><div class="footer-links"><a href="/contact" data-i18n="footer.contact">Contact</a><a href="/privacy" data-i18n="footer.privacy">Privacy</a><a href="/contact?type=partnership" data-i18n="footer.partnerships">Partnerships</a><a href="https://ecadelgroup.com" target="_blank" rel="noopener">ECADEL Group</a></div></div>
      </div>
      <div class="foot-bottom">
        <span>© <%= new Date().getFullYear() %> 256 Logistics Ltd · <span data-i18n="footer.ukOps">UK logistics operations</span></span>
        <span><span data-i18n="footer.signatureWork">A signature work by</span> <b>ECADEL GROUP LIMITED</b></span>
      </div>
    </div>
  </footer>

  <script src="/js/i18n.js?v=<%= assetVersion %>"></script>
  <script>
    (function () {
      var root = document.documentElement;
      var loader = document.getElementById('loader');
      var toggle = document.getElementById('themeToggle');
      var iconDark = document.getElementById('toggleIconDark');
      var iconLight = document.getElementById('toggleIconLight');
      function hideLoader() { document.body.classList.remove('loading'); loader && loader.classList.add('is-hidden'); }
      function reflectTheme(theme) {
        var isLight = theme === 'light';
        if (iconDark) iconDark.style.display = isLight ? 'none' : '';
        if (iconLight) iconLight.style.display = isLight ? '' : 'none';
      }
      function setTheme(theme) {
        root.setAttribute('data-theme', theme);
        localStorage.setItem('public-theme', theme);
        document.cookie = 'publicTheme=' + theme + '; Path=/; Max-Age=31536000; SameSite=Lax';
        reflectTheme(theme);
      }
      reflectTheme(root.getAttribute('data-theme'));
      toggle && toggle.addEventListener('click', function () { setTheme(root.getAttribute('data-theme') === 'light' ? 'dark' : 'light'); });
      window.addEventListener('load', hideLoader);
      setTimeout(hideLoader, 850);

      // Language switcher popover
      var langToggle = document.getElementById('langToggle');
      var langMenu = document.getElementById('langMenu');
      if (langToggle && langMenu) {
        var closeLangMenu = function () { langMenu.classList.remove('is-open'); langToggle.setAttribute('aria-expanded', 'false'); };
        langToggle.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = langMenu.classList.toggle('is-open');
          langToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        document.addEventListener('click', function (e) { if (!langMenu.contains(e.target) && e.target !== langToggle) closeLangMenu(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLangMenu(); });
        langMenu.querySelectorAll('[data-lang-option]').forEach(function (btn) { btn.addEventListener('click', closeLangMenu); });
      }

      // Scroll reveal
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) { els.forEach(function(e){ e.classList.add('in'); }); }
      else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en, i) { if (en.isIntersecting) { en.target.style.transitionDelay = (Math.min(i, 4) * 60) + 'ms'; en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { threshold: 0.14 });
        els.forEach(function (e) { io.observe(e); });
      }

      // Count-up stats
      var counters = document.querySelectorAll('[data-count]');
      var seen = false;
      function runCounts() {
        if (seen) return; seen = true;
        counters.forEach(function (el) {
          var target = parseInt(el.getAttribute('data-count'), 10) || 0;
          var suffix = el.getAttribute('data-suffix') || '';
          var t0 = performance.now(), dur = 1100;
          function tick(now) {
            var p = Math.min((now - t0) / dur, 1), eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(eased * target) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        });
      }
      var statWrap = document.querySelector('.stats');
      if (statWrap && 'IntersectionObserver' in window) {
        var io2 = new IntersectionObserver(function (e) { if (e[0].isIntersecting) runCounts(); }, { threshold: 0.5 });
        io2.observe(statWrap);
      } else { runCounts(); }
    }());
  </script>
</body>
</html>
