<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0c">
  <title><%= title %></title>
  <meta name="description" content="FLEETS.HQ — the operating system for UK transport companies. Drivers, vehicles, compliance, tachographs and maintenance in one connected platform.">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/img/favicon-64.png">
  <link rel="apple-touch-icon" href="/img/favicon-180.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    // Pre-paint theme bootstrap — shares the public-site preference
    // (publicTheme / public-theme) with /about, /services, /contact, /track.
    (function () {
      var stored = localStorage.getItem('public-theme');
      var cookie = document.cookie.match(/(?:^|; )publicTheme=([^;]+)/);
      var preferred = stored || (cookie && cookie[1]) || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', preferred);
    }());
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0a0c; --bg-2: #0e0e11; --panel: rgba(22,22,27,.72); --panel-2: rgba(255,255,255,.04);
      --line: rgba(255,255,255,.1); --line-2: rgba(255,255,255,.18);
      --text: #f3f4f6; --heading: #fff; --muted: #a3a7b0; --soft: #71757e;
      --red: #e11d2a; --red-deep: #a60f1a; --gold: #f5b301; --green: #10b981;
    }
    [data-theme="light"] {
      --bg: #f6f6f4; --bg-2: #eeeeec; --panel: rgba(255,255,255,.9); --panel-2: rgba(10,10,12,.035);
      --line: rgba(10,10,12,.1); --line-2: rgba(10,10,12,.16);
      --text: #26262c; --heading: #0a0a0c; --muted: #55575f; --soft: #74767d;
    }
    html { font-size: 16px; }
    body {
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      min-height: 100vh; min-height: 100dvh; background: var(--bg); color: var(--text);
      display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; overflow-x: hidden;
      transition: background .2s ease, color .2s ease;
    }
    a { text-decoration: none; color: inherit; }

    /* Ambient field (dark) */
    .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
    .bg .grid {
      position: absolute; inset: -2px;
      background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 30% 20%, #000 30%, transparent 100%);
              mask-image: radial-gradient(ellipse 70% 60% at 30% 20%, #000 30%, transparent 100%);
    }
    [data-theme="light"] .bg .grid { opacity: .5; }
    .orb { position: absolute; border-radius: 50%; filter: blur(90px); }
    .orb.a { width: 540px; height: 540px; top: -180px; left: -120px; background: radial-gradient(circle, rgba(225,29,42,.4), transparent 68%); }
    .orb.b { width: 420px; height: 420px; bottom: -160px; left: 22%; background: radial-gradient(circle, rgba(245,179,1,.22), transparent 65%); }
    .orb.c { width: 460px; height: 460px; top: 30%; right: -160px; background: radial-gradient(circle, rgba(225,29,42,.2), transparent 66%); }
    [data-theme="light"] .orb { opacity: .5; }

    /* Brand mark */
    .mark { width: 40px; height: 40px; flex-shrink: 0; display: grid; place-items: center; }
    .mark img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 8px 18px rgba(37,99,235,.45)); }
    .wordmark { font-weight: 900; color: var(--heading); font-size: 17px; letter-spacing: -.3px; line-height: 1; }
    .wordmark b { color: var(--red); }
    .wordmark small { display: block; font-size: 9.5px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: var(--soft); margin-top: 4px; }

    /* Layout */
    .auth { position: relative; z-index: 1; flex: 1; width: 100%; display: grid; grid-template-columns: 1.05fr 480px; }

    /* Brand side */
    .brand-side { position: relative; padding: 44px clamp(28px, 5vw, 76px) 30px; display: flex; flex-direction: column; justify-content: center; gap: 22px; overflow: hidden; }
    /* Dark theme: UK network map backdrop */
    .netmap-bg { position: absolute; inset: 0; z-index: -1; opacity: .5; display: flex; align-items: center; justify-content: flex-end; }
    .netmap-bg svg { width: 62%; max-width: 640px; height: auto; }
    .netmap-bg .node { fill: var(--gold); animation: pulse 3.4s ease-in-out infinite; }
    .netmap-bg .node.hot { fill: var(--red); }
    .netmap-bg .route { stroke: rgba(245,179,1,.3); stroke-width: 1; fill: none; }
    .netmap-bg .route.hot { stroke: rgba(225,29,42,.5); }
    @keyframes pulse { 0%,100% { opacity:.5 } 50% { opacity:1 } }
    /* Light theme: road photo backdrop */
    .brand-photo { position: absolute; inset: 0; z-index: -1; display: none;
      background: url('/img/road-skyline.jpeg') center right / cover no-repeat; opacity: .22;
      -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 24%, #000 66%, #000 100%);
              mask-image: linear-gradient(100deg, transparent 0%, transparent 24%, #000 66%, #000 100%); }
    [data-theme="light"] .netmap-bg { display: none; }
    [data-theme="light"] .brand-photo { display: block; }

    .brand-lockup { display: inline-flex; align-items: center; gap: 12px; }
    .brand-head h1 { font-size: clamp(32px, 4vw, 52px); font-weight: 900; line-height: 1.04; letter-spacing: -.035em; color: var(--heading); }
    .brand-head h1 .accent { color: var(--red); }
    .brand-head p { margin-top: 14px; max-width: 440px; color: var(--muted); font-size: 15.5px; line-height: 1.6; }
    .pillars { display: flex; flex-wrap: wrap; gap: 9px; }
    .pchip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 13px; border: 1px solid var(--line); border-radius: 100px; background: var(--panel-2); font-size: 13px; font-weight: 600; color: var(--text); }
    .pchip svg { width: 15px; height: 15px; color: var(--gold); flex-shrink: 0; }
    .pchip.hot svg { color: var(--red); }
    .tagline { font-size: 12.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--soft); }
    .tagline b { color: var(--gold); }
    .stats { display: flex; flex-wrap: wrap; gap: 26px; padding-top: 18px; border-top: 1px solid var(--line); }
    .stat .n { font-size: 22px; font-weight: 900; color: var(--heading); letter-spacing: -.02em; line-height: 1; }
    .stat .l { font-size: 11.5px; color: var(--soft); margin-top: 4px; }

    /* Form side */
    /* Extra top padding reserves space for .controls-overlay so it can
       never collide with the vertically-centred card, at any viewport
       height (fixed clearance, not luck-of-the-centring-math). */
    .form-side { position: relative; display: flex; align-items: center; justify-content: center; padding: 78px 32px 40px; }

    /* Icon-only theme + language controls, floating top-right */
    .controls-overlay { position: absolute; top: 22px; right: 24px; z-index: 5; display: flex; align-items: center; gap: 8px; }
    .ctrl-btn {
      display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; flex-shrink: 0;
      border-radius: 50%; border: 1px solid var(--line-2); background: var(--panel-2); color: var(--muted);
      cursor: pointer; font-size: 16px; line-height: 1; transition: color .15s, border-color .15s, transform .15s;
    }
    .ctrl-btn:hover { color: var(--gold); border-color: var(--gold); transform: translateY(-1px); }
    .ctrl-btn svg { width: 17px; height: 17px; }
    .lang-switch { position: relative; }
    .lang-menu {
      position: absolute; top: calc(100% + 8px); right: 0; z-index: 10; display: none; flex-direction: column; gap: 2px;
      padding: 6px; min-width: 46px; border-radius: 12px; border: 1px solid var(--line-2); background: var(--bg-2);
      box-shadow: 0 16px 34px rgba(0,0,0,.35);
    }
    .lang-menu.is-open { display: flex; }
    .lang-menu button {
      display: flex; align-items: center; justify-content: center; padding: 8px; border-radius: 8px; border: 0;
      background: transparent; cursor: pointer; font-size: 19px; line-height: 1; transition: background .15s;
    }
    .lang-menu button:hover { background: var(--panel-2); }
    .lang-menu button.is-active { box-shadow: inset 0 0 0 1.5px var(--gold); }

    .card {
      position: relative; width: 100%; max-width: 380px; padding: 34px 32px 28px;
      background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 82%, #fff 4%), var(--bg-2));
      border: 1px solid var(--line-2); border-radius: 20px; backdrop-filter: blur(18px);
      box-shadow: 0 30px 80px rgba(0,0,0,.35);
    }
    [data-theme="dark"] .card { box-shadow: 0 30px 80px rgba(0,0,0,.55); }
    .card::before { content: ""; position: absolute; top: 0; left: 22px; right: 22px; height: 2px; border-radius: 999px;
      background: linear-gradient(90deg, transparent, var(--red), var(--gold), transparent); }

    .card-logo { display: flex; align-items: center; gap: 11px; margin-bottom: 20px; }
    .eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; color: var(--gold); }
    .eyebrow svg { width: 13px; height: 13px; }
    .card h2 { margin-top: 8px; font-size: 25px; font-weight: 800; letter-spacing: -.5px; color: var(--heading); }
    .card .sub { margin-top: 5px; font-size: 14px; color: var(--muted); margin-bottom: 22px; }

    .error-box { display: flex; align-items: center; gap: 9px; background: rgba(225,29,42,.1); border: 1px solid rgba(225,29,42,.4);
      color: #fca5a5; border-radius: 10px; padding: 11px 13px; font-size: 13px; font-weight: 500; margin-bottom: 18px; }
    [data-theme="light"] .error-box { color: #b91c1c; }
    .error-box svg { width: 16px; height: 16px; flex-shrink: 0; }

    .group { margin-bottom: 16px; }
    .group label { display: block; font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 7px; letter-spacing: .2px; }
    .iwrap { position: relative; }
    .iwrap > .ic { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); width: 17px; height: 17px; color: var(--soft); pointer-events: none; }
    .inp {
      width: 100%; padding: 13px 14px 13px 40px; font-size: 16px; font-family: inherit; color: var(--text);
      background: var(--panel-2); border: 1.5px solid var(--line-2); border-radius: 11px; transition: border-color .15s, box-shadow .15s, background .15s;
    }
    .inp::placeholder { color: var(--soft); }
    .inp:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(245,179,1,.18); }
    .inp.has-toggle { padding-right: 44px; }
    .toggle-pw { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; display: grid; place-items: center;
      background: transparent; border: 0; cursor: pointer; color: var(--soft); border-radius: 8px; }
    .toggle-pw:hover { color: var(--gold); background: var(--panel-2); }
    .toggle-pw svg { width: 18px; height: 18px; }

    .row-between { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; }
    .remember { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 600; color: var(--muted); cursor: pointer; }
    .remember input { width: 15px; height: 15px; accent-color: var(--red); cursor: pointer; }
    .forgot { font-size: 12.5px; font-weight: 600; color: var(--muted); transition: color .15s; }
    .forgot:hover { color: var(--gold); }

    .btn {
      width: 100%; margin-top: 20px; padding: 14px; font-size: 15px; font-weight: 800; font-family: inherit; letter-spacing: .2px;
      color: #fff; background: linear-gradient(135deg, var(--red), var(--red-deep)); border: 1px solid rgba(255,255,255,.14);
      border-radius: 11px; cursor: pointer; transition: transform .15s, box-shadow .15s; box-shadow: 0 12px 30px rgba(225,29,42,.35);
      display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgba(225,29,42,.5); }
    .btn:active { transform: translateY(0); }
    .btn[disabled] { opacity: .7; cursor: progress; transform: none; }
    .btn .spin { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .trust { display: flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 11.5px; color: var(--soft); }
    .trust .lock { width: 14px; height: 14px; color: var(--green); flex-shrink: 0; }
    .register-note { margin-top: 14px; text-align: center; font-size: 12.5px; color: var(--soft); }
    .register-note a { color: var(--gold); font-weight: 700; }

    /* Bottom bar */
    .bottom-bar { position: relative; z-index: 1; border-top: 1px solid var(--line); padding: 16px clamp(24px, 5vw, 60px); }
    .bb-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .bb-trust { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: var(--soft); max-width: 620px; }
    .bb-trust svg { width: 16px; height: 16px; color: var(--green); flex-shrink: 0; }
    .bb-right { display: flex; align-items: center; gap: 16px; font-size: 11.5px; color: var(--soft); font-weight: 600; flex-wrap: wrap; }
    .bb-right b { color: var(--red); }
    .bb-links { margin-top: 12px; text-align: center; font-size: 12px; color: var(--soft); }
    .bb-links a { color: var(--muted); font-weight: 600; }
    .bb-links a:hover { color: var(--gold); }
    .bb-links .sep { margin: 0 9px; opacity: .5; }

    /* Responsive */
    @media (max-width: 940px) {
      .auth { grid-template-columns: 1fr; }
      .brand-side { padding: 36px 24px 28px; text-align: center; align-items: center; }
      .brand-lockup { justify-content: center; }
      .brand-head p { margin-left: auto; margin-right: auto; }
      .pillars { justify-content: center; }
      .stats { display: none; }
      .tagline { display: none; }
      /* Fixed to the viewport corner (not static in the flow) so it never
         creates its own orphaned section between the brand and form areas. */
      .controls-overlay { position: fixed; top: 14px; right: 14px; z-index: 20; }
      .ctrl-btn { background: var(--panel); backdrop-filter: blur(10px); box-shadow: 0 8px 20px rgba(0,0,0,.28); }
      .form-side { padding: 24px 20px 40px; flex-direction: column; }
      /* The logo already appears once in .brand-side above — showing it
         again in the card is redundant now that brand-side stays visible
         on mobile (unlike the desktop-only pattern this card was based on). */
      .card-logo { display: none; }
      /* Fade the photo/netmap out toward the bottom instead of the desktop
         left-to-right reveal, so it blends into the form section below
         instead of cutting off in a hard rectangle. */
      .brand-photo {
        -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,.6) 0%, #000 30%, #000 68%, transparent 100%);
                mask-image: linear-gradient(180deg, rgba(0,0,0,.6) 0%, #000 30%, #000 68%, transparent 100%);
      }
      .netmap-bg {
        justify-content: center; opacity: .35;
        -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
                mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
      }
      .netmap-bg svg { width: 85%; }
      .bb-row { justify-content: center; text-align: center; }
      .bb-trust { max-width: none; justify-content: center; }
    }
    @media (max-width: 420px) {
      .card { padding: 26px 22px 22px; border-radius: 18px; }
      .card h2 { font-size: 22px; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
  </style>
</head>
<body>

  <div class="bg" aria-hidden="true">
    <div class="grid"></div>
    <span class="orb a"></span><span class="orb b"></span><span class="orb c"></span>
  </div>

  <main class="auth">
    <!-- Brand side -->
    <section class="brand-side">
      <div class="netmap-bg" aria-hidden="true">
        <svg viewBox="0 0 400 340" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path class="route" d="M150 96 L210 78 L268 120 L240 196 L168 220 L120 168 Z"/>
          <path class="route hot" d="M150 96 L240 196"/>
          <path class="route" d="M210 78 L168 220"/><path class="route" d="M120 168 L268 120"/>
          <circle class="node hot" cx="150" cy="96" r="3.4"/><circle class="node" cx="210" cy="78" r="3.2"/>
          <circle class="node" cx="268" cy="120" r="3.2"/><circle class="node hot" cx="240" cy="196" r="3.4"/>
          <circle class="node" cx="168" cy="220" r="3.2"/><circle class="node" cx="120" cy="168" r="3.2"/>
          <circle class="node" cx="196" cy="150" r="2.6"/><circle class="node" cx="300" cy="170" r="2.6"/>
        </svg>
      </div>
      <div class="brand-photo" aria-hidden="true"></div>

      <a class="brand-lockup" href="/welcome" data-i18n="aria.brandHome" data-i18n-attr="aria-label" aria-label="FLEETS.HQ home">
        <span class="mark"><img src="/img/logo-fleetshq-icon.png" alt=""></span>
        <span class="wordmark">FLEETS<b>.HQ</b><small data-i18n="brand.tagline">The operating system for transport companies</small></span>
      </a>
      <div class="brand-head">
        <h1 data-i18n-html="welcome.hero.headline">One Platform.<br>Total <span class="accent">Control.</span></h1>
        <p data-i18n="welcome.hero.sub">Drivers, vehicles, compliance, tachographs and maintenance — everything your transport operation needs, in one connected platform.</p>
      </div>
      <div class="pillars">
        <span class="pchip"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg><span data-i18n="pillar.drivers">Drivers</span></span>
        <span class="pchip"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 17H5a2 2 0 01-2-2V7a2 2 0 012-2h3m8 10h3a2 2 0 002-2V7a2 2 0 00-2-2h-3M8 17V7m8 10V7m-8 0l4-4m0 0l4 4m-4-4v14"/></svg><span data-i18n="pillar.vehicles">Vehicles</span></span>
        <span class="pchip hot"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg><span data-i18n="pillar.compliance">Compliance</span></span>
        <span class="pchip"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span data-i18n="pillar.tachographs">Tachographs</span></span>
        <span class="pchip"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 4a2 2 0 114 0 7 7 0 014 6 3 3 0 11-4 4 7 7 0 01-8 0 3 3 0 11-4-4 7 7 0 014-6z"/></svg><span data-i18n="pillar.maintenance">Maintenance</span></span>
      </div>
      <div class="tagline" data-i18n-html="welcome.tagline"><b>Built by hauliers.</b> For hauliers.</div>
      <div class="stats">
        <div class="stat"><div class="n">5</div><div class="l" data-i18n="stat.domains.l">Operating domains</div></div>
        <div class="stat"><div class="n">DVSA</div><div class="l" data-i18n="stat.dvsa.l">Audit-ready</div></div>
        <div class="stat"><div class="n">UK</div><div class="l" data-i18n-html="stat.uk.l">Hosted &amp; GDPR-aligned</div></div>
        <div class="stat"><div class="n">24/7</div><div class="l" data-i18n="stat.monitoring.l">Compliance monitoring</div></div>
      </div>
    </section>

    <!-- Form side -->
    <section class="form-side">
      <div class="controls-overlay">
        <div class="lang-switch">
          <button type="button" class="ctrl-btn" id="langToggle" aria-haspopup="true" aria-expanded="false" data-i18n="aria.toggleLanguage" data-i18n-attr="aria-label" aria-label="Change language">
            <span data-lang-current>🇬🇧</span>
          </button>
          <div class="lang-menu" id="langMenu" role="menu">
            <button type="button" role="menuitem" data-lang-option="en" title="English">🇬🇧</button>
            <button type="button" role="menuitem" data-lang-option="fr" title="Français">🇫🇷</button>
            <button type="button" role="menuitem" data-lang-option="es" title="Español">🇪🇸</button>
            <button type="button" role="menuitem" data-lang-option="pt" title="Português">🇵🇹</button>
          </div>
        </div>
        <button type="button" class="ctrl-btn" id="themeToggle" data-i18n="aria.toggleTheme" data-i18n-attr="aria-label" aria-label="Toggle theme">
          <svg id="toggleIconDark" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          <svg id="toggleIconLight" style="display:none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.7-.7M6.34 6.34l-.7-.7m12.02 0l-.7.7M6.34 17.66l-.7.7M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </button>
      </div>

      <div class="card">
        <a class="card-logo" href="/welcome" data-i18n="aria.brandHome" data-i18n-attr="aria-label" aria-label="FLEETS.HQ home">
          <span class="mark"><img src="/img/logo-fleetshq-icon.png" alt=""></span>
          <span class="wordmark">FLEETS<b>.HQ</b></span>
        </a>

        <div class="eyebrow">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span data-i18n="form.eyebrow">Secure access</span>
        </div>
        <h2 data-i18n="form.title">Welcome back</h2>
        <p class="sub" data-i18n="form.subtitle">Sign in to your FLEETS.HQ dashboard.</p>

        <% if (error) { %>
          <div class="error-box">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/login" id="loginForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="from" value="welcome">
          <div class="group">
            <label for="emailInput" data-i18n="form.emailLabel">Email address</label>
            <div class="iwrap">
              <svg class="ic" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <input class="inp" type="email" name="email" id="emailInput" placeholder="you@fleetshq.com" required autocomplete="username" autofocus>
            </div>
          </div>
          <div class="group">
            <label for="passInput" data-i18n="form.passwordLabel">Password</label>
            <div class="iwrap">
              <svg class="ic" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <input class="inp has-toggle" type="password" name="password" id="passInput" placeholder="••••••••" required autocomplete="current-password">
              <button type="button" class="toggle-pw" id="togglePw" data-i18n="aria.showPassword" data-i18n-attr="aria-label" aria-label="Show password">
                <svg id="eyeOpen" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <svg id="eyeOff" style="display:none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
              </button>
            </div>
            <div class="row-between">
              <label class="remember"><input type="checkbox" name="rememberMe" value="1"> <span data-i18n="form.remember">Remember me</span></label>
              <a class="forgot" href="/forgot-password" data-i18n="form.forgot">Forgot password?</a>
            </div>
          </div>
          <button type="submit" class="btn" id="submitBtn">
            <span class="btn-label" data-i18n="form.submit">Sign in to dashboard</span>
            <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
        </form>

        <div class="trust">
          <svg class="lock" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span data-i18n="form.trust">Encrypted session · JWT authenticated · UK-hosted</span>
        </div>
        <div class="register-note"><span data-i18n="form.registerPrompt">New here?</span> <a href="/register" data-i18n="form.registerLink">Register your company</a></div>
      </div>
    </section>
  </main>

  <footer class="bottom-bar">
    <div class="bb-row">
      <div class="bb-trust">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span data-i18n="footer.trust">Enterprise-grade security. Your data is protected, encrypted in transit and at rest, on UK-hosted infrastructure.</span>
      </div>
      <div class="bb-right">
        <span><span data-i18n="footer.poweredBy">Powered by</span> <b>256 Digital Technologies</b></span>
        <span>© <%= new Date().getFullYear() %> FLEETS.HQ</span>
      </div>
    </div>
    <div class="bb-links">
      <a href="/contact" data-i18n="footer.contact">Contact</a><span class="sep">·</span>
      <a href="/track" data-i18n="footer.track">Track a shipment</a><span class="sep">·</span>
      <a href="/privacy" data-i18n="footer.privacy">Privacy</a>
    </div>
  </footer>

  <script src="/js/i18n.js?v=<%= assetVersion %>"></script>
  <script>
    (function () {
      var root = document.documentElement;
      var toggle = document.getElementById('themeToggle');
      var iconDark = document.getElementById('toggleIconDark');
      var iconLight = document.getElementById('toggleIconLight');
      function reflectTheme(theme) {
        var isLight = theme === 'light';
        iconDark.style.display = isLight ? 'none' : '';
        iconLight.style.display = isLight ? '' : 'none';
      }
      reflectTheme(root.getAttribute('data-theme'));
      toggle.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        localStorage.setItem('public-theme', next);
        document.cookie = 'publicTheme=' + next + '; Path=/; Max-Age=31536000; SameSite=Lax';
        reflectTheme(next);
      });

      // Language switcher popover
      var langToggle = document.getElementById('langToggle');
      var langMenu = document.getElementById('langMenu');
      function closeLangMenu() {
        langMenu.classList.remove('is-open');
        langToggle.setAttribute('aria-expanded', 'false');
      }
      langToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = langMenu.classList.toggle('is-open');
        langToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', function (e) {
        if (!langMenu.contains(e.target) && e.target !== langToggle) closeLangMenu();
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLangMenu(); });
      langMenu.querySelectorAll('[data-lang-option]').forEach(function (btn) {
        btn.addEventListener('click', closeLangMenu);
      });

      var form = document.getElementById('loginForm');
      var btn = document.getElementById('submitBtn');
      var pwToggle = document.getElementById('togglePw');
      var pw = document.getElementById('passInput');
      var eyeOpen = document.getElementById('eyeOpen');
      var eyeOff = document.getElementById('eyeOff');
      pwToggle.addEventListener('click', function () {
        var show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        eyeOpen.style.display = show ? 'none' : '';
        eyeOff.style.display = show ? '' : 'none';
        var lang = (window.FleetI18n && FleetI18n.detectLang()) || 'en';
        pwToggle.setAttribute('aria-label', FleetI18n.t(show ? 'aria.hidePassword' : 'aria.showPassword', lang));
        pw.focus();
      });
      form.addEventListener('submit', function () {
        btn.disabled = true;
        var lang = (window.FleetI18n && FleetI18n.detectLang()) || 'en';
        var submitting = window.FleetI18n ? FleetI18n.t('form.submitting', lang) : 'Signing in…';
        btn.innerHTML = '<span class="spin"></span><span class="btn-label">' + submitting + '</span>';
      });
    }());
  </script>
</body>
</html>
