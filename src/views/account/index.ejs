<%- include('../layouts/main', { body: `
<div class="page-head">
  <div class="page-head-main">
    <div class="page-eyebrow">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      Account
    </div>
    <h1>My Account</h1>
    <p class="page-sub">Your profile and sign-in security.</p>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3>Profile</h3></div>
    <div class="card-body">
      <div class="info-row">
        <div class="info-item"><label class="form-label">Name</label><div style="font-weight:600">${esc(user.name)}</div></div>
        <div class="info-item"><label class="form-label">Email</label><div class="cell-muted">${esc(user.email)}</div></div>
        <div class="info-item"><label class="form-label">Role</label><div><span class="badge badge-blue">${esc(user.role.replace(/_/g, ' '))}</span></div></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Change password</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Current password</label>
        <input class="form-control" type="password" id="curPw" autocomplete="current-password">
      </div>
      <div class="form-group">
        <label class="form-label">New password</label>
        <input class="form-control" type="password" id="newPw" placeholder="At least 8 characters, with a letter and a number" autocomplete="new-password">
      </div>
      <div class="form-group">
        <label class="form-label">Confirm new password</label>
        <input class="form-control" type="password" id="confPw" autocomplete="new-password">
      </div>
      <button class="btn btn-primary" id="changePwBtn">Update password</button>
    </div>
  </div>
</div>

<script>
document.getElementById('changePwBtn').addEventListener('click', async function(){
  var cur = document.getElementById('curPw').value, nw = document.getElementById('newPw').value, cf = document.getElementById('confPw').value;
  if (!cur || !nw) { showToast('Fill in your current and new password', 'error'); return; }
  if (nw !== cf) { showToast('New passwords do not match', 'error'); return; }
  var btn = this; btn.disabled = true; btn.textContent = 'Updating…';
  try {
    await apiCall('POST', '/api/v1/auth/change-password', { currentPassword: cur, newPassword: nw });
    showToast('Password updated', 'success');
    document.getElementById('curPw').value = ''; document.getElementById('newPw').value = ''; document.getElementById('confPw').value = '';
  } catch (e) { showToast(e.message || 'Could not change password', 'error'); }
  finally { btn.disabled = false; btn.textContent = 'Update password'; }
});
</script>
` }) %>
