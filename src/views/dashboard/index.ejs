<script>
function fhqGauge(id, value, color) {
  var canvas = document.getElementById(id);
  if (!canvas || !window.Chart) return;
  var track = document.documentElement.getAttribute('data-theme') === 'dark' ? 'rgba(255,255,255,.1)' : '#edf2f7';
  new Chart(canvas.getContext('2d'), {
    type: 'doughnut',
    data: { datasets: [{ data: [value, Math.max(0, 100 - value)], backgroundColor: [color, track], borderWidth: 0, borderRadius: 6 }] },
    options: { cutout: '76%', responsive: false, events: [], plugins: { legend: { display: false }, tooltip: { enabled: false } } }
  });
}
fhqGauge('fhqScoreGauge', ${score.overall.toFixed(0)}, '${score.overall >= 85 ? '#22c55e' : score.overall >= 70 ? '#f59e0b' : '#ef4444'}');
fhqGauge('fhqFleetGauge', ${dashboardOps.fleet.pct}, '#22c55e');

(function() {
  var el = document.getElementById('fhqFinanceChart');
  if (!el || !window.Chart) return;
  var slices = ${JSON.stringify(dashboardOps.finance.slices)};
  if (!slices.length) slices = [{ label: 'No expenses', value: 1 }];
  new Chart(el.getContext('2d'), {
    type: 'doughnut',
    data: {
      labels: slices.map(function(s) { return s.label.replace(/_/g, ' '); }),
      datasets: [{ data: slices.map(function(s) { return s.value; }), backgroundColor: ['#2563eb', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#64748b'], borderWidth: 0 }]
    },
    options: { cutout: '62%', maintainAspectRatio: false, plugins: { legend: { display: false } } }
  });
})();
</script>
