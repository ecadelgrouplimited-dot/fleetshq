  .fhq-score-value span { font-size:17px; }
  .fhq-score-value small { display:block; font-size:11.5px; font-weight:600; color:#475569; letter-spacing:0; margin-top:1px; }
  .fhq-score-foot { display:flex; align-items:center; justify-content:center; gap:7px; font-size:11.5px; margin-top:11px; }
  .fhq-delta { display:inline-flex; align-items:center; gap:3px; font-weight:700; }
  .fhq-delta svg { width:11px; height:11px; }
  .fhq-score-card .fhq-link { justify-content:center; padding-top:7px; }

  .fhq-kpi-top { display:flex; align-items:flex-start; gap:13px; }
  .fhq-kpi-icon { flex:none; width:42px; height:42px; border-radius:50%; display:grid; place-items:center; }
  .fhq-kpi-icon svg { width:23px; height:23px; }
  .fhq-kpi.blue   .fhq-kpi-icon { color:#2563eb; background:#eff6ff; }
  .fhq-kpi.purple .fhq-kpi-icon { color:#7c3aed; background:#f5f3ff; }
  .fhq-kpi.teal   .fhq-kpi-icon { color:#0d9488; background:#effefb; }
  .fhq-kpi.red    .fhq-kpi-icon { color:#dc2626; background:#fef2f2; }
  .fhq-kpi-meta { display:flex; flex-direction:column; min-width:0; }
  .fhq-kpi-label { font-size:12.5px; font-weight:600; color:#334155; }
  .fhq-kpi-value { font-size:30px; line-height:1.15; font-weight:800; letter-spacing:-.8px; margin-top:3px; }
  .fhq-kpi-sub { color:#64748b; font-size:11.5px; margin-top:2px; }
  .fhq-kpi-actions { display:flex; align-items:baseline; gap:14px; margin-top:16px; }
  .fhq-kpi-actions strong { font-size:21px; font-weight:800; }
  .fhq-kpi-actions strong.red { color:#dc2626; } .fhq-kpi-actions strong.amber { color:#f59e0b; }
  .fhq-kpi-actions span { color:#475569; font-size:12px; }

  /* ── main grid ─────────────────────────────────────────────────────── */
  .fhq-main-grid { display:grid; grid-template-columns:minmax(0, 1fr) 292px; gap:13px; align-items:start; }
  .fhq-main-col { display:flex; flex-direction:column; gap:13px; min-width:0; }
  .fhq-split { display:grid; grid-template-columns:minmax(0, 1.1fr) minmax(0, 1fr); gap:13px; align-items:start; }
  .fhq-section-head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 17px 10px; }
  .fhq-section-head h3 { font-size:15px; margin:0; font-weight:700; letter-spacing:-.2px; }
  .fhq-section-head small { color:#64748b; font-size:12px; font-weight:500; }
  .fhq-section-head.compact { padding:13px 15px 9px; }
  .fhq-section-head.compact h3 { font-size:14px; }
  .fhq-section-head a { font-size:11.5px; font-weight:600; text-decoration:none; color:#2563eb; }

  /* ── compliance overview tiles ─────────────────────────────────────── */
  .fhq-tiles { display:grid; grid-template-columns:repeat(6, minmax(0, 1fr)); gap:10px; padding:4px 15px 16px; }
  .fhq-tile { display:flex; flex-direction:column; padding:11px 11px 10px; border-radius:9px; border:1px solid #eef2f7; background:#fff; text-decoration:none; color:#0f172a; transition:border-color .15s, box-shadow .15s, transform .15s; }
  .fhq-tile:hover { border-color:#dbe3ee; box-shadow:0 4px 12px rgba(15,23,42,.06); transform:translateY(-1px); }
  .fhq-tile-head { display:flex; align-items:center; gap:8px; min-height:30px; }
  .fhq-t-icon { flex:none; width:30px; height:30px; border-radius:50%; display:grid; place-items:center; }
  .fhq-t-icon svg { width:17px; height:17px; }
  .fhq-tile-label { font-size:11px; font-weight:600; color:#334155; line-height:1.25; }
  .fhq-tile-count { font-size:24px; font-weight:800; letter-spacing:-.6px; margin-top:9px; }
  .fhq-tile-unit { font-size:10.5px; color:#64748b; margin-top:2px; }
  .fhq-tile-bar { height:3px; border-radius:2px; margin-top:12px; background:#eef2f7; overflow:hidden; }
  .fhq-tile-bar i { display:block; height:100%; border-radius:2px; }
  /* Tone palette shared by tile icons and their progress bars. */
  .fhq-t-icon.amber  { color:#f59e0b; background:#fef6e7; } .fhq-tile.amber  .fhq-tile-bar i { background:#f59e0b; } .fhq-tile.amber  .fhq-tile-bar { background:#fdf0d5; }
  .fhq-t-icon.green  { color:#16a34a; background:#eafaf0; } .fhq-tile.green  .fhq-tile-bar i { background:#16a34a; } .fhq-tile.green  .fhq-tile-bar { background:#daf4e4; }
  .fhq-t-icon.red    { color:#dc2626; background:#fdeeee; } .fhq-tile.red    .fhq-tile-bar i { background:#dc2626; } .fhq-tile.red    .fhq-tile-bar { background:#f8dada; }
  .fhq-t-icon.purple { color:#7c3aed; background:#f3efff; } .fhq-tile.purple .fhq-tile-bar i { background:#7c3aed; } .fhq-tile.purple .fhq-tile-bar { background:#e7dffc; }
  .fhq-t-icon.blue   { color:#2563eb; background:#eaf1fe; } .fhq-tile.blue   .fhq-tile-bar i { background:#2563eb; } .fhq-tile.blue   .fhq-tile-bar { background:#d8e5fd; }
  .fhq-t-icon.orange { color:#ea580c; background:#fef0e7; } .fhq-tile.orange .fhq-tile-bar i { background:#ea580c; } .fhq-tile.orange .fhq-tile-bar { background:#fbdfcd; }

  /* ── compliance trend ──────────────────────────────────────────────── */
  .fhq-trend-chart { height:132px; padding:2px 15px 0; }
  .fhq-trend-chips { display:grid; grid-template-columns:repeat(6, minmax(0, 1fr)); gap:7px; padding:12px 15px 15px; }
  .fhq-chip { display:flex; flex-direction:column; align-items:center; gap:3px; padding:7px 3px 8px; border:1px solid #eef2f7; border-radius:8px; }
  .fhq-chip small { font-size:8.5px; color:#94a3b8; font-weight:600; white-space:nowrap; }
  .fhq-chip strong { font-size:16px; font-weight:800; letter-spacing:-.4px; }
  .fhq-chip.is-current { background:#2563eb; border-color:#2563eb; }
