<%- include('../layouts/main', { body: `
<div class="fhq-dashboard">
  ${typeof platformQueue !== 'undefined' && platformQueue ? `
  <a href="/platform" class="fhq-banner">
    <span class="fhq-banner-icon">!</span>
    <span><strong>${platformQueue.pendingActivation} awaiting activation</strong>${platformQueue.inFlight > 0 ? ` · ${platformQueue.inFlight} registrations in progress` : ''}</span>
    <span>Review queue -></span>
  </a>` : ''}

  ${typeof setup !== 'undefined' && setup ? `
  <div class="fhq-setup">
    <div>
      <strong>Let's get your fleet set up</strong>
      <span>${setup.doneCount}/${setup.steps.length} essentials ready</span>
    </div>
    <div class="fhq-setup-steps">
      ${setup.steps.map(s => `<a href="${s.href}" class="${s.done ? 'done' : ''}">${s.done ? 'Done' : 'Open'} · ${s.label}</a>`).join('')}
    </div>
  </div>` : ''}

  <div class="fhq-kpis">
    <a href="/compliance" class="fhq-card fhq-score-card">
      <div class="fhq-card-title">Overall Compliance Score</div>
      <div class="fhq-score-wrap">
        <canvas id="fhqScoreGauge" width="132" height="132"></canvas>
        <div class="fhq-score-value">${score.overall.toFixed(0)}<span>%</span><small>${score.overall >= 85 ? 'Good' : score.overall >= 70 ? 'Fair' : 'At Risk'}</small></div>
      </div>
      <div class="fhq-card-foot">
        ${scoreDelta === null ? '<span class="muted">No prior score</span>' : `<span class="${scoreDelta >= 0 ? 'good' : 'bad'}">${scoreDelta >= 0 ? 'up' : 'down'} ${Math.abs(scoreDelta).toFixed(0)}%</span> <span class="muted">from last month</span>`}
        <strong>View Score Breakdown -></strong>
      </div>
    </a>

    ${[
      { label: 'Drivers', value: stats.driverCount, sub: 'Total Drivers', actions: stats.driverActions, href: '/employees?type=drivers', tone: 'blue', icon: 'M17 20h5v-2a3 3 0 00-5.36-1.86M17 20H7m10 0v-2a5 5 0 00-10 0v2m8-13a3 3 0 11-6 0 3 3 0 016 0z' },
      { label: 'Vehicles', value: stats.totalVehicles, sub: 'Total Vehicles', actions: stats.vehicleActions, href: '/fleet', tone: 'purple', icon: 'M3 7h11v8H3zM14 10h4l3 3v2h-7zM7 19a2 2 0 100-4 2 2 0 000 4zM18 19a2 2 0 100-4 2 2 0 000 4z' },
      { label: 'Trailers', value: stats.totalTrailers, sub: 'Total Trailers', actions: stats.trailerActions, href: '/trailers', tone: 'teal', icon: 'M4 8h12v7H4zM16 11h3l2 2v2h-5zM7 18a2 2 0 100-4 2 2 0 000 4zM18 18a2 2 0 100-4 2 2 0 000 4z' },
      { label: 'Compliance Alerts', value: alerts.length, sub: 'Open Alerts', actions: alertGroups.critical.length, href: '#fhqAlerts', tone: 'red', icon: 'M12 9v4m0 4h.01M10.3 4.3L2.7 18a2 2 0 001.7 3h15.2a2 2 0 001.7-3L13.7 4.3a2 2 0 00-3.4 0z' },
    ].map(k => `
    <a href="${k.href}" class="fhq-card fhq-kpi ${k.tone}">
      <div class="fhq-kpi-head">
        <span class="fhq-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${k.icon}"/></svg></span>
        <span>${k.label}</span>
      </div>
      <div class="fhq-kpi-value">${k.value}</div>
      <div class="fhq-kpi-sub">${k.sub}</div>
      <div class="fhq-kpi-actions"><strong>${k.actions}</strong> Actions Required</div>
      <div class="fhq-card-foot"><strong>View ${k.label} -></strong></div>
    </a>`).join('')}
  </div>

  <div class="fhq-main-grid">
    <section class="fhq-card fhq-rota">
      <div class="fhq-section-head">
        <div>
          <h3>Employee Rota</h3>
          <span>${dashboardOps.week.label}</span>
        </div>
        <div class="fhq-rota-tools">
          <a href="${dashboardOps.week.prevHref}" class="btn btn-outline btn-sm" aria-label="Previous week">&lt;</a>
          <a href="${dashboardOps.week.todayHref}" class="btn btn-outline btn-sm">Today</a>
          <a href="${dashboardOps.week.nextHref}" class="btn btn-outline btn-sm" aria-label="Next week">&gt;</a>
          <span class="segmented"><a class="active" href="/">Week</a><a href="/">2 Weeks</a><a href="/">Month</a></span>
          ${dashboardOps.canManageRota ? `<button class="btn btn-primary btn-sm" type="button" onclick="document.getElementById('fhqRotaForm').classList.toggle('open')">Add Rota</button>` : ''}
        </div>
      </div>

      <form class="fhq-rota-filters" method="get" action="/">
        <input type="hidden" name="week" value="${dashboardOps.week.key}">
        <select name="employeeId" aria-label="Filter employee">
          <option value="">All employees</option>
          ${dashboardOps.rotaOptions.employees.map(e => `<option value="${esc(e.id)}" ${dashboardOps.rotaFilters.employeeId === e.id ? 'selected' : ''}>${esc(e.fullName)}</option>`).join('')}
        </select>
        <select name="role" aria-label="Filter role">
          <option value="">All roles</option>
          ${dashboardOps.rotaOptions.roles.map(role => `<option value="${esc(role)}" ${dashboardOps.rotaFilters.role === role ? 'selected' : ''}>${esc(role)}</option>`).join('')}
        </select>
        <select name="location" aria-label="Filter location">
          <option value="">All locations</option>
          ${dashboardOps.rotaOptions.locations.map(location => `<option value="${esc(location)}" ${dashboardOps.rotaFilters.location === location ? 'selected' : ''}>${esc(location)}</option>`).join('')}
        </select>
        <select name="shiftType" aria-label="Filter shift type">
          <option value="">All shifts</option>
          ${dashboardOps.rotaOptions.statuses.map(s => `<option value="${s}" ${dashboardOps.rotaFilters.shiftType === s ? 'selected' : ''}>${s.replace(/_/g, ' ')}</option>`).join('')}
        </select>
        <button class="btn btn-outline btn-sm">Filters</button>
        <a href="/?week=${dashboardOps.week.key}" class="btn btn-ghost btn-sm">Clear</a>
      </form>

      ${dashboardOps.canManageRota ? `
      <form id="fhqRotaForm" class="fhq-rota-form" method="post" action="/rota">
        <input type="hidden" name="_csrf" value="${csrfToken}">
        <select name="employeeId" required><option value="">Employee</option>${dashboardOps.rotaOptions.employees.map(e => `<option value="${esc(e.id)}">${esc(e.fullName)}</option>`).join('')}</select>
        <input type="date" name="shiftDate" required value="${dashboardOps.week.days.find(d => d.isToday)?.key || dashboardOps.week.days[0].key}">
        <select name="status">${dashboardOps.rotaOptions.statuses.map(s => `<option value="${s}">${s.replace(/_/g, ' ')}</option>`).join('')}</select>
        <input type="time" name="startTime" aria-label="Start time">
        <input type="time" name="endTime" aria-label="End time">
        <select name="vehicleId"><option value="">Vehicle</option>${dashboardOps.rotaOptions.vehicles.map(v => `<option value="${esc(v.id)}">${esc(v.registration)}</option>`).join('')}</select>
        <input name="routeLabel" placeholder="Route / duty">
        <input name="location" placeholder="Location">
        <button class="btn btn-primary btn-sm">Save</button>
      </form>` : ''}

      <div class="fhq-rota-scroll">
        <table class="fhq-rota-table">
          <thead>
            <tr>
              <th>Employee / Role</th>
              ${dashboardOps.week.days.map(d => `<th class="${d.isToday ? 'today' : ''}">${d.label}<span>${d.shortDate}</span></th>`).join('')}
            </tr>
          </thead>
          <tbody>
            ${dashboardOps.rotaRows.length === 0 ? `<tr><td colspan="8"><div class="empty-state"><p>No active drivers to schedule</p></div></td></tr>` : dashboardOps.rotaRows.map(row => `
            <tr>
              <td>${avatar(row.employee, { size: 34, withName: true, sub: row.employee.jobTitle || 'Driver' })}</td>
              ${row.cells.map(cell => `<td><div class="fhq-shift ${cell.tone}">
                <strong>${esc(cell.time || cell.title)}</strong>
                <span>${esc(cell.detail || cell.title)}</span>
                ${dashboardOps.canManageRota && cell.id ? `
                <details class="fhq-shift-edit">
                  <summary>Edit</summary>
                  <form method="post" action="/rota/${cell.id}">
                    <input type="hidden" name="_csrf" value="${csrfToken}">
                    <input type="date" name="shiftDate" value="${cell.shiftDate}">
                    <select name="status">${dashboardOps.rotaOptions.statuses.map(s => `<option value="${s}" ${cell.status === s ? 'selected' : ''}>${s.replace(/_/g, ' ')}</option>`).join('')}</select>
                    <input type="time" name="startTime" value="${esc(cell.startTime)}">
                    <input type="time" name="endTime" value="${esc(cell.endTime)}">
                    <select name="vehicleId"><option value="">Vehicle</option>${dashboardOps.rotaOptions.vehicles.map(v => `<option value="${esc(v.id)}" ${cell.vehicleId === v.id ? 'selected' : ''}>${esc(v.registration)}</option>`).join('')}</select>
                    <input name="routeLabel" value="${esc(cell.routeLabel)}" placeholder="Route / duty">
                    <input name="location" value="${esc(cell.location)}" placeholder="Location">
                    <input name="notes" value="${esc(cell.notes)}" placeholder="Notes">
                    <button class="btn btn-primary btn-sm">Save</button>
                  </form>
                  <form method="post" action="/rota/${cell.id}/delete" data-confirm="Delete this rota shift?">
                    <input type="hidden" name="_csrf" value="${csrfToken}">
                    <input type="hidden" name="week" value="${dashboardOps.week.key}">
                    <button class="btn btn-outline btn-sm">Delete</button>
                  </form>
                </details>` : ''}
              </div></td>`).join('')}
            </tr>`).join('')}
          </tbody>
        </table>
      </div>
      <div class="fhq-legend">
        ${[
          ['assigned', 'Assigned'], ['rest_day', 'Rest Day / Off'], ['relief_cover', 'Relief / Cover'],
          ['on_site', 'On Site / Office'], ['standby', 'Standby'], ['leave', 'Leave'],
        ].map(([tone, label]) => `<span><i class="${tone}"></i>${label}</span>`).join('')}
        <em>All times are local to operating centre</em>
      </div>
    </section>

    <aside class="fhq-rail">
      <section class="fhq-card" id="fhqAlerts">
        <div class="fhq-section-head compact"><h3>Recent Alerts</h3><a href="/reports">View All</a></div>
        <div class="fhq-rail-list">
          ${alerts.length === 0 ? `<div class="empty-state"><p>No open alerts</p></div>` : alerts.slice(0, 5).map(a => `
          <a href="${a.href}" class="fhq-rail-item ${a.severity}">
            <span class="fhq-alert-icon">!</span>
            <span><strong>${esc(a.message)}</strong><small>${esc(a.preview?.filter(Boolean).slice(0, 2).join(' · ') || a.typeLabel)}</small></span>
            <em>${a.daysUntil !== null && a.daysUntil !== undefined ? (a.daysUntil < 0 ? 'Overdue' : a.daysUntil + 'd') : ''}</em>
          </a>`).join('')}
        </div>
      </section>

      <section class="fhq-card">
        <div class="fhq-section-head compact"><h3>Upcoming Tasks</h3><a href="/compliance-tasks">View All</a></div>
        <div class="fhq-rail-list">
          ${upcomingTasks.length === 0 ? `<div class="empty-state"><p>No upcoming tasks</p></div>` : upcomingTasks.slice(0, 5).map(t => `
          <a href="/compliance-tasks?task=${t.id}" class="fhq-rail-item task ${t.priority}">
            <span class="fhq-task-icon"></span>
            <span><strong>${esc(t.title)}</strong><small>${esc(t.priority)} priority</small></span>
            <em>${t.dueDate ? (t.isOverdue ? 'Overdue' : new Date(t.dueDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })) : ''}</em>
          </a>`).join('')}
        </div>
      </section>
    </aside>
  </div>

  <div class="fhq-bottom-grid">
    <section class="fhq-card fhq-mini-card">
      <div class="fhq-section-head compact"><h3>Fuel Overview <small>(This Month)</small></h3><a href="/fleet/fuel">View Details</a></div>
      <div class="fhq-mini-main"><span class="fhq-mini-icon green">F</span><div><strong>${dashboardOps.fuel.litres.toLocaleString(undefined, { maximumFractionDigits: 0 })} L</strong><small>Total Fuel</small>${dashboardOps.fuel.deltaPct === null ? '' : `<em class="${dashboardOps.fuel.deltaPct <= 0 ? 'good' : 'bad'}">${dashboardOps.fuel.deltaPct >= 0 ? '+' : ''}${dashboardOps.fuel.deltaPct}% vs last month</em>`}</div></div>
      <div class="fhq-bars">${dashboardOps.fuel.bars.slice(-18).map(v => `<i style="height:${Math.max(8, Math.min(48, v / Math.max(...dashboardOps.fuel.bars, 1) * 48))}px"></i>`).join('')}</div>
      <ol>${dashboardOps.fuel.topConsumers.map(c => `<li><span>${esc(c.label)}</span><strong>${c.value.toFixed(0)} L</strong></li>`).join('')}</ol>
    </section>

    <section class="fhq-card fhq-mini-card">
      <div class="fhq-section-head compact"><h3>AdBlue Overview <small>(This Month)</small></h3><a href="/fleet/adblue">View Details</a></div>
      <div class="fhq-mini-main"><span class="fhq-mini-icon blue">A</span><div><strong>${dashboardOps.adBlue.litres.toLocaleString(undefined, { maximumFractionDigits: 0 })} L</strong><small>Total AdBlue</small>${dashboardOps.adBlue.deltaPct === null ? '' : `<em class="${dashboardOps.adBlue.deltaPct <= 0 ? 'good' : 'bad'}">${dashboardOps.adBlue.deltaPct >= 0 ? '+' : ''}${dashboardOps.adBlue.deltaPct}% vs last month</em>`}</div></div>
      <div class="fhq-placeholder-bars">${dashboardOps.adBlue.bars.slice(-18).map(v => `<i style="height:${Math.max(8, Math.min(48, v / Math.max(...dashboardOps.adBlue.bars, 1) * 48))}px"></i>`).join('')}</div>
      <ol>${dashboardOps.adBlue.topConsumers.length ? dashboardOps.adBlue.topConsumers.map(c => `<li><span>${esc(c.label)}</span><strong>${c.value.toFixed(0)} L</strong></li>`).join('') : '<li><span>No AdBlue logged</span><strong>0 L</strong></li>'}</ol>
    </section>

    <section class="fhq-card fhq-mini-card finance">
      <div class="fhq-section-head compact"><h3>Finance Overview <small>(This Month)</small></h3><a href="/finance">View Details</a></div>
      <div class="fhq-finance-values">
        <div><small>Total Income</small><strong>£${dashboardOps.finance.income.toLocaleString(undefined, { maximumFractionDigits: 0 })}</strong></div>
        <div><small>Total Expenses</small><strong>£${dashboardOps.finance.expenses.toLocaleString(undefined, { maximumFractionDigits: 0 })}</strong></div>
        <div><small>Net Profit</small><strong>£${dashboardOps.finance.profit.toLocaleString(undefined, { maximumFractionDigits: 0 })}</strong></div>
      </div>
      <div class="fhq-finance-chart"><canvas id="fhqFinanceChart"></canvas></div>
    </section>

    <section class="fhq-card fhq-mini-card availability">
      <div class="fhq-section-head compact"><h3>Fleet Availability</h3><a href="/fleet/overview">View Details</a></div>
      <div class="fhq-availability-body">
        <div class="fhq-fleet-gauge"><canvas id="fhqFleetGauge" width="118" height="118"></canvas><span>${dashboardOps.fleet.pct}%<small>Available</small></span></div>
        <dl>
          <dt>Total Fleet</dt><dd>${dashboardOps.fleet.total}</dd>
          <dt>Available</dt><dd class="good">${dashboardOps.fleet.available}</dd>
          <dt>In Use</dt><dd>${dashboardOps.fleet.inUse}</dd>
          <dt>In Workshop</dt><dd class="bad">${dashboardOps.fleet.inWorkshop}</dd>
          <dt>Out of Service</dt><dd>${dashboardOps.fleet.outOfService}</dd>
        </dl>
      </div>
    </section>
  </div>
</div>

<style>
  .fhq-dashboard { display:flex; flex-direction:column; gap:16px; color:#0f172a; }
  .fhq-banner, .fhq-setup { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 16px; border-radius:8px; background:#fff7ed; color:#9a3412; border:1px solid #fed7aa; text-decoration:none; }
  .fhq-banner-icon { width:26px; height:26px; border-radius:50%; display:grid; place-items:center; background:#f97316; color:#fff; font-weight:900; }
  .fhq-setup { background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe; align-items:flex-start; }
  .fhq-setup > div:first-child { display:flex; flex-direction:column; gap:2px; }
  .fhq-setup-steps { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
  .fhq-setup-steps a { color:inherit; text-decoration:none; font-size:12px; font-weight:700; padding:5px 8px; border-radius:6px; background:rgba(255,255,255,.65); }
  .fhq-setup-steps a.done { color:#047857; }
  .fhq-kpis { display:grid; grid-template-columns:1.25fr repeat(4, 1fr); gap:14px; }
  .fhq-card { background:#fff; border:1px solid #edf1f7; border-radius:8px; box-shadow:0 3px 12px rgba(15,23,42,.035); }
  .fhq-card a { color:#2563eb; }
  .fhq-score-card, .fhq-kpi { text-decoration:none; color:#0f172a; padding:18px; min-height:158px; }
  .fhq-card-title { text-align:center; font-size:12px; font-weight:800; margin-bottom:8px; }
  .fhq-score-wrap { position:relative; width:132px; height:132px; margin:0 auto; }
  .fhq-score-value { position:absolute; inset:0; display:grid; place-items:center; align-content:center; font-size:31px; font-weight:900; }
  .fhq-score-value span { font-size:15px; }
  .fhq-score-value small { display:block; font-size:11px; font-weight:800; color:#334155; }
  .fhq-card-foot { display:flex; align-items:center; justify-content:space-between; gap:8px; font-size:12px; margin-top:8px; }
  .fhq-card-foot strong { color:#2563eb; font-size:12px; }
  .good { color:#16a34a; } .bad { color:#dc2626; } .muted { color:#64748b; }
  .fhq-kpi { display:flex; flex-direction:column; }
  .fhq-kpi-head { display:flex; align-items:center; gap:12px; font-size:12px; font-weight:800; color:#334155; }
  .fhq-icon { width:42px; height:42px; border-radius:50%; display:grid; place-items:center; }
  .fhq-icon svg { width:23px; height:23px; }
  .fhq-kpi.blue .fhq-icon { color:#2563eb; background:#eff6ff; }
  .fhq-kpi.purple .fhq-icon { color:#7c3aed; background:#f5f3ff; }
  .fhq-kpi.teal .fhq-icon { color:#0d9488; background:#ccfbf1; }
  .fhq-kpi.red .fhq-icon { color:#dc2626; background:#fee2e2; }
  .fhq-kpi-value { font-size:31px; line-height:1; font-weight:900; margin-top:10px; }
  .fhq-kpi-sub { color:#64748b; font-size:12px; font-weight:700; margin-top:5px; }
  .fhq-kpi-actions { margin-top:18px; padding-top:14px; border-top:1px solid #edf1f7; color:#475569; font-size:12px; }
  .fhq-kpi-actions strong { color:#dc2626; font-size:20px; margin-right:18px; }
  .fhq-main-grid { display:grid; grid-template-columns:minmax(0, 1fr) 310px; gap:14px; align-items:start; }
  .fhq-section-head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; border-bottom:1px solid #edf1f7; }
  .fhq-section-head h3 { font-size:16px; margin:0; }
  .fhq-section-head span, .fhq-section-head small { color:#64748b; font-size:12px; font-weight:700; }
  .fhq-section-head.compact { padding:13px 14px; }
  .fhq-section-head.compact h3 { font-size:14px; }
  .fhq-section-head.compact a { font-size:11px; font-weight:800; text-decoration:none; }
  .fhq-rota-tools { display:flex; align-items:center; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
  .fhq-rota-filters { display:grid; grid-template-columns:repeat(4,minmax(120px,1fr)) auto auto; gap:8px; padding:0 14px 12px; border-bottom:1px solid #edf1f7; }
  .fhq-rota-form { display:none; grid-template-columns:1.2fr 150px 140px 95px 95px 130px 1fr 1fr auto; gap:8px; padding:12px 14px; border-bottom:1px solid #edf1f7; background:#f8fafc; }
  .fhq-rota-form.open { display:grid; }
  .fhq-rota-form input, .fhq-rota-form select, .fhq-rota-filters select, .fhq-shift-edit input, .fhq-shift-edit select { min-width:0; border:1px solid #cbd5e1; border-radius:7px; padding:7px 8px; font:inherit; font-size:12px; background:#fff; }
  .fhq-rota-scroll { overflow-x:auto; }
  .fhq-rota-table { width:100%; min-width:900px; border-collapse:separate; border-spacing:0; }
  .fhq-rota-table th, .fhq-rota-table td { border-right:1px solid #edf1f7; border-bottom:1px solid #edf1f7; padding:10px; vertical-align:middle; }
  .fhq-rota-table th { text-align:left; font-size:11px; font-weight:900; background:#fbfdff; white-space:nowrap; }
  .fhq-rota-table th:first-child { width:190px; }
  .fhq-rota-table th span { display:block; margin-top:2px; color:#64748b; font-weight:700; }
  .fhq-rota-table th.today { color:#2563eb; }
  .fhq-shift { min-height:48px; border-radius:6px; padding:7px 8px; display:flex; flex-direction:column; justify-content:center; gap:3px; text-align:center; border:1px solid transparent; }
  .fhq-shift strong { font-size:11px; font-weight:900; }
  .fhq-shift span { font-size:10.5px; font-weight:800; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .fhq-shift-edit { margin-top:4px; text-align:left; }
  .fhq-shift-edit summary { cursor:pointer; list-style:none; font-size:10px; font-weight:900; text-align:center; opacity:.85; }
  .fhq-shift-edit form { display:grid; grid-template-columns:1fr; gap:5px; margin-top:6px; }
  .fhq-shift-edit .btn { width:100%; justify-content:center; min-height:28px; padding:4px 6px; font-size:10.5px; }
  .fhq-shift.assigned { background:#ecfdf5; color:#047857; border-color:#bbf7d0; }
  .fhq-shift.rest_day { background:#fffbeb; color:#92400e; border-color:#fde68a; }
  .fhq-shift.relief_cover { background:#fef2f2; color:#b91c1c; border-color:#fecaca; }
  .fhq-shift.on_site, .fhq-shift.office, .fhq-shift.work_from_home { background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe; }
  .fhq-shift.standby { background:#f8fafc; color:#64748b; border-color:#e2e8f0; }
  .fhq-shift.leave, .fhq-shift.sick, .fhq-shift.training { background:#f5f3ff; color:#6d28d9; border-color:#ddd6fe; }
  .fhq-legend { display:flex; align-items:center; gap:16px; padding:12px 16px; flex-wrap:wrap; font-size:11px; color:#64748b; font-weight:700; }
  .fhq-legend span { display:inline-flex; align-items:center; gap:6px; }
  .fhq-legend i { width:9px; height:9px; border-radius:50%; background:#94a3b8; }
