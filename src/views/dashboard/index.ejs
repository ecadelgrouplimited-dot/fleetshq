  .fhq-risk-who strong { display:block; font-size:12.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .fhq-risk-who small { display:block; font-size:11px; color:#64748b; margin-top:1px; }
  .fhq-risk-bar { height:5px; border-radius:3px; background:#eef2f7; overflow:hidden; }
  .fhq-risk-bar i { display:block; height:100%; border-radius:3px; }
  .fhq-risk-bar.high i { background:#dc2626; } .fhq-risk-bar.medium i { background:#f59e0b; } .fhq-risk-bar.low i { background:#16a34a; }
  .fhq-risk-band { font-size:11px; font-weight:700; white-space:nowrap; text-align:right; }
  .fhq-risk-band.high { color:#dc2626; } .fhq-risk-band.medium { color:#f59e0b; } .fhq-risk-band.low { color:#16a34a; }

  /* ── alert / task rail ─────────────────────────────────────────────── */
  .fhq-rail { display:flex; flex-direction:column; gap:13px; }
  .fhq-rail-list { display:flex; flex-direction:column; padding:0 15px; }
  .fhq-rail-item { display:grid; grid-template-columns:28px minmax(0, 1fr) auto; align-items:center; column-gap:10px; padding:10px 0; text-decoration:none; color:#0f172a; border-bottom:1px solid #f1f5f9; }
  .fhq-rail-item:last-child { border-bottom:0; }
  .fhq-rail-icon { width:26px; height:26px; border-radius:50%; display:grid; place-items:center; background:#fef2f2; color:#dc2626; }
  .fhq-rail-icon svg { width:17px; height:17px; }
  .fhq-rail-item.warning .fhq-rail-icon { background:#fff8ec; color:#f59e0b; }
  .fhq-rail-item.notice  .fhq-rail-icon { background:#fffaeb; color:#eab308; }
  .fhq-rail-item .fhq-t-icon { width:26px; height:26px; }
  .fhq-rail-item .fhq-t-icon svg { width:16px; height:16px; }
  .fhq-rail-body strong { display:block; font-size:12.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .fhq-rail-body small { display:block; color:#64748b; font-size:11.5px; margin-top:1px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .fhq-rail-item em { font-style:normal; font-size:11px; font-weight:700; color:#f59e0b; white-space:nowrap; }
  .fhq-rail-item.critical em, .fhq-rail-item em.urgent { color:#dc2626; }

  /* ── bottom row ────────────────────────────────────────────────────── */
  .fhq-bottom-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:13px; }
  .fhq-mini-card { display:flex; flex-direction:column; min-height:190px; overflow:hidden; }
  .fhq-mini-main { display:flex; align-items:flex-start; gap:11px; padding:4px 15px 0; }
  .fhq-mini-main small { display:block; font-size:10.5px; color:#64748b; }
  .fhq-mini-main strong { display:block; font-size:21px; font-weight:800; letter-spacing:-.5px; margin-top:2px; }
  .fhq-mini-main em { display:block; margin-top:3px; font-size:10.5px; font-style:normal; font-weight:700; }
  .fhq-mini-main em span { color:#64748b; font-weight:500; }
  .fhq-mini-icon { flex:none; width:32px; height:32px; border-radius:9px; display:grid; place-items:center; }
  .fhq-mini-icon svg { width:18px; height:18px; }
  .fhq-mini-icon.green { background:#eafaf0; color:#16a34a; }
  .fhq-mini-icon.blue  { background:#eaf1fe; color:#2563eb; }
  .fhq-mini-icon.sm { width:18px; height:18px; border-radius:50%; font-size:10px; font-weight:800; font-style:normal; }
  .fhq-mini-split { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1.05fr); gap:10px; align-items:end; padding:12px 15px 14px; margin-top:auto; }
  .fhq-bars { height:48px; display:flex; align-items:flex-end; gap:2.5px; }
  .fhq-bars i { flex:1; border-radius:2px 2px 0 0; background:#22c55e; min-height:4px; }
  .fhq-bars.blue i { background:#60a5fa; }
  .fhq-top-title { display:block; font-size:10.5px; font-weight:700; color:#334155; margin-bottom:4px; }
  .fhq-top-list ol { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:3px; }
  .fhq-top-list li { display:flex; justify-content:space-between; gap:8px; font-size:10.5px; color:#64748b; }
  .fhq-top-list li span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .fhq-top-list li strong { color:#0f172a; font-weight:600; white-space:nowrap; }

  .fhq-finance-values { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:8px; padding:4px 15px 0; }
  .fhq-finance-values small { display:block; font-size:9.5px; color:#64748b; }
  .fhq-finance-values strong { display:block; font-size:16px; font-weight:800; letter-spacing:-.4px; margin-top:3px; }
  .fhq-fin-head { display:flex; align-items:center; gap:5px; }
  .fhq-finance-body { display:grid; grid-template-columns:86px minmax(0, 1fr); gap:10px; align-items:center; padding:10px 15px 14px; margin-top:auto; }
  .fhq-finance-chart { height:86px; }
  .fhq-finance-legend { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:4px 8px; }
  .fhq-finance-legend li { display:flex; align-items:center; gap:5px; font-size:9.5px; color:#475569; min-width:0; }
  .fhq-finance-legend i { flex:none; width:7px; height:7px; border-radius:50%; }
  .fhq-finance-legend span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  .fhq-availability-body { display:grid; grid-template-columns:112px minmax(0, 1fr); gap:14px; padding:6px 15px 14px; align-items:center; margin-top:auto; }
  .fhq-fleet-gauge { position:relative; width:112px; height:112px; }
  .fhq-fleet-gauge > span { position:absolute; inset:0; display:grid; place-items:center; align-content:center; font-size:23px; font-weight:800; letter-spacing:-.5px; }
  .fhq-fleet-gauge small { display:block; font-size:10px; font-weight:500; color:#64748b; letter-spacing:0; }
  .fhq-availability-body dl { display:grid; grid-template-columns:1fr auto; gap:9px 10px; font-size:11.5px; margin:0; }
  .fhq-availability-body dt { color:#334155; }
  .fhq-availability-body dd { margin:0; font-weight:700; text-align:right; }
  .fhq-availability-body .good { color:#16a34a; } .fhq-availability-body .info { color:#2563eb; }
  .fhq-availability-body .warn { color:#ea580c; } .fhq-availability-body .bad { color:#dc2626; }

  /* ── dark theme ────────────────────────────────────────────────────── */
  [data-theme="dark"] .fhq-dashboard { color:var(--text); }
  [data-theme="dark"] .fhq-card { background:var(--card); border-color:var(--border); }
  [data-theme="dark"] .fhq-score-card, [data-theme="dark"] .fhq-kpi,
  [data-theme="dark"] .fhq-rail-item, [data-theme="dark"] .fhq-risk-row, [data-theme="dark"] .fhq-tile { color:var(--text); }
  [data-theme="dark"] .fhq-tile { background:var(--surface-2); border-color:var(--border); }
  [data-theme="dark"] .fhq-tile:hover { border-color:var(--border-md); }
  [data-theme="dark"] .fhq-chip { border-color:var(--border); }
  [data-theme="dark"] .fhq-rail-item { border-bottom-color:var(--border); }
  [data-theme="dark"] .fhq-tile-bar, [data-theme="dark"] .fhq-risk-bar { background:rgba(148,163,184,.18); }
  [data-theme="dark"] .fhq-card-title, [data-theme="dark"] .fhq-kpi-label,
  [data-theme="dark"] .fhq-tile-label, [data-theme="dark"] .fhq-top-title,
  [data-theme="dark"] .fhq-availability-body dt, [data-theme="dark"] .fhq-kpi-actions span { color:var(--text-2); }
  [data-theme="dark"] .fhq-score-value small, [data-theme="dark"] .fhq-kpi-sub,
  [data-theme="dark"] .fhq-tile-unit, [data-theme="dark"] .fhq-rail-body small,
  [data-theme="dark"] .fhq-risk-who small, [data-theme="dark"] .fhq-mini-main small,
  [data-theme="dark"] .fhq-finance-values small, [data-theme="dark"] .fhq-top-list li,
  [data-theme="dark"] .fhq-finance-legend li, [data-theme="dark"] .fhq-fleet-gauge small { color:var(--text-muted); }
  [data-theme="dark"] .fhq-top-list li strong { color:var(--text); }

  /* ── responsive ────────────────────────────────────────────────────── */
  @media (max-width:1500px) {
    .fhq-kpis { grid-template-columns:repeat(3, minmax(0, 1fr)); }
    .fhq-score-card { grid-column:span 3; }
    .fhq-score-card .fhq-score-wrap { margin-top:6px; }
