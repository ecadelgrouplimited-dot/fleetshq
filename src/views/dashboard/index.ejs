    .fhq-score-card { grid-column:span 2; }
    .fhq-split, .fhq-rail, .fhq-bottom-grid { grid-template-columns:1fr; }
    .fhq-tiles { grid-template-columns:repeat(3, minmax(0, 1fr)); }
    .fhq-trend-chips { grid-template-columns:repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width:560px) {
    .fhq-kpis { grid-template-columns:1fr; }
    .fhq-score-card { grid-column:span 1; }
    .fhq-tiles { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .fhq-mini-split, .fhq-finance-body, .fhq-availability-body { grid-template-columns:1fr; }
    .fhq-finance-values { grid-template-columns:1fr; }
    .fhq-availability-body { justify-items:center; }
    .fhq-risk-row { grid-template-columns:34px minmax(0, 1fr) auto; }
    .fhq-risk-bar { grid-column:2 / -1; }
  }
</style>

<script>
(function() {
  var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
  var track = isDark ? 'rgba(148,163,184,.18)' : '#eef2f7';

  function gauge(id, value, color) {
    var canvas = document.getElementById(id);
    if (!canvas || !window.Chart) return;
    new Chart(canvas.getContext('2d'), {
      type: 'doughnut',
      data: { datasets: [{ data: [value, Math.max(0, 100 - value)], backgroundColor: [color, track], borderWidth: 0, borderRadius: 8 }] },
      options: { cutout: '78%', responsive: false, events: [], plugins: { legend: { display: false }, tooltip: { enabled: false } } }
    });
  }
  gauge('fhqScoreGauge', ${score.overall.toFixed(0)}, '${gaugeColor}');
  gauge('fhqFleetGauge', ${dashboardOps.fleet.pct}, '#16a34a');

  // Compliance trend — filled blue line, one point per month.
  var trendEl = document.getElementById('fhqTrendChart');
  if (trendEl && window.Chart) {
    var trend = ${JSON.stringify(complianceTrend)};
    var ctx = trendEl.getContext('2d');
    var fill = ctx.createLinearGradient(0, 0, 0, 130);
    fill.addColorStop(0, 'rgba(37,99,235,.20)');
    fill.addColorStop(1, 'rgba(37,99,235,0)');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: trend.map(function(p) { return p.label; }),
        datasets: [{
          data: trend.map(function(p) { return p.value; }),
          borderColor: '#2563eb', backgroundColor: fill, borderWidth: 2,
          pointBackgroundColor: '#2563eb', pointBorderColor: '#fff', pointBorderWidth: 2,
          pointRadius: 4, pointHoverRadius: 5, fill: true, tension: .35, spanGaps: true,
        }]
      },
      options: {
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: function(c) { return c.parsed.y + '% compliant'; } } }
        },
        scales: {
          y: { min: 0, max: 100, ticks: { stepSize: 25, font: { size: 9 }, callback: function(v) { return v + '%'; } },
               grid: { color: isDark ? 'rgba(148,163,184,.14)' : '#f1f5f9', drawTicks: false }, border: { display: false } },
          x: { ticks: { font: { size: 9 } }, grid: { display: false }, border: { display: false } }
        }
      }
    });
  }

  // Finance expense split — doughnut plus a value/percentage legend.
  var finEl = document.getElementById('fhqFinanceChart');
  if (finEl && window.Chart) {
    var slices = ${JSON.stringify(dashboardOps.finance.slices)};
    var palette = ['#2563eb', '#16a34a', '#f59e0b', '#dc2626', '#7c3aed', '#0891b2', '#64748b'];
    var empty = !slices.length;
    if (empty) slices = [{ label: 'No expenses', value: 1 }];
    var total = slices.reduce(function(sum, s) { return sum + s.value; }, 0) || 1;
    new Chart(finEl.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: slices.map(function(s) { return String(s.label).replace(/_/g, ' '); }),
        datasets: [{ data: slices.map(function(s) { return s.value; }),
          backgroundColor: empty ? [track] : palette, borderWidth: 0 }]
      },
      options: { cutout: '64%', maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
    var legend = document.getElementById('fhqFinanceLegend');
    if (legend && !empty) {
      legend.innerHTML = slices.slice(0, 6).map(function(s, i) {
        var label = String(s.label).replace(/_/g, ' ');
        var pct = Math.round((s.value / total) * 100);
        var amount = '£' + Math.round(s.value).toLocaleString();
        return '<li><i style="background:' + palette[i % palette.length] + '"></i>'
          + '<span>' + label + ' · ' + amount + ' (' + pct + '%)</span></li>';
      }).join('');
    }
  }
})();
</script>
` }) %>
