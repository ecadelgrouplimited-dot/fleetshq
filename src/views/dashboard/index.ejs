<%- include('../layouts/main', { body: `
<div class="dashboard-shell">
  <section class="dashboard-hero">
    <div class="dashboard-hero-main">
      <div class="dashboard-hero-copy">
        <span class="dashboard-eyebrow"><span class="pip"></span>Operations command centre</span>
        <h3>Live compliance view across people, fleet, defects, and daily controls.</h3>
        <p>Track pressure points, spot trend movement, and jump straight into the work that needs intervention.</p>
        <div class="dashboard-hero-actions">
          <a href="/audit-evidence" class="btn btn-primary">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v14l-4-2-3 2-3-2-4 2V6a2 2 0 012-2z"/></svg>
            Open audit evidence
          </a>
          <a href="/reports" class="btn btn-outline">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Open reports
          </a>
        </div>
      </div>
      <div class="dashboard-hero-scorecard">
        <div class="dashboard-score-ring">
          <canvas id="gaugeOverall" width="140" height="140"></canvas>
          <div class="dashboard-score-value">${score.overall.toFixed(0)}<sup>%</sup></div>
        </div>
        <div class="dashboard-score-copy">
          <div class="dashboard-score-label">Overall compliance</div>
          <div class="dashboard-score-helper">${alertGroups.critical.length} critical alerts and ${stats.openDefects} open defect${stats.openDefects !== 1 ? 's' : ''} currently shaping the score.</div>
        </div>
      </div>
    </div>

    <div class="dashboard-hero-side">
      ${healthCards.map((card, index) => `
        <a href="${card.href}" class="dashboard-health-card">
          <div class="dashboard-health-head">
            <span>${card.label}</span>
            <strong>${card.value.toFixed(0)}%</strong>
          </div>
          <div class="progress-bar dashboard-health-progress">
            <div class="progress-bar-fill ${card.value >= 85 ? 'green' : card.value >= 70 ? 'amber' : 'red'}" style="width:${card.value}%"></div>
          </div>
          <div class="dashboard-health-copy">${card.detail}</div>
        </a>
      `).join('')}
    </div>
  </section>

  <div class="stat-grid mb-6">
    <a href="/employees" class="stat-card blue">
      <div class="stat-icon blue">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
      <div>
        <div class="stat-value">${stats.totalEmp}</div>
        <div class="stat-label">Active Employees</div>
        <div class="stat-sub">${stats.sponsoredCount} sponsored workers</div>
      </div>
    </a>

    <a href="/fleet" class="stat-card green">
      <div class="stat-icon green">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
      </div>
      <div>
        <div class="stat-value">${stats.activeVehicles}</div>
        <div class="stat-label">Active Vehicles</div>
        <div class="stat-sub">${stats.totalVehicles} in fleet - ${stats.vorVehicles} VOR</div>
      </div>
    </a>

    <a href="/defects" class="stat-card ${stats.openDefects > 0 ? 'red' : 'green'}">
      <div class="stat-icon ${stats.openDefects > 0 ? 'red' : 'green'}">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      </div>
      <div>
        <div class="stat-value">${stats.openDefects}</div>
        <div class="stat-label">Open Defects</div>
        <div class="stat-sub">${stats.vorVehicles} vehicle${stats.vorVehicles !== 1 ? 's' : ''} off road</div>
      </div>
    </a>

    <a href="/checks" class="stat-card ${stats.missedChecks > 0 ? 'amber' : 'green'}">
      <div class="stat-icon ${stats.missedChecks > 0 ? 'amber' : 'green'}">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
      </div>
      <div>
        <div class="stat-value">${stats.missedChecks}</div>
        <div class="stat-label">Missed Checks Today</div>
        <div class="stat-sub">${stats.pendingToolbox} toolbox talk${stats.pendingToolbox !== 1 ? 's' : ''} unsigned</div>
      </div>
    </a>
  </div>

  <div class="dashboard-grid-top mb-6">
    <section class="card dashboard-chart-card">
      <div class="card-header">
        <div>
          <h3>Operations Pulse</h3>
          <p class="dashboard-card-copy">Checks submitted, nil-defect performance, and defect reporting over the last seven days.</p>
        </div>
      </div>
      <div class="card-body">
        <div class="dashboard-canvas-wrap" style="height:260px">
          <canvas id="operationsTrendChart"></canvas>
        </div>
      </div>
    </section>

    <section class="card dashboard-chart-card">
      <div class="card-header">
        <div>
          <h3>Live Risk Mix</h3>
          <p class="dashboard-card-copy">Current unresolved alerts by severity.</p>
        </div>
      </div>
      <div class="card-body dashboard-risk-mix-body">
        <div class="dashboard-risk-doughnut">
          <canvas id="alertMixChart" width="230" height="230"></canvas>
        </div>
        <div class="dashboard-risk-legend">
          <div class="dashboard-risk-row critical">
            <span><i></i>Critical</span>
            <strong>${chartData.alerts.critical}</strong>
          </div>
          <div class="dashboard-risk-row warning">
            <span><i></i>Warning</span>
            <strong>${chartData.alerts.warning}</strong>
          </div>
          <div class="dashboard-risk-row notice">
            <span><i></i>Notice</span>
            <strong>${chartData.alerts.notice}</strong>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="dashboard-grid-middle mb-6">
    <section class="card dashboard-chart-card">
      <div class="card-header">
        <div>
          <h3>Compliance Score Matrix</h3>
          <p class="dashboard-card-copy">A quick comparison between the live score pillars.</p>
        </div>
      </div>
      <div class="card-body">
        <div class="dashboard-canvas-wrap" style="height:250px">
          <canvas id="scoreBreakdownChart"></canvas>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <div>
          <h3>Defect Pressure</h3>
          <p class="dashboard-card-copy">Open defect mix by severity and workflow stage.</p>
        </div>
      </div>
      <div class="card-body dashboard-pressure-body">
        <div class="dashboard-canvas-wrap" style="height:250px">
          <canvas id="defectPressureChart"></canvas>
        </div>
        <div class="dashboard-pressure-grid">
          <div class="dashboard-pressure-pill danger"><span>Dangerous</span><strong>${chartData.defects.dangerous}</strong></div>
          <div class="dashboard-pressure-pill serious"><span>Serious</span><strong>${chartData.defects.serious}</strong></div>
          <div class="dashboard-pressure-pill minor"><span>Minor</span><strong>${chartData.defects.minor}</strong></div>
          <div class="dashboard-pressure-pill neutral"><span>Under review</span><strong>${chartData.defects.underReview}</strong></div>
          <div class="dashboard-pressure-pill neutral"><span>Repair booked</span><strong>${chartData.defects.repairBooked}</strong></div>
          <div class="dashboard-pressure-pill neutral"><span>Reported</span><strong>${chartData.defects.reported}</strong></div>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <div>
          <h3>Risk Hotspots</h3>
          <p class="dashboard-card-copy">The alert themes showing up most often right now.</p>
        </div>
      </div>
      <div class="card-body dashboard-hotspots">
        ${chartData.hotspots.length === 0 ? `
          <div class="empty-state" style="padding:36px 14px">
            <p>No recurring hotspots right now</p>
          </div>
        ` : chartData.hotspots.map((item, index) => `
          <div class="dashboard-hotspot-row">
            <div class="dashboard-hotspot-rank">0${index + 1}</div>
            <div class="dashboard-hotspot-main">
              <strong>${item.label}</strong>
              <div class="progress-bar dashboard-hotspot-progress">
                <div class="progress-bar-fill ${index === 0 ? 'red' : index === 1 ? 'amber' : 'green'}" style="width:${Math.min(100, item.count * 12)}%"></div>
              </div>
            </div>
            <span>${item.count}</span>
          </div>
        `).join('')}
      </div>
    </section>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header">
        <h3>Live Compliance Alerts</h3>
        <div style="display:flex;align-items:center;gap:8px">
          ${alertGroups.critical.length > 0 ? `<span class="badge badge-red"><span class="badge-dot" style="animation:blink 1.5s infinite"></span>${alertGroups.critical.length} Critical</span>` : ''}
          ${alertGroups.warning.length > 0 ? `<span class="badge badge-amber">${alertGroups.warning.length} Warning</span>` : ''}
          ${alertGroups.notice.length > 0 ? `<span class="badge badge-purple">${alertGroups.notice.length} Notice</span>` : ''}
        </div>
      </div>
      <div class="dashboard-alert-scroll">
        ${alerts.length === 0 ? `
          <div class="empty-state">
            <div class="empty-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
            <p>All compliance checks passed</p>
            <div class="empty-hint">No active alerts - great work</div>
          </div>
        ` : `
          <div class="alert-feed dashboard-alert-feed">
            ${alerts.map(a => `
              <a href="${a.href}" class="alert-item ${a.severity}">
                <div class="alert-indicator ${a.severity}"></div>
                <div class="alert-body">
                  <div class="alert-msg">${esc(a.message)}</div>
                  <div class="alert-meta">${a.typeLabel} - ${a.severity}</div>
                  ${a.preview?.length ? `<div class="alert-preview">${a.preview.map(item => `<span>${item}</span>`).join('')}</div>` : ''}
                </div>
                <div class="alert-side">
                  <span class="alert-badge ${a.severity}">${a.severity === 'critical' ? 'Critical' : a.severity === 'warning' ? 'Warning' : 'Notice'}</span>
                  <span class="alert-cta">${a.actionLabel}</span>
                </div>
              </a>
            `).join('')}
          </div>
        `}
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3>Open Defect Cases</h3>
        <a href="/defects" class="btn btn-outline btn-sm">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          View all
        </a>
      </div>
      ${recentDefects.length === 0 ? `
        <div class="empty-state">
          <div class="empty-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
          <p>No open defects</p>
        </div>
      ` : `
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Reference</th>
              <th>Vehicle</th>
              <th>Severity</th>
              <th>Status</th>
              <th>Open</th>
            </tr>
          </thead>
          <tbody>
            ${recentDefects.map(d => {
              const days = Math.floor((Date.now() - new Date(d.reportedAt)) / 86400000);
              return `<tr>
                <td><a href="/defects/${d.id}" style="font-family:monospace;font-size:12px;font-weight:700">${esc(d.referenceNumber)}</a></td>
                <td><span class="badge badge-slate">${esc(d.vehicle?.registration || '-')}</span></td>
                <td>
                  <span class="badge ${d.severity === 'dangerous' ? 'badge-red' : d.severity === 'serious' ? 'badge-amber' : 'badge-slate'}">
                    ${d.severity}
                  </span>
                </td>
                <td><span class="badge badge-blue">${d.status.replace(/_/g,' ')}</span></td>
                <td style="font-weight:700;color:${days > 5 ? '#dc2626' : days > 2 ? '#d97706' : '#374151'}">${days}d</td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      </div>`}
    </div>
  </div>
</div>

<style>
  .dashboard-shell { display:flex; flex-direction:column; gap:0; }
  .dashboard-hero { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(280px,.95fr); gap:16px; margin-bottom:24px; }
  .dashboard-hero-main { position:relative; overflow:hidden; background:linear-gradient(135deg,#0a1628 0%,#102545 48%,#123a72 100%); color:#fff; border-radius:16px; padding:26px; box-shadow:0 18px 44px rgba(10,22,40,.28); display:grid; grid-template-columns:minmax(0,1.2fr) 240px; gap:20px; border:1px solid rgba(148,163,184,.18); }
  .dashboard-hero-main::before { content:''; position:absolute; inset:0; pointer-events:none; background-image:linear-gradient(rgba(96,165,250,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(96,165,250,.07) 1px,transparent 1px); background-size:38px 38px; -webkit-mask-image:radial-gradient(ellipse 75% 85% at 88% 8%,#000 18%,transparent 72%); mask-image:radial-gradient(ellipse 75% 85% at 88% 8%,#000 18%,transparent 72%); }
  .dashboard-hero-main::after { content:''; position:absolute; width:340px; height:340px; border-radius:50%; top:-150px; right:-70px; filter:blur(72px); background:radial-gradient(circle,rgba(37,99,235,.5),rgba(6,182,212,.16) 58%,transparent 74%); pointer-events:none; }
  .dashboard-hero-main > * { position:relative; z-index:1; }
  .dashboard-eyebrow { display:inline-flex; align-items:center; gap:8px; padding:6px 12px; border-radius:999px; background:rgba(59,130,246,.14); border:1px solid rgba(59,130,246,.28); color:#bfdbfe; font-size:11px; font-weight:800; letter-spacing:.6px; text-transform:uppercase; margin-bottom:12px; }
  .dashboard-eyebrow .pip { width:7px; height:7px; border-radius:50%; background:#3b82f6; box-shadow:0 0 8px #3b82f6; animation:dashPip 2s ease-in-out infinite; }
  @keyframes dashPip { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.4)} }
  .dashboard-hero-copy h3 { font-size:32px; line-height:1.08; margin-bottom:10px; max-width:620px; }
  .dashboard-hero-copy p { color:#bfd0ea; font-size:14px; line-height:1.7; max-width:620px; }
  .dashboard-hero-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:18px; }
  .dashboard-hero-actions .btn-outline { border-color:rgba(191,219,254,.45); color:#dbeafe; }
  .dashboard-hero-actions .btn-outline:hover { background:#dbeafe; color:#123263; }
  .dashboard-hero-scorecard { position:relative; background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.03)); border:1px solid rgba(191,219,254,.18); border-radius:14px; padding:18px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; backdrop-filter:blur(6px); }
  .dashboard-hero-scorecard::before { content:''; position:absolute; top:0; left:18px; right:18px; height:1px; background:linear-gradient(90deg,transparent,rgba(96,165,250,.6),rgba(52,211,153,.55),transparent); }
  .dashboard-score-ring { position:relative; width:140px; height:140px; }
  .dashboard-score-ring::before { content:''; position:absolute; inset:14px; border-radius:50%; background:radial-gradient(circle,rgba(96,165,250,.22),transparent 68%); filter:blur(6px); z-index:0; }
  .dashboard-score-ring canvas { position:relative; z-index:1; }
  .dashboard-score-value { z-index:2; }
  .dashboard-score-value { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:34px; font-weight:900; letter-spacing:-1px; }
  .dashboard-score-value sup { font-size:16px; opacity:.72; margin-left:2px; }
  .dashboard-score-copy { text-align:center; }
  .dashboard-score-label { font-size:12px; font-weight:800; letter-spacing:.6px; text-transform:uppercase; color:#dbeafe; margin-bottom:6px; }
  .dashboard-score-helper { color:#9eb5d6; font-size:12px; line-height:1.6; }
  .dashboard-hero-side { display:flex; flex-direction:column; gap:12px; }
  .dashboard-health-card { background:#fff; border:1px solid var(--border); border-radius:14px; padding:16px; text-decoration:none; color:var(--text); box-shadow:var(--shadow-sm); transition:all .18s ease; }
  .dashboard-health-card:hover { transform:translateY(-2px); box-shadow:var(--shadow-md); }
  .dashboard-health-head { display:flex; justify-content:space-between; gap:12px; align-items:center; margin-bottom:10px; }
  .dashboard-health-head span { font-size:13px; font-weight:700; color:#334155; }
  .dashboard-health-head strong { font-size:24px; letter-spacing:-1px; }
  .dashboard-health-progress { height:8px; border-radius:999px; margin-bottom:10px; }
  .dashboard-health-copy, .dashboard-card-copy { color:#64748b; font-size:12px; line-height:1.6; margin-top:4px; }
  .dashboard-grid-top { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(320px,.9fr); gap:16px; }
  .dashboard-grid-middle { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,1fr) minmax(280px,.85fr); gap:16px; }
  .dashboard-chart-card .card-body { padding:18px 20px 14px; }
  .dashboard-canvas-wrap { position:relative; width:100%; }
  .dashboard-canvas-wrap canvas { position:absolute; inset:0; width:100% !important; height:100% !important; }
  .dashboard-risk-doughnut canvas, .dashboard-score-ring canvas { max-width:100%; height:auto; }
  .dashboard-risk-mix-body { display:grid; grid-template-columns:220px minmax(0,1fr); gap:18px; align-items:center; }
  .dashboard-risk-doughnut { display:flex; align-items:center; justify-content:center; }
  .dashboard-risk-legend { display:flex; flex-direction:column; gap:10px; }
  .dashboard-risk-row { display:flex; justify-content:space-between; align-items:center; padding:12px 14px; border:1px solid var(--border); border-radius:12px; text-decoration:none; color:var(--text); background:#fff; }
  .dashboard-risk-row span { display:flex; align-items:center; gap:10px; font-weight:700; }
  .dashboard-risk-row i { width:10px; height:10px; border-radius:999px; display:inline-block; }
  .dashboard-risk-row.critical i { background:#ef4444; box-shadow:0 0 0 4px rgba(239,68,68,.12); }
  .dashboard-risk-row.warning i { background:#f59e0b; box-shadow:0 0 0 4px rgba(245,158,11,.12); }
  .dashboard-risk-row.notice i { background:#8b5cf6; box-shadow:0 0 0 4px rgba(139,92,246,.12); }
  .dashboard-risk-row strong { font-size:22px; letter-spacing:-1px; }
  .dashboard-pressure-body { display:flex; flex-direction:column; gap:16px; }
  .dashboard-pressure-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
  .dashboard-pressure-pill { border-radius:12px; padding:12px 14px; border:1px solid var(--border); display:flex; justify-content:space-between; gap:10px; align-items:center; }
  .dashboard-pressure-pill span { color:#475569; font-size:12px; font-weight:700; }
  .dashboard-pressure-pill strong { font-size:20px; letter-spacing:-1px; }
  .dashboard-pressure-pill.danger { background:#fff1f2; border-color:#fecdd3; }
  .dashboard-pressure-pill.serious { background:#fffbeb; border-color:#fde68a; }
  .dashboard-pressure-pill.minor, .dashboard-pressure-pill.neutral { background:#f8fafc; }
  .dashboard-hotspots { display:flex; flex-direction:column; gap:12px; }
  .dashboard-hotspot-row { display:grid; grid-template-columns:42px minmax(0,1fr) auto; gap:12px; align-items:center; }
  .dashboard-hotspot-rank { width:42px; height:42px; border-radius:12px; background:#dbeafe; color:#1d4ed8; font-size:13px; font-weight:900; display:flex; align-items:center; justify-content:center; }
  .dashboard-hotspot-main strong { display:block; font-size:13px; margin-bottom:8px; }
  .dashboard-hotspot-progress { height:7px; border-radius:999px; }
  .dashboard-hotspot-row span { font-size:18px; font-weight:800; color:#1e293b; }
  .dashboard-alert-scroll { max-height:560px; overflow-y:auto; }
  .dashboard-alert-feed { padding:8px; }
  .alert-item { display:flex; align-items:flex-start; gap:14px; text-decoration:none; color:var(--text); border:1px solid var(--border); border-left-width:4px; border-radius:12px; padding:14px 16px; margin-bottom:10px; background:#fff; }
  .alert-item:hover { border-color:var(--primary); background:#f8fbff; }
  .alert-item.critical { border-left-color:#ef4444; }
  .alert-item.warning { border-left-color:#f59e0b; }
  .alert-item.notice { border-left-color:#8b5cf6; }
  .alert-indicator { width:14px; height:14px; border-radius:999px; flex:0 0 auto; margin-top:6px; }
  .alert-indicator.critical { background:#f87171; box-shadow:0 0 0 4px #fee2e2; }
  .alert-indicator.warning { background:#f59e0b; box-shadow:0 0 0 4px #fef3c7; }
  .alert-indicator.notice { background:#8b5cf6; box-shadow:0 0 0 4px #ede9fe; }
  .alert-body { min-width:0; flex:1; }
  .alert-msg { font-size:16px; font-weight:800; line-height:1.4; }
  .alert-meta { color:var(--text-muted); font-size:13px; margin-top:4px; }
  .alert-preview { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
