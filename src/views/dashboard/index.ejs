  /* ── row 1: score + KPIs ───────────────────────────────────────────── */
  .fhq-kpis { display:grid; grid-template-columns:1.06fr repeat(4, 1fr); gap:13px; }
  .fhq-score-card, .fhq-kpi { display:flex; flex-direction:column; text-decoration:none; color:#0f172a; padding:15px 17px 14px; }
  .fhq-card-title { text-align:center; font-size:12.5px; font-weight:700; color:#334155; }
  .fhq-score-wrap { position:relative; width:128px; height:128px; margin:8px auto 0; }
  .fhq-score-value { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:29px; font-weight:800; letter-spacing:-.5px; }
