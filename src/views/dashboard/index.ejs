<script>
// Toggle Quick Actions
function toggleQuickActions() {
  var menu = document.getElementById('quickActionsMenu');
  if (!menu) return;
  menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
}
document.addEventListener('click', function(e) {
  var trigger = document.getElementById('quickActionsTrigger');
  var menu = document.getElementById('quickActionsMenu');
  if (trigger && menu && !trigger.contains(e.target) && !menu.contains(e.target)) {
    menu.style.display = 'none';
  }
});

// Interactive Filter for Vehicle Status Table
function filterVehicleTable(status, btn) {
  var parent = btn.parentElement;
  parent.querySelectorAll('.fhq-tab-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  var rows = document.querySelectorAll('#vehicleStatusTable tbody tr');
  rows.forEach(function(r) {
    if (status === 'all' || r.getAttribute('data-status') === status) {
      r.style.display = '';
    } else {
      r.style.display = 'none';
    }
  });
}

// Interactive Filter for Employee Availability Table
function filterEmpTable(status, btn) {
  var parent = btn.parentElement;
  parent.querySelectorAll('.fhq-tab-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  var rows = document.querySelectorAll('#employeeStatusTable tbody tr');
  rows.forEach(function(r) {
    if (status === 'all' || r.getAttribute('data-status') === status) {
      r.style.display = '';
    } else {
      r.style.display = 'none';
    }
  });
}

// Interactive Filter for Sponsored Workers Table
function filterSponsoredTable(status, btn) {
  var parent = btn.parentElement;
  parent.querySelectorAll('.fhq-tab-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  var rows = document.querySelectorAll('#sponsoredTable tbody tr');
  rows.forEach(function(r) {
    if (status === 'all' || r.getAttribute('data-status') === status) {
      r.style.display = '';
    } else {
      r.style.display = 'none';
    }
  });
}

// Map initialization
var trackingData = ${JSON.stringify(complianceData.trackingVehicles)};
var mapMarkers = [];
var trackingMap;

function initLeafletMap() {
  if (typeof L === 'undefined') return;
  var container = document.getElementById('liveTrackingMap');
  if (!container) return;

  trackingMap = L.map('liveTrackingMap', {
    center: [53.2, -1.5],
    zoom: 6.5,
    zoomControl: true,
  });

  L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
    subdomains: 'abcd',
    maxZoom: 19
  }).addTo(trackingMap);

  renderMapMarkers('all');
}

function renderMapMarkers(filter) {
  if (!trackingMap) return;
  mapMarkers.forEach(function(m) { trackingMap.removeLayer(m); });
  mapMarkers = [];

  trackingData.forEach(function(v) {
    if (filter === 'in_use' && v.status !== 'In Use') return;
    if (filter === 'off_road' && v.status !== 'Off Road') return;
    if (filter === 'in_service' && v.status !== 'In Service') return;

    var iconHtml = '<div class="fhq-map-pin ' + v.tone + '">' +
      '<svg class="fhq-map-pin-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10m10 0H9m4 0h3m0 0V9h3l3 4v3"/></svg>' +
      '<div><div>' + v.registration + '</div><div class="fhq-map-pin-sub">' + v.speed + ' &bull; ' + v.location + '</div></div>' +
    '</div>';

    var customIcon = L.divIcon({
      html: iconHtml,
      className: '',
      iconSize: [120, 36],
      iconAnchor: [60, 18],
    });

    var marker = L.marker([v.lat, v.lng], { icon: customIcon }).addTo(trackingMap);
    marker.bindPopup('<b>' + v.registration + '</b> (' + v.fleetId + ')<br>Driver: ' + v.driver + '<br>Status: ' + v.status + '<br>Location: ' + v.location);
    mapMarkers.push(marker);
  });
}

function filterMapMarkers(val) {
  renderMapMarkers(val);
}

// Chart.js Fuel & AdBlue Bar Chart
function initFuelAdBlueChart() {
  if (typeof Chart === 'undefined') return;
  var canvas = document.getElementById('fuelAdBlueChart');
  if (!canvas) return;

  var months = ${JSON.stringify(complianceData.fuelAdBlue.months)};
  var fuel = ${JSON.stringify(complianceData.fuelAdBlue.fuelChartData)};
  var adblue = ${JSON.stringify(complianceData.fuelAdBlue.adBlueChartData)};

  new Chart(canvas, {
    type: 'bar',
    data: {
      labels: months,
      datasets: [
        {
          label: 'Fuel (L)',
          data: fuel,
          backgroundColor: '#3b82f6',
          borderRadius: 4,
          barPercentage: 0.6,
        },
        {
          label: 'AdBlue (L)',
          data: adblue,
          backgroundColor: '#10b981',
          borderRadius: 4,
          barPercentage: 0.6,
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: { grid: { display: false } },
        y: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 } } }
      }
    }
  });
}

document.addEventListener('DOMContentLoaded', function() {
  initLeafletMap();
  initFuelAdBlueChart();
});
</script>
