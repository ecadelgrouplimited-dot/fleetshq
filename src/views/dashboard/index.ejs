<%
// ── Transport Manager dashboard ───────────────────────────────────────────────
// Layout follows public/new_designs/68703.jpg:
//   row 1  compliance gauge + 4 KPI cards
//   row 2  Compliance Overview (12 tiles) | Recent Alerts rail
//   row 3  Compliance Trend + Top Risk Drivers | Upcoming Tasks rail
//   row 4  Fuel / AdBlue / Finance / Fleet Availability
//
// Icon markup for the compliance tiles. Each entry is the inner SVG of a
// 24×24 outline icon; the tile paints it with its own tone colour.
const ICONS = {
  pmi: '<path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>',
  mot: '<path d="M3 16v-3.2a2 2 0 01.4-1.2l2.2-3A2 2 0 017.2 8h9.6a2 2 0 011.6.8l2.2 3a2 2 0 01.4 1.2V16M5 16h14"/><circle cx="7" cy="16.5" r="1.6"/><circle cx="17" cy="16.5" r="1.6"/>',
  brake: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.2"/><path d="M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3"/>',
  defects: '<path d="M12 9.5v4m0 3.5h.01M10.3 4.3L2.7 18a2 2 0 001.7 3h15.2a2 2 0 001.7-3L13.7 4.3a2 2 0 00-3.4 0z"/>',
  vor: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/>',
  insurance: '<path d="M12 3l7.5 3v5.2c0 4.6-3.1 8.5-7.5 10.3C7.6 19.7 4.5 15.8 4.5 11.2V6L12 3z"/><path d="M9 12l2.2 2.2L15.2 10"/>',
  roadtax: '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-5z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  licence: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><circle cx="8.5" cy="11" r="2"/><path d="M5.5 16c.6-1.6 1.8-2.3 3-2.3s2.4.7 3 2.3M14.5 10.5h4M14.5 13.5h3"/>',
  cpc: '<path d="M12 4l9.5 4.6L12 13.2 2.5 8.6 12 4z"/><path d="M6.5 11v4.4c0 1.7 2.5 3 5.5 3s5.5-1.3 5.5-3V11"/>',
  infringements: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.4V12l3 2"/>',
  tachocard: '<path d="M12 3.5v11m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>',
  training: '<path d="M12 6.4v13m0-13C10.8 5.6 9.2 5.1 7.5 5.1S4.2 5.6 3 6.4v13c1.2-.8 2.8-1.3 4.5-1.3s3.3.5 4.5 1.3m0-13c1.2-.8 2.8-1.3 4.5-1.3s3.3.5 4.5 1.3v13c-1.2-.8-2.8-1.3-4.5-1.3s-3.3.5-4.5 1.3"/>',
};
// Icon per compliance-task category, for the Upcoming Tasks rail.
const TASK_ICONS = {
  vehicle_compliance: ICONS.mot, driver_compliance: ICONS.licence, tachograph: ICONS.infringements,
  insurance: ICONS.insurance, health_safety: ICONS.defects, training: ICONS.training,
  licensing: ICONS.cpc, other: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8.5 12.2l2.3 2.3 4.7-4.7"/>',
};
const TASK_TONES = {
  vehicle_compliance: 'green', driver_compliance: 'green', tachograph: 'red', insurance: 'blue',
  health_safety: 'amber', training: 'blue', licensing: 'orange', other: 'blue',
};
const band = score.overall >= 85 ? 'Good' : score.overall >= 70 ? 'Fair' : 'At Risk';
const gaugeColor = score.overall >= 85 ? '#16a34a' : score.overall >= 70 ? '#f59e0b' : '#ef4444';
// Alerts carry `daysUntil`, not a date — turn that back into the due date the
// design shows on the right of each row.
const alertDate = (a) => {
  if (a.daysUntil === null || a.daysUntil === undefined) return '';
  const d = new Date();
  d.setDate(d.getDate() + a.daysUntil);
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
};
const taskDate = (t) => {
  if (!t.dueDate) return '';
  const due = new Date(t.dueDate); due.setHours(0, 0, 0, 0);
  const now = new Date(); now.setHours(0, 0, 0, 0);
  const diff = Math.round((due - now) / 86400000);
  if (diff < 0) return 'Overdue';
  if (diff === 0) return 'Today';
  if (diff === 1) return 'Tomorrow';
  return due.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
};
const trendPoints = complianceTrend.filter((p) => p.value !== null);
const svgIcon = (inner, cls) => `<span class="fhq-t-icon ${cls}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner}</svg></span>`;
%>
<%- include('../layouts/main', { body: `
<div class="fhq-dashboard">
  ${typeof platformQueue !== 'undefined' && platformQueue ? `
  <a href="/platform" class="fhq-banner">
    <span class="fhq-banner-icon">!</span>
    <span><strong>${platformQueue.pendingActivation} awaiting activation</strong>${platformQueue.inFlight > 0 ? ` · ${platformQueue.inFlight} registrations in progress` : ''}</span>
    <span>Review queue →</span>
  </a>` : ''}

  ${typeof setup !== 'undefined' && setup ? `
  <div class="fhq-setup">
    <div>
      <strong>Let's get your fleet set up</strong>
      <span>${setup.doneCount}/${setup.steps.length} essentials ready</span>
    </div>
    <div class="fhq-setup-steps">
      ${setup.steps.map(s => `<a href="${s.href}" class="${s.done ? 'done' : ''}">${s.done ? 'Done' : 'Open'} · ${s.label}</a>`).join('')}
    </div>
  </div>` : ''}

  <!-- ── Row 1: compliance score + headline KPIs ─────────────────────── -->
  <div class="fhq-kpis">
    <a href="/compliance" class="fhq-card fhq-score-card">
      <div class="fhq-card-title">Overall Compliance Score</div>
      <div class="fhq-score-wrap">
        <canvas id="fhqScoreGauge" width="128" height="128"></canvas>
        <div class="fhq-score-value"><b>${score.overall.toFixed(0)}<span>%</span></b><small>${band}</small></div>
      </div>
      <div class="fhq-score-foot">
        ${scoreDelta === null
          ? '<span class="muted">No prior score</span>'
          : `<span class="fhq-delta ${scoreDelta >= 0 ? 'good' : 'bad'}">
               <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="${scoreDelta >= 0 ? 'M12 19V5m0 0l-6 6m6-6l6 6' : 'M12 5v14m0 0l6-6m-6 6l-6-6'}"/></svg>
               ${Math.abs(scoreDelta).toFixed(0)}%
             </span><span class="muted">from last month</span>`}
      </div>
      <span class="fhq-link">View Score Breakdown <i>→</i></span>
    </a>

    ${[
      { label: 'Drivers', value: stats.driverCount, sub: 'Total Drivers', actions: stats.driverActions, actionTone: 'red',
        href: '/employees?type=drivers', linkLabel: 'View Drivers', tone: 'blue',
        icon: '<circle cx="9" cy="8" r="3.3"/><path d="M3.5 19.5c0-3.1 2.5-5.4 5.5-5.4s5.5 2.3 5.5 5.4"/><circle cx="17" cy="9.5" r="2.4"/><path d="M15.5 14.4c2.9-.5 5 1.6 5 4.4"/>' },
      { label: 'Vehicles', value: stats.totalVehicles, sub: 'Total Vehicles', actions: stats.vehicleActions, actionTone: 'red',
        href: '/fleet', linkLabel: 'View Vehicles', tone: 'purple',
        icon: '<rect x="2.5" y="6.5" width="11" height="9" rx="1.5"/><path d="M13.5 9.5h3.6l3.4 3.4v2.6h-7z"/><circle cx="7" cy="17.6" r="1.9"/><circle cx="17.5" cy="17.6" r="1.9"/>' },
      { label: 'Trailers', value: stats.totalTrailers, sub: 'Total Trailers', actions: stats.trailerActions, actionTone: 'amber',
        href: '/trailers', linkLabel: 'View Trailers', tone: 'teal',
        icon: '<rect x="2.5" y="7" width="15" height="9" rx="1.6"/><path d="M17.5 13h4v2.4h-4z"/><circle cx="7.5" cy="18" r="1.7"/><circle cx="13.5" cy="18" r="1.7"/>' },
      { label: 'Compliance Alerts', value: alerts.length, sub: 'Open Alerts', actions: null, actionTone: 'red',
        href: '#fhqAlerts', linkLabel: 'View All Alerts', tone: 'red',
        icon: '<path d="M12 9.2v4.3m0 3.4h.01M10.3 4.3L2.7 18a2 2 0 001.7 3h15.2a2 2 0 001.7-3L13.7 4.3a2 2 0 00-3.4 0z"/>' },
    ].map(k => `
    <a href="${k.href}" class="fhq-card fhq-kpi ${k.tone}">
      <div class="fhq-kpi-top">
        <span class="fhq-kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${k.icon}</svg></span>
        <span class="fhq-kpi-meta">
          <span class="fhq-kpi-label">${k.label}</span>
          <span class="fhq-kpi-value">${k.value}</span>
          <span class="fhq-kpi-sub">${k.sub}</span>
        </span>
      </div>
      ${k.actions === null ? '' : `<div class="fhq-kpi-actions"><strong class="${k.actionTone}">${k.actions}</strong><span>Actions Required</span></div>`}
      <span class="fhq-link">${k.linkLabel} <i>→</i></span>
    </a>`).join('')}
  </div>

  <!-- ── Rows 2–3: compliance detail (left) + alert/task rail (right) ── -->
  <div class="fhq-main-grid">
    <div class="fhq-main-col">

      <section class="fhq-card fhq-overview">
        <div class="fhq-section-head"><h3>Compliance Overview</h3></div>
        <div class="fhq-tiles">
          ${complianceTiles.map(t => `
          <a href="${t.href}" class="fhq-tile ${t.tone}">
            <div class="fhq-tile-head">
              ${svgIcon(ICONS[t.key] || ICONS.training, t.tone)}
              <span class="fhq-tile-label">${esc(t.label)}</span>
            </div>
            <div class="fhq-tile-count">${t.count}</div>
            <div class="fhq-tile-unit">${esc(t.unit)}</div>
            <div class="fhq-tile-bar"><i style="width:${t.denom > 0 ? Math.max(6, Math.min(100, Math.round((t.count / t.denom) * 100))) : 0}%"></i></div>
          </a>`).join('')}
        </div>
      </section>

      <div class="fhq-split">
        <section class="fhq-card fhq-trend">
          <div class="fhq-section-head"><h3>Compliance Trend <small>(Last 6 Months)</small></h3></div>
          <div class="fhq-trend-chart">
            ${trendPoints.length < 2
              ? '<div class="empty-state"><p>Not enough history yet — the trend appears once a second monthly score is stored.</p></div>'
              : '<canvas id="fhqTrendChart"></canvas>'}
          </div>
          <div class="fhq-trend-chips">
            ${complianceTrend.map(p => `
            <span class="fhq-chip ${p.isCurrent ? 'is-current' : ''}">
              <small>${esc(p.label)}</small>
              <strong>${p.value === null ? '—' : Math.round(p.value) + '%'}</strong>
            </span>`).join('')}
          </div>
        </section>

        <section class="fhq-card fhq-risk">
          <div class="fhq-section-head compact"><h3>Top Risk Drivers</h3><a href="/driver-risk">View All</a></div>
          <div class="fhq-risk-list">
            ${topRiskDrivers.length === 0
              ? '<div class="empty-state"><p>No infringements or licence points on record</p></div>'
              : topRiskDrivers.map(d => `
            <a href="/driver-risk/${d.id}" class="fhq-risk-row">
              ${avatar(d, { size: 34 })}
              <span class="fhq-risk-who">
                <strong>${esc(d.fullName)}</strong>
                <small>${d.infringements > 0
                  ? d.infringements + ' Infringement' + (d.infringements === 1 ? '' : 's')
                  : d.licencePoints + ' Licence point' + (d.licencePoints === 1 ? '' : 's')}</small>
              </span>
              <span class="fhq-risk-bar ${d.band}"><i style="width:${d.riskPct}%"></i></span>
              <span class="fhq-risk-band ${d.band}">${d.band === 'high' ? 'High Risk' : d.band === 'medium' ? 'Medium Risk' : 'Low Risk'}</span>
            </a>`).join('')}
          </div>
          <a href="/driver-risk" class="fhq-foot-link">Go to Driver Risk <i>→</i></a>
        </section>
      </div>
    </div>

    <aside class="fhq-rail">
      <section class="fhq-card" id="fhqAlerts">
        <div class="fhq-section-head compact"><h3>Recent Alerts</h3><a href="/reports">View All</a></div>
        <div class="fhq-rail-list">
          ${alerts.length === 0 ? '<div class="empty-state"><p>No open alerts</p></div>' : alerts.slice(0, 5).map(a => `
          <a href="${a.href}" class="fhq-rail-item ${a.severity}">
            <span class="fhq-rail-icon">
              ${a.severity === 'critical'
                ? '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.9 3.6a1 1 0 00-1.8 0L2.4 19.5a1 1 0 00.9 1.5h17.4a1 1 0 00.9-1.5L12.9 3.6zM11 9.4h2v5.2h-2V9.4zm0 6.6h2v2h-2v-2z"/></svg>'
                : '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.8a9.2 9.2 0 100 18.4 9.2 9.2 0 000-18.4zM11 7h2v6h-2V7zm0 8h2v2h-2v-2z"/></svg>'}
            </span>
            <span class="fhq-rail-body">
              <strong>${esc(a.message)}</strong>
              <small>${esc(a.entityType === 'vehicle' ? 'Vehicle ' + (a.entityName || '') : (a.entityName || a.typeLabel))}</small>
            </span>
            <em>${esc(alertDate(a))}</em>
          </a>`).join('')}
        </div>
        <a href="/reports" class="fhq-foot-link">View All Alerts <i>→</i></a>
      </section>

      <section class="fhq-card">
        <div class="fhq-section-head compact"><h3>Upcoming Tasks</h3><a href="/compliance-tasks">View All</a></div>
        <div class="fhq-rail-list">
          ${upcomingTasks.length === 0 ? '<div class="empty-state"><p>No upcoming tasks</p></div>' : upcomingTasks.slice(0, 5).map(t => `
          <a href="/compliance-tasks?task=${t.id}" class="fhq-rail-item task ${t.isOverdue ? 'critical' : t.priority}">
            ${svgIcon(TASK_ICONS[t.category] || TASK_ICONS.other, TASK_TONES[t.category] || 'blue')}
            <span class="fhq-rail-body">
              <strong>${esc(t.title)}</strong>
              ${t.relatedTo ? `<small>${esc(t.relatedTo)}</small>` : ''}
            </span>
            <em class="${t.isOverdue || taskDate(t) === 'Today' ? 'urgent' : ''}">${esc(taskDate(t))}</em>
          </a>`).join('')}
        </div>
        <a href="/compliance-tasks" class="fhq-foot-link">View All Tasks <i>→</i></a>
      </section>
    </aside>
  </div>

  <!-- ── Row 4: fuel / adblue / finance / availability ───────────────── -->
  <div class="fhq-bottom-grid">
    <section class="fhq-card fhq-mini-card">
      <div class="fhq-section-head compact"><h3>Fuel Overview <small>(This Month)</small></h3><a href="/fleet/fuel">View Details</a></div>
      <div class="fhq-mini-main">
        <span class="fhq-mini-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V6a2 2 0 012-2h5a2 2 0 012 2v14M3 20h11M6.5 9h4M15 11h2.5a1.5 1.5 0 011.5 1.5V17a1.5 1.5 0 003 0V9l-3-3"/></svg></span>
        <div>
          <small>Total Fuel (L)</small>
          <strong>${dashboardOps.fuel.litres.toLocaleString(undefined, { maximumFractionDigits: 0 })} L</strong>
          ${dashboardOps.fuel.deltaPct === null ? '' : `<em class="${dashboardOps.fuel.deltaPct <= 0 ? 'good' : 'bad'}">${dashboardOps.fuel.deltaPct <= 0 ? '↓' : '↑'} ${Math.abs(dashboardOps.fuel.deltaPct)}% <span>vs last month</span></em>`}
        </div>
      </div>
      <div class="fhq-mini-split">
        <div class="fhq-bars">${dashboardOps.fuel.bars.slice(-16).map(v => `<i style="height:${Math.max(4, Math.min(46, v / Math.max(...dashboardOps.fuel.bars, 1) * 46))}px"></i>`).join('')}</div>
        <div class="fhq-top-list">
          <span class="fhq-top-title">Top Consumers</span>
          <ol>${dashboardOps.fuel.topConsumers.length
            ? dashboardOps.fuel.topConsumers.map((c, i) => `<li><span>${i + 1}. ${esc(c.label)}</span><strong>${c.value.toLocaleString(undefined, { maximumFractionDigits: 0 })} L</strong></li>`).join('')
            : '<li><span>No fuel logged</span><strong>0 L</strong></li>'}</ol>
        </div>
      </div>
    </section>

    <section class="fhq-card fhq-mini-card">
      <div class="fhq-section-head compact"><h3>AdBlue Overview <small>(This Month)</small></h3><a href="/fleet/adblue">View Details</a></div>
      <div class="fhq-mini-main">
        <span class="fhq-mini-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2s6 6.3 6 10.6a6 6 0 11-12 0c0-4.3 6-10.6 6-10.6z"/></svg></span>
        <div>
          <small>Total AdBlue (L)</small>
          <strong>${dashboardOps.adBlue.litres.toLocaleString(undefined, { maximumFractionDigits: 0 })} L</strong>
          ${dashboardOps.adBlue.deltaPct === null ? '' : `<em class="${dashboardOps.adBlue.deltaPct <= 0 ? 'good' : 'bad'}">${dashboardOps.adBlue.deltaPct <= 0 ? '↓' : '↑'} ${Math.abs(dashboardOps.adBlue.deltaPct)}% <span>vs last month</span></em>`}
        </div>
      </div>
      <div class="fhq-mini-split">
        <div class="fhq-bars blue">${dashboardOps.adBlue.bars.slice(-16).map(v => `<i style="height:${Math.max(4, Math.min(46, v / Math.max(...dashboardOps.adBlue.bars, 1) * 46))}px"></i>`).join('')}</div>
        <div class="fhq-top-list">
          <span class="fhq-top-title">Top Consumers</span>
          <ol>${dashboardOps.adBlue.topConsumers.length
            ? dashboardOps.adBlue.topConsumers.map((c, i) => `<li><span>${i + 1}. ${esc(c.label)}</span><strong>${c.value.toLocaleString(undefined, { maximumFractionDigits: 0 })} L</strong></li>`).join('')
            : '<li><span>No AdBlue logged</span><strong>0 L</strong></li>'}</ol>
        </div>
      </div>
    </section>

    <section class="fhq-card fhq-mini-card finance">
      <div class="fhq-section-head compact"><h3>Finance Overview <small>(This Month)</small></h3><a href="/finance">View Details</a></div>
      <div class="fhq-finance-values">
        <div>
          <span class="fhq-fin-head"><i class="fhq-mini-icon green sm">£</i><small>Total Income</small></span>
          <strong>£${dashboardOps.finance.income.toLocaleString(undefined, { maximumFractionDigits: 0 })}</strong>
        </div>
        <div>
          <small>Total Expenses</small>
          <strong>£${dashboardOps.finance.expenses.toLocaleString(undefined, { maximumFractionDigits: 0 })}</strong>
        </div>
        <div>
          <small>Net Profit</small>
          <strong>£${dashboardOps.finance.profit.toLocaleString(undefined, { maximumFractionDigits: 0 })}</strong>
        </div>
      </div>
      <div class="fhq-finance-body">
        <div class="fhq-finance-chart"><canvas id="fhqFinanceChart"></canvas></div>
        <ul class="fhq-finance-legend" id="fhqFinanceLegend"></ul>
      </div>
    </section>

    <section class="fhq-card fhq-mini-card availability">
      <div class="fhq-section-head compact"><h3>Fleet Availability</h3><a href="/fleet/overview">View Details</a></div>
      <div class="fhq-availability-body">
        <div class="fhq-fleet-gauge">
          <canvas id="fhqFleetGauge" width="112" height="112"></canvas>
          <span>${dashboardOps.fleet.pct}%<small>Available</small></span>
        </div>
        <dl>
          <dt>Total Fleet</dt><dd>${dashboardOps.fleet.total}</dd>
          <dt class="good">Available</dt><dd class="good">${dashboardOps.fleet.available}</dd>
          <dt class="info">In Use</dt><dd class="info">${dashboardOps.fleet.inUse}</dd>
          <dt class="warn">In Workshop</dt><dd class="warn">${dashboardOps.fleet.inWorkshop}</dd>
          <dt>Out of Service</dt><dd class="${dashboardOps.fleet.outOfService > 0 ? 'bad' : ''}">${dashboardOps.fleet.outOfService}</dd>
        </dl>
      </div>
    </section>
  </div>
</div>

<style>
  /* ── shell ─────────────────────────────────────────────────────────── */
  .fhq-dashboard { display:flex; flex-direction:column; gap:14px; color:#0f172a; }
  .fhq-card { background:#fff; border:1px solid #e9eef5; border-radius:10px; box-shadow:0 1px 2px rgba(15,23,42,.04); }
  .good { color:#16a34a; } .bad { color:#dc2626; } .muted { color:#64748b; }
  .fhq-banner, .fhq-setup { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 16px; border-radius:10px; background:#fff7ed; color:#9a3412; border:1px solid #fed7aa; text-decoration:none; }
  .fhq-banner-icon { width:26px; height:26px; border-radius:50%; display:grid; place-items:center; background:#f97316; color:#fff; font-weight:900; }
  .fhq-setup { background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe; align-items:flex-start; }
  .fhq-setup > div:first-child { display:flex; flex-direction:column; gap:2px; }
  .fhq-setup-steps { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
  .fhq-setup-steps a { color:inherit; text-decoration:none; font-size:12px; font-weight:700; padding:5px 8px; border-radius:6px; background:rgba(255,255,255,.65); }
  .fhq-setup-steps a.done { color:#047857; }

  /* Shared blue "View X →" affordance at the foot of a card. */
  .fhq-link { margin-top:auto; padding-top:12px; color:#2563eb; font-size:12px; font-weight:700; display:inline-flex; align-items:center; gap:6px; }
  .fhq-link i { font-style:normal; }
  .fhq-foot-link { display:flex; align-items:center; gap:7px; padding:11px 16px 13px; color:#2563eb; font-size:12px; font-weight:700; text-decoration:none; }
