<%
  // Compliance Overview tile icons (Phase B)
  const tileIcons = {
    mot: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    pmi: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z',
    insurance: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    roadtax: 'M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v14l-4-2-3 2-3-2-4 2V6a2 2 0 012-2z',
    tacho: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    cpc: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z',
    rtw: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
    training: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  };
%>
<%- include('../layouts/main', { body: `
<div class="dash">

  ${typeof platformQueue !== 'undefined' && platformQueue ? `
  <!-- ── Platform: self-serve registrations awaiting action ── -->
  <a href="/platform" class="card mb-4" style="display:flex;align-items:center;gap:14px;padding:14px 18px;text-decoration:none;border-left:4px solid var(--warning)">
    <span style="width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:color-mix(in srgb, var(--warning) 14%, transparent);flex-shrink:0">
      <svg fill="none" viewBox="0 0 24 24" stroke="var(--warning)" style="width:19px;height:19px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
    </span>
    <span style="flex:1;min-width:0">
      <span style="display:block;font-weight:800;font-size:14px">${platformQueue.pendingActivation > 0 ? `${platformQueue.pendingActivation} business${platformQueue.pendingActivation === 1 ? '' : 'es'} awaiting activation` : 'New registrations in progress'}</span>
      <span style="display:block;font-size:12px;color:var(--text-muted);margin-top:2px">${platformQueue.pendingActivation > 0 ? 'Verified and waiting for the FLEET.HQ team — confirm payment, then activate.' : ''}${platformQueue.inFlight > 0 ? ` ${platformQueue.inFlight} more still completing registration.` : ''}</span>
    </span>
    <span class="btn btn-primary btn-sm" style="flex-shrink:0">Review queue →</span>
  </a>` : ''}

  <!-- ── KPI row ─────────────────────────────────────── -->
  <div class="dash-kpi-row mb-4">
    <div class="card dash-gauge-card">
      <div class="dash-gauge">
        <canvas id="gaugeOverall" width="150" height="150"></canvas>
        <div class="dash-gauge-value">${score.overall.toFixed(0)}<sup>%</sup></div>
      </div>
      <div class="dash-gauge-meta">
        <div class="dash-gauge-label">Overall compliance</div>
        <div class="dash-gauge-band ${score.overall >= 85 ? 'good' : score.overall >= 70 ? 'ok' : 'risk'}">${score.overall >= 85 ? 'Good' : score.overall >= 70 ? 'Fair' : 'At risk'}</div>
        ${scoreDelta === null ? '' : `<div class="ui-delta ${scoreDelta >= 0 ? 'good' : 'bad'}" style="margin-top:6px"><span class="ui-delta-arrow">${scoreDelta >= 0 ? '▲' : '▼'}</span>${Math.abs(scoreDelta).toFixed(0)}% <span class="ui-delta-label">from last month</span></div>`}
      </div>
    </div>

    <a href="/employees" class="card dash-kpi">
      <div class="dash-kpi-top">
        <div class="stat-icon blue"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
        <span class="dash-kpi-link">View drivers →</span>
      </div>
      <div class="dash-kpi-value">${stats.driverCount}</div>
      <div class="dash-kpi-label">Drivers</div>
      <div class="dash-kpi-sub">${stats.driverActions > 0 ? `<span class="dot amber"></span>${stats.driverActions} need attention` : `<span class="dot green"></span>All up to date`}</div>
    </a>

    <a href="/fleet" class="card dash-kpi">
      <div class="dash-kpi-top">
        <div class="stat-icon green"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17H5a2 2 0 01-2-2V7a2 2 0 012-2h3m8 10h3a2 2 0 002-2V7a2 2 0 00-2-2h-3M8 17V7m8 10V7m-8 0l4-4m0 0l4 4m-4-4v14"/></svg></div>
        <span class="dash-kpi-link">View vehicles →</span>
      </div>
      <div class="dash-kpi-value">${stats.totalVehicles}</div>
      <div class="dash-kpi-label">Vehicles</div>
      <div class="dash-kpi-sub">${stats.vehicleActions > 0 ? `<span class="dot amber"></span>${stats.vehicleActions} need attention` : `<span class="dot green"></span>Fleet compliant`}</div>
    </a>

    <a href="#dashAlerts" class="card dash-kpi ${alertGroups.critical.length > 0 ? 'dash-kpi-alert' : ''}">
      <div class="dash-kpi-top">
        <div class="stat-icon ${alerts.length > 0 ? 'red' : 'green'}"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg></div>
        <span class="dash-kpi-link">View all →</span>
      </div>
      <div class="dash-kpi-value">${alerts.length}</div>
      <div class="dash-kpi-label">Compliance Alerts</div>
      <div class="dash-kpi-sub">${alertGroups.critical.length > 0 ? `<span class="dot red"></span>${alertGroups.critical.length} critical` : `<span class="dot green"></span>Nothing critical`}</div>
    </a>
  </div>

  <!-- ── Compliance Overview tiles ───────────────────── -->
  <div class="card mb-4">
    <div class="card-header"><h3>Compliance Overview</h3><span class="text-sm text-muted">Items due within 30 days (RTW within 60)</span></div>
    <div class="card-body">
      <div class="dash-tiles">
        ${complianceTiles.map(t => `
          <a href="${t.href}" class="dash-tile ${t.tone}">
            <div class="dash-tile-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${tileIcons[t.key]}"/></svg></div>
            <div class="dash-tile-count">${t.count}</div>
            <div class="dash-tile-label">${t.label}</div>
            <div class="dash-tile-bar"></div>
          </a>
        `).join('')}
      </div>
    </div>
  </div>

  <!-- ── Trend + Alerts ──────────────────────────────── -->
  <div class="dash-2col mb-4">
    <div class="card">
      <div class="card-header"><h3>Compliance Trend</h3><span class="text-sm text-muted">Overall score over time</span></div>
      <div class="card-body">
        ${complianceTrend.length < 2
          ? `<div class="empty-state" style="padding:40px 14px"><p>Not enough history yet</p><div class="empty-hint">The score trend appears once a few days of data accumulate.</div></div>`
          : `<div style="position:relative;height:240px"><canvas id="complianceTrendChart"></canvas></div>`}
      </div>
    </div>

    <div class="card" id="dashAlerts">
      <div class="card-header">
        <h3>Alerts &amp; Notifications</h3>
        ${alertGroups.critical.length > 0 ? `<span class="badge badge-red">${alertGroups.critical.length} critical</span>` : ''}
      </div>
      <div class="dash-alert-scroll">
        ${alerts.length === 0 ? `
          <div class="empty-state" style="padding:40px 14px">
            <div class="empty-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
            <p>All compliance checks passed</p>
            <div class="empty-hint">No active alerts — great work</div>
          </div>
        ` : alerts.map(a => `
          <a href="${a.href}" class="dash-alert ${a.severity}">
            <span class="dash-alert-dot ${a.severity}"></span>
            <span class="dash-alert-body">
              <span class="dash-alert-msg">${esc(a.message)}</span>
              <span class="dash-alert-meta">${a.typeLabel}</span>
            </span>
            <span class="dash-alert-cta">${a.actionLabel || 'View'} →</span>
          </a>
        `).join('')}
      </div>
    </div>
  </div>

  <!-- ── Upcoming compliance tasks ───────────────────── -->
  ${upcomingTasks.length > 0 ? `
  <div class="card mb-4">
    <div class="card-header"><h3>Upcoming Compliance Tasks</h3><a href="/compliance-tasks" class="btn btn-outline btn-sm">View all</a></div>
    <div class="card-body">
      <div class="dash-tasks">
        ${upcomingTasks.map(t => `
          <a href="/compliance-tasks?task=${t.id}" class="dash-task">
            <span class="dash-task-dot ${t.priority === 'critical' ? 'red' : t.priority === 'high' ? 'amber' : t.priority === 'medium' ? 'blue' : 'slate'}"></span>
            <span class="dash-task-title">${esc(t.title)}</span>
            <span class="dash-task-due ${t.isOverdue ? 'overdue' : ''}">${t.dueDate ? (t.isOverdue ? 'Overdue · ' : 'Due ') + new Date(t.dueDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) : 'No due date'}</span>
          </a>
        `).join('')}
      </div>
    </div>
  </div>` : ''}

  <!-- ── Operations pulse + open defects ─────────────── -->
  <div class="dash-2col">
    <div class="card">
      <div class="card-header"><h3>Operations Pulse</h3><span class="text-sm text-muted">Last 7 days</span></div>
      <div class="card-body"><div style="position:relative;height:240px"><canvas id="operationsTrendChart"></canvas></div></div>
    </div>

    <div class="card">
      <div class="card-header"><h3>Open Defect Cases</h3><a href="/defects" class="btn btn-outline btn-sm">View all</a></div>
      ${recentDefects.length === 0 ? `
        <div class="empty-state" style="padding:40px 14px">
          <div class="empty-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
          <p>No open defects</p>
        </div>
      ` : `
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Reference</th><th scope="col">Vehicle</th><th scope="col">Severity</th><th scope="col">Status</th><th scope="col">Open</th></tr></thead>
          <tbody>
            ${recentDefects.map(d => {
              const days = Math.floor((Date.now() - new Date(d.reportedAt)) / 86400000);
              return `<tr>
                <td><a href="/defects/${d.id}" style="font-family:monospace;font-size:12px;font-weight:700">${esc(d.referenceNumber)}</a></td>
                <td><span class="badge badge-slate">${esc(d.vehicle?.registration || '-')}</span></td>
                <td><span class="badge ${d.severity === 'dangerous' ? 'badge-red' : d.severity === 'serious' ? 'badge-amber' : 'badge-slate'}">${d.severity}</span></td>
                <td><span class="badge badge-blue">${d.status.replace(/_/g,' ')}</span></td>
                <td style="font-weight:700;color:${days > 5 ? 'var(--danger)' : days > 2 ? 'var(--warning)' : 'var(--text)'}">${days}d</td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      </div>`}
    </div>
  </div>
</div>

<style>
  .dash { display:flex; flex-direction:column; }
  .dash-kpi-row { display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:16px; }
  .dash-gauge-card { display:flex; align-items:center; gap:18px; padding:20px 22px; }
  .dash-gauge { position:relative; width:118px; height:118px; flex-shrink:0; }
  .dash-gauge canvas { width:118px !important; height:118px !important; }
  .dash-gauge-value { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:30px; font-weight:900; letter-spacing:-1px; color:var(--text); }
  .dash-gauge-value sup { font-size:14px; opacity:.6; margin-left:1px; }
  .dash-gauge-label { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--text-muted); }
  .dash-gauge-band { display:inline-block; margin-top:6px; font-size:18px; font-weight:800; }
  .dash-gauge-band.good { color:var(--success); }
  .dash-gauge-band.ok { color:var(--warning); }
  .dash-gauge-band.risk { color:var(--danger); }
  .dash-kpi { display:flex; flex-direction:column; padding:18px 20px; text-decoration:none; color:var(--text); transition:transform .15s, box-shadow .15s; }
  .dash-kpi:hover { transform:translateY(-2px); box-shadow:var(--shadow-md); }
  .dash-kpi-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .dash-kpi-top .stat-icon { width:38px; height:38px; }
  .dash-kpi-link { font-size:11px; font-weight:700; color:var(--primary); }
  .dash-kpi-value { font-size:34px; font-weight:900; letter-spacing:-1.5px; line-height:1; }
  .dash-kpi-label { font-size:13px; font-weight:700; color:var(--text-muted); margin-top:4px; }
  .dash-kpi-sub { display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:var(--text-2); margin-top:10px; }
  .dash-kpi-sub .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .dash-kpi-sub .dot.green { background:var(--success); }
  .dash-kpi-sub .dot.amber { background:var(--warning); }
  .dash-kpi-sub .dot.red { background:var(--danger); }
  .dash-kpi-alert { border-color:rgba(239,68,68,.35); }

  .dash-tiles { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
  .dash-tile { position:relative; display:flex; flex-direction:column; gap:4px; padding:16px; border:1px solid var(--border); border-radius:12px; background:var(--card); text-decoration:none; color:var(--text); overflow:hidden; transition:transform .15s, box-shadow .15s; }
  .dash-tile:hover { transform:translateY(-2px); box-shadow:var(--shadow); }
  .dash-tile-icon { width:32px; height:32px; border-radius:9px; display:flex; align-items:center; justify-content:center; background:var(--surface-2); color:var(--text-muted); margin-bottom:4px; }
  .dash-tile-icon svg { width:18px; height:18px; }
  .dash-tile-count { font-size:26px; font-weight:900; letter-spacing:-1px; line-height:1; }
  .dash-tile-label { font-size:12px; font-weight:700; color:var(--text-muted); }
  .dash-tile-bar { position:absolute; left:0; bottom:0; height:3px; width:100%; background:var(--border-md); }
  .dash-tile.amber .dash-tile-bar { background:var(--warning); }
  .dash-tile.amber .dash-tile-icon { background:var(--warning-bg); color:var(--warning); }
  .dash-tile.red .dash-tile-bar { background:var(--danger); }
  .dash-tile.red .dash-tile-icon { background:var(--danger-bg); color:var(--danger); }
  .dash-tile.green .dash-tile-bar { background:var(--success); }
  .dash-tile.green .dash-tile-icon { background:var(--success-bg); color:var(--success); }

  .dash-2col { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .dash-alert-scroll { max-height:300px; overflow-y:auto; padding:6px; }
  .dash-alert { display:flex; align-items:center; gap:12px; padding:12px 14px; border-radius:10px; text-decoration:none; color:var(--text); border-bottom:1px solid var(--border); }
  .dash-alert:last-child { border-bottom:none; }
  .dash-alert:hover { background:var(--surface-2); }
  .dash-alert-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .dash-alert-dot.critical { background:var(--danger); box-shadow:0 0 0 4px rgba(239,68,68,.14); }
  .dash-alert-dot.warning { background:var(--warning); box-shadow:0 0 0 4px rgba(245,158,11,.14); }
  .dash-alert-dot.notice { background:var(--notice); box-shadow:0 0 0 4px rgba(139,92,246,.14); }
  .dash-alert-body { flex:1; min-width:0; display:flex; flex-direction:column; }
  .dash-alert-msg { font-size:13.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .dash-alert-meta { font-size:11.5px; color:var(--text-muted); }
  .dash-alert-cta { font-size:12px; font-weight:700; color:var(--primary); white-space:nowrap; flex-shrink:0; }
  .dash-tasks { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:10px; }
  .dash-task { display:flex; align-items:center; gap:10px; padding:11px 14px; border:1px solid var(--border); border-radius:10px; text-decoration:none; color:var(--text); background:var(--card); }
  .dash-task:hover { background:var(--surface-2); border-color:var(--primary); }
  .dash-task-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .dash-task-dot.red { background:var(--danger); } .dash-task-dot.amber { background:var(--warning); }
  .dash-task-dot.blue { background:var(--primary); } .dash-task-dot.slate { background:var(--text-light); }
  .dash-task-title { flex:1; min-width:0; font-size:13px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .dash-task-due { font-size:11px; color:var(--text-muted); white-space:nowrap; flex-shrink:0; }
  .dash-task-due.overdue { color:var(--danger); font-weight:700; }

  @media (max-width:1100px) {
    .dash-kpi-row { grid-template-columns:1fr 1fr; }
    .dash-tiles { grid-template-columns:repeat(2,1fr); }
    .dash-2col { grid-template-columns:1fr; }
  }
  @media (max-width:560px) {
    .dash-kpi-row { grid-template-columns:1fr; }
    .dash-gauge-card { justify-content:center; }
  }
</style>

<script>
function drawGauge(id, value) {
  const canvas = document.getElementById(id);
  if (!canvas || !window.Chart) return;
  const fill = value >= 85 ? '#10b981' : value >= 70 ? '#f59e0b' : '#ef4444';
  const track = document.documentElement.getAttribute('data-theme') === 'dark' ? 'rgba(255,255,255,.08)' : '#eef2f7';
  new Chart(canvas.getContext('2d'), {
    type: 'doughnut',
    data: { datasets: [{ data: [value, 100 - value], backgroundColor: [fill, track], borderWidth: 0, borderRadius: 6 }] },
    options: { cutout: '80%', rotation: -110, circumference: 220, responsive: false, events: [],
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      animation: { duration: 900, easing: 'easeInOutCubic' } }
  });
}

const scores = ${JSON.stringify(score)};
const chartData = ${JSON.stringify(chartData)};
const complianceTrend = ${JSON.stringify(complianceTrend)};

(function() {
  var el = document.getElementById('gaugeOverall');
  if (!el) return;
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(e) { if (e[0].isIntersecting) { drawGauge('gaugeOverall', scores.overall); obs.disconnect(); } }, { threshold: .1 });
    obs.observe(el);
  } else { drawGauge('gaugeOverall', scores.overall); }
})();

if (document.getElementById('complianceTrendChart') && complianceTrend.length >= 2) {
  new Chart(document.getElementById('complianceTrendChart'), {
    type: 'line',
    data: { labels: complianceTrend.map(d => d.label), datasets: [{
      label: 'Overall compliance', data: complianceTrend.map(d => d.value),
      borderColor: '#2563eb', backgroundColor: 'rgba(37,99,235,.10)', fill: true, tension: .35,
      pointRadius: 2, pointHoverRadius: 4, borderWidth: 2,
    }] },
    options: { maintainAspectRatio: false, plugins: { legend: { display: false } },
      scales: { x: { grid: { display: false } }, y: { min: 0, max: 100, ticks: { stepSize: 25, callback: v => v + '%' } } } }
  });
}

if (document.getElementById('operationsTrendChart')) {
  new Chart(document.getElementById('operationsTrendChart'), {
    type: 'bar',
    data: { labels: chartData.trend.map(i => i.label), datasets: [
      { type: 'bar', label: 'Checks', data: chartData.trend.map(i => i.checks), backgroundColor: '#2563eb', borderRadius: 6, maxBarThickness: 26 },
      { type: 'line', label: 'Defects', data: chartData.trend.map(i => i.defects), borderColor: '#ef4444', backgroundColor: 'rgba(239,68,68,.14)', tension: .35, fill: true, pointRadius: 2 },
      { type: 'line', label: 'Nil-defect', data: chartData.trend.map(i => i.nilDefects), borderColor: '#10b981', tension: .35, fill: false, pointRadius: 2 },
    ] },
    options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 14 } } },
