<%- include('../layouts/main', { body: `
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="/css/compliance-dashboard.css?v=${typeof assetVersion !== 'undefined' ? assetVersion : '1.0.0'}" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="fhq-dashboard-wrap">
  <!-- ── Dashboard Header ────────────────────────────────────────────── -->
  <div class="fhq-dash-header">
    <div class="fhq-dash-title">
      <h1>Dashboard</h1>
      <p>Welcome back, ${typeof user !== 'undefined' && user.name ? user.name : 'Transport Manager'}</p>
    </div>
    <div class="fhq-dash-actions">
      <div class="dropdown" style="position:relative; display:inline-block;">
        <button type="button" class="fhq-quick-actions-btn" id="quickActionsTrigger" onclick="toggleQuickActions()">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Quick Actions
          <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div id="quickActionsMenu" class="dropdown-menu" style="display:none; position:absolute; right:0; top:110%; background:#fff; border:1px solid #e2e8f0; border-radius:8px; box-shadow:0 10px 25px rgba(0,0,0,0.1); min-width:180px; z-index:1000; padding:6px 0;">
          <a href="/fleet/new" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:12px; color:#1e293b; text-decoration:none;"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg> Add Vehicle</a>
          <a href="/employees/new" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:12px; color:#1e293b; text-decoration:none;"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg> Add Employee</a>
          <a href="/checks/new" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:12px; color:#1e293b; text-decoration:none;"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Submit Check</a>
          <a href="/defects" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:12px; color:#1e293b; text-decoration:none;"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> Log Defect</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ── ROW 1: 4 Top KPI Cards ──────────────────────────────────────── -->
  <div class="fhq-kpi-grid">
    <!-- Card 1: DVSA Compliance -->
    <div class="fhq-card">
      <div class="fhq-card-head">
        <div class="fhq-card-head-title">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          DVSA Compliance
        </div>
      </div>
      <div class="fhq-gauge-card-body">
        <div class="fhq-gauge-wrap">
          <svg class="fhq-gauge-svg" viewBox="0 0 36 36">
            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e2e8f0" stroke-width="3.5" />
            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#10b981" stroke-width="3.5" stroke-dasharray="${complianceData.dvsaCompliance.percent}, 100" stroke-linecap="round" />
          </svg>
          <div class="fhq-gauge-text">
            <span class="fhq-gauge-val">${complianceData.dvsaCompliance.percent}%</span>
            <span class="fhq-gauge-sub">Compliant</span>
          </div>
        </div>
        <div class="fhq-legend-list">
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot green"></i> Compliant</span>
            <span class="fhq-legend-val">${complianceData.dvsaCompliance.compliant}</span>
          </div>
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot orange"></i> Expiring Soon</span>
            <span class="fhq-legend-val">${complianceData.dvsaCompliance.expiringSoon}</span>
          </div>
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot red"></i> Overdue</span>
            <span class="fhq-legend-val">${complianceData.dvsaCompliance.overdue}</span>
          </div>
        </div>
      </div>
      <a href="/fleet" class="fhq-card-foot-link">View DVSA Compliance <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
    </div>

    <!-- Card 2: Home Office Compliance -->
    <div class="fhq-card">
      <div class="fhq-card-head">
        <div class="fhq-card-head-title">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Home Office Compliance
        </div>
      </div>
      <div class="fhq-gauge-card-body">
        <div class="fhq-gauge-wrap">
          <svg class="fhq-gauge-svg" viewBox="0 0 36 36">
            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e2e8f0" stroke-width="3.5" />
            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#10b981" stroke-width="3.5" stroke-dasharray="${complianceData.homeOfficeCompliance.percent}, 100" stroke-linecap="round" />
          </svg>
          <div class="fhq-gauge-text">
            <span class="fhq-gauge-val">${complianceData.homeOfficeCompliance.percent}%</span>
            <span class="fhq-gauge-sub">Compliant</span>
          </div>
        </div>
        <div class="fhq-legend-list">
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot green"></i> Compliant</span>
            <span class="fhq-legend-val">${complianceData.homeOfficeCompliance.compliant}</span>
          </div>
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot orange"></i> Expiring Soon</span>
            <span class="fhq-legend-val">${complianceData.homeOfficeCompliance.expiringSoon}</span>
          </div>
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot blue"></i> Overdue</span>
            <span class="fhq-legend-val">${complianceData.homeOfficeCompliance.overdue}</span>
          </div>
        </div>
      </div>
      <a href="/sponsored-workers" class="fhq-card-foot-link">View Home Office Compliance <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
    </div>

    <!-- Card 3: Fleet Vehicles -->
    <div class="fhq-card">
      <div class="fhq-card-head">
        <div class="fhq-card-head-title">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17a2 2 0 11-4 0 2 2 0 014 0zM20 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10m10 0H9m4 0h3m0 0V9h3l3 4v3"/></svg>
          Fleet Vehicles
        </div>
      </div>
      <div class="fhq-vehicle-kpi-body">
        <div class="fhq-vehicle-kpi-left">
          <div>
            <div class="fhq-vehicle-big-count">${complianceData.fleetVehicles.total}</div>
            <div class="fhq-vehicle-sublabel">Total Trucks</div>
          </div>
          <div class="fhq-legend-list" style="margin-top:4px;">
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot green"></i> In Use</span>
              <span class="fhq-legend-val">${complianceData.fleetVehicles.inUse}</span>
            </div>
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot red"></i> Off Road</span>
              <span class="fhq-legend-val">${complianceData.fleetVehicles.offRoad}</span>
            </div>
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot slate"></i> In Service</span>
              <span class="fhq-legend-val">${complianceData.fleetVehicles.inService}</span>
            </div>
          </div>
        </div>
        <img class="fhq-vehicle-visual" src="/img/card-truck.png" alt="Truck" onerror="this.style.display='none'">
      </div>
      <a href="/fleet" class="fhq-card-foot-link">View Fleet <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
    </div>

    <!-- Card 4: Trailers -->
    <div class="fhq-card">
      <div class="fhq-card-head">
        <div class="fhq-card-head-title">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          Trailers
        </div>
      </div>
      <div class="fhq-vehicle-kpi-body">
        <div class="fhq-vehicle-kpi-left">
          <div>
            <div class="fhq-vehicle-big-count">${complianceData.trailers.total}</div>
            <div class="fhq-vehicle-sublabel">Total Trailers</div>
          </div>
          <div class="fhq-legend-list" style="margin-top:4px;">
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot green"></i> In Use</span>
              <span class="fhq-legend-val">${complianceData.trailers.inUse}</span>
            </div>
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot red"></i> Off Road</span>
              <span class="fhq-legend-val">${complianceData.trailers.offRoad}</span>
            </div>
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot slate"></i> In Service</span>
              <span class="fhq-legend-val">${complianceData.trailers.inService}</span>
            </div>
          </div>
        </div>
        <img class="fhq-vehicle-visual" src="/img/card-trailer.png" alt="Trailer" onerror="this.style.display='none'">
      </div>
      <a href="/trailers" class="fhq-card-foot-link">View Trailers <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
    </div>
  </div>

  <!-- ── ROW 2: LIVE MAP & KEY DATES / ACTIVITIES ────────────────────── -->
  <div class="fhq-row2-grid">
    <!-- Left: Live Vehicle Tracking Map -->
    <div class="fhq-card fhq-map-card">
      <div class="fhq-card-head">
        <div class="fhq-card-head-title">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Live Vehicle Tracking
        </div>
        <select id="mapFilterSelect" onchange="filterMapMarkers(this.value)" style="font-size:12px; font-weight:600; padding:4px 8px; border-radius:6px; border:1px solid #cbd5e1; background:#f8fafc; color:#334155; cursor:pointer;">
          <option value="all">All Vehicles (${complianceData.trackingVehicles.length})</option>
          <option value="in_use">In Use</option>
          <option value="off_road">Off Road</option>
          <option value="in_service">In Service</option>
        </select>
      </div>

      <div id="liveTrackingMap" class="fhq-map-container"></div>

      <div style="margin-top:12px; display:flex; justify-content:space-between; align-items:center;">
        <a href="/fleet" class="fhq-card-link">View All Tracking <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
        <span style="font-size:11px; color:#64748b;">Live telematics feed updated just now</span>
      </div>
    </div>

    <!-- Right Column: Key Dates + Split Activity/Alerts -->
    <div class="fhq-right-col">
      <!-- Top Right: Key Dates -->
      <div class="fhq-card" style="flex:1;">
        <div class="fhq-card-head">
          <div class="fhq-card-head-title">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Key Dates (Next 30 Days)
          </div>
          <a href="/fleet" class="fhq-card-link">View All</a>
        </div>
        <div class="fhq-key-dates-list">
          ${complianceData.keyDates.map(kd => `
            <div class="fhq-key-date-row">
              <div class="fhq-key-date-left">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>${kd.label}</span>
              </div>
              <div class="fhq-key-date-right">
                <span class="fhq-key-date-val">${kd.date}</span>
                <span class="fhq-pill ${kd.tone}">${kd.days}</span>
              </div>
            </div>
          `).join('')}
        </div>
      </div>

      <!-- Bottom Right: Split Activity & Alerts -->
      <div class="fhq-split-subgrid">
        <!-- Recent Activity -->
        <div class="fhq-card">
          <div class="fhq-card-head">
            <div class="fhq-card-head-title" style="font-size:13px;">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Recent Activity
            </div>
            <a href="/audit-evidence" class="fhq-card-link">View All</a>
          </div>
          <div class="fhq-activity-list">
            ${complianceData.recentActivity.map(act => `
              <div class="fhq-activity-item">
                <span class="fhq-act-icon ${act.tone}">
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                </span>
                <div class="fhq-act-text">
                  <div>${act.title}</div>
                  <span class="fhq-act-time">${act.time}</span>
                </div>
              </div>
            `).join('')}
          </div>
        </div>

        <!-- Alerts & Outstanding Actions -->
        <div class="fhq-card">
          <div class="fhq-card-head">
            <div class="fhq-card-head-title" style="font-size:13px;">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              Alerts &amp; Actions
            </div>
            <a href="/alerts" class="fhq-card-link">View All</a>
          </div>
          <div class="fhq-actions-list">
            ${complianceData.alertsAndActions.map(act => `
              <a href="${act.href}" class="fhq-action-item">
                <span class="fhq-count-badge ${act.tone}">${act.count}</span>
                <span style="flex:1;">${act.label}</span>
                <svg width="12" height="12" fill="none" stroke="#94a3b8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            `).join('')}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── ROW 3: DETAILED STATUS TABLES ──────────────────────────────── -->
  <div class="fhq-row3-grid">
    <!-- Col 1: Vehicle Status Table -->
    <div class="fhq-card">
      <div class="fhq-card-head">
        <div class="fhq-card-head-title">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17a2 2 0 11-4 0 2 2 0 014 0zM20 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10m10 0H9m4 0h3m0 0V9h3l3 4v3"/></svg>
          Vehicle Status
        </div>
        <a href="/fleet" class="fhq-card-link">View All</a>
      </div>
      <div class="fhq-tabs">
        <button type="button" class="fhq-tab-btn active" onclick="filterVehicleTable('all', this)">All</button>
        <button type="button" class="fhq-tab-btn" onclick="filterVehicleTable('In Use', this)">In Use (${complianceData.fleetVehicles.inUse})</button>
        <button type="button" class="fhq-tab-btn" onclick="filterVehicleTable('Off Road', this)">Off Road (${complianceData.fleetVehicles.offRoad})</button>
        <button type="button" class="fhq-tab-btn" onclick="filterVehicleTable('In Service', this)">In Service (${complianceData.fleetVehicles.inService})</button>
      </div>
      <div style="overflow-x:auto;">
        <table class="fhq-table" id="vehicleStatusTable">
          <thead>
            <tr>
              <th>Reg</th>
              <th>Fleet ID</th>
              <th>Driver</th>
              <th>Status</th>
              <th>Location</th>
            </tr>
          </thead>
          <tbody>
            ${complianceData.vehicleStatusList.map(v => `
              <tr data-status="${v.status}">
                <td><span class="fhq-reg-badge">${v.reg}</span></td>
                <td><span style="color:#64748b; font-size:11px; font-weight:600;">${v.fleetId}</span></td>
                <td>${v.driver}</td>
                <td><span class="fhq-pill ${v.statusTone === 'green' ? 'green' : v.statusTone === 'red' ? 'red' : 'blue'}">${v.status}</span></td>
                <td><span style="font-size:11px; color:#475569;">${v.location}</span></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Col 2: Employee Availability Table -->
    <div class="fhq-card">
      <div class="fhq-card-head">
        <div class="fhq-card-head-title">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Employee Availability
        </div>
        <a href="/employees" class="fhq-card-link">View All</a>
      </div>
      <div class="fhq-tabs">
        <button type="button" class="fhq-tab-btn active" onclick="filterEmpTable('all', this)">All</button>
        <button type="button" class="fhq-tab-btn" onclick="filterEmpTable('Available', this)">Available</button>
        <button type="button" class="fhq-tab-btn" onclick="filterEmpTable('On Holiday', this)">On Holiday</button>
        <button type="button" class="fhq-tab-btn" onclick="filterEmpTable('Sick / Absent', this)">Sick / Absent</button>
        <button type="button" class="fhq-tab-btn" onclick="filterEmpTable('Pending RTW', this)">Pending RTW</button>
      </div>
      <div style="overflow-x:auto;">
        <table class="fhq-table" id="employeeStatusTable">
          <thead>
            <tr>
              <th>Name</th>
              <th>Role</th>
              <th>Status</th>
              <th>Next Shift</th>
            </tr>
          </thead>
          <tbody>
            ${complianceData.employeeAvailabilityList.map(e => `
              <tr data-status="${e.status}">
                <td>
                  <div class="fhq-user-cell">
                    <span class="fhq-avatar-sm">${e.name ? e.name.charAt(0) : 'E'}</span>
                    <span style="font-weight:600;">${e.name}</span>
                  </div>
                </td>
                <td><span style="color:#64748b; font-size:11px;">${e.role}</span></td>
                <td><span class="fhq-pill ${e.statusTone === 'green' ? 'green' : e.statusTone === 'orange' ? 'orange' : 'amber'}">${e.status}</span></td>
                <td><span style="font-size:11px; font-weight:600; color:#334155;">${e.nextShift}</span></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Col 3: Fleet Availability Gauge -->
