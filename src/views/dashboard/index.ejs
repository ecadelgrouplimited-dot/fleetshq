<script>
function gaugeColors(scoreValue) {
  if (scoreValue >= 85) return { fill: '#10b981', track: '#d1fae5' };
  if (scoreValue >= 70) return { fill: '#f59e0b', track: '#fef3c7' };
  return { fill: '#ef4444', track: '#fee2e2' };
}

function drawGauge(id, value, trackColor, fillColor) {
  const canvas = document.getElementById(id);
  if (!canvas) return;
  new Chart(canvas.getContext('2d'), {
    type: 'doughnut',
    data: {
      datasets: [{
        data: [value, 100 - value],
        backgroundColor: [fillColor, trackColor],
        borderWidth: 0,
        borderRadius: 6,
      }]
    },
    options: {
      cutout: '82%',
      rotation: -110,
      circumference: 220,
      responsive: false,
      events: [],
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      animation: { duration: 1000, easing: 'easeInOutCubic' },
    }
  });
}

