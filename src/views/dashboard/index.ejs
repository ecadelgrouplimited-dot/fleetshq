<%- include('../layouts/main', { body: `
<link rel="stylesheet" href="/css/compliance-dashboard.css?v=20261030v5" />

<style>
  /* Inlined to bypass 30-day static CSS cache in server.js */
  .fhq-dashboard-wrap {
    background: #f4f7fb;
    min-height: calc(100vh - 64px);
    padding: 16px 22px 36px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #1e3a8a;
  }
  .fhq-dash-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }
  .fhq-dash-title h1 {
    font-size: 26px;
    font-weight: 800;
    color: #1e3a8a;
    margin: 0 0 2px 0;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .fhq-dash-title p {
    font-size: 13.5px;
    color: #1d4ed8;
    margin: 0;
    font-weight: 400;
  }
  .fhq-quick-actions-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1d4ed8;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 7px;
    border: 1px solid #1d4ed8;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(29, 78, 216, 0.25);
    text-decoration: none;
  }
  .fhq-quick-actions-btn:hover { background: #1e40af; }
  .fhq-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    padding: 13px 15px;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .fhq-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .fhq-card-head-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: #1e3a8a;
  }
  .fhq-card-link {
    font-size: 11.5px;
    font-weight: 600;
    color: #1d4ed8;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .fhq-card-link:hover { text-decoration: underline; }
  .fhq-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 12px;
  }
  .fhq-kpi-icon-box {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .fhq-kpi-icon-box.green { background: #dcfce7; color: #16a34a; }
  .fhq-kpi-icon-box.blue { background: #dbeafe; color: #1d4ed8; }
  .fhq-gauge-card-body {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
  }
  .fhq-gauge-wrap {
    position: relative;
    width: 102px;
    height: 102px;
    flex-shrink: 0;
  }
  .fhq-gauge-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .fhq-gauge-val {
    font-size: 21px;
    font-weight: 800;
    color: #1e3a8a;
    line-height: 1.05;
  }
  .fhq-gauge-sub {
    font-size: 10px;
    font-weight: 600;
    color: #1d4ed8;
    margin-top: 1px;
  }
  .fhq-legend-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .fhq-legend-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    color: #1e3a8a;
    font-weight: 500;
  }
  .fhq-legend-label {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .fhq-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .fhq-dot.green { background: #16a34a; }
  .fhq-dot.orange { background: #f59e0b; }
  .fhq-dot.red { background: #dc2626; }
  .fhq-dot.blue { background: #2563eb; }
  .fhq-dot.slate { background: #94a3b8; }
  .fhq-legend-val {
    font-weight: 700;
    color: #1e3a8a;
  }
  .fhq-row2-3col {
    display: grid;
    grid-template-columns: 1.86fr 1.07fr 1.07fr;
    gap: 12px;
    margin-bottom: 12px;
    align-items: stretch;
  }
  .fhq-stack-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fhq-row3-3col {
    display: grid;
    grid-template-columns: 1.05fr 1.08fr 1.15fr;
    gap: 12px;
    margin-bottom: 12px;
  }
  .fhq-row4-3col {
    display: grid;
    grid-template-columns: 1.05fr 1.08fr 1.15fr;
    gap: 12px;
  }
  .fhq-tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
    overflow-x: auto;
  }
  .fhq-tab-btn {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    padding: 4px 11px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    color: #1e3a8a;
    cursor: pointer;
    white-space: nowrap;
  }
  .fhq-tab-btn.active-blue {
    background: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
  }
  .fhq-tab-btn.active-green {
    background: #15803d;
    border-color: #15803d;
    color: #ffffff;
  }
  .fhq-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11.5px;
  }
  .fhq-table th {
    text-align: left;
    font-size: 11px;
    font-weight: 700;
    color: #1e3a8a;
    padding: 5px 6px;
    border-bottom: 1px solid #e2e8f0;
    white-space: nowrap;
  }
  .fhq-table td {
    padding: 5.5px 6px;
    border-bottom: 1px solid #f1f5f9;
    color: #1e3a8a;
    vertical-align: middle;
    white-space: nowrap;
  }
  .fhq-table tr:last-child td { border-bottom: none; }
  .fhq-pill {
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 58px;
    text-align: center;
  }
  .fhq-pill.green { background: #dcfce7; color: #15803d; }
  .fhq-pill.orange { background: #fef3c7; color: #b45309; }
  .fhq-pill.red { background: #fee2e2; color: #b91c1c; }
  .fhq-pill.blue { background: #dbeafe; color: #1d4ed8; }
  .fhq-avatar-img {
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    max-width: 24px !important;
    min-height: 24px !important;
    max-height: 24px !important;
    border-radius: 50% !important;
    object-fit: cover !important;
    border: 1px solid #cbd5e1;
    flex-shrink: 0;
  }
</style>

<div class="fhq-dashboard-wrap">

  <!-- ── Dashboard Header ────────────────────────────────────────────── -->
  <div class="fhq-dash-header">
    <div class="fhq-dash-title">
      <h1>Dashboard</h1>
      <p>Welcome back, Transport Manager</p>
    </div>
    <div class="fhq-dash-actions">
      <div class="dropdown" style="position:relative; display:inline-block;">
        <button type="button" class="fhq-quick-actions-btn" id="quickActionsTrigger" onclick="toggleQuickActions()">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M16 2v4M8 2v4M3 10h18M12 13v5M9.5 15.5h5"/></svg>
          Quick Actions
          <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div id="quickActionsMenu" class="dropdown-menu" style="display:none; position:absolute; right:0; top:110%; background:#fff; border:1px solid #e2e8f0; border-radius:8px; box-shadow:0 10px 25px rgba(0,0,0,0.1); min-width:190px; z-index:1000; padding:6px 0;">
          <a href="/fleet/new" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:12px; color:#1e3a8a; font-weight:600; text-decoration:none;">+ Add Vehicle</a>
          <a href="/employees/new" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:12px; color:#1e3a8a; font-weight:600; text-decoration:none;">+ Add Employee</a>
          <a href="/training" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:12px; color:#1e3a8a; font-weight:600; text-decoration:none;">+ Record Training</a>
          <a href="/defects" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:12px; color:#1e3a8a; font-weight:600; text-decoration:none;">+ Log Defect</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════ -->
  <!-- ROW 1: 4 TOP KPI CARDS                                             -->
  <!-- ══════════════════════════════════════════════════════════════════ -->
  <div class="fhq-kpi-grid">

    <!-- Card 1: DVSA Compliance -->
    <div class="fhq-card">
      <div class="fhq-card-head" style="margin-bottom:8px;">
        <div class="fhq-card-head-title">
          <span class="fhq-kpi-icon-box green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
          </span>
          DVSA Compliance
        </div>
      </div>
      <div class="fhq-gauge-card-body">
        <div class="fhq-gauge-wrap">
          <svg width="102" height="102" viewBox="0 0 36 36">
            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#cbd5e1" stroke-width="4" />
            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#16a34a" stroke-width="4" stroke-dasharray="90 10" stroke-dashoffset="18" stroke-linecap="round" />
          </svg>
          <div class="fhq-gauge-text">
            <span class="fhq-gauge-val">92%</span>
            <span class="fhq-gauge-sub">Compliant</span>
          </div>
        </div>
        <div style="flex:1;display:flex;flex-direction:column;justify-content:space-between;height:100%;">
          <div class="fhq-legend-list">
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot green"></i> Compliant</span>
              <span class="fhq-legend-val" style="color:#15803d;">18</span>
            </div>
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot orange"></i> Expiring Soon</span>
              <span class="fhq-legend-val" style="color:#ea580c;">3</span>
            </div>
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot red"></i> Overdue</span>
              <span class="fhq-legend-val" style="color:#dc2626;">2</span>
            </div>
          </div>
          <div style="text-align:right;margin-top:8px;">
            <a href="/fleet" class="fhq-card-link">View DVSA Compliance →</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Home Office Compliance -->
    <div class="fhq-card">
      <div class="fhq-card-head" style="margin-bottom:8px;">
        <div class="fhq-card-head-title">
          <span class="fhq-kpi-icon-box blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
          </span>
          Home Office Compliance
        </div>
      </div>
      <div class="fhq-gauge-card-body">
        <div class="fhq-gauge-wrap">
          <svg width="102" height="102" viewBox="0 0 36 36">
            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#cbd5e1" stroke-width="4" />
            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#16a34a" stroke-width="4" stroke-dasharray="93 7" stroke-dashoffset="18" stroke-linecap="round" />
          </svg>
          <div class="fhq-gauge-text">
            <span class="fhq-gauge-val">96%</span>
            <span class="fhq-gauge-sub">Compliant</span>
          </div>
        </div>
        <div style="flex:1;display:flex;flex-direction:column;justify-content:space-between;height:100%;">
          <div class="fhq-legend-list">
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot green"></i> Compliant</span>
              <span class="fhq-legend-val" style="color:#15803d;">11</span>
            </div>
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot orange"></i> Expiring Soon</span>
              <span class="fhq-legend-val" style="color:#ea580c;">1</span>
            </div>
            <div class="fhq-legend-item">
              <span class="fhq-legend-label"><i class="fhq-dot red"></i> Overdue</span>
              <span class="fhq-legend-val" style="color:#1e3a8a;">0</span>
            </div>
          </div>
          <div style="text-align:right;margin-top:8px;">
            <a href="/sponsored-workers" class="fhq-card-link">View Home Office Compliance →</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 3: Fleet Vehicles -->
    <div class="fhq-card">
      <div class="fhq-card-head" style="margin-bottom:8px;">
        <div class="fhq-card-head-title">
          <span class="fhq-kpi-icon-box blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
          </span>
          Fleet Vehicles
        </div>
      </div>
      <div style="display:grid;grid-template-columns:80px 1fr 78px;align-items:center;gap:10px;flex:1;">
        <div style="text-align:center;">
          <div style="font-size:28px;font-weight:800;color:#1e3a8a;line-height:1;">10</div>
          <div style="font-size:12px;color:#1e3a8a;font-weight:500;margin-top:4px;">Total Trucks</div>
        </div>
        <div class="fhq-legend-list">
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot green"></i> In Use</span>
            <span class="fhq-legend-val" style="color:#15803d;">9</span>
          </div>
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot red"></i> Off Road</span>
            <span class="fhq-legend-val" style="color:#dc2626;">1</span>
          </div>
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot slate"></i> In Service</span>
            <span class="fhq-legend-val" style="color:#1e3a8a;">0</span>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;">
          <img src="/img/card-truck.png?v=5" alt="Truck" style="width:72px;height:78px;object-fit:contain;">
          <a href="/fleet" class="fhq-card-link" style="margin-top:4px;white-space:nowrap;">View Fleet →</a>
        </div>
      </div>
    </div>

    <!-- Card 4: Trailers -->
    <div class="fhq-card">
      <div class="fhq-card-head" style="margin-bottom:8px;">
        <div class="fhq-card-head-title">
          <span class="fhq-kpi-icon-box blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"/></svg>
          </span>
          Trailers
        </div>
      </div>
      <div style="display:grid;grid-template-columns:80px 1fr 78px;align-items:center;gap:10px;flex:1;">
        <div style="text-align:center;">
          <div style="font-size:28px;font-weight:800;color:#1e3a8a;line-height:1;">6</div>
          <div style="font-size:12px;color:#1e3a8a;font-weight:500;margin-top:4px;">Total Trailers</div>
        </div>
        <div class="fhq-legend-list">
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot green"></i> In Use</span>
            <span class="fhq-legend-val" style="color:#15803d;">5</span>
          </div>
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot red"></i> Off Road</span>
            <span class="fhq-legend-val" style="color:#dc2626;">0</span>
          </div>
          <div class="fhq-legend-item">
            <span class="fhq-legend-label"><i class="fhq-dot slate"></i> In Service</span>
            <span class="fhq-legend-val" style="color:#1d4ed8;">1</span>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;">
          <img src="/img/card-trailer.png?v=5" alt="Trailer" style="width:72px;height:78px;object-fit:contain;">
          <a href="/trailers" class="fhq-card-link" style="margin-top:4px;white-space:nowrap;">View Trailers →</a>
        </div>
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════════════════════════════════ -->
  <!-- ROW 2: LIVE MAP | KEY DATES + ACTIVITY | ALERTS + AVAILABILITY      -->
  <!-- ══════════════════════════════════════════════════════════════════ -->
  <div class="fhq-row2-3col">

    <!-- Col 1: Live Vehicle Tracking -->
    <div class="fhq-card" style="padding:12px 14px;">
      <div class="fhq-card-head" style="margin-bottom:8px;">
        <div class="fhq-card-head-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#1d4ed8"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          Live Vehicle Tracking
        </div>
        <select style="font-size:11.5px; font-weight:600; padding:4px 10px; border-radius:6px; border:1px solid #cbd5e1; background:#ffffff; color:#1e3a8a; cursor:pointer;">
          <option value="all">All Vehicles (10)</option>
          <option value="in_use">In Use (9)</option>
          <option value="off_road">Off Road (1)</option>
        </select>
      </div>
      <div style="position:relative;flex:1;min-height:345px;border-radius:8px;overflow:hidden;border:1px solid #e2e8f0;">
        <img src="/img/uk-tracking-map.png?v=5" alt="Live UK Vehicle Tracking Map" style="width:100%;height:100%;object-fit:cover;display:block;">
        <a href="/fleet" title="View All Tracking" style="position:absolute;left:1.5%;bottom:2%;width:38%;height:11%;display:block;border-radius:6px;"></a>
      </div>
    </div>

    <!-- Col 2: Key Dates (Next 30 Days) + Recent Activity -->
    <div class="fhq-stack-col">

      <!-- Key Dates (Next 30 Days) -->
      <div class="fhq-card" style="padding:12px 14px;">
        <div class="fhq-card-head" style="margin-bottom:8px;">
          <div class="fhq-card-head-title">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="#1d4ed8"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
            Key Dates <span style="font-weight:400;color:#1d4ed8;">(Next 30 Days)</span>
          </div>
          <a href="/fleet" class="fhq-card-link">View All</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:5px;font-size:11.5px;">
          ${[
            { label: 'MOT Expiry', date: '12 Sep 2025', days: '115 days', tone: 'green', color: '#16a34a' },
            { label: 'Tax Expiry', date: '31 May 2026', days: '381 days', tone: 'green', color: '#16a34a' },
            { label: 'Insurance Expiry', date: '30 Jun 2025', days: '30 days', tone: 'orange', color: '#1d4ed8' },
