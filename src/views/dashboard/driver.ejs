  .vehicle-meta { display:flex; flex-direction:column; align-items:flex-end; gap:8px; color:var(--text-muted); font-size:12px; font-weight:700; }
  .vehicle-compliance-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:12px; margin-top:14px; }
  .vehicle-compliance-card { border:1px solid var(--border); border-radius:8px; padding:12px 14px; background:#fff; }
  .vehicle-compliance-card.green { background:#f0fdf4; border-color:#bbf7d0; }
  .vehicle-compliance-card.amber { background:#fffbeb; border-color:#fde68a; }
  .vehicle-compliance-card.red { background:#fef2f2; border-color:#fecaca; }
  .vehicle-compliance-top { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .vehicle-compliance-top span { font-size:12px; font-weight:800; color:var(--text-muted); text-transform:uppercase; }
  .vehicle-compliance-top strong { font-size:14px; font-weight:800; color:var(--text); text-align:right; }
  .vehicle-compliance-helper { margin-top:6px; font-size:12px; color:var(--text-muted); }
  .training-progress-bar { height:14px; background:#e2e8f0; border-radius:999px; overflow:hidden; }
  .training-progress-fill { height:100%; background:linear-gradient(90deg, #2563eb 0%, #60a5fa 100%); border-radius:999px; }
  .training-breakdown { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:12px; margin-top:16px; }
  .training-chip { border:1px solid var(--border); border-radius:8px; padding:14px 12px; text-align:center; background:#fff; }
  .training-chip strong { display:block; font-size:24px; font-weight:900; }
  .training-chip span { display:block; font-size:12px; color:var(--text-muted); margin-top:6px; }
  .training-chip.completed { background:#f0fdf4; border-color:#bbf7d0; }
  .training-chip.progress { background:#eff6ff; border-color:#bfdbfe; }
  .training-chip.expired { background:#fef2f2; border-color:#fecaca; }
  .training-chip.pending { background:#f8fafc; }
  .dashboard-talks { display:flex; flex-direction:column; gap:10px; }
  .dashboard-talk-card { display:flex; justify-content:space-between; align-items:center; gap:14px; border:1px solid var(--border); border-radius:8px; padding:14px 16px; }
  .dashboard-talk-card.signed { background:#f8fafc; }
  .dashboard-talk-topic { font-size:15px; font-weight:800; color:var(--text); }
  .dashboard-talk-meta { font-size:12px; color:var(--text-muted); margin-top:4px; line-height:1.5; }
  .alert-item { display:block; border:1px solid var(--border); border-left-width:4px; border-radius:8px; padding:12px 14px; margin-bottom:10px; background:#fff; color:var(--text); text-decoration:none; }
  .alert-item:hover { border-color:var(--primary); background:#eff6ff; }
  .alert-item.critical { border-left-color:#ef4444; }
  .alert-item.warning { border-left-color:#f59e0b; }
  .alert-item.notice { border-left-color:#3b82f6; }
  .alert-main { font-weight:700; margin-bottom:3px; }
  .alert-sub { color:var(--text-muted); font-size:13px; line-height:1.5; }
  .alert-preview { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
  .alert-preview span { border:1px solid var(--border); border-radius:999px; background:#f8fafc; color:var(--text-muted); font-size:11px; font-weight:700; padding:4px 10px; }
  .alert-link { margin-top:10px; font-size:12px; font-weight:800; color:var(--primary); }
  .table-link { font-weight:800; color:var(--primary); text-decoration:none; }
  @media (max-width: 1200px) {
    .driver-stat-grid { grid-template-columns:repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .driver-hero, .driver-stat-grid, .status-grid, .vehicle-compliance-grid, .training-breakdown { grid-template-columns:1fr; }
    .vehicle-summary, .dashboard-talk-card { flex-direction:column; align-items:flex-start; }
    .vehicle-meta { align-items:flex-start; }
    .week-strip { grid-template-columns:repeat(4, minmax(0, 1fr)); }
  }
</style>

<script>
async function signToolboxTalk(id, button) {
  const original = button.textContent;
  button.disabled = true;
  button.textContent = 'Signing...';
  try {
    const res = await fetch('/api/v1/toolbox-talks/' + id + '/sign', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ signatureData: 'signed-via-driver-dashboard' }),
    });
    if (!res.ok) throw new Error('Unable to sign toolbox talk');
    showToast('Toolbox talk signed successfully', 'success');
    setTimeout(() => window.location.reload(), 500);
  } catch (error) {
    button.disabled = false;
    button.textContent = original;
    showToast(error.message || 'Unable to sign toolbox talk', 'error');
  }
}
</script>
` }) %>
