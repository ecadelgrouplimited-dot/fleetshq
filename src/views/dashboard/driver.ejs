  .week-day strong { display:block; font-size:13px; margin-top:6px; }
  .week-day.ok { background:#f0fdf4; border-color:#bbf7d0; }
  .week-day.warn { background:#fffbeb; border-color:#fde68a; }
  .week-day.miss { background:#fef2f2; border-color:#fecaca; }
  .vehicle-summary { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:14px 16px; border:1px solid var(--border); border-radius:8px; background:#f8fafc; }
  .vehicle-registration { font-size:28px; font-weight:900; letter-spacing:0; }
