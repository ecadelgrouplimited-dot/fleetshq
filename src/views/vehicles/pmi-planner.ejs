<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <a href="/fleet" class="btn btn-ghost btn-sm">← Back to Fleet</a>
</div>

${vehicles.filter(v => v.pmiDays !== null && v.pmiDays < 0).length > 0 ? `
<div class="card mb-4" style="border-left:4px solid #ef4444">
  <div class="card-header" style="background:#fef2f2">
    <h3 style="color:#dc2626">⚠ PMI Overdue — ${vehicles.filter(v => v.pmiDays !== null && v.pmiDays < 0).length} Vehicle${vehicles.filter(v => v.pmiDays !== null && v.pmiDays < 0).length !== 1 ? 's' : ''}</h3>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Registration</th><th>Make/Model</th><th>Driver</th><th>Last PMI</th><th>Next PMI</th><th>Days Overdue</th></tr></thead>
      <tbody>
        ${vehicles.filter(v => v.pmiDays !== null && v.pmiDays < 0).map(v => `
          <tr>
            <td><a href="/fleet/${v.id}" style="font-weight:700">${v.registration}</a></td>
            <td>${v.make} ${v.model}</td>
            <td>${v.assignedDriver?.fullName || '—'}</td>
            <td>${formatDate(v.lastPmiDate)}</td>
            <td style="color:#dc2626;font-weight:700">${formatDate(v.nextPmiDate)}</td>
            <td><span class="badge badge-red">${Math.abs(v.pmiDays)} days overdue</span></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>
</div>
` : ''}

${vehicles.filter(v => v.pmiDays !== null && v.pmiDays >= 0 && v.pmiDays <= 14).length > 0 ? `
<div class="card mb-4" style="border-left:4px solid #f59e0b">
  <div class="card-header" style="background:#fffbeb">
    <h3 style="color:#d97706">PMI Due Soon — ${vehicles.filter(v => v.pmiDays !== null && v.pmiDays >= 0 && v.pmiDays <= 14).length} Vehicle${vehicles.filter(v => v.pmiDays !== null && v.pmiDays >= 0 && v.pmiDays <= 14).length !== 1 ? 's' : ''}</h3>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Registration</th><th>Make/Model</th><th>Driver</th><th>Last PMI</th><th>Next PMI</th><th>Days Until</th></tr></thead>
      <tbody>
        ${vehicles.filter(v => v.pmiDays !== null && v.pmiDays >= 0 && v.pmiDays <= 14).map(v => `
          <tr>
            <td><a href="/fleet/${v.id}" style="font-weight:700">${v.registration}</a></td>
            <td>${v.make} ${v.model}</td>
            <td>${v.assignedDriver?.fullName || '—'}</td>
            <td>${formatDate(v.lastPmiDate)}</td>
            <td>${formatDate(v.nextPmiDate)}</td>
            <td><span class="badge badge-amber">${v.pmiDays === 0 ? 'Today' : v.pmiDays + ' days'}</span></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>
</div>
` : ''}

<div class="card">
  <div class="card-header"><h3>Full PMI Schedule</h3></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Registration</th><th>Make/Model</th><th>Driver</th><th>PMI Interval</th><th>Last PMI</th><th>Next PMI</th><th>Status</th></tr></thead>
      <tbody>
        ${vehicles.map(v => {
          const badge = !v.nextPmiDate ? 'badge-slate' : v.pmiDays < 0 ? 'badge-red' : v.pmiDays <= 14 ? 'badge-amber' : 'badge-green';
          const status = !v.nextPmiDate ? 'No date set' : v.pmiDays < 0 ? 'OVERDUE' : v.pmiDays <= 14 ? 'Due soon' : 'On schedule';
          return `<tr>
            <td><a href="/fleet/${v.id}" style="font-weight:700">${v.registration}</a></td>
            <td>${v.make} ${v.model}</td>
            <td>${v.assignedDriver?.fullName || '—'}</td>
            <td>Every ${v.pmiIntervalWeeks} weeks</td>
            <td>${formatDate(v.lastPmiDate)}</td>
            <td>${formatDate(v.nextPmiDate)}</td>
            <td><span class="badge ${badge}">${status}</span></td>
          </tr>`;
        }).join('')}
      </tbody>
    </table>
  </div>
</div>
` }) %>
