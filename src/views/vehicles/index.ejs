<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <p class="text-sm text-muted"><span id="visibleVehicleCount">${vehicles.length}</span> of ${vehicles.length} vehicles in fleet</p>
  <div class="flex gap-2">
    <a href="/fleet/pmi-planner" class="btn btn-outline btn-sm">PMI Planner</a>
    <a href="/vor" class="btn btn-ghost btn-sm">VOR Records</a>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body" style="padding:14px 20px">
    <form method="GET" action="/fleet" class="filter-form">
    <div class="filter-search">
      <label class="form-label">Search fleet</label>
      <input class="form-control" data-live-search="#vehiclesTableBody" data-live-count="#visibleVehicleCount" data-live-empty="#noVehiclesFound" placeholder="Registration, make, model, driver, status...">
    </div>
    <div>
      <label class="form-label">Status</label>
      <select class="form-control" name="status">
        <option value="" ${!filters?.status ? 'selected' : ''}>All active fleet</option>
        ${[['active','Active'],['vor','VOR'],['awaiting_repair','Awaiting Repair'],['hired','Hired'],['sold','Sold']].map(([v,l]) => `<option value="${v}" ${filters?.status === v ? 'selected' : ''}>${l}</option>`).join('')}
      </select>
    </div>
    <div>
      <label class="form-label">Compliance</label>
      <select class="form-control" name="due">
        <option value="" ${!filters?.due ? 'selected' : ''}>All compliance states</option>
        ${[['pmi_overdue','PMI overdue'],['pmi_due_14','PMI due in 14 days'],['mot_due_30','MOT due in 30 days'],['open_defects','Open defects'],['unassigned','Unassigned vehicles']].map(([v,l]) => `<option value="${v}" ${filters?.due === v ? 'selected' : ''}>${l}</option>`).join('')}
      </select>
    </div>
    <button class="btn btn-primary" type="submit">Filter</button>
    <a class="btn btn-ghost" href="/fleet">Reset</a>
    </form>
  </div>
</div>

<!-- Fleet KPI strip (Phase B M1) -->
<div class="fleet-kpis mb-4">
  ${[
    { label: 'Total Vehicles', value: fleetKpis.total, tone: 'blue', sub: 'In fleet' },
    { label: 'Off Road (VOR)', value: fleetKpis.vor, tone: fleetKpis.vor > 0 ? 'red' : 'green', sub: 'Not for use' },
    { label: 'MOT Due', value: fleetKpis.motDue, tone: fleetKpis.motDue > 0 ? 'amber' : 'green', sub: 'Next 30 days' },
    { label: 'Insurance Due', value: fleetKpis.insuranceDue, tone: fleetKpis.insuranceDue > 0 ? 'amber' : 'green', sub: 'Next 30 days' },
    { label: 'Road Tax Due', value: fleetKpis.roadTaxDue, tone: fleetKpis.roadTaxDue > 0 ? 'amber' : 'green', sub: 'Next 30 days' },
    { label: 'Tacho Cal Due', value: fleetKpis.tachoDue, tone: fleetKpis.tachoDue > 0 ? 'amber' : 'green', sub: 'Next 30 days' },
    { label: 'PMI Due', value: fleetKpis.pmiDue, tone: fleetKpis.pmiDue > 0 ? 'amber' : 'green', sub: 'Next 14 days' },
    { label: 'Open Defects', value: fleetKpis.openDefects, tone: fleetKpis.openDefects > 0 ? 'red' : 'green', sub: 'Vehicles affected' },
  ].map(k => `
    <div class="fleet-kpi ${k.tone}">
      <div class="fleet-kpi-value">${k.value}</div>
      <div class="fleet-kpi-label">${k.label}</div>
      <div class="fleet-kpi-sub">${k.sub}</div>
    </div>
  `).join('')}
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Vehicle</th><th scope="col">Driver</th><th scope="col">MOT Expiry</th>
          <th scope="col">Next PMI</th><th scope="col">Insurance</th><th scope="col" class="col-roadtax">Road Tax</th><th scope="col" class="col-tacho">Tacho Cal</th><th scope="col">Defects</th><th scope="col">Status</th><th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody id="vehiclesTableBody">
        ${vehicles.map(v => `
        <tr data-search-row data-search-text="${`${esc(v.registration)} ${esc(v.make)} ${esc(v.model)} ${v.year} ${esc(v.assignedDriver?.fullName || '')} ${v.status}`.toLowerCase()}">
          <td>
            <div style="display:flex;align-items:center;gap:10px">
              ${vehicleThumb(v, { size: 40 })}
              <div>
                <a href="/fleet/${v.id}" class="reg-link">${esc(v.registration)}</a>
                <div class="cell-muted" style="margin-top:2px">${v.year} ${esc(v.make)} ${esc(v.model)}</div>
              </div>
            </div>
          </td>
          <td>
            ${v.assignedDriver
              ? `<span class="fw-600">${esc(v.assignedDriver.fullName)}</span>`
              : '<span class="text-light">Unassigned</span>'}
          </td>
          <td>
            <span class="badge ${!v.motExpiryDate ? 'badge-slate' : v.motDays < 0 ? 'badge-red' : v.motDays <= 14 ? 'badge-amber' : 'badge-green'}">
              ${!v.motExpiryDate ? '—' : v.motDays < 0 ? 'OVERDUE' : v.motDays <= 14 ? v.motDays + 'd left' : formatDate(v.motExpiryDate)}
            </span>
          </td>
          <td>
            <span class="badge ${!v.nextPmiDate ? 'badge-slate' : v.pmiDays < 0 ? 'badge-red' : v.pmiDays <= 14 ? 'badge-amber' : 'badge-green'}">
              ${!v.nextPmiDate ? 'Not set' : v.pmiDays < 0 ? Math.abs(v.pmiDays) + 'd overdue' : v.pmiDays <= 14 ? v.pmiDays + 'd remaining' : formatDate(v.nextPmiDate)}
            </span>
          </td>
          <td>
            <span class="badge ${!v.insuranceExpiryDate ? 'badge-slate' : v.insuranceDays < 0 ? 'badge-red' : v.insuranceDays <= 30 ? 'badge-amber' : 'badge-green'}">
              ${!v.insuranceExpiryDate ? '—' : v.insuranceDays < 0 ? 'EXPIRED' : v.insuranceDays <= 30 ? v.insuranceDays + 'd' : 'Valid'}
            </span>
          </td>
          <td class="col-roadtax">
            <span class="badge ${v.roadTaxDays === null ? 'badge-slate' : v.roadTaxDays < 0 ? 'badge-red' : v.roadTaxDays <= 30 ? 'badge-amber' : 'badge-green'}">
              ${v.roadTaxDays === null ? '—' : v.roadTaxDays < 0 ? 'EXPIRED' : v.roadTaxDays <= 30 ? v.roadTaxDays + 'd' : 'Valid'}
            </span>
          </td>
          <td class="col-tacho">
            <span class="badge ${v.tachoDays === null ? 'badge-slate' : v.tachoDays < 0 ? 'badge-red' : v.tachoDays <= 30 ? 'badge-amber' : 'badge-green'}">
              ${v.tachoDays === null ? '—' : v.tachoDays < 0 ? 'EXPIRED' : v.tachoDays <= 30 ? v.tachoDays + 'd' : 'Valid'}
            </span>
          </td>
          <td>
            ${v.defects.length > 0
              ? `<span class="badge ${v.defects.some(d => d.severity === 'dangerous') ? 'badge-red' : 'badge-amber'}">${v.defects.length} open</span>`
              : '<span class="badge badge-green">Clear</span>'}
          </td>
          <td>
            <span class="badge ${v.status === 'active' ? 'badge-green' : v.status === 'vor' ? 'badge-red' : 'badge-slate'}">
              ${v.status === 'active' ? 'Active' : v.status === 'vor' ? 'VOR' : v.status.toUpperCase()}
            </span>
          </td>
          <td>
            <div class="flex gap-2">
              <a href="/fleet/${v.id}" class="btn btn-ghost btn-sm">View</a>
              <a href="/fleet/${v.id}/edit" class="btn btn-outline btn-sm">Edit</a>
              <button type="button" data-del-vehicle data-id="${v.id}" data-reg="${esc(v.registration)}" class="btn btn-danger-soft btn-sm">Delete</button>
            </div>
          </td>
        </tr>`).join('')}
        <tr id="noVehiclesFound" style="display:none">
          <td colspan="10">
            <div class="empty-state">
              <p>No vehicles match your search</p>
              <div class="empty-hint">Clear the search to restore the fleet list</div>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

${totalPages > 1 ? `
<div class="pagination">
  ${page > 1 ? `<a href="?status=${encodeURIComponent(filters.status||'')}&due=${encodeURIComponent(filters.due||'')}&page=${page-1}" class="btn btn-ghost btn-sm">← Prev</a>` : ''}
  <span>Page ${page} of ${totalPages} · ${total} vehicles</span>
  ${page < totalPages ? `<a href="?status=${encodeURIComponent(filters.status||'')}&due=${encodeURIComponent(filters.due||'')}&page=${page+1}" class="btn btn-primary btn-sm">Next →</a>` : ''}
</div>` : ''}

<style>
  .reg-link { font-weight: 800; font-size: 15px; font-family: ui-monospace, monospace; letter-spacing: -.5px; color: var(--primary); text-decoration: none; }
  .reg-link:hover { text-decoration: underline; }
  .fleet-kpis { display:grid; grid-template-columns:repeat(8,1fr); gap:12px; }
  .fleet-kpi { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:14px 16px; position:relative; overflow:hidden; box-shadow:var(--shadow-xs); }
  .fleet-kpi::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--border-md); }
  .fleet-kpi.blue::before { background:var(--primary); }
  .fleet-kpi.green::before { background:var(--success); }
  .fleet-kpi.amber::before { background:var(--warning); }
  .fleet-kpi.red::before { background:var(--danger); }
  .fleet-kpi-value { font-size:26px; font-weight:900; letter-spacing:-1px; line-height:1; }
  .fleet-kpi.amber .fleet-kpi-value { color:var(--warning); }
  .fleet-kpi.red .fleet-kpi-value { color:var(--danger); }
  .fleet-kpi-label { font-size:12px; font-weight:700; color:var(--text); margin-top:6px; }
  .fleet-kpi-sub { font-size:11px; color:var(--text-muted); margin-top:2px; }
  @media (max-width:1200px) { .fleet-kpis { grid-template-columns:repeat(4,1fr); } }
  @media (max-width:680px) { .fleet-kpis { grid-template-columns:repeat(2,1fr); } .col-roadtax, .col-tacho { display:none; } }
</style>

<script>
document.querySelectorAll('[data-del-vehicle]').forEach(b => b.addEventListener('click', () => deleteVehicle(b.dataset.id, b.dataset.reg)));
async function deleteVehicle(id, registration) {
  const confirmed = await showConfirmDialog({
    title: 'Delete Vehicle Record',
    message: 'Delete vehicle ' + registration + '? This only works when there are no linked documents, checks, defects or VOR records.',
    confirmLabel: 'Delete Vehicle',
    cancelLabel: 'Cancel',
    tone: 'danger'
  });
  if (!confirmed) return;
  const res = await fetch('/api/v1/vehicles/' + id, {
    method: 'DELETE',
    credentials: 'same-origin',
  });
  if (res.ok) {
    showToast('Vehicle deleted successfully', 'success');
    setTimeout(() => location.reload(), 900);
  } else {
    const e = await res.json();
    showToast(e.error?.message || 'Delete failed', 'error');
  }
}
</script>
` }) %>
