<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <a href="/fleet" class="btn btn-ghost btn-sm">← Back to Fleet</a>
  <div class="flex gap-2">
    <a href="/fleet/${vehicle.id}/edit" class="btn btn-outline btn-sm">Edit Vehicle</a>
    <button type="button" id="deleteVehBtn" class="btn btn-danger-soft btn-sm">Delete</button>
    <select class="form-control" style="width:170px;height:34px;padding:5px 10px" onchange="updateVehicleStatus(this.value)">
      ${[['active','Active'],['vor','VOR'],['awaiting_repair','Awaiting Repair'],['hired','Hired'],['sold','Sold']].map(([v,l]) => `<option value="${v}" ${vehicle.status === v ? 'selected' : ''}>${l}</option>`).join('')}
    </select>
  </div>
</div>

<div class="grid-2 mb-4">
  <div class="card">
    <div class="card-header"><h3>Vehicle Profile</h3></div>
    <div class="card-body">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--border)">
        <div id="vehPhotoThumb">${vehicleThumb(vehicle, { size: 88 })}</div>
        <div>
          <div style="font-weight:800;font-size:18px;line-height:1.1">${esc(vehicle.registration)}</div>
          <div class="text-sm text-muted" style="margin:2px 0 10px">${esc(vehicle.make)} ${esc(vehicle.model)}</div>
          <label class="btn btn-outline btn-sm" style="cursor:pointer;margin:0">
            <span id="vehPhotoBtnLabel">${vehicle.imageStorageKey ? 'Change photo' : 'Add photo'}</span>
            <input type="file" id="vehPhotoInput" accept="image/jpeg,image/png,image/webp" hidden>
          </label>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        ${[
          ['Registration', vehicle.registration],
          ['Make & Model', vehicle.year + ' ' + vehicle.make + ' ' + vehicle.model],
          ['VIN', vehicle.vinNumber],
          ['Operator Licence Disc', vehicle.operatorLicenceDisc || '—'],
          ['Assigned Driver', vehicle.assignedDriver?.fullName || 'Unassigned'],
          ['Current Mileage', vehicle.currentMileage?.toLocaleString() + ' miles'],
          ['PMI Interval', 'Every ' + vehicle.pmiIntervalWeeks + ' weeks'],
          ['Last PMI', formatDate(vehicle.lastPmiDate)],
        ].map(([k, v]) => `
          <div><div class="text-sm text-muted" style="margin-bottom:3px">${k}</div><div style="font-weight:600;font-size:13.5px">${v}</div></div>
        `).join('')}
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Compliance Dates</h3></div>
    <div class="card-body">
      ${[
        { label: 'Next PMI', date: vehicle.nextPmiDate, days: daysUntil(vehicle.nextPmiDate), critical: 14 },
        { label: 'MOT Expiry', date: vehicle.motExpiryDate, days: daysUntil(vehicle.motExpiryDate), critical: 14 },
        { label: 'Insurance Expiry', date: vehicle.insuranceExpiryDate, days: daysUntil(vehicle.insuranceExpiryDate), critical: 14 },
        { label: 'Tacho Calibration', date: vehicle.tachoCalibrExpiry, days: daysUntil(vehicle.tachoCalibrExpiry), critical: 30 },
      ].map(item => {
        const status = !item.date ? 'slate' : item.days < 0 ? 'danger' : item.days <= item.critical ? 'warning' : 'ok';
        const color = status === 'danger' ? 'var(--danger)' : status === 'warning' ? 'var(--warning)' : 'var(--success)';
        return `
          <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border)">
            <div style="font-size:13px;font-weight:500">${item.label}</div>
            <div style="text-align:right">
              <div style="font-weight:700;font-size:13px;color:${color}">${formatDate(item.date)}</div>
              ${item.days !== null ? `<div style="font-size:11px;color:${color}">${item.days < 0 ? 'OVERDUE by ' + Math.abs(item.days) + 'd' : item.days + ' days remaining'}</div>` : ''}
            </div>
          </div>
        `;
      }).join('')}
    </div>
  </div>
</div>

${vehicle.defects?.length > 0 ? `
<div class="card mb-4">
  <div class="card-header"><h3 style="color:var(--danger-t)">Open Defects (${vehicle.defects.length})</h3></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Reference</th><th scope="col">Category</th><th scope="col">Severity</th><th scope="col">Status</th><th scope="col">Reported By</th><th scope="col"></th></tr></thead>
      <tbody>
        ${vehicle.defects.map(d => `
          <tr>
            <td><a href="/defects/${d.id}" style="font-weight:700">${esc(d.referenceNumber)}</a></td>
            <td>${d.defectCategory}</td>
            <td><span class="badge ${d.severity === 'dangerous' ? 'badge-red' : d.severity === 'serious' ? 'badge-amber' : 'badge-slate'}">${d.severity}</span></td>
            <td><span class="badge badge-blue">${d.status.replace(/_/g,' ')}</span></td>
            <td>${esc(d.reportedBy?.fullName)}</td>
            <td><a href="/defects/${d.id}" class="btn btn-ghost btn-sm">View</a></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>
</div>
` : ''}

<div class="card mb-4">
  <div class="card-header">
    <h3>Maintenance Documents</h3>
    <button class="btn btn-primary btn-sm" id="openDocModalBtn">+ Upload</button>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Type</th><th scope="col">File</th><th scope="col">Document Date</th><th scope="col">Expiry</th><th scope="col">Uploaded</th></tr></thead>
      <tbody>
        ${vehicle.documents.length === 0
          ? `<tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">No documents uploaded</td></tr>`
          : vehicle.documents.map(d => `
            <tr>
              <td style="font-weight:600;text-transform:capitalize">${d.documentType.replace(/_/g,' ')}</td>
              <td><a href="/documents/vehicle-document/${d.id}" class="document-link">${esc(d.fileName)}</a></td>
              <td>${formatDate(d.documentDate)}</td>
              <td>${formatDate(d.expiryDate)}</td>
              <td style="font-size:12px;color:var(--text-muted)">${formatDate(d.createdAt)}</td>
            </tr>
          `).join('')}
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3>Recent Daily Checks (Last 7)</h3></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Date</th><th scope="col">Driver</th><th scope="col">Mileage</th><th scope="col">Result</th></tr></thead>
      <tbody>
        ${vehicle.checks.length === 0
          ? `<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--text-muted)">No checks recorded</td></tr>`
          : vehicle.checks.map(c => {
              const defects = c.items.filter(i => i.status === 'defect_found').length;
              return `<tr>
                <td style="font-weight:500">${formatDate(c.checkDate)}</td>
                <td>${esc(c.driver?.fullName || '—')}</td>
                <td style="color:var(--text-muted)">${c.mileage?.toLocaleString()} mi</td>
                <td>${c.nilDefect ? '<span class="badge badge-green">Nil Defect</span>' : defects > 0 ? `<span class="badge badge-amber">${defects} defect(s)</span>` : '<span class="badge badge-green">Pass</span>'}</td>
              </tr>`;
            }).join('')}
      </tbody>
    </table>
  </div>
</div>

<!-- Document Upload Modal -->
<div id="docModal" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-header">
      <h3>Upload Maintenance Document</h3>
      <button id="closeDocModalBtn" class="btn btn-ghost btn-sm">✕</button>
    </div>
    <form id="vehDocForm">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Document Type</label>
          <select class="form-control" name="documentType">
            ${['pmi_sheet','brake_test','mot_certificate','service_invoice','repair_invoice','tyre_report','tacho_certificate','safety_inspection','roadside_inspection','prohibition_notice','rectification_evidence','other']
              .map(t => `<option value="${t}">${t.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase())}</option>`).join('')}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Document Date</label>
          <input class="form-control" type="date" name="documentDate" value="${new Date().toISOString().split('T')[0]}">
        </div>
        <div class="form-group">
          <label class="form-label">File</label>
          <input class="form-control" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" id="cancelDocModalBtn" class="btn btn-ghost">Cancel</button>
        <button type="button" id="uploadVehDocBtn" class="btn btn-primary">Upload</button>
      </div>
    </form>
  </div>
</div>

<script>
(function() {
  const docModal = document.getElementById('docModal');
  const openBtn = document.getElementById('openDocModalBtn');
  const closeBtn = document.getElementById('closeDocModalBtn');
  const cancelBtn = document.getElementById('cancelDocModalBtn');
  const uploadBtn = document.getElementById('uploadVehDocBtn');
  const deleteBtn = document.getElementById('deleteVehBtn');

  if (openBtn) openBtn.addEventListener('click', function() { docModal.style.display = 'flex'; });
  if (closeBtn) closeBtn.addEventListener('click', function() { docModal.style.display = 'none'; });
  if (cancelBtn) cancelBtn.addEventListener('click', function() { docModal.style.display = 'none'; });
  if (uploadBtn) uploadBtn.addEventListener('click', async function() {
    const form = document.getElementById('vehDocForm');
    const fd = new FormData(form);
    const res = await fetch('/api/v1/vehicles/${vehicle.id}/documents', { method: 'POST', body: fd, credentials: 'same-origin' });
    if (res.ok) { showToast('Document uploaded', 'success'); docModal.style.display = 'none'; setTimeout(function() { location.reload(); }, 1000); }
    else { showToast('Upload failed', 'error'); }
  });
  if (deleteBtn) deleteBtn.addEventListener('click', function() { deleteVehicleRecord(); });

  // Vehicle photo upload (Phase A)
  const photoInput = document.getElementById('vehPhotoInput');
  if (photoInput) photoInput.addEventListener('change', async function() {
    const file = photoInput.files && photoInput.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('image', file);
    const label = document.getElementById('vehPhotoBtnLabel');
    const prev = label ? label.textContent : '';
    if (label) label.textContent = 'Uploading…';
    try {
      const res = await fetch('/fleet/${vehicle.id}/photo', {
        method: 'POST', body: fd, credentials: 'same-origin',
        headers: { 'X-CSRF-Token': '${csrfToken}' }
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Upload failed');
      const thumb = document.getElementById('vehPhotoThumb');
      if (thumb) thumb.innerHTML = '<span class="ui-vthumb" style="width:88px;height:88px"><img src="' + data.url + '" alt="" style="width:88px;height:88px"></span>';
      if (label) label.textContent = 'Change photo';
      showToast('Vehicle photo updated', 'success');
    } catch (err) {
      if (label) label.textContent = prev;
      showToast(err.message || 'Could not upload photo', 'error');
    }
    photoInput.value = '';
  });
})();

async function updateVehicleStatus(status) {
  const res = await fetch('/api/v1/vehicles/${vehicle.id}/status', {
    method: 'PATCH',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status })
  });
  if (res.ok) { showToast('Vehicle status updated', 'success'); setTimeout(()=>location.reload(), 700); }
  else { showToast('Status update failed', 'error'); }
}

async function deleteVehicleRecord() {
  const confirmed = await showConfirmDialog({
    title: 'Delete Vehicle Record',
    message: 'Delete vehicle ${esc(vehicle.registration)}? This only works when there are no linked documents, checks, defects or VOR records.',
    confirmLabel: 'Delete Vehicle',
    cancelLabel: 'Cancel',
    tone: 'danger'
  });
  if (!confirmed) return;
  const res = await fetch('/api/v1/vehicles/${vehicle.id}', {
    method: 'DELETE',
    credentials: 'same-origin',
  });
  if (res.ok) { showToast('Vehicle deleted successfully', 'success'); setTimeout(()=>window.location.href='/fleet', 900); }
  else {
    const e = await res.json();
    showToast(e.error?.message || 'Delete failed', 'error');
  }
}
</script>
<style>
  .document-link { font-size:12px; font-weight:700; color:var(--primary); text-decoration:none; }
  .document-link:hover { text-decoration:underline; }
</style>
` }) %>
