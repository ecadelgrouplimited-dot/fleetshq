            <option value="local-emp-driver-001">Mulindwa Denis (HGV Driver)</option>
            <option value="local-emp-nirmal-004">Nirmal Singh (HGV Driver)</option>
            <option value="local-emp-prince-005">Prince Kumar (HGV Driver)</option>
            <option value="local-emp-sahil-006">Sahil Kumar (HGV Driver)</option>
          </select>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label style="font-size:12px;font-weight:600;color:#334155;display:block;margin-bottom:4px;">Leave Type</label>
            <select name="type" class="leave-filter-select" style="width:100%;">
