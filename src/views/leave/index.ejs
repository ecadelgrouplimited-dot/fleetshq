          <div>
            <label style="font-size:12px;font-weight:600;color:#334155;display:block;margin-bottom:4px;">End Date</label>
            <input type="date" name="endDate" class="leave-filter-input" style="width:100%;" required>
          </div>
        </div>
        <div>
          <label style="font-size:12px;font-weight:600;color:#334155;display:block;margin-bottom:4px;">Reason / Notes</label>
