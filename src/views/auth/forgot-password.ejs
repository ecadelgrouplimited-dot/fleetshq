<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#0a0a0c">
  <title>Reset password — FLEETS.HQ</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/img/favicon-64.png">
  <link rel="apple-touch-icon" href="/img/favicon-180.png">
  <script>
    // Pre-paint theme + direction bootstrap — shares the public-site
    // preference (publicTheme/public-theme, publicLang/public-lang) with
    // /welcome, /contact and /track, avoiding a flash of the wrong theme
    // or text direction for returning visitors.
    (function () {
      var stored = localStorage.getItem('public-theme');
      var cookie = document.cookie.match(/(?:^|; )publicTheme=([^;]+)/);
      var preferred = stored || (cookie && cookie[1]) || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', preferred);

      var storedLang = localStorage.getItem('public-lang');
      var langCookie = document.cookie.match(/(?:^|; )publicLang=([^;]+)/);
      var lang = storedLang || (langCookie && langCookie[1]);
      if (lang === 'ar') document.documentElement.setAttribute('dir', 'rtl');
    }());
  </script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0a0a0c; --bg-2: #0e0e11; --panel: rgba(22,22,27,.72); --panel-2: rgba(255,255,255,.04);
      --line: rgba(255,255,255,.1); --line-2: rgba(255,255,255,.18);
      --text: #e8e8ec; --heading: #fff; --muted: #9d9da8; --soft: #6f6f7a;
      --red: #e11d2a; --red-deep: #a60f1a; --gold: #f5b301; --green: #10b981;
    }
    [data-theme="light"] {
      --bg: #f6f6f4; --bg-2: #eeeeec; --panel: rgba(255,255,255,.9); --panel-2: rgba(10,10,12,.035);
      --line: rgba(10,10,12,.1); --line-2: rgba(10,10,12,.16);
      --text: #26262c; --heading: #0a0a0c; --muted: #55575f; --soft: #74767d;
    }
    html, body { min-height: 100%; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased;
      display: flex; align-items: center; justify-content: center; padding: 24px; position: relative; overflow: hidden;
      transition: background .2s ease, color .2s ease; }
    a { text-decoration: none; color: inherit; }

    .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
    .bg::before { content: ""; position: absolute; inset: 0;
      background: radial-gradient(ellipse 55% 45% at 88% 12%, rgba(245,179,1,.10), transparent 60%),
                  radial-gradient(ellipse 50% 45% at 10% 90%, rgba(225,29,42,.12), transparent 60%); }
    /* Corner reveal: the road fades in from the bottom-right only — "the road
       ahead" — a third distinct treatment from login (left panel) and
       register (top-down fade). */
    .bg-photo { position: absolute; inset: 0; background: url('/img/road-skyline.jpeg') bottom right / cover no-repeat; opacity: .2;
      -webkit-mask-image: radial-gradient(ellipse 65% 60% at 100% 100%, #000 0%, transparent 70%);
              mask-image: radial-gradient(ellipse 65% 60% at 100% 100%, #000 0%, transparent 70%); }
    [data-theme="light"] .bg-photo { opacity: .28; }

    .wrap { position: relative; z-index: 1; width: 100%; max-width: 400px; }
    .lockup { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 26px; }
    .mark { width: 34px; height: 34px; flex-shrink: 0; display: grid; place-items: center; }
    .mark img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 8px 18px rgba(37,99,235,.4)); }
    .wordmark { font-weight: 900; color: var(--heading); font-size: 16px; letter-spacing: -.3px; }
    .wordmark b { color: var(--red); }

    .card { position: relative; background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 82%, #fff 4%), var(--bg-2));
      border: 1px solid var(--line-2); border-radius: 20px; padding: 32px 30px 28px;
      backdrop-filter: blur(18px); box-shadow: 0 30px 80px rgba(0,0,0,.35); text-align: center; }
    [data-theme="dark"] .card { box-shadow: 0 30px 80px rgba(0,0,0,.55); }
    .card::before { content: ""; position: absolute; top: 0; left: 22px; right: 22px; height: 2px; border-radius: 999px;
      background: linear-gradient(90deg, transparent, var(--red), var(--gold), transparent); }
    .icon { width: 50px; height: 50px; margin: 0 auto 16px; border-radius: 50%; display: grid; place-items: center;
      background: rgba(245,179,1,.1); border: 1.5px solid rgba(245,179,1,.35); }
    .icon svg { width: 22px; height: 22px; color: var(--gold); }
    .icon.done { background: rgba(16,185,129,.1); border-color: rgba(16,185,129,.4); }
    .icon.done svg { color: var(--green); }
    h1 { font-size: 22px; font-weight: 800; letter-spacing: -.4px; color: var(--heading); }
    p.sub { margin-top: 10px; font-size: 13.5px; color: var(--muted); line-height: 1.6; margin-bottom: 22px; }

    .group { text-align: left; margin-bottom: 16px; }
    .inp { width: 100%; padding: 12px 14px; font-size: 15px; font-family: inherit; color: var(--text);
      background: var(--panel-2); border: 1.5px solid var(--line-2); border-radius: 11px; transition: border-color .15s, box-shadow .15s; }
    .inp::placeholder { color: var(--soft); }
    .inp:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(245,179,1,.18); }

    .btn { width: 100%; padding: 13px; font-size: 14.5px; font-weight: 800; font-family: inherit; letter-spacing: .2px;
      color: #fff; background: linear-gradient(135deg, var(--red), var(--red-deep)); border: 1px solid rgba(255,255,255,.14);
      border-radius: 11px; cursor: pointer; transition: transform .15s, box-shadow .15s; box-shadow: 0 12px 30px rgba(225,29,42,.4); min-height: 48px; }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgba(225,29,42,.55); }

    .back { display: block; margin-top: 20px; text-align: center; font-size: 12.5px; font-weight: 700; color: var(--muted); }
    .back:hover { color: var(--gold); }
    .controls-overlay { position: fixed; top: 22px; right: 24px; z-index: 5; display: flex; align-items: center; gap: 8px; }
    [dir="rtl"] .controls-overlay { right: auto; left: 24px; }
    .ctrl-btn {
      display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; flex-shrink: 0;
      border-radius: 50%; border: 1px solid var(--line-2); background: var(--panel-2); color: var(--muted);
      cursor: pointer; font-size: 16px; line-height: 1; transition: color .15s, border-color .15s, transform .15s;
    }
    .ctrl-btn:hover { color: var(--gold); border-color: var(--gold); transform: translateY(-1px); }
    .ctrl-btn svg { width: 17px; height: 17px; }
    .lang-switch { position: relative; }
    .lang-menu {
      position: absolute; top: calc(100% + 8px); right: 0; z-index: 10; display: none; flex-direction: column; gap: 2px;
      padding: 6px; min-width: 46px; border-radius: 12px; border: 1px solid var(--line-2); background: var(--bg-2);
      box-shadow: 0 16px 34px rgba(0,0,0,.35);
    }
    .lang-menu.is-open { display: flex; }
    .lang-menu button {
      display: flex; align-items: center; justify-content: center; padding: 8px; border-radius: 8px; border: 0;
      background: transparent; cursor: pointer; font-size: 19px; line-height: 1; transition: background .15s;
    }
    .lang-menu button:hover { background: var(--panel-2); }
    .lang-menu button.is-active { box-shadow: inset 0 0 0 1.5px var(--gold); }
    [dir="rtl"] .lang-menu { right: auto; left: 0; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
  </style>
</head>
<body>
  <div class="bg" aria-hidden="true"><div class="bg-photo"></div></div>
  <div class="controls-overlay">
    <div class="lang-switch">
      <button type="button" class="ctrl-btn" id="langToggle" aria-haspopup="true" aria-expanded="false" data-i18n="aria.toggleLanguage" data-i18n-attr="aria-label" aria-label="Change language">
        <span data-lang-current>🇬🇧</span>
      </button>
      <div class="lang-menu" id="langMenu" role="menu">
        <button type="button" role="menuitem" data-lang-option="en" title="English">🇬🇧</button>
        <button type="button" role="menuitem" data-lang-option="fr" title="Français">🇫🇷</button>
        <button type="button" role="menuitem" data-lang-option="es" title="Español">🇪🇸</button>
        <button type="button" role="menuitem" data-lang-option="zh" title="中文">🇨🇳</button>
        <button type="button" role="menuitem" data-lang-option="ar" title="العربية">🇸🇦</button>
        <button type="button" role="menuitem" data-lang-option="ro" title="Română">🇷🇴</button>
      </div>
    </div>
    <button type="button" class="ctrl-btn" id="themeToggle" data-i18n="aria.toggleTheme" data-i18n-attr="aria-label" aria-label="Toggle theme">
      <svg id="toggleIconDark" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      <svg id="toggleIconLight" style="display:none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.7-.7M6.34 6.34l-.7-.7m12.02 0l-.7.7M6.34 17.66l-.7.7M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
    </button>
  </div>
  <div class="wrap">
    <a class="lockup" href="/welcome" aria-label="FLEETS.HQ home">
      <span class="mark"><img src="/img/logo-fleetshq-icon.png" alt=""></span>
      <span class="wordmark">FLEETS<b>.HQ</b></span>
    </a>
    <div class="card">
      <% if (sent) { %>
        <div class="icon done" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h1 data-i18n="reset.sentTitle">Check your email</h1>
        <p class="sub" data-i18n="reset.sentSub">If an account exists for that address, we've sent a link to reset your password. It expires in 1 hour.</p>
        <a class="btn" href="/login" style="display:block;text-align:center;line-height:22px;" data-i18n="reset.backToSignIn">Back to sign in</a>
      <% } else { %>
        <div class="icon" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/></svg>
        </div>
        <h1 data-i18n="reset.title">Reset your password</h1>
        <p class="sub" data-i18n="reset.subtitle">Enter your account email and we'll send you a link to set a new password.</p>
        <form method="POST" action="/forgot-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="group">
            <input class="inp" type="email" name="email" placeholder="you@fleetshq.com" required autofocus autocomplete="email">
          </div>
          <button type="submit" class="btn" data-i18n="reset.submit">Send reset link</button>
        </form>
      <% } %>
    </div>
    <a class="back" href="/login" data-i18n="reset.back">← Back to sign in</a>
  </div>
  <script src="/js/i18n.js?v=<%= assetVersion %>"></script>
  <script>
    (function () {
      var root = document.documentElement;
      var toggle = document.getElementById('themeToggle');
      var iconDark = document.getElementById('toggleIconDark');
      var iconLight = document.getElementById('toggleIconLight');
      function reflectTheme(theme) {
        var isLight = theme === 'light';
        iconDark.style.display = isLight ? 'none' : '';
        iconLight.style.display = isLight ? '' : 'none';
      }
      reflectTheme(root.getAttribute('data-theme'));
      toggle.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        localStorage.setItem('public-theme', next);
        document.cookie = 'publicTheme=' + next + '; Path=/; Max-Age=31536000; SameSite=Lax';
        reflectTheme(next);
      });

      var langToggle = document.getElementById('langToggle');
      var langMenu = document.getElementById('langMenu');
      function closeLangMenu() {
        langMenu.classList.remove('is-open');
        langToggle.setAttribute('aria-expanded', 'false');
      }
      langToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = langMenu.classList.toggle('is-open');
        langToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', function (e) {
        if (!langMenu.contains(e.target) && e.target !== langToggle) closeLangMenu();
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLangMenu(); });
      langMenu.querySelectorAll('[data-lang-option]').forEach(function (btn) {
        btn.addEventListener('click', closeLangMenu);
      });
    }());
  </script>
</body>
</html>
