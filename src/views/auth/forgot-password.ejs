<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reset password — 256 Logistics</title>
  <link rel="stylesheet" href="/css/app.css">
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; background:linear-gradient(135deg,#0f172a 0%,#123263 100%); padding:20px; }
    .auth-card { background:#fff; border-radius:16px; padding:34px; max-width:420px; width:100%; box-shadow:0 24px 70px rgba(0,0,0,.32); }
    .auth-card h1 { font-size:22px; margin-bottom:6px; color:#0f172a; }
    .auth-card p { color:#64748b; font-size:14px; line-height:1.6; margin-bottom:20px; }
    .auth-card .form-control { margin-bottom:14px; }
    .auth-card .btn { width:100%; justify-content:center; }
    .auth-back { display:block; text-align:center; margin-top:18px; font-size:13px; color:#2563eb; text-decoration:none; }
  </style>
</head>
<body>
  <div class="auth-card">
    <% if (sent) { %>
      <h1>Check your email</h1>
      <p>If an account exists for that address, we've sent a link to reset your password. It expires in 1 hour.</p>
      <a class="btn btn-primary" href="/login">Back to sign in</a>
    <% } else { %>
      <h1>Reset your password</h1>
      <p>Enter your account email and we'll send you a link to set a new password.</p>
      <form method="POST" action="/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input class="form-control" type="email" name="email" placeholder="you@256logisticsltd.com" required autofocus autocomplete="email">
        <button type="submit" class="btn btn-primary">Send reset link</button>
      </form>
      <a class="auth-back" href="/login">Back to sign in</a>
    <% } %>
  </div>
</body>
</html>
