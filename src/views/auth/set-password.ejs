<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0c">
  <title>Set your password — FLEETS.HQ</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/img/favicon-64.png">
  <link rel="apple-touch-icon" href="/img/favicon-180.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0a0c; --panel-2: rgba(255,255,255,.04); --line-2: rgba(255,255,255,.18);
      --text: #f3f4f6; --muted: #a3a7b0; --soft: #71757e;
      --red: #e11d2a; --red-deep: #a60f1a; --gold: #f5b301; --green: #10b981;
    }
    html { font-size: 16px; }
    body { font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; min-height: 100vh; min-height: 100dvh;
      background: var(--bg); color: var(--text); display: grid; place-items: center; padding: 24px; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    a { text-decoration: none; color: inherit; }
    .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
    .orb { position: absolute; border-radius: 50%; filter: blur(90px); }
    .orb.a { width: 520px; height: 520px; top: -160px; left: -120px; background: radial-gradient(circle, rgba(225,29,42,.38), transparent 68%); }
    .orb.b { width: 420px; height: 420px; bottom: -160px; right: -120px; background: radial-gradient(circle, rgba(245,179,1,.2), transparent 66%); }
    .mark { position: relative; width: 44px; height: 44px; border-radius: 13px; flex-shrink: 0;
      background: linear-gradient(145deg, var(--red), var(--red-deep)); display: grid; place-items: center; color: #fff; box-shadow: 0 10px 28px rgba(225,29,42,.45); isolation: isolate; overflow: hidden; }
    .mark::before { content: ""; position: absolute; inset: 9px 10px 8px; border: 2px solid var(--gold); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); opacity: .85; z-index: -1; }
    .mark::after { content: "F"; font-weight: 900; font-size: 20px; }
    .wordmark { font-weight: 900; color: #fff; font-size: 18px; letter-spacing: -.3px; }
    .wordmark b { color: var(--red); }
    .card { position: relative; z-index: 1; width: 100%; max-width: 420px; padding: 34px 32px 28px;
      background: linear-gradient(180deg, rgba(28,28,34,.86), rgba(16,16,20,.92)); border: 1px solid var(--line-2); border-radius: 20px;
      backdrop-filter: blur(18px); box-shadow: 0 30px 80px rgba(0,0,0,.55); }
    .card::before { content: ""; position: absolute; top: 0; left: 22px; right: 22px; height: 2px; border-radius: 999px;
      background: linear-gradient(90deg, transparent, var(--red), var(--gold), transparent); }
    .lockup { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
    .eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; color: var(--gold); }
    .card h2 { margin-top: 7px; font-size: 24px; font-weight: 800; letter-spacing: -.5px; color: #fff; }
    .card .sub { margin-top: 5px; font-size: 14px; color: var(--muted); margin-bottom: 20px; }
    .error-box { display: flex; align-items: center; gap: 9px; background: rgba(225,29,42,.1); border: 1px solid rgba(225,29,42,.4);
      color: #fca5a5; border-radius: 10px; padding: 11px 13px; font-size: 13px; font-weight: 500; margin-bottom: 16px; }
    .error-box svg { width: 16px; height: 16px; flex-shrink: 0; }
    .group { margin-bottom: 15px; }
    .group label { display: block; font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 7px; }
    .iwrap { position: relative; }
    .inp { width: 100%; padding: 13px 44px 13px 14px; font-size: 16px; font-family: inherit; color: #fff; background: rgba(255,255,255,.04);
      border: 1.5px solid var(--line-2); border-radius: 11px; transition: border-color .15s, box-shadow .15s; }
    .inp::placeholder { color: var(--soft); }
    .inp:focus { outline: none; border-color: var(--gold); background: rgba(255,255,255,.06); box-shadow: 0 0 0 3px rgba(245,179,1,.18); }
    .toggle-pw { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; display: grid; place-items: center;
      background: transparent; border: 0; cursor: pointer; color: var(--soft); border-radius: 8px; }
    .toggle-pw:hover { color: var(--gold); background: rgba(255,255,255,.05); }
    .toggle-pw svg { width: 18px; height: 18px; }
    .meter { height: 5px; border-radius: 3px; background: rgba(255,255,255,.1); margin-top: 8px; overflow: hidden; }
    .meter > span { display: block; height: 100%; width: 0; border-radius: 3px; transition: width .2s, background .2s; }
    .meter-label { font-size: 11px; color: var(--soft); margin-top: 5px; min-height: 14px; }
    .hint { font-size: 11.5px; color: var(--soft); margin-top: 6px; }
    .btn { width: 100%; margin-top: 10px; padding: 14px; font-size: 15px; font-weight: 800; font-family: inherit; color: #fff;
      background: linear-gradient(135deg, var(--red), var(--red-deep)); border: 1px solid rgba(255,255,255,.14); border-radius: 11px; cursor: pointer;
      transition: transform .15s, box-shadow .15s; box-shadow: 0 12px 30px rgba(225,29,42,.4); min-height: 50px; }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgba(225,29,42,.55); }
    .signout { display: block; text-align: center; margin-top: 16px; font-size: 12.5px; color: var(--soft); }
    .signout:hover { color: var(--gold); }
    @media (max-width: 420px) { .card { padding: 26px 20px 22px; } }
  </style>
</head>
<body>
  <div class="bg" aria-hidden="true"><span class="orb a"></span><span class="orb b"></span></div>
  <div class="card">
    <div class="lockup">
      <span class="mark" aria-hidden="true"></span>
      <span class="wordmark">FLEETS<b>.HQ</b></span>
    </div>
    <div class="eyebrow">First sign-in</div>
    <h2>Set your password</h2>
    <p class="sub">For security, choose a new password to replace the temporary one you were given.</p>

    <% if (error) { %>
      <div class="error-box">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/set-password" id="pwForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="group">
        <label for="cur">Temporary password</label>
        <div class="iwrap">
          <input class="inp" type="password" name="currentPassword" id="cur" required autocomplete="current-password" placeholder="The password you were given">
          <button type="button" class="toggle-pw" data-toggle="cur" aria-label="Show password">👁</button>
        </div>
      </div>
      <div class="group">
        <label for="np">New password</label>
        <div class="iwrap">
          <input class="inp" type="password" name="newPassword" id="np" required autocomplete="new-password" placeholder="Choose a strong password">
          <button type="button" class="toggle-pw" data-toggle="np" aria-label="Show password">👁</button>
        </div>
        <div class="meter"><span id="meterFill"></span></div>
        <div class="meter-label" id="meterLabel"></div>
        <div class="hint">At least 8 characters, with letters and numbers.</div>
      </div>
      <div class="group">
        <label for="cp">Confirm new password</label>
        <div class="iwrap">
          <input class="inp" type="password" name="confirmPassword" id="cp" required autocomplete="new-password" placeholder="Re-enter new password">
          <button type="button" class="toggle-pw" data-toggle="cp" aria-label="Show password">👁</button>
        </div>
      </div>
      <button type="submit" class="btn">Set password &amp; continue</button>
    </form>
    <a class="signout" href="/logout">Sign out</a>
  </div>

  <script>
    (function () {
      document.querySelectorAll('[data-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var inp = document.getElementById(btn.getAttribute('data-toggle'));
          inp.type = inp.type === 'password' ? 'text' : 'password';
          inp.focus();
        });
      });
      var np = document.getElementById('np');
      var fill = document.getElementById('meterFill');
      var label = document.getElementById('meterLabel');
      np.addEventListener('input', function () {
        var v = np.value, score = 0;
        if (v.length >= 8) score++;
        if (v.length >= 12) score++;
        if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
        if (/[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;
        var pct = [0, 20, 40, 60, 80, 100][score];
        var colors = ['#71757e', '#e11d2a', '#f59e0b', '#f5b301', '#10b981', '#10b981'];
        var labels = ['', 'Weak', 'Fair', 'Good', 'Strong', 'Very strong'];
        fill.style.width = pct + '%';
        fill.style.background = colors[score];
        label.textContent = v ? labels[score] : '';
        label.style.color = colors[score];
      });
    }());
  </script>
</body>
</html>
