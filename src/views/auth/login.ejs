<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0c">
  <title>Sign in — FLEET.HQ</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0a0c; --panel: rgba(22,22,27,.72); --panel-2: rgba(255,255,255,.04);
      --line: rgba(255,255,255,.1); --line-2: rgba(255,255,255,.18);
      --text: #f3f4f6; --heading: #fff; --muted: #a3a7b0; --soft: #71757e;
      --red: #e11d2a; --red-deep: #a60f1a; --gold: #f5b301; --green: #10b981;
    }
    html { font-size: 16px; }
    body {
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      min-height: 100vh; min-height: 100dvh; background: var(--bg); color: var(--text);
      display: flex; -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    a { text-decoration: none; color: inherit; }

    /* Ambient field */
    .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
    .bg .grid {
      position: absolute; inset: -2px;
      background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 30% 20%, #000 30%, transparent 100%);
              mask-image: radial-gradient(ellipse 70% 60% at 30% 20%, #000 30%, transparent 100%);
    }
    .orb { position: absolute; border-radius: 50%; filter: blur(90px); }
    .orb.a { width: 540px; height: 540px; top: -180px; left: -120px; background: radial-gradient(circle, rgba(225,29,42,.4), transparent 68%); }
    .orb.b { width: 420px; height: 420px; bottom: -160px; left: 22%; background: radial-gradient(circle, rgba(245,179,1,.22), transparent 65%); }
    .orb.c { width: 460px; height: 460px; top: 30%; right: -160px; background: radial-gradient(circle, rgba(225,29,42,.2), transparent 66%); }
    .netmap { position: absolute; top: 8%; left: 4%; width: 420px; max-width: 42vw; opacity: .5; }
    .netmap .node { fill: var(--gold); animation: pulse 3.4s ease-in-out infinite; }
    .netmap .node.hot { fill: var(--red); }
    .netmap .route { stroke: rgba(245,179,1,.3); stroke-width: 1; fill: none; }
    .netmap .route.hot { stroke: rgba(225,29,42,.5); }
    @keyframes pulse { 0%,100% { opacity:.5 } 50% { opacity:1 } }

    /* Brand mark (FLEET.HQ pin) */
    .mark { position: relative; width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0;
      background: linear-gradient(145deg, var(--red), var(--red-deep)); display: grid; place-items: center;
      color: #fff; box-shadow: 0 10px 28px rgba(225,29,42,.45); isolation: isolate; overflow: hidden; }
    .mark::before { content: ""; position: absolute; inset: 8px 9px 7px; border: 2px solid var(--gold); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); opacity: .85; z-index: -1; }
    .mark::after { content: "F"; font-weight: 900; font-size: 18px; }
    .wordmark { font-weight: 900; color: #fff; font-size: 17px; letter-spacing: -.3px; line-height: 1; }
    .wordmark b { color: var(--red); }
    .wordmark small { display: block; font-size: 9.5px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: var(--soft); margin-top: 4px; }

    /* Layout */
    .auth { position: relative; z-index: 1; width: 100%; display: grid; grid-template-columns: 1.05fr 480px; }

    /* Brand side */
    .brand-side { padding: 54px clamp(40px, 5vw, 76px); display: flex; flex-direction: column; justify-content: center; gap: 26px; }
    .brand-lockup { display: inline-flex; align-items: center; gap: 12px; }
    .brand-head h1 { font-size: clamp(34px, 4.4vw, 56px); font-weight: 900; line-height: 1.02; letter-spacing: -.035em; color: #fff; }
    .brand-head h1 .accent { color: var(--red); }
    .brand-head p { margin-top: 16px; max-width: 440px; color: var(--muted); font-size: 16px; line-height: 1.6; }
    .pillars { display: flex; flex-wrap: wrap; gap: 9px; }
    .pchip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 13px; border: 1px solid var(--line); border-radius: 100px; background: var(--panel-2); font-size: 13px; font-weight: 600; color: var(--text); }
    .pchip svg { width: 15px; height: 15px; color: var(--gold); }
    .pchip.hot svg { color: var(--red); }
    .stats { display: flex; gap: 30px; padding-top: 22px; border-top: 1px solid var(--line); }
    .stat .n { font-size: 26px; font-weight: 900; color: #fff; letter-spacing: -.02em; line-height: 1; }
    .stat .l { font-size: 12px; color: var(--soft); margin-top: 5px; }
    .powered { font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--soft); }
    .powered b { color: var(--red); }

    /* Form side */
    .form-side { position: relative; display: flex; align-items: center; justify-content: center; padding: 40px; }
    .card {
      position: relative; width: 100%; max-width: 380px; padding: 34px 32px 28px;
      background: linear-gradient(180deg, rgba(28,28,34,.86), rgba(16,16,20,.92));
      border: 1px solid var(--line-2); border-radius: 20px; backdrop-filter: blur(18px);
      box-shadow: 0 30px 80px rgba(0,0,0,.55);
    }
    .card::before { content: ""; position: absolute; top: 0; left: 22px; right: 22px; height: 2px; border-radius: 999px;
      background: linear-gradient(90deg, transparent, var(--red), var(--gold), transparent); }
    .back-home { position: absolute; top: -34px; left: 2px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--muted); transition: color .15s; }
    .back-home:hover { color: var(--gold); }
    .back-home svg { width: 14px; height: 14px; }

    .card-logo { display: none; align-items: center; gap: 11px; margin-bottom: 20px; }
    .eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; color: var(--gold); }
    .card h2 { margin-top: 8px; font-size: 26px; font-weight: 800; letter-spacing: -.5px; color: #fff; }
    .card .sub { margin-top: 5px; font-size: 14px; color: var(--muted); margin-bottom: 22px; }

    .error-box { display: flex; align-items: center; gap: 9px; background: rgba(225,29,42,.1); border: 1px solid rgba(225,29,42,.4);
      color: #fca5a5; border-radius: 10px; padding: 11px 13px; font-size: 13px; font-weight: 500; margin-bottom: 18px; }
    .error-box svg { width: 16px; height: 16px; flex-shrink: 0; }

    .group { margin-bottom: 16px; }
    .group label { display: block; font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 7px; letter-spacing: .2px; }
    .iwrap { position: relative; }
    .iwrap > .ic { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); width: 17px; height: 17px; color: var(--soft); pointer-events: none; }
    .inp {
      width: 100%; padding: 13px 14px 13px 40px; font-size: 16px; font-family: inherit; color: #fff;
      background: rgba(255,255,255,.04); border: 1.5px solid var(--line-2); border-radius: 11px; transition: border-color .15s, box-shadow .15s, background .15s;
    }
    .inp::placeholder { color: var(--soft); }
    .inp:focus { outline: none; border-color: var(--gold); background: rgba(255,255,255,.06); box-shadow: 0 0 0 3px rgba(245,179,1,.18); }
    .inp.has-toggle { padding-right: 44px; }
    .toggle-pw { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; display: grid; place-items: center;
      background: transparent; border: 0; cursor: pointer; color: var(--soft); border-radius: 8px; }
    .toggle-pw:hover { color: var(--gold); background: rgba(255,255,255,.05); }
    .toggle-pw svg { width: 18px; height: 18px; }
    .forgot { display: block; text-align: right; margin-top: 9px; font-size: 12.5px; font-weight: 600; color: var(--muted); transition: color .15s; }
    .forgot:hover { color: var(--gold); }

    .btn {
      width: 100%; margin-top: 8px; padding: 14px; font-size: 15px; font-weight: 800; font-family: inherit; letter-spacing: .2px;
      color: #fff; background: linear-gradient(135deg, var(--red), var(--red-deep)); border: 1px solid rgba(255,255,255,.14);
      border-radius: 11px; cursor: pointer; transition: transform .15s, box-shadow .15s; box-shadow: 0 12px 30px rgba(225,29,42,.4);
      display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgba(225,29,42,.55); }
    .btn:active { transform: translateY(0); }
    .btn[disabled] { opacity: .7; cursor: progress; transform: none; }
    .btn .spin { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .trust { display: flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 11.5px; color: var(--soft); }
    .trust .lock { width: 14px; height: 14px; color: var(--green); flex-shrink: 0; }
    .credit { margin-top: 16px; text-align: center; font-size: 11px; color: var(--soft); }
    .credit a { color: var(--gold); font-weight: 700; }

    /* Responsive */
    @media (max-width: 940px) {
      .auth { grid-template-columns: 1fr; }
      .brand-side { display: none; }
      .form-side { padding: 28px 20px; min-height: 100dvh; }
      .card { max-width: 400px; padding-top: 28px; }
      .card-logo { display: flex; }
      .back-home { position: static; margin-bottom: 16px; }
      .netmap { left: 50%; top: auto; bottom: 2%; transform: translateX(-50%); max-width: 80vw; opacity: .28; }
    }
    @media (max-width: 420px) {
      .form-side { padding: 18px 14px; }
      .card { padding: 24px 20px 22px; border-radius: 18px; }
      .card h2 { font-size: 23px; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
  </style>
</head>
<body>

  <div class="bg" aria-hidden="true">
    <div class="grid"></div>
    <span class="orb a"></span><span class="orb b"></span><span class="orb c"></span>
    <svg class="netmap" viewBox="0 0 400 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path class="route" d="M150 96 L210 78 L268 120 L240 196 L168 220 L120 168 Z"/>
      <path class="route hot" d="M150 96 L240 196"/>
      <path class="route" d="M210 78 L168 220"/><path class="route" d="M120 168 L268 120"/>
      <circle class="node hot" cx="150" cy="96" r="3.2"/><circle class="node" cx="210" cy="78" r="3"/>
      <circle class="node" cx="268" cy="120" r="3"/><circle class="node hot" cx="240" cy="196" r="3.2"/>
      <circle class="node" cx="168" cy="220" r="3"/><circle class="node" cx="120" cy="168" r="3"/>
      <circle class="node" cx="196" cy="150" r="2.4"/><circle class="node" cx="300" cy="170" r="2.4"/>
    </svg>
  </div>

  <main class="auth">
    <!-- Brand side (desktop) -->
    <section class="brand-side">
      <a class="brand-lockup" href="/welcome" aria-label="FLEET.HQ home">
        <span class="mark" aria-hidden="true"></span>
        <span class="wordmark">FLEET<b>.HQ</b><small>by 256 Logistics</small></span>
      </a>
      <div class="brand-head">
        <h1>One Platform.<br>Total <span class="accent">Control.</span></h1>
        <p>The operating system for transport companies — drivers, vehicles, compliance, tachographs and maintenance in one connected platform.</p>
      </div>
      <div class="pillars">
        <span class="pchip"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>Drivers</span>
        <span class="pchip"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 17H5a2 2 0 01-2-2V7a2 2 0 012-2h3m8 10h3a2 2 0 002-2V7a2 2 0 00-2-2h-3M8 17V7m8 10V7m-8 0l4-4m0 0l4 4m-4-4v14"/></svg>Vehicles</span>
        <span class="pchip hot"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>Compliance</span>
        <span class="pchip"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Tachographs</span>
        <span class="pchip"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 4a2 2 0 114 0 7 7 0 014 6 3 3 0 11-4 4 7 7 0 01-8 0 3 3 0 11-4-4 7 7 0 014-6z"/></svg>Maintenance</span>
      </div>
      <div class="stats">
        <div class="stat"><div class="n">5</div><div class="l">Operating domains</div></div>
        <div class="stat"><div class="n">DVSA</div><div class="l">Audit-ready</div></div>
        <div class="stat"><div class="n">24/7</div><div class="l">Monitoring</div></div>
      </div>
      <div class="powered">Powered by <b>256 Digital Technologies</b></div>
    </section>

    <!-- Form side -->
    <section class="form-side">
      <div class="card">
        <a class="back-home" href="/welcome">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
          Back to home
        </a>
        <a class="card-logo" href="/welcome" aria-label="FLEET.HQ home">
          <span class="mark" aria-hidden="true"></span>
          <span class="wordmark">FLEET<b>.HQ</b><small>by 256 Logistics</small></span>
        </a>

        <div class="eyebrow">Secure access</div>
        <h2>Welcome back</h2>
        <p class="sub">Sign in to your FLEET.HQ dashboard.</p>

        <% if (error) { %>
          <div class="error-box">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/login" id="loginForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="group">
            <label for="emailInput">Email address</label>
            <div class="iwrap">
              <svg class="ic" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <input class="inp" type="email" name="email" id="emailInput" placeholder="you@fleetshq.com" required autocomplete="username" autofocus>
            </div>
          </div>
          <div class="group">
            <label for="passInput">Password</label>
            <div class="iwrap">
              <svg class="ic" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <input class="inp has-toggle" type="password" name="password" id="passInput" placeholder="••••••••" required autocomplete="current-password">
              <button type="button" class="toggle-pw" id="togglePw" aria-label="Show password">
                <svg id="eyeOpen" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <svg id="eyeOff" style="display:none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
              </button>
            </div>
            <a class="forgot" href="/forgot-password">Forgot password?</a>
          </div>
          <button type="submit" class="btn" id="submitBtn">
            <span class="btn-label">Sign in to dashboard</span>
            <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
        </form>

        <div class="trust">
          <svg class="lock" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Encrypted session · JWT authenticated · UK-hosted
        </div>
        <div class="credit" style="margin-top:14px">New to FLEET.HQ? <a href="/register">Register your company</a></div>
        <div class="credit">Powered by <a href="https://ecadelgroup.com" target="_blank" rel="noopener">256 Digital Technologies</a></div>
      </div>
    </section>
  </main>

  <script>
    (function () {
      var form = document.getElementById('loginForm');
      var btn = document.getElementById('submitBtn');
      var toggle = document.getElementById('togglePw');
      var pw = document.getElementById('passInput');
      var eyeOpen = document.getElementById('eyeOpen');
      var eyeOff = document.getElementById('eyeOff');
      toggle.addEventListener('click', function () {
        var show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        eyeOpen.style.display = show ? 'none' : '';
        eyeOff.style.display = show ? '' : 'none';
        toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        pw.focus();
      });
      form.addEventListener('submit', function () {
        btn.disabled = true;
        btn.innerHTML = '<span class="spin"></span><span class="btn-label">Signing in…</span>';
      });
    }());
  </script>
</body>
</html>
