<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — 256 Logistics</title>
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; background:linear-gradient(135deg,#0f172a 0%,#123263 100%); padding:20px; }
    .auth-card { background:#fff; border-radius:16px; padding:34px; max-width:420px; width:100%; box-shadow:0 24px 70px rgba(0,0,0,.32); }
    .auth-card h1 { font-size:22px; margin-bottom:6px; color:#0f172a; }
    .auth-card p { color:#64748b; font-size:14px; line-height:1.6; margin-bottom:20px; }
    .auth-card .form-control { margin-bottom:14px; }
    .auth-card .btn { width:100%; justify-content:center; }
    .auth-error { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; border-radius:10px; padding:10px 14px; font-size:13px; margin-bottom:16px; }
  </style>
</head>
<body>
  <div class="auth-card">
    <% if (done) { %>
      <h1>Password updated</h1>
      <p>Your password has been changed successfully. You can now sign in with your new password.</p>
      <a class="btn btn-primary" href="/login">Sign in</a>
    <% } else { %>
      <h1>Set a new password</h1>
      <p>Choose a new password for your account.</p>
      <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
      <form method="POST" action="/reset-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= token %>">
        <input class="form-control" type="password" name="password" placeholder="New password (min 8, letters + numbers)" required minlength="8" autofocus autocomplete="new-password">
        <button type="submit" class="btn btn-primary">Update password</button>
      </form>
    <% } %>
  </div>
</body>
</html>
