<%- include('../layouts/main', { body: `
<div class="page-head">
  <div class="page-head-main">
    <div class="page-eyebrow">Fleet manager</div>
    <h1>Fuel management</h1>
    <p class="page-sub">Log fuel against each vehicle and watch cost and efficiency.</p>
  </div>
  <div class="page-head-actions"><a class="btn btn-outline" href="/fleet/overview">Fleet overview</a></div>
</div>

<div class="stat-grid mb-6">
  <div class="stat-card green"><div class="stat-icon green"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h6a2 2 0 002-2V7M3 7l2-3h6l2 3M3 7h10"/></svg></div><div><div class="stat-value">£${totals.spend.toFixed(2)}</div><div class="stat-label">Spend this month</div></div></div>
  <div class="stat-card blue"><div class="stat-icon blue"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg></div><div><div class="stat-value">${totals.litres.toFixed(0)} L</div><div class="stat-label">Litres this month</div></div></div>
  <div class="stat-card amber"><div class="stat-icon amber"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m-6 4h6m2 5a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v9"/></svg></div><div><div class="stat-value">£${totals.ppl.toFixed(2)}</div><div class="stat-label">Avg per litre</div><div class="stat-sub">${totals.count} fill-up${totals.count === 1 ? '' : 's'}</div></div></div>
</div>

<div class="grid-2">
  ${canLog ? `
  <div class="card">
    <div class="card-header"><h3>Log a fill-up</h3></div>
    <div class="card-body">
      <form method="post" action="/fleet/fuel">
        <input type="hidden" name="_csrf" value="${csrfToken}">
        <div class="form-group"><label class="form-label">Vehicle <span class="required">*</span></label>
          <select class="form-control" name="vehicleId" required><option value="">Choose…</option>${vehicles.map(v => `<option value="${esc(v.id)}">${esc(v.registration)}</option>`).join('')}</select>
        </div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Date</label><input class="form-control" type="date" name="loggedDate"></div>
          <div class="form-group"><label class="form-label">Odometer (mi)</label><input class="form-control" type="number" min="0" name="odometer"></div>
        </div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Litres</label><input class="form-control" type="number" min="0" step="0.01" name="litres" required></div>
          <div class="form-group"><label class="form-label">Cost (£)</label><input class="form-control" type="number" min="0" step="0.01" name="cost" required></div>
        </div>
        <div class="form-group"><label class="form-label">Fuel card</label><input class="form-control" name="fuelCard" placeholder="Card / reference"></div>
        <button class="btn btn-primary">Save fuel log</button>
      </form>
    </div>
  </div>` : ''}

  <div class="card" ${canLog ? '' : 'style="grid-column:1/-1"'}>
    <div class="card-header"><h3>Recent fill-ups</h3></div>
    ${logs.length === 0 ? `<div class="empty-state"><p>No fuel logged yet</p><div class="empty-hint">Logged fill-ups appear here with cost and efficiency.</div></div>` : `
    <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th>Vehicle</th><th>Litres</th><th>Cost</th><th>£/L</th><th>Odometer</th></tr></thead>
        <tbody>
          ${logs.map(l => `
            <tr>
              <td>${formatDate(l.loggedDate)}</td>
              <td style="font-weight:600">${esc(vehMap[l.vehicleId] || '—')}</td>
              <td>${Number(l.litres).toFixed(1)}</td>
              <td style="font-weight:700">£${Number(l.cost).toFixed(2)}</td>
              <td class="cell-muted">£${Number(l.litres) > 0 ? (Number(l.cost) / Number(l.litres)).toFixed(2) : '—'}</td>
              <td class="cell-muted">${l.odometer ? l.odometer.toLocaleString() : '—'}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    </div>`}
  </div>
</div>
` }) %>
