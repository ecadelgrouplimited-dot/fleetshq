              <strong style="color:#1e3a8a;">${plan.planOverviewDonut.completed} (${plan.planOverviewDonut.completedPercent}%)</strong>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="display:flex;align-items:center;gap:7px;color:#1e3a8a;font-weight:500;"><span style="width:11px;height:11px;border-radius:3px;background:#2563eb;"></span>In Progress</span>
              <strong style="color:#1e3a8a;">${plan.planOverviewDonut.inProgress} (${plan.planOverviewDonut.inProgressPercent}%)</strong>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="display:flex;align-items:center;gap:7px;color:#1e3a8a;font-weight:500;"><span style="width:11px;height:11px;border-radius:3px;background:#f97316;"></span>Not Started</span>
              <strong style="color:#1e3a8a;">${plan.planOverviewDonut.notStarted} (${plan.planOverviewDonut.notStartedPercent}%)</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Monthly Training Plan (Stacked Bar Chart) -->
      <div class="training-card" style="padding:14px 18px;">
        <div class="training-card-title" style="margin-bottom:10px;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="#2563eb"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
          Monthly Training Plan
