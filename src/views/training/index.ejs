<%- include('../layouts/main', { body: `
<div style="display:flex;gap:20px;margin-bottom:24px">
  <div class="card" style="flex:1;padding:20px;text-align:center">
    <div style="font-size:28px;font-weight:800;color:#10b981">${drivers.filter(d=>d.completionPercent===100).length}</div>
    <div class="text-sm text-muted">Fully Inducted</div>
  </div>
  <div class="card" style="flex:1;padding:20px;text-align:center">
    <div style="font-size:28px;font-weight:800;color:#f59e0b">${drivers.filter(d=>d.completionPercent>0&&d.completionPercent<100).length}</div>
    <div class="text-sm text-muted">In Progress</div>
  </div>
  <div class="card" style="flex:1;padding:20px;text-align:center">
    <div style="font-size:28px;font-weight:800;color:#ef4444">${drivers.filter(d=>d.completionPercent===0).length}</div>
    <div class="text-sm text-muted">Not Started</div>
  </div>
  <div class="card" style="flex:1;padding:20px;text-align:center">
    <div style="font-size:28px;font-weight:800;color:#3b82f6">${talks.length}</div>
    <div class="text-sm text-muted">Toolbox Talks (recent)</div>
  </div>
</div>

<div class="grid-2">
  <!-- Driver Training -->
  <div class="card">
    <div class="card-header"><h3>Driver Training Matrix</h3></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Driver</th><th>Completion</th><th>Progress</th></tr></thead>
        <tbody>
          ${drivers.map(d => `
            <tr>
              <td><a href="/employees/${d.id}" style="font-weight:600">${d.fullName}</a><div style="font-size:11px;color:#64748b">${d.jobTitle}</div></td>
              <td style="font-weight:700;color:${d.completionPercent >= 80 ? '#10b981' : d.completionPercent >= 60 ? '#f59e0b' : '#ef4444'}">${d.completionPercent}%</td>
              <td style="width:160px">
                <div class="progress-bar">
                  <div class="progress-bar-fill ${d.completionPercent >= 80 ? 'green' : d.completionPercent >= 60 ? 'amber' : 'red'}" style="width:${d.completionPercent}%"></div>
                </div>
              </td>
            </tr>
          `).join('')}
          ${drivers.length === 0 ? '<tr><td colspan="3" style="text-align:center;padding:24px;color:#64748b">No drivers found</td></tr>' : ''}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Toolbox Talks -->
  <div class="card">
    <div class="card-header">
      <h3>Toolbox Talks</h3>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Topic</th><th>Date</th><th>Signed</th><th>Manager Sign-Off</th></tr></thead>
        <tbody>
          ${talks.map(t => `
            <tr>
              <td style="font-weight:600">${t.topic}</td>
              <td style="font-size:12px;color:#64748b">${formatDate(t.dateIssued)}</td>
              <td>
                <span class="badge ${t.totalSigned === t.assignments.length && t.assignments.length > 0 ? 'badge-green' : 'badge-amber'}">
                  ${t.totalSigned}/${t.assignments.length}
                </span>
              </td>
              <td>
                ${t.managerSignedOff
                  ? '<span class="badge badge-green">Signed off</span>'
                  : '<span class="badge badge-amber">Pending</span>'}
              </td>
            </tr>
          `).join('')}
          ${talks.length === 0 ? '<tr><td colspan="4" style="text-align:center;padding:24px;color:#64748b">No toolbox talks yet</td></tr>' : ''}
        </tbody>
      </table>
    </div>
  </div>
</div>
` }) %>
