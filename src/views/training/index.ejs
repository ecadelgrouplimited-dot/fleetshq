<%- include('../layouts/main', { body: `
<link rel="stylesheet" href="/css/hr-hub.css?v=20261030v4">
<link rel="stylesheet" href="/css/training-hub.css?v=20261030v4">

<style>
  /* Inlined to bypass 30-day static CSS cache in server.js */
  .training-hub-container {
    padding: 18px 24px 36px;
    background-color: #f4f7fb;
    min-height: calc(100vh - 64px);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #1e293b;
  }
  .training-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
    gap: 16px;
  }
  .training-header-title {
    font-size: 26px;
    font-weight: 800;
    color: #1e3a8a;
    letter-spacing: -0.02em;
    margin: 0 0 3px 0;
    line-height: 1.15;
  }
  .training-header-sub {
    font-size: 13.5px;
    color: #1d4ed8;
    margin: 0;
    font-weight: 400;
  }
  .training-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .training-subnav {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0 8px;
    margin-bottom: 16px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    overflow-x: auto;
  }
  .training-subnav-item {
    padding: 11px 22px;
    font-size: 13px;
    font-weight: 600;
    color: #1e3a8a;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: all 0.15s ease;
    white-space: nowrap;
    position: relative;
  }
  .training-subnav-item:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0;
    top: 25%;
    height: 50%;
    width: 1px;
    background: #e2e8f0;
  }
  .training-subnav-item:hover {
    color: #2563eb;
    background: #f8fafc;
  }
  .training-subnav-item.active {
    color: #2563eb;
    font-weight: 700;
    border-bottom-color: #2563eb;
  }
  .training-kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-bottom: 16px;
  }
  .training-kpi-card {
    border-radius: 10px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }
  .training-kpi-card.kpi-tint-blue {
    background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
    border: 1px solid #dbeafe;
  }
  .training-kpi-card.kpi-tint-green {
    background: linear-gradient(135deg, #f0fdf4 0%, #f8fafc 100%);
    border: 1px solid #dcfce7;
  }
  .training-kpi-card.kpi-tint-amber {
    background: linear-gradient(135deg, #fffbeb 0%, #fff7ed 100%);
    border: 1px solid #fde68a;
  }
  .training-kpi-card.kpi-tint-amber-dark {
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1px solid #fed7aa;
  }
  .training-kpi-card.kpi-tint-red {
    background: linear-gradient(135deg, #fef2f2 0%, #fff5f5 100%);
    border: 1px solid #fecaca;
  }
  .training-kpi-card.kpi-tint-purple {
    background: linear-gradient(135deg, #f5f3ff 0%, #faf5ff 100%);
    border: 1px solid #ddd6fe;
  }
  .training-kpi-icon {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .training-kpi-val {
    font-size: 27px;
    font-weight: 800;
    line-height: 1.05;
    margin-bottom: 3px;
  }
  .training-kpi-title {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 2px;
  }
  .training-kpi-sub {
    font-size: 11.5px;
    font-weight: 500;
  }
  .training-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    margin-bottom: 16px;
    overflow: hidden;
  }
  .training-card-header {
    padding: 12px 16px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .training-card-title {
    font-size: 14.5px;
    font-weight: 700;
    color: #1e3a8a;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .training-3col-top {
    display: grid;
    grid-template-columns: 1.05fr 1.35fr 1.45fr;
    gap: 14px;
    margin-bottom: 16px;
  }
  .training-3col-top > .training-card,
  .training-3col-bottom > .training-card {
    margin-bottom: 0;
  }
  .training-3col-bottom {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.35fr;
    gap: 14px;
    margin-top: 16px;
  }
  .training-filter-bar {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 12px 16px;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .training-filter-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .training-filter-label {
    font-size: 11.5px;
    font-weight: 700;
    color: #1e3a8a;
  }
  .training-select,
  .training-input {
    height: 34px;
    padding: 0 10px;
    font-size: 12px;
    color: #1e3a8a;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    outline: none;
    font-weight: 500;
  }
  .training-select {
    padding-right: 24px;
    cursor: pointer;
  }
  .training-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .training-search-wrap svg {
    position: absolute;
    left: 10px;
    color: #1e3a8a;
    pointer-events: none;
  }
  .training-search-wrap .training-input {
    padding-left: 30px;
    width: 100%;
  }
  .training-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }
  .training-table th {
    background: #f8fafc;
    color: #1e3a8a;
    font-weight: 700;
    font-size: 11.5px;
    padding: 9px 12px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
    border-top: 1px solid #f1f5f9;
    white-space: nowrap;
  }
  .training-table td {
    padding: 7.5px 12px;
    border-bottom: 1px solid #f1f5f9;
    color: #1e3a8a;
    vertical-align: middle;
  }
  .training-table tbody tr:hover {
    background-color: #f8fafc;
  }
  .training-table tbody tr:last-child td {
    border-bottom: none;
  }
  .emp-profile-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #1d4ed8;
    font-weight: 500;
    font-size: 12.5px;
  }
  .emp-profile-link:hover {
    color: #1e40af;
    text-decoration: underline;
  }
  .emp-avatar-sm {
    width: 26px !important;
    height: 26px !important;
    min-width: 26px !important;
    max-width: 26px !important;
    min-height: 26px !important;
    max-height: 26px !important;
    border-radius: 50% !important;
    object-fit: cover !important;
    border: 1px solid #cbd5e1;
    background: #e2e8f0;
    display: inline-block;
    flex-shrink: 0;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 12px;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    min-width: 76px;
    text-align: center;
  }
  .badge-green { background: #dcfce7; color: #15803d; }
  .badge-amber { background: #fef3c7; color: #b45309; }
  .badge-yellow { background: #fef9c3; color: #a16207; }
  .badge-red { background: #fee2e2; color: #b91c1c; }
  .badge-blue { background: #dbeafe; color: #1d4ed8; }
  .badge-purple { background: #ede9fe; color: #6d28d9; }
  .badge-gray { background: #f1f5f9; color: #475569; }
  .badge-green-light {
    background: #dcfce7; color: #166534; font-weight: 700;
    width: 100%; display: inline-block; text-align: center; padding: 3px 6px; border-radius: 4px;
  }
  .badge-amber-light {
    background: #fef3c7; color: #92400e; font-weight: 700;
    width: 100%; display: inline-block; text-align: center; padding: 3px 6px; border-radius: 4px;
  }
  .badge-red-light {
    background: #fee2e2; color: #991b1b; font-weight: 700;
    width: 100%; display: inline-block; text-align: center; padding: 3px 6px; border-radius: 4px;
  }
  .mandatory-row {
    display: grid;
    grid-template-columns: 138px 1fr 48px 36px;
    align-items: center;
    gap: 10px;
    font-size: 12px;
  }
  .mandatory-bar-track {
    height: 10px;
    background: #cbd5e1;
    border-radius: 3px;
    overflow: hidden;
    display: flex;
  }
  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
  }
  .matrix-table th,
  .matrix-table td {
    border: 1px solid #e2e8f0;
    padding: 5px 4px;
    text-align: center;
    vertical-align: middle;
  }
  .matrix-cat-header {
    font-weight: 700;
    font-size: 11.5px;
    padding: 7px 6px !important;
  }
  .matrix-cat-blue { background: #dbeafe; color: #1e40af; }
  .matrix-cat-green { background: #dcfce7; color: #166534; }
  .matrix-cat-orange { background: #fef3c7; color: #9a3412; }
  .matrix-cat-purple { background: #ede9fe; color: #5b21b6; }
  .matrix-cell-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    line-height: 1.1;
  }
  .matrix-icon {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 800;
    color: #ffffff;
  }
  .matrix-icon.check { background: #16a34a; }
  .matrix-icon.alert { background: #f59e0b; }
  .matrix-icon.cross { background: #dc2626; }
  .matrix-icon.dash { background: #cbd5e1; border-radius: 4px; color: #ffffff; }
  .matrix-date {
    font-size: 9.5px;
    color: #1e3a8a;
    font-weight: 500;
  }
  .training-donut-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .training-donut-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }
  .training-donut-val {
    font-size: 22px;
    font-weight: 800;
    color: #1e3a8a;
    line-height: 1.05;
  }
  .training-donut-sub {
    font-size: 10.5px;
    color: #1d4ed8;
    font-weight: 600;
    margin-top: 2px;
  }
  .btn-primary-blue {
    background: #1d4ed8;
    color: #ffffff;
    border: 1px solid #1d4ed8;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn-primary-blue:hover { background: #1e40af; }
  .btn-secondary-white {
    background: #ffffff;
    color: #1d4ed8;
    border: 1px solid #93c5fd;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn-secondary-white:hover { background: #eff6ff; }
  .btn-action-outline {
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
    min-width: 96px;
    text-align: center;
  }
  .btn-action-outline:hover { background: #dbeafe; }
  .btn-dots {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #1e3a8a;
    cursor: pointer;
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }
  .btn-dots:hover { background: #f1f5f9; }
</style>

<div class="training-hub-container">

  <!-- Header Area -->
  <div class="training-header">
    <div>
      <h1 class="training-header-title">
        ${activeTab === 'records' ? 'Training Records' :
          activeTab === 'competency' ? 'Competency Matrix' :
          activeTab === 'expiry' ? 'Expiring Soon' :
          activeTab === 'plan' ? 'Training Plan' :
          activeTab === 'certificates' ? 'Certificates & Qualifications' :
          activeTab === 'reports' ? 'Training & Compliance Reports' :
          'Training & Competency'}
      </h1>
      <p class="training-header-sub">
        ${activeTab === 'records' ? 'View and manage all employee training records, certificates and expiry dates.' :
          activeTab === 'competency' ? 'Track employee competency, training status and expiry dates against required roles and legal requirements.' :
          activeTab === 'expiry' ? 'View all training, certificates and compliance items due to expire soon.' :
          activeTab === 'plan' ? 'Plan, schedule and track employee training to ensure compliance and continuous development.' :
          activeTab === 'certificates' ? 'View and download official training and compliance certification records.' :
          activeTab === 'reports' ? 'Periodic Driver CPC audit logs and qualifications reports.' :
          'Manage employee training, qualifications and competency records.'}
      </p>
    </div>

    <div class="training-header-actions">
      ${activeTab === 'records' ? `
        <button class="btn-primary-blue" onclick="document.getElementById('recordTrainingModal').style.display='flex'">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Training Record
        </button>
        <button class="btn-secondary-white" onclick="alert('Bulk upload dialog')">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Bulk Upload
        </button>
      ` : activeTab === 'competency' ? `
        <button class="btn-primary-blue" onclick="document.getElementById('recordTrainingModal').style.display='flex'">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add / Update Competency
        </button>
      ` : activeTab === 'expiry' ? `
        <!-- Expiring Soon has Export / Print / View All inside the Expiring Items card header per mockup 4 -->
      ` : activeTab === 'plan' ? `
        <button class="btn-primary-blue" onclick="document.getElementById('recordTrainingModal').style.display='flex'">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Training Plan
        </button>
        <button class="btn-secondary-white" onclick="alert('Downloading Training Plan...')">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download Plan
        </button>
      ` : `
        <button class="btn-primary-blue" onclick="document.getElementById('recordTrainingModal').style.display='flex'">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Record Training
        </button>
      `}
    </div>
  </div>

  <!-- Sub Navigation Tabs -->
  <div class="training-subnav">
    <a href="/training?tab=overview" class="training-subnav-item ${activeTab === 'overview' ? 'active' : ''}">Overview</a>
    <a href="/training?tab=records" class="training-subnav-item ${activeTab === 'records' ? 'active' : ''}">Training Records</a>
    <a href="/training?tab=competency" class="training-subnav-item ${activeTab === 'competency' ? 'active' : ''}">Competency Matrix</a>
    <a href="/training?tab=expiry" class="training-subnav-item ${activeTab === 'expiry' ? 'active' : ''}">Expiring Soon</a>
    <a href="/training?tab=plan" class="training-subnav-item ${activeTab === 'plan' ? 'active' : ''}">Training Plan</a>
    <a href="/training?tab=certificates" class="training-subnav-item ${activeTab === 'certificates' ? 'active' : ''}">Certificates</a>
    <a href="/training?tab=reports" class="training-subnav-item ${activeTab === 'reports' ? 'active' : ''}">Reports</a>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <!-- TAB 1: OVERVIEW (matches Training and Competency Dashboard 1.png)       -->
  <!-- ══════════════════════════════════════════════════════════════════════ -->
  ${activeTab === 'overview' ? `
    <!-- Top 5 KPI Grid -->
    <div class="training-kpi-grid">
      ${overview.kpis.map(kpi => {
        const tintClass = kpi.color === 'green' ? 'kpi-tint-green' : kpi.color === 'amber' ? 'kpi-tint-amber' : kpi.color === 'red' ? 'kpi-tint-red' : 'kpi-tint-blue';
        const valColor = kpi.color === 'green' ? '#15803d' : kpi.color === 'amber' ? '#ea580c' : kpi.color === 'red' ? '#dc2626' : '#1e3a8a';
        const titleColor = kpi.color === 'green' ? '#15803d' : kpi.color === 'amber' ? '#c2410c' : kpi.color === 'red' ? '#dc2626' : '#1d4ed8';
        return `
          <div class="training-kpi-card ${tintClass}">
            <div class="training-kpi-icon">
              ${kpi.icon === 'check-circle' ? `
                <svg width="42" height="42" viewBox="0 0 42 42" fill="none"><circle cx="21" cy="21" r="19" fill="#16a34a"/><path d="M13.5 21.5L18.5 26.5L28.5 16" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              ` : kpi.icon === 'clock' ? `
                <svg width="42" height="42" viewBox="0 0 42 42" fill="none"><circle cx="21" cy="21" r="19" fill="#f59e0b"/><path d="M21 11.5V21.5L27 25" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              ` : kpi.icon === 'alert-triangle' ? `
                <svg width="42" height="42" viewBox="0 0 42 42" fill="none"><path d="M18.4 6.5C19.55 4.5 22.45 4.5 23.6 6.5L37.4 30.5C38.55 32.5 37.1 35 34.8 35H7.2C4.9 35 3.45 32.5 4.6 30.5L18.4 6.5Z" fill="#dc2626"/><path d="M21 15V23.5" stroke="#fff" stroke-width="3.2" stroke-linecap="round"/><circle cx="21" cy="29.5" r="2" fill="#fff"/></svg>
              ` : kpi.icon === 'file-text' ? `
                <svg width="42" height="42" viewBox="0 0 42 42" fill="none"><rect x="7" y="4" width="24" height="32" rx="3" fill="#2563eb"/><path d="M13 13H25M13 19H25M13 25H21" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>
              ` : `
                <svg width="44" height="44" viewBox="0 0 44 44" fill="none"><path d="M22 8L4 17L22 26L40 17L22 8Z" fill="#2563eb"/><path d="M11 22V31C11 33.5 16 36 22 36C28 36 33 33.5 33 31V22L22 27.5L11 22Z" fill="#1d4ed8"/><path d="M38 18V29" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round"/></svg>
              `}
            </div>
            <div>
              <div class="training-kpi-val" style="color:${valColor};">${kpi.value}</div>
              <div class="training-kpi-title" style="color:${titleColor};">${kpi.title}</div>
              <div class="training-kpi-sub" style="color:${kpi.trend === 'up' ? '#15803d' : kpi.color === 'red' ? '#dc2626' : '#1e3a8a'};">
                ${kpi.trend === 'up' ? '<span style="font-weight:800;">↑ 4%</span> vs last year' :
                  kpi.id === 'compliant' ? '<strong style="color:#15803d;">86%</strong> of workforce' :
                  kpi.id === 'overdue' ? '<strong style="color:#dc2626;">7%</strong> of workforce' :
                  kpi.sub}
              </div>
            </div>
          </div>
        `;
      }).join('')}
    </div>

    <!-- 3-Col Top Grid (Compliance Rate, Mandatory Status, Upcoming Training) -->
    <div class="training-3col-top">

      <!-- Card 1: Training Compliance Rate -->
      <div class="training-card" style="padding:14px 18px;">
        <div class="training-card-title" style="margin-bottom:14px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#2563eb"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          Training Compliance Rate
        </div>
        <div style="display:flex;align-items:center;gap:20px;">
          <div class="training-donut-wrap" style="width:128px;height:128px;">
