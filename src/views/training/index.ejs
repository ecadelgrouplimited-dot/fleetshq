              <td style="font-weight:500;">${sr.course}</td>
              <td>${sr.provider}</td>
              <td style="padding:0;position:relative;height:38px;">
                <!-- 3-month background grid -->
                <div style="position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr);pointer-events:none;">
                  <div style="border-left:1px solid #f1f5f9;"></div>
                  <div style="border-left:1px solid #f1f5f9;"></div>
                  <div style="border-left:1px solid #e2e8f0;"></div>
                  <div style="border-left:1px solid #f1f5f9;"></div>
                  <div style="border-left:1px solid #e2e8f0;"></div>
                  <div style="border-left:1px solid #f1f5f9;"></div>
                </div>
                <!-- Gantt Bar -->
                <div style="position:absolute;top:7px;left:${sr.gantt.left};width:${sr.gantt.width};height:22px;background:${sr.gantt.color};color:${sr.gantt.textColor || '#ffffff'};border-radius:4px;font-size:11px;font-weight:600;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(0,0,0,0.08);white-space:nowrap;">
                  ${sr.gantt.label}
