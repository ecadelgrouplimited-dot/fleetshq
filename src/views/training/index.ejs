            <div style="display:flex;justify-content:space-between;padding:4px 4px 0;font-size:9.5px;color:#1e3a8a;font-weight:600;">
              ${plan.monthlyPlanStacked.map(mp => `<span>${mp.month}</span>`).join('')}
