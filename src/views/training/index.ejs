<%- include('../layouts/main', { body: `
<div style="display:flex;gap:20px;margin-bottom:24px">
  <div class="card" style="flex:1;padding:20px;text-align:center">
    <div style="font-size:28px;font-weight:800;color:var(--success)">${drivers.filter(d=>d.completionPercent===100).length}</div>
    <div class="text-sm text-muted">Fully Inducted</div>
  </div>
  <div class="card" style="flex:1;padding:20px;text-align:center">
    <div style="font-size:28px;font-weight:800;color:var(--warning)">${drivers.filter(d=>d.completionPercent>0&&d.completionPercent<100).length}</div>
    <div class="text-sm text-muted">In Progress</div>
  </div>
  <div class="card" style="flex:1;padding:20px;text-align:center">
    <div style="font-size:28px;font-weight:800;color:var(--danger)">${drivers.filter(d=>d.completionPercent===0).length}</div>
    <div class="text-sm text-muted">Not Started</div>
  </div>
  <div class="card" style="flex:1;padding:20px;text-align:center">
    <div style="font-size:28px;font-weight:800;color:var(--primary)">${talks.length}</div>
    <div class="text-sm text-muted">Toolbox Talks (recent)</div>
  </div>
</div>

<div class="grid-2">
  <!-- Driver Training -->
  <div class="card">
    <div class="card-header">
      <h3>Driver Training Matrix</h3>
      <input class="form-control" style="max-width:280px" data-live-search="#trainingTableBody" data-live-count="#visibleTrainingCount" data-live-empty="#noTrainingFound" placeholder="Search drivers, role, progress...">
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Driver</th><th>Completion</th><th>Progress</th></tr></thead>
        <tbody id="trainingTableBody">
          ${drivers.map(d => `
            <tr data-search-row data-search-text="${`${esc(d.fullName)} ${esc(d.jobTitle)} ${d.completionPercent}% ${d.completionPercent === 100 ? 'fully inducted' : d.completionPercent > 0 ? 'in progress' : 'not started'}`.toLowerCase()}">
              <td><a href="/employees/${d.id}" style="font-weight:600">${esc(d.fullName)}</a><div style="font-size:11px;color:var(--text-muted)">${esc(d.jobTitle)}</div></td>
              <td style="font-weight:700;color:${d.completionPercent >= 80 ? 'var(--success)' : d.completionPercent >= 60 ? 'var(--warning)' : 'var(--danger)'}">${d.completionPercent}%</td>
              <td style="width:160px">
                <div class="progress-bar">
                  <div class="progress-bar-fill ${d.completionPercent >= 80 ? 'green' : d.completionPercent >= 60 ? 'amber' : 'red'}" style="width:${d.completionPercent}%"></div>
                </div>
              </td>
            </tr>
          `).join('')}
          ${drivers.length === 0 ? '<tr><td colspan="3" style="text-align:center;padding:24px;color:var(--text-muted)">No drivers found</td></tr>' : ''}
          <tr id="noTrainingFound" style="display:none"><td colspan="3" style="text-align:center;padding:24px;color:var(--text-muted)">No drivers match your search</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Toolbox Talks -->
  <div class="card">
    <div class="card-header">
      <h3>Toolbox Talks</h3>
      <input class="form-control" style="max-width:280px" data-live-search="#toolboxTableBody" data-live-empty="#noToolboxFound" placeholder="Search talks, dates, sign-off...">
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Topic</th><th>Date</th><th>Signed</th><th>Manager Sign-Off</th></tr></thead>
        <tbody id="toolboxTableBody">
          ${talks.map(t => `
            <tr data-search-row data-search-text="${`${t.topic} ${formatDate(t.dateIssued)} ${t.managerSignedOff ? 'signed off' : 'pending'} ${t.totalSigned}/${t.assignments.length}`.toLowerCase()}">
              <td style="font-weight:600">${t.topic}</td>
              <td style="font-size:12px;color:var(--text-muted)">${formatDate(t.dateIssued)}</td>
              <td>
                <span class="badge ${t.totalSigned === t.assignments.length && t.assignments.length > 0 ? 'badge-green' : 'badge-amber'}">
                  ${t.totalSigned}/${t.assignments.length}
                </span>
              </td>
              <td>
                ${t.managerSignedOff
                  ? '<span class="badge badge-green">Signed off</span>'
                  : '<span class="badge badge-amber">Pending</span>'}
              </td>
            </tr>
          `).join('')}
          ${talks.length === 0 ? '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--text-muted)">No toolbox talks yet</td></tr>' : ''}
          <tr id="noToolboxFound" style="display:none"><td colspan="4" style="text-align:center;padding:24px;color:var(--text-muted)">No toolbox talks match your search</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
` }) %>
