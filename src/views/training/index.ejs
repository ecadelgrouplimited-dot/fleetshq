          <span style="display:inline-flex;align-items:center;gap:4px;"><span style="width:9px;height:9px;background:#2563eb;border-radius:2px;"></span>In Progress</span>
          <span style="display:inline-flex;align-items:center;gap:4px;"><span style="width:9px;height:9px;background:#f97316;border-radius:2px;"></span>Not Started</span>
        </div>
        <div style="display:flex;gap:6px;align-items:stretch;height:145px;">
          <div style="display:flex;flex-direction:column;justify-content:space-between;font-size:10px;color:#1e3a8a;font-weight:600;padding-bottom:18px;text-align:right;width:16px;">
