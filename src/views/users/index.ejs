<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <p class="text-sm text-muted"><span id="visibleUserCount">${users.length}</span> of ${users.length} system users</p>
  <div class="flex gap-2">
    <button class="btn btn-outline" id="fromEmployeesBtn">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M9 20H4v-2a3 3 0 015.356-1.857M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      From employees
    </button>
    <button class="btn btn-primary" onclick="document.getElementById('addUserModal').style.display='flex'">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Add User
    </button>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body" style="padding:14px 20px">
    <div class="filter-form">
      <div class="filter-search">
        <label class="form-label">Search users</label>
        <input class="form-control" data-live-search="#usersTableBody" data-live-count="#visibleUserCount" data-live-empty="#noUsersFound" placeholder="Name, email, role, status...">
      </div>
      <button class="btn btn-ghost" type="button" onclick="document.querySelector('[data-live-search]').value='';document.querySelector('[data-live-search]').dispatchEvent(new Event('input'))">Clear</button>
    </div>
  </div>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Name</th><th>Email</th><th>Roles</th><th>Last Login</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody id="usersTableBody">
        ${users.map(u => `
          <tr data-search-row data-search-text="${`${esc(u.firstName)} ${esc(u.lastName)} ${esc(u.email)} ${(u.roles && u.roles.length ? u.roles : [u.role]).join(' ')} ${u.isActive ? 'active' : 'inactive'}`.toLowerCase()}">
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#3b82f6,#7c3aed);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;flex-shrink:0">${esc(u.firstName.charAt(0))}</div>
                <span class="fw-600">${esc(u.firstName)} ${esc(u.lastName)}</span>
              </div>
            </td>
            <td class="cell-muted">${esc(u.email)}</td>
            <td>
              <div class="role-chip-list">
                ${(u.roles && u.roles.length ? u.roles : [u.role]).map(r => `<span class="badge ${r === 'director' || r === 'super_admin' ? 'badge-purple' : r === 'transport_manager' || r === 'fleet_manager' ? 'badge-blue' : r === 'hr_manager' || r === 'trainer' ? 'badge-cyan' : r === 'driver' || r === 'client' ? 'badge-slate' : 'badge-green'}">${roleLabel ? roleLabel(r) : r.replace(/_/g,' ')}</span>`).join('')}
              </div>
            </td>
            <td class="cell-muted">${u.lastLoginAt ? formatDate(u.lastLoginAt) : 'Never'}</td>
            <td>
              <span class="badge ${u.isActive ? 'badge-green' : 'badge-red'}">${u.isActive ? 'Active' : 'Inactive'}</span>
            </td>
            <td>
              <div class="flex gap-2" style="flex-wrap:wrap">
                <button data-edit-user data-id="${u.id}" data-first="${esc(u.firstName)}" data-last="${esc(u.lastName)}" data-phone="${esc(u.phone || '')}" data-active="${u.isActive ? 'true' : 'false'}" data-roles="${esc((u.roles && u.roles.length ? u.roles : [u.role]).join(','))}" data-branches="${esc((u.branchIds || []).join(','))}" class="btn btn-ghost btn-sm">Edit</button>
                <button data-reset-user data-id="${u.id}" data-name="${esc(u.firstName)} ${esc(u.lastName)}" class="btn btn-outline btn-sm">Reset PW</button>
                ${u.isActive
                  ? `<button data-toggle-user data-id="${u.id}" data-to="false" class="btn btn-ghost btn-sm">Deactivate</button>`
                  : `<button data-toggle-user data-id="${u.id}" data-to="true" class="btn btn-success btn-sm">Reactivate</button>`}
                <button data-delete-user data-id="${u.id}" data-name="${esc(u.firstName)} ${esc(u.lastName)}" class="btn btn-danger-soft btn-sm">Delete</button>
              </div>
            </td>
          </tr>
        `).join('')}
        <tr id="noUsersFound" style="display:none">
          <td colspan="6">
            <div class="empty-state">
              <p>No users match your search</p>
              <div class="empty-hint">Clear the search to see everyone again</div>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Add User Modal -->
<div id="addUserModal" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-header">
      <h3>Add System User</h3>
      <button onclick="document.getElementById('addUserModal').style.display='none'" class="btn btn-ghost btn-sm">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">First Name <span class="required">*</span></label>
          <input class="form-control" id="uFirstName" placeholder="First name">
        </div>
        <div class="form-group">
          <label class="form-label">Last Name <span class="required">*</span></label>
          <input class="form-control" id="uLastName" placeholder="Last name">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Email <span class="required">*</span></label>
        <input class="form-control" id="uEmail" type="email" placeholder="user@256logisticsltd.com">
      </div>
      <div class="form-group">
        <label class="form-label">Roles <span class="required">*</span></label>
        <select class="form-control" id="uRoles" multiple size="8">
          ${roleOptions.map(r => `<option value="${r.value}" ${r.value === 'driver' ? 'selected' : ''}>${esc(r.label)}</option>`).join('')}
        </select>
        <div class="form-hint">Hold Ctrl/Cmd to assign more than one panel role.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Branches</label>
        <select class="form-control" id="uBranchIds" multiple size="5">
          ${(branches || []).map(b => `<option value="${b.id}">${esc(b.name)}</option>`).join('')}
        </select>
        <div class="form-hint">Leave empty for all branches / not branch-limited.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Temporary Password <span class="required">*</span></label>
        <input class="form-control" id="uPass" type="password" placeholder="Min. 8 characters">
      </div>
    </div>
    <div class="modal-footer">
      <button onclick="document.getElementById('addUserModal').style.display='none'" class="btn btn-ghost">Cancel</button>
      <button onclick="createUser()" class="btn btn-primary">Create User</button>
    </div>
  </div>
</div>

<!-- Edit User Modal -->
<div id="editUserModal" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-header">
      <h3>Edit User</h3>
      <button onclick="closeModal('editUserModal')" class="btn btn-ghost btn-sm">âœ•</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="editUserId">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">First Name</label>
          <input class="form-control" id="editFirstName">
        </div>
        <div class="form-group">
          <label class="form-label">Last Name</label>
          <input class="form-control" id="editLastName">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Phone</label>
        <input class="form-control" id="editPhone" placeholder="Optional phone number">
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
          <input type="checkbox" id="editIsActive" style="width:16px;height:16px">
          <span style="font-size:13px;font-weight:600">Active account</span>
        </label>
      </div>
      <div class="form-group">
        <label class="form-label">Roles</label>
        <select class="form-control" id="editRoles" multiple size="8">
          ${roleOptions.map(r => `<option value="${r.value}">${esc(r.label)}</option>`).join('')}
        </select>
        <div class="form-hint">The first selected role is kept as the primary compatibility role.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Branches</label>
        <select class="form-control" id="editBranchIds" multiple size="5">
          ${(branches || []).map(b => `<option value="${b.id}">${esc(b.name)}</option>`).join('')}
        </select>
        <div class="form-hint">Leave empty for all branches / not branch-limited.</div>
      </div>
    </div>
    <div class="modal-footer">
      <button onclick="closeModal('editUserModal')" class="btn btn-ghost">Cancel</button>
      <button onclick="saveUserEdit()" class="btn btn-primary">Save Changes</button>
    </div>
  </div>
</div>

<!-- Reset Password Modal -->
<div id="resetPasswordModal" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-header">
      <h3>Reset Password</h3>
      <button onclick="closeModal('resetPasswordModal')" class="btn btn-ghost btn-sm">âœ•</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="resetUserId">
      <div class="form-group">
        <label class="form-label">User</label>
        <div id="resetUserName" class="form-control" style="display:flex;align-items:center;background:#f8fafc"></div>
      </div>
      <div class="form-group">
        <label class="form-label">New Temporary Password</label>
        <input class="form-control" id="resetPasswordValue" type="password" placeholder="Minimum 8 characters">
      </div>
    </div>
    <div class="modal-footer">
      <button onclick="closeModal('resetPasswordModal')" class="btn btn-ghost">Cancel</button>
      <button onclick="submitPasswordReset()" class="btn btn-primary">Reset Password</button>
    </div>
  </div>
</div>

<!-- Create logins from employees -->
<div id="fromEmployeesModal" class="modal-overlay" style="display:none">
  <div class="modal" style="max-width:700px">
    <div class="modal-header">
      <h3>Create logins from employees</h3>
      <button onclick="closeModal('fromEmployeesModal')" class="btn btn-ghost btn-sm">✕</button>
    </div>
    <div class="modal-body" id="feBody">
      ${eligibleEmployees.length === 0 ? `
        <div class="empty-state"><p>Everyone already has an account</p><div class="empty-hint">All active employees with an email address already have a login.</div></div>
      ` : `
        <p class="text-sm text-muted" style="margin-bottom:12px">${eligibleEmployees.length} active employee${eligibleEmployees.length !== 1 ? 's' : ''} with an email address ${eligibleEmployees.length !== 1 ? 'have' : 'has'} no login yet. Select who should get an account — we'll link each login to their employee record and generate a temporary password.</p>
        <div class="fe-controls">
          <label class="fe-selectall"><input type="checkbox" id="feSelectAll"> Select all</label>
          <div class="fe-role">
            <label class="form-label" style="margin:0 0 0 auto">Role</label>
            <select class="form-control" id="feRole" style="width:auto">
              ${roleOptions.map(r => `<option value="${r.value}" ${r.value === 'driver' ? 'selected' : ''}>${esc(r.label)}</option>`).join('')}
            </select>
          </div>
        </div>
        <div class="fe-list">
          ${eligibleEmployees.map(e => `
            <label class="fe-row">
              <input type="checkbox" class="fe-check" value="${e.id}">
              <div class="fe-person">
                <strong>${esc(e.fullName)}</strong>
                <span>${esc(e.email)}${e.jobTitle ? ' · ' + esc(e.jobTitle) : ''}</span>
              </div>
              ${e.isDriver ? '<span class="badge badge-blue">Driver</span>' : ''}
            </label>
          `).join('')}
        </div>
      `}
    </div>
    <div class="modal-footer" id="feFooter">
      <button onclick="closeModal('fromEmployeesModal')" class="btn btn-ghost">Cancel</button>
      ${eligibleEmployees.length ? `<button class="btn btn-primary" id="feCreateBtn" disabled><span id="feCount">0</span> selected — Create logins</button>` : ''}
    </div>
  </div>
</div>

<style>
  .fe-controls { display:flex; align-items:center; gap:14px; padding:8px 0 12px; border-bottom:1px solid var(--mac-hairline); margin-bottom:8px; }
  .fe-selectall { display:inline-flex; align-items:center; gap:8px; font-size:13px; font-weight:600; cursor:pointer; }
  .fe-role { display:flex; align-items:center; gap:8px; margin-left:auto; }
  .fe-list { max-height:340px; overflow:auto; display:flex; flex-direction:column; gap:6px; }
  .fe-row { display:flex; align-items:center; gap:12px; padding:9px 12px; border:1px solid var(--border); border-radius:10px; cursor:pointer; }
  .fe-row:hover { background:#f8fafc; }
  .fe-person { display:flex; flex-direction:column; min-width:0; flex:1; }
  .fe-person strong { font-size:13px; }
  .fe-person span { font-size:11.5px; color:var(--text-muted); }
  .fe-alert { background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; border-radius:10px; padding:10px 14px; font-size:12.5px; margin-bottom:12px; }
  #feBody code { background:#f1f5f9; padding:2px 6px; border-radius:5px; font-size:12px; font-weight:700; }
  .role-chip-list { display:flex; flex-wrap:wrap; gap:5px; }
  .form-hint { margin-top:5px; color:var(--text-muted); font-size:11.5px; }
</style>

<script>
document.querySelectorAll('[data-edit-user]').forEach(b => b.addEventListener('click', () => openEditUser(b.dataset.id, b.dataset.first, b.dataset.last, b.dataset.phone, b.dataset.active === 'true', b.dataset.roles, b.dataset.branches)));
document.querySelectorAll('[data-reset-user]').forEach(b => b.addEventListener('click', () => openResetPassword(b.dataset.id, b.dataset.name)));
document.querySelectorAll('[data-toggle-user]').forEach(b => b.addEventListener('click', () => toggleUser(b.dataset.id, b.dataset.to === 'true')));
document.querySelectorAll('[data-delete-user]').forEach(b => b.addEventListener('click', () => confirmDeleteUser(b.dataset.id, b.dataset.name)));
function closeModal(id) {
  document.getElementById(id).style.display = 'none';
}

async function createUser() {
  const selectedRoles = Array.prototype.slice.call(document.getElementById('uRoles').selectedOptions).map(o => o.value);
  const body = {
    firstName: document.getElementById('uFirstName').value,
    lastName: document.getElementById('uLastName').value,
    email: document.getElementById('uEmail').value,
    password: document.getElementById('uPass').value,
    role: selectedRoles[0],
    roles: selectedRoles,
    branchIds: Array.prototype.slice.call(document.getElementById('uBranchIds').selectedOptions).map(o => o.value),
  };
  const res = await fetch('/api/v1/users', {
    method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  if (res.ok) { showToast('User created successfully', 'success'); setTimeout(() => location.reload(), 1200); }
  else { const e = await res.json(); showToast(e.error?.message || 'Failed', 'error'); }
  document.getElementById('addUserModal').style.display = 'none';
}

function openEditUser(id, firstName, lastName, phone, isActive, roles, branches) {
  document.getElementById('editUserId').value = id;
  document.getElementById('editFirstName').value = firstName;
  document.getElementById('editLastName').value = lastName;
  document.getElementById('editPhone').value = phone || '';
  document.getElementById('editIsActive').checked = Boolean(isActive);
  var selectedRoles = String(roles || '').split(',').filter(Boolean);
  Array.prototype.slice.call(document.getElementById('editRoles').options).forEach(function(option){
    option.selected = selectedRoles.indexOf(option.value) !== -1;
  });
  var selectedBranches = String(branches || '').split(',').filter(Boolean);
  Array.prototype.slice.call(document.getElementById('editBranchIds').options).forEach(function(option){
    option.selected = selectedBranches.indexOf(option.value) !== -1;
  });
  document.getElementById('editUserModal').style.display = 'flex';
}

async function saveUserEdit() {
  const id = document.getElementById('editUserId').value;
  const selectedRoles = Array.prototype.slice.call(document.getElementById('editRoles').selectedOptions).map(o => o.value);
  const body = {
    firstName: document.getElementById('editFirstName').value,
    lastName: document.getElementById('editLastName').value,
    phone: document.getElementById('editPhone').value,
    isActive: document.getElementById('editIsActive').checked,
    role: selectedRoles[0],
    roles: selectedRoles,
    branchIds: Array.prototype.slice.call(document.getElementById('editBranchIds').selectedOptions).map(o => o.value),
  };
  const res = await fetch('/api/v1/users/' + id, {
    method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  if (res.ok) { showToast('User updated successfully', 'success'); setTimeout(() => location.reload(), 1000); }
  else { const e = await res.json(); showToast(e.error?.message || 'Update failed', 'error'); }
  closeModal('editUserModal');
}

function openResetPassword(id, name) {
  document.getElementById('resetUserId').value = id;
  document.getElementById('resetUserName').textContent = name;
  document.getElementById('resetPasswordValue').value = '';
  document.getElementById('resetPasswordModal').style.display = 'flex';
}

async function submitPasswordReset() {
  const id = document.getElementById('resetUserId').value;
  const newPassword = document.getElementById('resetPasswordValue').value;
  const res = await fetch('/api/v1/users/' + id + '/reset-password', {
    method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ newPassword }),
  });
  if (res.ok) { showToast('Password reset successfully', 'success'); }
  else { const e = await res.json(); showToast(e.error?.message || 'Reset failed', 'error'); }
  closeModal('resetPasswordModal');
}

async function toggleUser(id, active) {
  const res = await fetch('/api/v1/users/' + id, {
    method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ isActive: active }),
  });
  if (res.ok) { showToast(active ? 'User reactivated' : 'User deactivated', 'success'); setTimeout(() => location.reload(), 1000); }
  else {
    const e = await res.json();
    showToast(e.error?.message || 'Action failed', 'error');
  }
}

async function confirmDeleteUser(id, name) {
  const confirmed = await showConfirmDialog({
    title: 'Delete User Account',
    message: 'Delete the user account for ' + name + '? This only works when the user has no audit-owned records.',
    confirmLabel: 'Delete User',
    cancelLabel: 'Cancel',
    tone: 'danger'
  });
  if (!confirmed) return;
  const res = await fetch('/api/v1/users/' + id, {
    method: 'DELETE', credentials: 'same-origin',
  });
  if (res.ok) { showToast('User deleted successfully', 'success'); setTimeout(() => location.reload(), 1000); }
  else {
    const e = await res.json();
    showToast(e.error?.message || 'Delete failed', 'error');
  }
}

// ── Create logins from employees ──────────────────────────────────────
(function(){
  var modal = document.getElementById('fromEmployeesModal');
  var openBtn = document.getElementById('fromEmployeesBtn');
  if (openBtn) openBtn.addEventListener('click', function(){ modal.style.display = 'flex'; });
  var selectAll = document.getElementById('feSelectAll');
  var createBtn = document.getElementById('feCreateBtn');
  function escJs(v){ return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function checks(){ return Array.prototype.slice.call(document.querySelectorAll('.fe-check')); }
  function updateCount(){ var n = checks().filter(function(c){return c.checked;}).length; var el=document.getElementById('feCount'); if(el) el.textContent=n; if(createBtn) createBtn.disabled = n===0; }
  if (selectAll) selectAll.addEventListener('change', function(){ checks().forEach(function(c){ c.checked = selectAll.checked; }); updateCount(); });
  if (modal) modal.addEventListener('change', function(e){ if(e.target.classList && e.target.classList.contains('fe-check')) updateCount(); });
  updateCount();

  if (createBtn) createBtn.addEventListener('click', async function(){
    var ids = checks().filter(function(c){return c.checked;}).map(function(c){return c.value;});
    if (!ids.length) return;
    var role = document.getElementById('feRole').value;
    createBtn.disabled = true; createBtn.textContent = 'Creating…';
    try {
      var res = await apiCall('POST', '/api/v1/users/from-employees', { employeeIds: ids, role: role });
      renderResults(res.data, role);
    } catch(e){ showToast(e.message || 'Failed to create logins', 'error'); createBtn.disabled = false; updateCount(); }
  });

  function renderResults(d, role){
    var created = d.results.filter(function(r){ return r.status === 'created'; });
    var rows = d.results.map(function(r){
      var badge = r.status==='created'?'badge-green':r.status==='skipped'?'badge-amber':'badge-red';
      var pw = r.tempPassword ? '<code>'+escJs(r.tempPassword)+'</code>' : '<span class="cell-muted">'+escJs(r.message||'-')+'</span>';
      return '<tr><td class="fw-600">'+escJs(r.name||'-')+'</td><td class="cell-muted">'+escJs(r.email||'-')+'</td><td>'+pw+'</td><td><span class="badge '+badge+'">'+r.status+'</span></td></tr>';
    }).join('');
    document.getElementById('feBody').innerHTML =
      '<div class="fe-alert">'+d.summary.created+' account(s) created · '+d.summary.skipped+' skipped · '+d.summary.failed+' failed. <strong>Copy these temporary passwords now — they are shown only once.</strong> Ask each person to change theirs after first login.</div>'+
      '<div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Temp password</th><th>Status</th></tr></thead><tbody>'+rows+'</tbody></table></div>';
    var footer = document.getElementById('feFooter');
    footer.innerHTML = (created.length ? '<button class="btn btn-ghost" id="feDownload">Download credentials (CSV)</button>' : '') + '<button class="btn btn-primary" onclick="location.reload()">Done</button>';
    var dl = document.getElementById('feDownload');
    if (dl) dl.addEventListener('click', function(){
      var csv = 'name,email,temp_password,role\\n' + created.map(function(r){ return '"'+String(r.name||'').replace(/"/g,'""')+'","'+r.email+'","'+r.tempPassword+'","'+role+'"'; }).join('\\n');
      var blob = new Blob([csv], { type:'text/csv;charset=utf-8' });
      var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = '256-new-logins.csv'; a.click(); URL.revokeObjectURL(a.href);
    });
    showToast(d.summary.created + ' login(s) created', d.summary.failed ? 'warning' : 'success');
  }
})();
</script>

<style>
  .btn-danger-soft { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
  .btn-danger-soft:hover { background:#fee2e2; }
</style>
` }) %>
