<%- include('../layouts/main', { body: `
${(() => {
  const rows = workers.map(w => {
    const visaDays = daysUntil(w.visaExpiryDate);
    const rtwDays = w.rightToWorkFollowupDate ? daysUntil(w.rightToWorkFollowupDate) : null;
    const salaryMatch = Number(w.salaryOnCos) === Number(w.actualSalary);
    const unreported = (w.changes || []).length;
    const flags = [];
    if (visaDays !== null && visaDays <= 30) flags.push('visa');
    if (rtwDays !== null && rtwDays <= 14) flags.push('rtw');
    if (!salaryMatch) flags.push('salary');
    if (unreported > 0) flags.push('changes');
    const atRisk = flags.length > 0;
    return { w, visaDays, rtwDays, salaryMatch, unreported, flags, atRisk };
  });

  const incompleteList = (typeof incomplete !== 'undefined' && incomplete) ? incomplete : [];
  const eligible = (typeof eligibleEmployees !== 'undefined' && eligibleEmployees) ? eligibleEmployees : [];
  const stats = {
    total: rows.length,
    incomplete: incompleteList.length,
    visa: rows.filter(r => r.flags.includes('visa')).length,
    rtw: rows.filter(r => r.flags.includes('rtw')).length,
    salary: rows.filter(r => r.flags.includes('salary')).length,
    changes: rows.filter(r => r.flags.includes('changes')).length,
    clear: rows.filter(r => !r.atRisk).length,
  };
  // Sponsored employees missing their compliance record are NOT compliant — count them in the roster total.
  const grandTotal = stats.total + stats.incomplete;
  const compliancePct = grandTotal ? Math.round((stats.clear / grandTotal) * 100) : 100;

  const initials = (name) => name.split(' ').filter(Boolean).slice(0,2).map(p => p[0]).join('').toUpperCase();
  const avatarHue = (name) => { let h=0; for (const c of name) h=(h*31+c.charCodeAt(0))%360; return h; };

  return `
  <div class="page-head">
    <div class="page-head-main">
      <div class="page-eyebrow">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        People / Sponsored Workers
      </div>
      <h1>Sponsored Workers</h1>
      <p class="page-sub">Live Home Office sponsorship compliance — visas, right-to-work follow-ups, salary alignment, and unreported changes across your licensed roster.</p>
    </div>
    <div class="page-head-actions">
      <div class="sponsor-readiness">
        <div class="sponsor-readiness-ring" style="--pct:${compliancePct}">
          <span>${compliancePct}%</span>
        </div>
        <div>
          <div class="sponsor-readiness-label">Roster ready</div>
          <div class="sponsor-readiness-sub">${stats.clear}/${grandTotal} fully clear</div>
        </div>
      </div>
      <button type="button" class="btn btn-primary" id="addSponsoredBtn">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add sponsored worker
      </button>
      <a href="/audit-evidence/sponsored" class="btn btn-outline">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l4-4m-4 4l-4-4M4 17v1a2 2 0 002 2h12a2 2 0 002-2v-1"/></svg>
        Export pack
      </a>
    </div>
  </div>

  ${incompleteList.length ? `
  <div class="incomplete-banner">
    <div class="incomplete-head">
      <div class="incomplete-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg></div>
      <div>
        <strong>${incompleteList.length} sponsored ${incompleteList.length === 1 ? 'employee needs' : 'employees need'} compliance details</strong>
        <p>These staff are marked as sponsored but have no CoS, visa or right-to-work record yet — add their details to start tracking compliance.</p>
      </div>
    </div>
    <div class="incomplete-list">
      ${incompleteList.map(emp => `
        <div class="incomplete-row">
          <div class="incomplete-person">
            <span class="mac-avatar" style="background:linear-gradient(135deg,hsl(${avatarHue(emp.fullName)},70%,58%),hsl(${(avatarHue(emp.fullName)+40)%360},68%,48%))">${esc(initials(emp.fullName))}</span>
            <div><strong>${esc(emp.fullName)}</strong><span>${esc(emp.jobTitle || '')}${emp.department ? ' · ' + esc(emp.department) : ''}</span></div>
          </div>
          <button type="button" class="btn btn-primary btn-sm complete-sponsor" data-emp="${emp.id}" data-name="${esc(emp.fullName)}">Add details</button>
        </div>
      `).join('')}
    </div>
  </div>` : ''}

  <div class="stat-grid mb-4">
    <button type="button" class="stat-card blue sponsor-stat" data-filter="all">
      <div class="stat-icon blue"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M9 7a3 3 0 106 0 3 3 0 00-6 0z"/></svg></div>
      <div><div class="stat-value">${grandTotal}</div><div class="stat-label">Sponsored Workers</div><div class="stat-sub">${stats.clear} fully compliant${stats.incomplete ? ` · ${stats.incomplete} need details` : ''}</div></div>
    </button>
    <button type="button" class="stat-card ${stats.visa ? 'red' : 'green'} sponsor-stat" data-filter="visa">
      <div class="stat-icon ${stats.visa ? 'red' : 'green'}"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
      <div><div class="stat-value">${stats.visa}</div><div class="stat-label">Visa Expiring</div><div class="stat-sub">within 30 days</div></div>
    </button>
    <button type="button" class="stat-card ${stats.rtw ? 'amber' : 'green'} sponsor-stat" data-filter="rtw">
      <div class="stat-icon ${stats.rtw ? 'amber' : 'green'}"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
      <div><div class="stat-value">${stats.rtw}</div><div class="stat-label">RTW Follow-Up Due</div><div class="stat-sub">within 14 days</div></div>
    </button>
    <button type="button" class="stat-card ${stats.salary ? 'red' : 'green'} sponsor-stat" data-filter="salary">
      <div class="stat-icon ${stats.salary ? 'red' : 'green'}"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
      <div><div class="stat-value">${stats.salary}</div><div class="stat-label">Salary Mismatch</div><div class="stat-sub">CoS vs actual</div></div>
    </button>
    <button type="button" class="stat-card ${stats.changes ? 'amber' : 'green'} sponsor-stat" data-filter="changes">
      <div class="stat-icon ${stats.changes ? 'amber' : 'green'}"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"/></svg></div>
      <div><div class="stat-value">${stats.changes}</div><div class="stat-label">Unreported Changes</div><div class="stat-sub">need Home Office report</div></div>
    </button>
  </div>

  <div class="mac-window" id="sponsorWindow">
    <div class="mac-titlebar">
      <div class="mac-traffic"><i class="r"></i><i class="y"></i><i class="g"></i></div>
      <div class="mac-title">Roster <span class="mac-title-sub">— <span id="sponsorVisible">${rows.length}</span> of ${rows.length} workers</span></div>
      <div class="mac-titlebar-actions">
        <label class="search-field">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 110-15 7.5 7.5 0 010 15z"/></svg>
          <input id="sponsorSearch" type="search" placeholder="Search name, CoS, job…" autocomplete="off">
        </label>
      </div>
    </div>

    <div class="toolbar">
      <div class="segmented" id="sponsorSegments">
        <button class="active" data-filter="all">All <span class="seg-count">${stats.total}</span></button>
        <button data-filter="risk">Needs attention <span class="seg-count">${stats.total - stats.clear}</span></button>
        <button data-filter="visa">Visa <span class="seg-count">${stats.visa}</span></button>
        <button data-filter="rtw">RTW <span class="seg-count">${stats.rtw}</span></button>
        <button data-filter="salary">Salary <span class="seg-count">${stats.salary}</span></button>
        <button data-filter="changes">Changes <span class="seg-count">${stats.changes}</span></button>
      </div>
      <div class="spacer"></div>
      <span class="toolbar-label" id="sponsorEmptyHint" style="display:none">No matches</span>
    </div>

    <div class="table-wrap">
      <table class="sponsor-table">
        <thead>
          <tr>
            <th>Worker</th>
            <th>CoS / SOC</th>
            <th>Visa Expiry</th>
            <th>RTW Follow-Up</th>
            <th>Salary Match</th>
            <th>Changes</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="sponsorBody">
          ${rows.length === 0 ? `<tr><td colspan="7"><div class="empty-state"><div class="empty-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M9 7a3 3 0 106 0 3 3 0 00-6 0z"/></svg></div><p>No sponsored workers yet</p><div class="empty-hint">Add a sponsored worker to start tracking compliance.</div></div></td></tr>` :
          rows.map(({ w, visaDays, rtwDays, salaryMatch, unreported, flags, atRisk }) => `
            <tr data-search-row
                data-flags="${flags.join(' ')}"
                data-search-text="${`${esc(w.employee.fullName)} ${esc(w.employee.department)} ${esc(w.employee.jobTitle)} ${esc(w.cosNumber)} ${esc(w.socCode)} ${esc(w.sponsoredJobTitle)} ${w.employee.employmentStatus}`.toLowerCase()}">
              <td>
                <a class="sponsor-worker" href="/employees/${w.employee.id}">
                  <span class="mac-avatar" style="background:linear-gradient(135deg,hsl(${esc(avatarHue(w.employee.fullName))},70%,58%),hsl(${esc((avatarHue(w.employee.fullName)+40)%360)},68%,48%))">${esc(initials(w.employee.fullName))}</span>
                  <span class="sponsor-worker-text">
                    <strong>${esc(w.employee.fullName)}</strong>
                    <span>${esc(w.sponsoredJobTitle || w.employee.jobTitle)} · ${esc(w.employee.department)}</span>
                  </span>
                </a>
              </td>
              <td data-label="CoS / SOC">
                <div class="mono" style="font-size:12.5px;font-weight:700">${esc(w.cosNumber)}</div>
                <div class="cell-muted mono" style="font-size:11px">SOC ${esc(w.socCode)}</div>
              </td>
              <td data-label="Visa Expiry">
                <div style="font-weight:600;color:${visaDays < 0 ? 'var(--danger)' : visaDays <= 30 ? 'var(--warning-t)' : 'var(--text-2)'}">${formatDate(w.visaExpiryDate)}</div>
                ${visaDays < 0 ? '<span class="badge badge-red">Expired</span>' : visaDays <= 30 ? `<span class="badge badge-amber">${visaDays}d left</span>` : `<span class="cell-muted" style="font-size:11px">${visaDays}d</span>`}
              </td>
              <td data-label="RTW Follow-Up">
                ${w.rightToWorkFollowupDate ? `
                  <div style="font-weight:600;color:${rtwDays < 0 ? 'var(--danger)' : rtwDays <= 14 ? 'var(--warning-t)' : 'var(--text-2)'}">${formatDate(w.rightToWorkFollowupDate)}</div>
                  ${rtwDays <= 14 ? `<span class="badge badge-${rtwDays < 0 ? 'red' : 'amber'}">${rtwDays < 0 ? 'Overdue' : rtwDays + 'd'}</span>` : `<span class="cell-muted" style="font-size:11px">${rtwDays}d</span>`}
                ` : '<span class="badge badge-slate">Not set</span>'}
              </td>
              <td data-label="Salary Match">
                ${salaryMatch
                  ? '<span class="badge badge-green"><span class="badge-dot"></span>Match</span>'
                  : `<span class="badge badge-red">Mismatch</span><div class="cell-muted" style="font-size:11px;margin-top:3px">CoS £${Number(w.salaryOnCos).toLocaleString()} · Actual £${Number(w.actualSalary).toLocaleString()}</div>`}
              </td>
              <td data-label="Changes">
                ${unreported > 0
                  ? `<span class="badge badge-red">${unreported} unreported</span>`
                  : '<span class="badge badge-green"><span class="badge-dot"></span>All reported</span>'}
              </td>
              <td data-label="Status">
                ${atRisk
                  ? `<span class="badge badge-amber">Action needed</span>`
                  : `<span class="badge badge-green">Compliant</span>`}
              </td>
            </tr>
          `).join('')}
          <tr id="sponsorNoMatch" style="display:none"><td colspan="7"><div class="empty-state" style="padding:36px 14px"><p>No workers match these filters</p><div class="empty-hint">Try clearing the search or choosing a different segment.</div></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div id="sponsorModal" class="modal-overlay" style="display:none">
    <div class="modal" style="max-width:660px">
      <div class="modal-header">
        <h3>Add sponsorship details</h3>
        <button type="button" class="btn btn-ghost btn-sm" data-close-sponsor>✕</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Employee <span class="required">*</span></label>
          <select class="form-control" id="spEmployee">
            <option value="">Select employee…</option>
            ${eligible.map(e => `<option value="${e.id}" data-jobtitle="${esc(e.jobTitle || '')}" data-loc="${esc(e.workLocation || '')}" data-hours="${e.contractedHours == null ? '' : e.contractedHours}" data-salary="${e.salary == null ? '' : e.salary}">${esc(e.fullName)}${e.jobTitle ? ' — ' + esc(e.jobTitle) : ''}</option>`).join('')}
          </select>
          ${eligible.length === 0 ? '<div class="form-hint">All employees already have a sponsorship record.</div>' : ''}
        </div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">CoS number <span class="required">*</span></label><input class="form-control" id="spCos" placeholder="e.g. C2G7X12345"></div>
          <div class="form-group"><label class="form-label">SOC code <span class="required">*</span></label><input class="form-control" id="spSoc" placeholder="e.g. 8211"></div>
        </div>
        <div class="form-group"><label class="form-label">Sponsored job title <span class="required">*</span></label><input class="form-control" id="spJob" placeholder="As stated on the CoS"></div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Salary on CoS (£) <span class="required">*</span></label><input class="form-control" id="spSalCos" type="number" step="0.01" placeholder="38700"></div>
          <div class="form-group"><label class="form-label">Actual salary (£) <span class="required">*</span></label><input class="form-control" id="spSalAct" type="number" step="0.01" placeholder="38700"></div>
        </div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Contracted hours / week <span class="required">*</span></label><input class="form-control" id="spHours" type="number" step="0.5" placeholder="39"></div>
          <div class="form-group"><label class="form-label">Work location <span class="required">*</span></label><input class="form-control" id="spLoc" placeholder="Main Depot"></div>
        </div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Visa expiry <span class="required">*</span></label><input class="form-control" id="spVisa" type="date"></div>
          <div class="form-group"><label class="form-label">Right-to-work check date <span class="required">*</span></label><input class="form-control" id="spRtwCheck" type="date"></div>
        </div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">RTW follow-up date</label><input class="form-control" id="spRtwFollow" type="date"></div>
          <div class="form-group"><label class="form-label">RTW document type</label><input class="form-control" id="spRtwDoc" placeholder="e.g. BRP, Passport"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" data-close-sponsor>Cancel</button>
        <button type="button" class="btn btn-primary" id="spSubmit">Save sponsorship</button>
      </div>
    </div>
  </div>

  <style>
    .incomplete-banner { background:var(--warning-bg); border:1px solid rgba(245,158,11,.3); border-radius:16px; padding:16px 18px; margin-bottom:16px; }
    .incomplete-head { display:flex; gap:12px; align-items:flex-start; margin-bottom:12px; }
    .incomplete-icon { width:38px; height:38px; flex-shrink:0; border-radius:10px; background:var(--warning-bg); color:var(--warning-t); display:flex; align-items:center; justify-content:center; }
    .incomplete-icon svg { width:20px; height:20px; }
    .incomplete-head strong { font-size:14px; color:var(--warning-t); }
    .incomplete-head p { font-size:12.5px; color:var(--text-muted); margin-top:2px; line-height:1.5; }
    .incomplete-list { display:flex; flex-direction:column; gap:8px; }
    .incomplete-row { display:flex; align-items:center; justify-content:space-between; gap:12px; background:var(--card); border:1px solid rgba(245,158,11,.3); border-radius:12px; padding:8px 12px; }
    .incomplete-person { display:flex; align-items:center; gap:10px; min-width:0; }
    .incomplete-person strong { display:block; font-size:13px; }
    .incomplete-person span { font-size:11.5px; color:var(--text-muted); }
    .sponsor-readiness { display:flex; align-items:center; gap:12px; background:var(--card); border:1px solid var(--mac-hairline); border-radius:14px; padding:8px 14px 8px 8px; box-shadow:var(--mac-shadow); }
    .sponsor-readiness-ring { width:46px; height:46px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;
      background:conic-gradient(var(--success) calc(var(--pct)*1%), #e9eef6 0); }
    .sponsor-readiness-ring span { width:34px; height:34px; border-radius:50%; background:var(--card); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; color:var(--text); }
    .sponsor-readiness-label { font-size:12px; font-weight:700; color:var(--text); }
    .sponsor-readiness-sub { font-size:11px; color:var(--text-muted); margin-top:1px; }
    .sponsor-stat { font-family:inherit; text-align:left; }
    .sponsor-stat.active { outline:2px solid var(--primary); outline-offset:1px; }
    .sponsor-worker { display:flex; align-items:center; gap:11px; text-decoration:none; }
    .sponsor-worker-text { display:flex; flex-direction:column; min-width:0; }
    .sponsor-worker-text strong { font-size:13.5px; font-weight:700; color:var(--text); }
    .sponsor-worker-text span { font-size:11.5px; color:var(--text-muted); }
    .sponsor-table tbody tr.row-risk td:first-child { box-shadow: inset 3px 0 0 var(--warning); }
    @media (max-width:1100px) { .sponsor-readiness { display:none; } }
    @media (max-width:760px) {
      .sponsor-table thead { display:none; }
      .sponsor-table, .sponsor-table tbody, .sponsor-table tr, .sponsor-table td { display:block; width:100%; }
      .sponsor-table tr { border:1px solid var(--mac-hairline); border-radius:12px; margin:10px; padding:8px 6px; }
      .sponsor-table td { border:none !important; padding:7px 12px; position:static !important; box-shadow:none !important; background:transparent !important; }
      .sponsor-table td[data-label] { display:flex; justify-content:space-between; align-items:baseline; gap:14px; }
      .sponsor-table td[data-label]::before {
        content: attr(data-label); flex:0 0 auto;
        font-size:10px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; color:var(--text-light);
      }
      .sponsor-table td[data-label] > * { text-align:right; }
      .sponsor-table td:first-child { padding:6px 12px 10px; margin-bottom:4px; border-bottom:1px solid var(--mac-hairline) !important; }
    }
  </style>

  <script>
  (function() {
    const body = document.getElementById('sponsorBody');
    if (!body) return;
    const rows = Array.from(body.querySelectorAll('tr[data-search-row]'));
    const search = document.getElementById('sponsorSearch');
    const segments = document.getElementById('sponsorSegments');
    const visible = document.getElementById('sponsorVisible');
    const noMatch = document.getElementById('sponsorNoMatch');
    const emptyHint = document.getElementById('sponsorEmptyHint');
    let filter = 'all';

    rows.forEach(r => { if ((r.getAttribute('data-flags') || '').trim()) r.classList.add('row-risk'); });

    function matchesFilter(r) {
      if (filter === 'all') return true;
      const flags = (r.getAttribute('data-flags') || '').split(' ').filter(Boolean);
      if (filter === 'risk') return flags.length > 0;
      return flags.includes(filter);
    }
    function apply() {
      const q = (search.value || '').trim().toLowerCase();
      let count = 0;
      rows.forEach(r => {
        const text = r.getAttribute('data-search-text') || '';
        const show = matchesFilter(r) && (!q || text.indexOf(q) !== -1);
        r.style.display = show ? '' : 'none';
        if (show) count++;
      });
      if (visible) visible.textContent = String(count);
      const none = count === 0 && rows.length > 0;
      if (noMatch) noMatch.style.display = none ? '' : 'none';
      if (emptyHint) emptyHint.style.display = none ? '' : 'none';
    }
    function setFilter(f) {
      filter = f;
      Array.from(segments.querySelectorAll('button')).forEach(b => b.classList.toggle('active', b.getAttribute('data-filter') === f));
      document.querySelectorAll('.sponsor-stat').forEach(s => s.classList.toggle('active', s.getAttribute('data-filter') === f));
      apply();
    }

    search.addEventListener('input', apply);
    segments.addEventListener('click', e => {
      const btn = e.target.closest('button[data-filter]');
      if (btn) setFilter(btn.getAttribute('data-filter'));
    });
    document.querySelectorAll('.sponsor-stat').forEach(card => {
      card.addEventListener('click', () => setFilter(card.getAttribute('data-filter')));
    });
    apply();
  })();
  </script>

  <script>
  (function(){
    var modal = document.getElementById('sponsorModal');
    if (!modal) return;
    var sel = document.getElementById('spEmployee');
    function prefill(){
      var o = sel.options[sel.selectedIndex];
      if (!o || !o.value) return;
      var set = function(id, v){ var el = document.getElementById(id); if (el && !el.value) el.value = v || ''; };
      set('spJob', o.dataset.jobtitle); set('spLoc', o.dataset.loc); set('spHours', o.dataset.hours); set('spSalAct', o.dataset.salary);
    }
    function open(empId){ if (empId) sel.value = empId; prefill(); modal.style.display = 'flex'; }
    function close(){ modal.style.display = 'none'; }
    sel.addEventListener('change', prefill);
    var addBtn = document.getElementById('addSponsoredBtn');
    if (addBtn) addBtn.addEventListener('click', function(){ open(); });
    document.querySelectorAll('.complete-sponsor').forEach(function(b){ b.addEventListener('click', function(){ open(b.dataset.emp); }); });
    modal.querySelectorAll('[data-close-sponsor]').forEach(function(b){ b.addEventListener('click', close); });
    modal.addEventListener('click', function(e){ if (e.target === modal) close(); });

    document.getElementById('spSubmit').addEventListener('click', async function(){
      var val = function(id){ return (document.getElementById(id).value || '').trim(); };
      var body = {
        employeeId: sel.value,
        cosNumber: val('spCos'), socCode: val('spSoc'), sponsoredJobTitle: val('spJob'),
        salaryOnCos: val('spSalCos'), actualSalary: val('spSalAct'), contractedHours: val('spHours'),
        workLocation: val('spLoc'), visaExpiryDate: val('spVisa'), rightToWorkCheckDate: val('spRtwCheck'),
        rightToWorkFollowupDate: val('spRtwFollow') || null, rightToWorkDocumentType: val('spRtwDoc') || null,
        actualWorkingPattern: null,
      };
      var required = [['employeeId','Employee'],['cosNumber','CoS number'],['socCode','SOC code'],['sponsoredJobTitle','Job title'],['salaryOnCos','Salary on CoS'],['actualSalary','Actual salary'],['contractedHours','Contracted hours'],['workLocation','Work location'],['visaExpiryDate','Visa expiry'],['rightToWorkCheckDate','RTW check date']];
      var missing = required.filter(function(r){ return !body[r[0]]; }).map(function(r){ return r[1]; });
      if (missing.length){ showToast('Please fill: ' + missing.join(', '), 'error'); return; }
      var btn = this; btn.disabled = true; btn.textContent = 'Saving…';
      try {
        await apiCall('POST', '/api/v1/sponsored-workers', body);
        showToast('Sponsorship saved', 'success');
        setTimeout(function(){ location.reload(); }, 700);
      } catch(e){ showToast(e.message || 'Could not save', 'error'); btn.disabled = false; btn.textContent = 'Save sponsorship'; }
    });
  })();
  </script>
  `;
})()}
