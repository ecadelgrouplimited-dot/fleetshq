<%- include('../layouts/main', { body: `
<div class="page-head">
  <div class="page-head-main">
    <div class="page-eyebrow">Client portal</div>
    <h1>Shipments at a glance</h1>
    <p class="page-sub">Book movements, track progress, and pick up where work needs attention.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn btn-outline" href="/shipments">All shipments</a>
    <a class="btn btn-primary" href="/book">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Book a shipment
    </a>
  </div>
</div>

<div class="stat-grid mb-6">
  <a href="/shipments" class="stat-card blue">
    <div class="stat-icon blue"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM20 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10m10 0H9m4 0h3m0 0V9h3l3 4v3"/></svg></div>
    <div><div class="stat-value">${stats.total}</div><div class="stat-label">Total shipments</div></div>
  </a>
  <a href="/shipments?status=allocated" class="stat-card amber">
    <div class="stat-icon amber"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>
    <div><div class="stat-value">${stats.active}</div><div class="stat-label">In progress</div></div>
  </a>
  <a href="/shipments?status=out_for_delivery" class="stat-card amber">
    <div class="stat-icon amber"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg></div>
    <div><div class="stat-value">${stats.outForDelivery}</div><div class="stat-label">Out for delivery</div></div>
  </a>
  <a href="/shipments?status=delivered" class="stat-card green">
    <div class="stat-icon green"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg></div>
    <div><div class="stat-value">${stats.delivered}</div><div class="stat-label">Delivered</div></div>
  </a>
</div>

<div class="card">
  <div class="card-header"><h3>Recent shipments</h3><a class="btn btn-outline btn-sm" href="/shipments">View all</a></div>
  ${shipments.length === 0 ? `
    <div class="empty-state">
      <div class="empty-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM20 17a2 2 0 11-4 0 2 2 0 014 0z"/></svg></div>
      <p>No shipments yet</p>
      <div class="empty-hint">Book your first movement to get started.</div>
      <a class="btn btn-primary" href="/book" style="margin-top:14px">Book a shipment</a>
    </div>
  ` : `
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Reference</th><th scope="col">Customer</th><th scope="col">Service</th><th scope="col">Status</th><th scope="col">Total</th><th scope="col"></th></tr></thead>
      <tbody>
        ${shipments.map(s => `
          <tr>
            <td><a href="/shipments/${s.id}" style="font-family:monospace;font-weight:700">${esc(s.reference)}</a></td>
            <td>${esc(s.customer ? s.customer.name : '—')}</td>
            <td>${esc(s.serviceName)}</td>
            <td><span class="badge ${svc.statusBadge(s.status)}">${esc(svc.statusLabel(s.status))}</span></td>
            <td style="font-weight:700">£${Number(s.priceTotal).toFixed(2)}</td>
            <td><a class="btn btn-outline btn-sm" href="/shipments/${s.id}">View</a></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>`}
</div>
` }) %>
