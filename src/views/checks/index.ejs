<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <div>
    ${missedVehicles.length > 0 ? `<span class="badge badge-red" style="font-size:13px;padding:6px 12px">⚠ ${missedVehicles.length} vehicle${missedVehicles.length !== 1 ? 's' : ''} with no check today</span>` : '<span class="badge badge-green" style="font-size:13px;padding:6px 12px">All vehicles checked today</span>'}
  </div>
  <a href="/checks/new" class="btn btn-primary">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style="width:15px;height:15px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Submit Daily Check
  </a>
</div>

${missedVehicles.length > 0 ? `
<div class="card mb-4" style="border-left:4px solid #ef4444">
  <div class="card-header" style="background:#fef2f2"><h3 style="color:#dc2626">Vehicles Without a Check Today</h3></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Vehicle</th><th>Driver</th><th>Status</th></tr></thead>
      <tbody>
        ${missedVehicles.map(v => `
          <tr>
            <td style="font-weight:700">${v.registration}</td>
            <td>${v.assignedDriver?.fullName || '—'}</td>
            <td><span class="badge badge-red">No check submitted</span></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>
</div>
` : ''}

<div class="card">
  <div class="card-header"><h3>Recent Daily Checks</h3></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Date</th><th>Vehicle</th><th>Driver</th><th>Mileage</th><th>Defects</th><th>Result</th></tr></thead>
      <tbody>
        ${checks.length === 0 ? `<tr><td colspan="6" style="text-align:center;padding:32px;color:#64748b">No checks recorded</td></tr>` :
        checks.map(c => {
          const defectItems = c.items.filter(i => i.status === 'defect_found');
          return `<tr>
            <td style="font-weight:500">${formatDate(c.checkDate)} <span style="color:#64748b;font-size:12px">${new Date(c.submittedAt).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}</span></td>
            <td style="font-weight:600">${c.vehicle?.registration}</td>
            <td>${c.driver?.fullName}</td>
            <td style="color:#64748b">${c.mileage?.toLocaleString()} mi</td>
            <td>${defectItems.length > 0 ? `<span class="badge badge-red">${defectItems.length} defect${defectItems.length !== 1 ? 's' : ''}</span>` : '<span class="badge badge-green">None</span>'}</td>
            <td>${c.nilDefect ? '<span class="badge badge-green">Nil Defect</span>' : defectItems.length > 0 ? '<span class="badge badge-amber">Defects Reported</span>' : '<span class="badge badge-green">Pass</span>'}</td>
          </tr>`;
        }).join('')}
      </tbody>
    </table>
  </div>
</div>
` }) %>
