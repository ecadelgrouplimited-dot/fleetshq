<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <a href="/checks" class="btn btn-ghost btn-sm">Back to checks</a>
  <div class="flex gap-2">
    ${user.role !== 'driver' ? `<a href="/fleet/${check.vehicleId}" class="btn btn-outline btn-sm">Open vehicle</a>` : ''}
    <a href="/defects${check.defects.length ? `/${check.defects[0].id}` : ''}" class="btn btn-primary btn-sm">${check.defects.length ? 'Open linked defect' : 'Open defects'}</a>
  </div>
</div>

<div class="stat-grid mb-4">
  <div class="stat-card blue"><div><div class="stat-value">${check.vehicle.registration}</div><div class="stat-label">Vehicle</div><div class="stat-sub">${check.vehicle.make} ${check.vehicle.model}</div></div></div>
  <div class="stat-card green"><div><div class="stat-value">${formatDate(check.checkDate)}</div><div class="stat-label">Check Date</div><div class="stat-sub">${new Date(check.checkTime).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}</div></div></div>
  <div class="stat-card amber"><div><div class="stat-value">${check.mileage.toLocaleString()}</div><div class="stat-label">Mileage</div><div class="stat-sub">${check.location || 'Location not provided'}</div></div></div>
  <div class="stat-card ${check.nilDefect ? 'green' : check.defects.length ? 'red' : 'blue'}"><div><div class="stat-value">${check.defects.length}</div><div class="stat-label">Linked Defects</div><div class="stat-sub">${check.nilDefect ? 'Nil defect submitted' : check.defects.length ? 'Needs follow-up' : 'No linked cases'}</div></div></div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3>Submission Summary</h3></div>
    <div class="card-body">
      <div class="summary-grid">
        <div><div class="text-sm text-muted">Driver</div><div class="fw-700">${check.driver.fullName}</div><div class="text-sm text-muted">${check.driver.jobTitle || ''}</div></div>
        <div><div class="text-sm text-muted">Result</div><div class="fw-700">${check.nilDefect ? 'Nil defect' : check.defects.length ? 'Defects reported' : 'Pass'}</div></div>
        <div><div class="text-sm text-muted">Submitted</div><div class="fw-700">${formatDate(check.submittedAt)}</div></div>
        <div><div class="text-sm text-muted">Vehicle Status</div><div class="fw-700">${check.vehicle.status.replace(/_/g, ' ')}</div></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Linked Defects</h3></div>
    <div class="card-body">
      ${check.defects.length === 0 ? '<div class="empty-state"><p>No defect cases were linked to this check</p></div>' : `
        <div class="linked-list">
          ${check.defects.map(defect => `
            <a href="/defects/${defect.id}" class="linked-row">
              <span class="fw-700">${defect.referenceNumber}</span>
              <span class="badge ${defect.severity === 'dangerous' ? 'badge-red' : defect.severity === 'serious' ? 'badge-amber' : 'badge-slate'}">${defect.severity}</span>
              <span class="badge badge-blue">${defect.status.replace(/_/g, ' ')}</span>
            </a>
          `).join('')}
        </div>
      `}
    </div>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header"><h3>Inspection Items</h3></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Item</th><th>Status</th><th>Notes</th></tr></thead>
      <tbody>
        ${check.items.map(item => `
          <tr>
            <td style="font-weight:700">${CHECK_ITEM_LABELS[item.item] || item.item.replace(/_/g, ' ')}</td>
            <td>
              <span class="badge ${item.status === 'ok' ? 'badge-green' : item.status === 'defect_found' ? 'badge-red' : 'badge-slate'}">
                ${item.status === 'ok' ? 'OK' : item.status === 'defect_found' ? 'Defect found' : 'Not applicable'}
              </span>
            </td>
            <td class="cell-muted">${item.notes || '-'}</td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>
</div>

<style>
  .summary-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:18px; }
  .linked-list { display:flex; flex-direction:column; gap:10px; }
  .linked-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 14px; border:1px solid var(--border); border-radius:8px; color:var(--text); text-decoration:none; }
  .linked-row:hover { border-color:var(--primary); background:#eff6ff; }
  @media (max-width: 900px) { .summary-grid { grid-template-columns:1fr; } }
</style>
` }) %>
