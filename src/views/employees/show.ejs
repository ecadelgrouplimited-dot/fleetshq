<%- include('../layouts/main', { body: `
<link rel="stylesheet" href="/css/driver-hub.css">

<div class="dh-container">
  <!-- Page Header Breadcrumbs & Action Buttons -->
  <div class="dh-header">
    <div>
      <div class="dh-breadcrumbs">
        <span>People</span>
        <span class="sep">&gt;</span>
        <a href="/drivers">Drivers</a>
        <span class="sep">&gt;</span>
        <span style="color:#0f172a;">${profile.name}</span>
        ${activeTab !== 'overview' ? `
          <span class="sep">&gt;</span>
          <span style="color:#2563eb; text-transform:capitalize;">${activeTab.replace(/-/g, ' ')}</span>
        ` : ''}
      </div>
      <div class="dh-subtitle">Complete driver profile, records, compliance and history</div>
    </div>
    <div class="dh-header-actions">
      <a href="/drivers" class="btn-dh-white">
        <svg style="width:14px; height:14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Back to Driver List</span>
      </a>
      <a href="/employees/${profile.id}?tab=documents" class="btn-dh-white">
        <svg style="width:14px; height:14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>View All Documents</span>
      </a>
      <a href="/employees/${profile.id}/edit" class="btn-dh-primary">
        <svg style="width:14px; height:14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
        <span>Edit Driver</span>
      </a>
    </div>
  </div>

  <!-- Hero Profile Banner Card (Present across all profile tabs) -->
  <div class="dh-hero-card">
    <img src="${profile.avatarUrl}" alt="${profile.name}" class="dh-hero-photo" onerror="this.src='/img/driver-jashanjot.png'">
    
    <div class="dh-hero-primary">
      <div class="dh-hero-name">
        <span>${profile.name}</span>
        <span class="dh-badge dh-badge-green" style="font-size:11px;">✓ Active Driver</span>
      </div>
      <div class="dh-hero-code">Driver ID: ${profile.employeeCode}</div>
      <div class="dh-hero-contact-row" style="margin-top:6px;">
        <svg style="width:14px; height:14px; color:#2563eb;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <span>${profile.phone}</span>
      </div>
      <div class="dh-hero-contact-row">
        <svg style="width:14px; height:14px; color:#2563eb;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <span>${profile.email}</span>
      </div>
      <div class="dh-hero-contact-row">
        <svg style="width:14px; height:14px; color:#2563eb;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span>${profile.address}</span>
      </div>
    </div>

    <div class="dh-hero-details-col">
      <div class="dh-detail-row">
        <span class="label">Date of Birth:</span>
        <span class="val">${profile.dateOfBirth} (${profile.age} years)</span>
      </div>
      <div class="dh-detail-row">
        <span class="label">NI Number:</span>
        <span class="val" style="font-family:monospace;">${profile.niNumber}</span>
      </div>
      <div class="dh-detail-row">
        <span class="label">Start Date:</span>
        <span class="val">${profile.startDate}</span>
      </div>
      <div class="dh-detail-row">
        <span class="label">Employment:</span>
        <span class="val">${profile.employmentType}</span>
      </div>
      <div class="dh-detail-row">
        <span class="label">Operating Centre:</span>
        <span class="val">${profile.operatingCentre}</span>
      </div>
      <div class="dh-detail-row">
        <span class="label">Current Truck:</span>
        <span class="val" style="font-family:monospace; color:#2563eb;">${profile.currentTruck}</span>
      </div>
      <div class="dh-detail-row">
        <span class="label">Current Trailer:</span>
        <span class="val">${profile.currentTrailer}</span>
      </div>
      <div class="dh-detail-row">
        <span class="label">Manager:</span>
        <span class="val">${profile.manager}</span>
      </div>
    </div>

    <div class="dh-hero-status-box">
      <div class="dh-hero-status-head">
        <span>Current Status</span>
        <span class="dh-badge dh-badge-green">✓ Available</span>
      </div>
      <div class="dh-status-line"><span>On Duty:</span> <b style="color:#64748b;">No</b></div>
      <div class="dh-status-line"><span>On Holiday:</span> <b style="color:#64748b;">No</b></div>
      <div class="dh-status-line"><span>Sick / Absent:</span> <b style="color:#64748b;">No</b></div>
      <div class="dh-status-line"><span>Pending RTW:</span> <b style="color:#64748b;">No</b></div>
    </div>
  </div>

  <!-- Profile Navigation Tabs (11 Tabs matching Designs 2 - 12) -->
  <div class="dh-tabs-nav">
    <a href="/employees/${profile.id}?tab=overview" class="dh-tab-btn ${activeTab === 'overview' ? 'active' : ''}">Overview</a>
    <a href="/employees/${profile.id}?tab=personal" class="dh-tab-btn ${activeTab === 'personal' ? 'active' : ''}">Personal Details</a>
    <a href="/employees/${profile.id}?tab=licence" class="dh-tab-btn ${activeTab === 'licence' ? 'active' : ''}">Licence &amp; CPC</a>
    <a href="/employees/${profile.id}?tab=medical" class="dh-tab-btn ${activeTab === 'medical' ? 'active' : ''}">Medical &amp; Fitness</a>
    <a href="/employees/${profile.id}?tab=training" class="dh-tab-btn ${activeTab === 'training' ? 'active' : ''}">Training &amp; Competency</a>
    <a href="/employees/${profile.id}?tab=employment" class="dh-tab-btn ${activeTab === 'employment' ? 'active' : ''}">Employment &amp; HR</a>
    <a href="/employees/${profile.id}?tab=rota" class="dh-tab-btn ${activeTab === 'rota' ? 'active' : ''}">Rota &amp; Attendance</a>
    <a href="/employees/${profile.id}?tab=compliance" class="dh-tab-btn ${activeTab === 'compliance' ? 'active' : ''}">Compliance</a>
    <a href="/employees/${profile.id}?tab=documents" class="dh-tab-btn ${activeTab === 'documents' ? 'active' : ''}">Documents</a>
    <a href="/employees/${profile.id}?tab=incidents" class="dh-tab-btn ${activeTab === 'incidents' ? 'active' : ''}">Incidents &amp; Risk</a>
    <a href="/employees/${profile.id}?tab=notes" class="dh-tab-btn ${activeTab === 'notes' ? 'active' : ''}">Notes &amp; Actions</a>
  </div>

  <!-- TAB CONTENT -->

  <!-- TAB 1: OVERVIEW (Design 2) -->
  ${activeTab === 'overview' ? `
    <!-- 6 Key Compliance Cards -->
    <div class="dh-grid-6-cards">
      <!-- Driving Licence -->
      <div class="dh-compliance-card">
        <div>
          <div class="head">
            <span class="title">Driving Licence</span>
            <span class="dh-badge dh-badge-green">✓ Valid</span>
          </div>
          <div class="info-line">No: <span class="info-val" style="font-family:monospace;">${overview.licence.number}</span></div>
          <div class="info-line">Expires: <span class="info-val">${overview.licence.expires}</span></div>
          <div class="info-line">Type: <span class="info-val">${overview.licence.type}</span></div>
        </div>
        <a href="/employees/${profile.id}?tab=licence" class="foot-link">View Details →</a>
      </div>

      <!-- CPC -->
      <div class="dh-compliance-card">
        <div>
          <div class="head">
            <span class="title">CPC</span>
            <span class="dh-badge dh-badge-green">✓ Valid</span>
          </div>
          <div class="info-line">CPC No: <span class="info-val" style="font-family:monospace;">${overview.cpc.number}</span></div>
          <div class="info-line">Expires: <span class="info-val" style="color:#d97706; font-weight:700;">${overview.cpc.expires}</span></div>
          <div class="info-line">Modules: <span class="info-val">${overview.cpc.modules}</span></div>
        </div>
        <a href="/employees/${profile.id}?tab=licence" class="foot-link">View Details →</a>
      </div>

      <!-- Digital Tacho Card -->
      <div class="dh-compliance-card">
        <div>
          <div class="head">
            <span class="title">Digital Tacho Card</span>
            <span class="dh-badge dh-badge-green">✓ Valid</span>
          </div>
          <div class="info-line">No: <span class="info-val" style="font-family:monospace;">${overview.tacho.number}</span></div>
          <div class="info-line">Expires: <span class="info-val">${overview.tacho.expires}</span></div>
        </div>
        <a href="/employees/${profile.id}?tab=licence" class="foot-link">View Details →</a>
      </div>

      <!-- Medical Certificate -->
      <div class="dh-compliance-card">
        <div>
          <div class="head">
            <span class="title">Medical Certificate</span>
            <span class="dh-badge dh-badge-green">✓ Valid</span>
          </div>
          <div class="info-line">Expires: <span class="info-val">${overview.medical.expires}</span></div>
          <div class="info-line">Days Left: <span class="dh-badge dh-badge-green" style="font-size:10px;">${overview.medical.daysLeft}</span></div>
        </div>
        <a href="/employees/${profile.id}?tab=medical" class="foot-link">View Details →</a>
      </div>

      <!-- ADR Certificate -->
      <div class="dh-compliance-card">
        <div>
          <div class="head">
            <span class="title">ADR Certificate</span>
            <span class="dh-badge dh-badge-red">⚠ Not Held</span>
          </div>
          <div class="info-line">Status: <span class="info-val" style="color:#dc2626;">Not Required</span></div>
        </div>
        <a href="/employees/${profile.id}?tab=training" class="foot-link">View Details →</a>
      </div>

      <!-- Right to Work -->
      <div class="dh-compliance-card">
        <div>
          <div class="head">
            <span class="title">Right to Work</span>
            <span class="dh-badge dh-badge-green">✓ Valid</span>
          </div>
          <div class="info-line">Checked: <span class="info-val">${overview.rightToWork.checked}</span></div>
          <div class="info-line">Status: <span class="info-val">${overview.rightToWork.status}</span></div>
        </div>
        <a href="/employees/${profile.id}?tab=employment" class="foot-link">View Details →</a>
      </div>
    </div>

    <!-- Assigned Vehicle & Availability Row -->
    <div class="dh-grid-3">
      <!-- Assigned Vehicle & Trailer -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">
            <svg style="width:16px; height:16px; color:#2563eb;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
            <span>Assigned Vehicle &amp; Trailer</span>
          </div>
          <a href="/fleet" class="dh-card-link">View All</a>
        </div>
        <div class="dh-card-body" style="display:flex; gap:16px; align-items:center;">
          <div style="flex:1; border:1px solid #e2e8f0; border-radius:8px; padding:12px; display:flex; gap:10px; align-items:center;">
            <img src="${overview.assignedVehicle.image}" alt="Truck" style="width:64px; height:auto; object-fit:contain; border-radius:6px;">
            <div>
              <div style="font-weight:800; font-family:monospace; font-size:13px; color:#0f172a;">${overview.assignedVehicle.registration}</div>
              <div style="font-size:11px; color:#64748b;">${overview.assignedVehicle.model}</div>
              <span class="dh-badge dh-badge-green" style="font-size:10px; margin-top:4px;">${overview.assignedVehicle.status}</span>
              <div style="font-size:10px; color:#64748b; margin-top:4px;">📍 ${overview.assignedVehicle.location}</div>
            </div>
          </div>
          <div style="flex:1; border:1px solid #e2e8f0; border-radius:8px; padding:12px; display:flex; gap:10px; align-items:center;">
            <img src="${overview.assignedVehicle.trailerImage}" alt="Trailer" style="width:64px; height:auto; object-fit:contain; border-radius:6px;">
            <div>
              <div style="font-weight:800; font-family:monospace; font-size:13px; color:#0f172a;">${overview.assignedVehicle.trailer}</div>
              <div style="font-size:11px; color:#64748b;">${overview.assignedVehicle.trailerType}</div>
              <span class="dh-badge dh-badge-green" style="font-size:10px; margin-top:4px;">In Use</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Availability (Next 14 Days) -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">
            <svg style="width:16px; height:16px; color:#2563eb;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Availability (Next 14 Days)</span>
          </div>
          <a href="/employees/${profile.id}?tab=rota" class="dh-card-link">View All</a>
        </div>
        <div class="dh-card-body">
          <div style="display:flex; gap:6px; justify-content:space-between;">
            ${overview.availabilityNext14Days.map(a => `
              <div style="flex:1; text-align:center; padding:8px 4px; border:1px solid #e2e8f0; border-radius:6px; background:#f8fafc;">
                <div style="font-size:11px; font-weight:700; color:#334155;">${a.day}</div>
                <div style="font-size:11px; font-weight:700; color:${a.status === 'Work' ? '#059669' : '#64748b'}; margin-top:4px;">${a.status}</div>
              </div>
            `).join('')}
          </div>
          <a href="/employees/${profile.id}?tab=rota" class="foot-link" style="margin-top:14px; display:inline-block;">View Full Rota →</a>
        </div>
      </div>

      <!-- Leave & Absence (Current Year) -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">
            <svg style="width:16px; height:16px; color:#2563eb;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Leave &amp; Absence (Current Year)</span>
          </div>
          <a href="/leave" class="dh-card-link">View All</a>
        </div>
        <div class="dh-card-body" style="display:flex; flex-direction:column; gap:10px;">
          <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 0; border-bottom:1px solid #f1f5f9;">
            <span style="font-size:12.5px; color:#334155;">Annual Leave</span>
            <div style="display:flex; align-items:center; gap:8px;">
              <span style="font-weight:700; color:#0f172a; font-size:13px;">${overview.leaveSummary.annualUsed} days used</span>
              <span class="dh-badge dh-badge-green">${overview.leaveSummary.annualLeft} left</span>
            </div>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 0; border-bottom:1px solid #f1f5f9;">
            <span style="font-size:12.5px; color:#334155;">Sick Leave</span>
            <span style="font-weight:700; color:#0f172a; font-size:13px;">${overview.leaveSummary.sickDays} days</span>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 0;">
            <span style="font-size:12.5px; color:#334155;">Other Leave</span>
            <span style="font-weight:700; color:#0f172a; font-size:13px;">${overview.leaveSummary.otherDays} days</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mini-Tables: Training, Compliance, Recent Activity -->
    <div class="dh-grid-3">
      <!-- Training & Competency -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">Training &amp; Competency</div>
          <a href="/employees/${profile.id}?tab=training" class="dh-card-link">View All</a>
        </div>
        <div class="dh-table-wrap">
          <table class="dh-table">
            <thead>
              <tr><th>Course</th><th>Date</th><th>Expiry</th><th>Status</th></tr>
            </thead>
            <tbody>
              ${overview.trainingList.map(t => `
                <tr>
                  <td style="font-weight:600; color:#0f172a;">${t.course}</td>
                  <td style="color:#64748b;">${t.date}</td>
                  <td style="color:#64748b;">${t.expiry}</td>
                  <td><span class="dh-badge dh-badge-${t.badge}">${t.status}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Compliance Overview -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">Compliance Overview</div>
          <a href="/employees/${profile.id}?tab=compliance" class="dh-card-link">View All</a>
        </div>
        <div class="dh-table-wrap">
          <table class="dh-table">
            <thead>
              <tr><th>Item</th><th>Expiry</th><th>Days Left</th><th>Status</th></tr>
            </thead>
            <tbody>
              ${overview.complianceItems.map(c => `
                <tr>
                  <td style="font-weight:600; color:#0f172a;">${c.item}</td>
                  <td style="color:#64748b;">${c.expiry}</td>
                  <td style="font-weight:700; color:#0f172a;">${c.daysLeft}</td>
                  <td><span class="dh-badge dh-badge-${c.badge}">${c.status}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">Recent Activity</div>
          <a href="/employees/${profile.id}?tab=notes" class="dh-card-link">View All</a>
        </div>
        <div class="dh-table-wrap">
          <table class="dh-table">
            <thead>
              <tr><th>Date / Time</th><th>Activity</th><th>By</th></tr>
            </thead>
            <tbody>
              ${overview.recentActivity.map(ra => `
                <tr>
                  <td style="color:#64748b; font-size:11px; white-space:nowrap;">${ra.date}</td>
                  <td style="font-weight:600; color:#1e293b;">${ra.text}</td>
                  <td style="color:#64748b;">${ra.by}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Incidents, Documents, Notes Row -->
    <div class="dh-grid-3">
      <!-- Incidents, Defects & Risk -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">Incidents, Defects &amp; Risk</div>
          <a href="/employees/${profile.id}?tab=incidents" class="dh-card-link">View All</a>
        </div>
        <div class="dh-table-wrap">
          <table class="dh-table">
            <thead>
              <tr><th>Date</th><th>Type</th><th>Details</th><th>Status</th></tr>
            </thead>
            <tbody>
              ${overview.incidentsList.map(inc => `
                <tr>
                  <td style="color:#64748b; font-size:11px;">${inc.date}</td>
                  <td><span class="dh-badge ${inc.type === 'Defect' ? 'dh-badge-amber' : inc.type === 'Incident' ? 'dh-badge-red' : 'dh-badge-blue'}">${inc.type}</span></td>
                  <td style="color:#1e293b; font-weight:600;">${inc.details}</td>
                  <td><span class="dh-badge dh-badge-green">✓ ${inc.status}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Documents -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">Documents</div>
          <a href="/employees/${profile.id}?tab=documents" class="dh-card-link">View All</a>
        </div>
        <div class="dh-table-wrap">
          <table class="dh-table">
            <thead>
              <tr><th>Document</th><th>Uploaded</th><th>Expiry</th><th>Status</th></tr>
            </thead>
            <tbody>
              ${overview.documentsList.map(doc => `
                <tr>
                  <td style="font-weight:600; color:#0f172a;">${doc.name}</td>
                  <td style="color:#64748b;">${doc.uploaded}</td>
                  <td style="color:#64748b;">${doc.expiry}</td>
                  <td><span class="dh-badge ${doc.status === 'Valid' ? 'dh-badge-green' : 'dh-badge-amber'}">${doc.status}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Notes & Actions -->
      <div class="dh-card">
        <div class="dh-card-head">
          <div class="dh-card-title">Notes &amp; Actions</div>
          <a href="/employees/${profile.id}?tab=notes" class="dh-card-link">View All</a>
        </div>
        <div class="dh-table-wrap">
          <table class="dh-table">
            <thead>
              <tr><th>Date</th><th>Note / Action</th><th>Status</th></tr>
            </thead>
            <tbody>
              ${overview.notesList.map(n => `
                <tr>
                  <td style="color:#64748b; font-size:11px;">${n.date}</td>
                  <td style="font-weight:600; color:#1e293b;">${n.text}</td>
                  <td><span class="dh-badge ${n.status === 'Completed' ? 'dh-badge-green' : 'dh-badge-amber'}">${n.status}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  ` : ''}

  <!-- TAB 2: PERSONAL DETAILS (Design 3) -->
