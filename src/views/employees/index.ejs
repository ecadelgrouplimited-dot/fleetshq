<%- include('../layouts/main', { body: `
<!-- Page header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <p class="text-sm text-muted"><span id="visibleEmployeeCount">${employees.length}</span> of ${employees.length} employee${employees.length !== 1 ? 's' : ''} · filtered results</p>
  </div>
  <a href="/employees/new" class="btn btn-primary">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Add Employee
  </a>
</div>

<!-- Filters -->
<div class="card mb-4">
  <div class="card-body" style="padding:14px 20px">
    <form method="GET" action="/employees" class="filter-form">
      <div class="filter-search">
        <label class="form-label">Search employees</label>
        <input class="form-control" name="search" data-live-search="#employeesTableBody" data-live-count="#visibleEmployeeCount" data-live-empty="#noEmployeesFound" placeholder="Name, role, department, vehicle…" value="${filters.search || ''}">
      </div>
      <div style="min-width:140px">
        <label class="form-label">Status</label>
        <select class="form-control" name="status">
          <option value="active" ${filters.status === 'active' ? 'selected' : ''}>Active</option>
          <option value="" ${!filters.status ? 'selected' : ''}>All statuses</option>
          <option value="terminated" ${filters.status === 'terminated' ? 'selected' : ''}>Terminated</option>
          <option value="on_leave" ${filters.status === 'on_leave' ? 'selected' : ''}>On Leave</option>
        </select>
      </div>
      <div style="min-width:160px">
        <label class="form-label">Department</label>
        <select class="form-control" name="department">
          <option value="">All Departments</option>
          ${departments.map(d => `<option value="${d}" ${esc(filters.department === d ? 'selected' : '')}>${d}</option>`).join('')}
        </select>
      </div>
      <div style="min-width:170px">
        <label class="form-label">Quick Filter</label>
        <select class="form-control" name="type">
          <option value="" ${!filters.type ? 'selected' : ''}>Everyone</option>
          <option value="drivers" ${filters.type === 'drivers' ? 'selected' : ''}>Drivers</option>
          <option value="sponsored" ${filters.type === 'sponsored' ? 'selected' : ''}>Sponsored workers</option>
          <option value="missing_docs" ${filters.type === 'missing_docs' ? 'selected' : ''}>Missing documents</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Filter</button>
      <a href="/employees" class="btn btn-ghost">Reset</a>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Employee</th>
          <th>Role</th>
          <th>Department</th>
          <th>Start Date</th>
          <th>Vehicle</th>
          <th>Documents</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="employeesTableBody">
        ${employees.length === 0 ? `
          <tr>
            <td colspan="8">
              <div class="empty-state">
                <div class="empty-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
                <p>No employees found</p>
                <div class="empty-hint">Try adjusting your search or filters</div>
              </div>
            </td>
          </tr>
        ` : employees.map(e => `
          <tr data-search-row data-search-text="${`${esc(e.fullName)} ${esc(e.jobTitle)} ${esc(e.department)} ${esc(e.email || '')} ${esc(e.drivingVehicle?.registration || '')} ${e.employmentStatus} ${e.isDriver ? 'driver' : ''} ${e.isSponsored ? 'sponsored' : ''}`.toLowerCase()}">
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <div style="width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#3b82f6,#7c3aed);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex-shrink:0">${esc(e.fullName.charAt(0))}</div>
                <div>
                  <a href="/employees/${e.id}" style="font-weight:700;font-size:13.5px">${esc(e.fullName)}</a>
                  <div style="margin-top:3px;display:flex;gap:4px">
                    ${e.isSponsored ? '<span class="badge badge-purple" style="font-size:10px">Sponsored</span>' : ''}
                    ${e.isDriver ? '<span class="badge badge-blue" style="font-size:10px">Driver</span>' : ''}
                  </div>
                </div>
              </div>
            </td>
            <td class="cell-muted">${esc(e.jobTitle)}</td>
            <td>
              <span class="badge badge-slate" style="font-size:11px">${esc(e.department)}</span>
            </td>
            <td class="cell-muted">${formatDate(e.startDate)}</td>
            <td>
              ${e.drivingVehicle
                ? `<span class="badge badge-cyan" style="font-family:monospace;font-size:11px">${esc(e.drivingVehicle.registration)}</span>`
                : '<span style="color:#cbd5e1">—</span>'}
            </td>
            <td>
              ${e.missingDocs > 0
                ? `<span class="badge badge-red"><span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block"></span>${e.missingDocs} missing</span>`
                : `<span class="badge badge-green">✓ Complete</span>`}
            </td>
            <td>
              <span class="badge ${e.employmentStatus === 'active' ? 'badge-green' : e.employmentStatus === 'terminated' ? 'badge-red' : 'badge-amber'}">
                ${e.employmentStatus === 'active' ? '● ' : ''}${e.employmentStatus.replace('_',' ')}
              </span>
            </td>
            <td>
              <div class="flex gap-2">
                <a href="/employees/${e.id}" class="btn btn-ghost btn-sm">View</a>
                <a href="/employees/${e.id}/edit" class="btn btn-outline btn-sm">Edit</a>
                <button type="button" data-del-employee data-id="${e.id}" data-name="${esc(e.fullName)}" class="btn btn-danger-soft btn-sm">Delete</button>
              </div>
            </td>
          </tr>
        `).join('')}
        <tr id="noEmployeesFound" style="display:none">
          <td colspan="8">
            <div class="empty-state">
              <p>No employees match your search</p>
              <div class="empty-hint">Clear the search or adjust filters</div>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
document.querySelectorAll('[data-del-employee]').forEach(b => b.addEventListener('click', () => deleteEmployee(b.dataset.id, b.dataset.name)));
async function deleteEmployee(id, name) {
  const confirmed = await showConfirmDialog({
    title: 'Delete Employee Record',
    message: 'Delete employee record for ' + name + '? This only works when there are no linked compliance records.',
    confirmLabel: 'Delete Employee',
    cancelLabel: 'Cancel',
    tone: 'danger'
  });
  if (!confirmed) return;
  const res = await fetch('/api/v1/employees/' + id, {
    method: 'DELETE',
    credentials: 'same-origin',
  });
  if (res.ok) {
    showToast('Employee deleted successfully', 'success');
    setTimeout(() => location.reload(), 900);
  } else {
    const e = await res.json();
    showToast(e.error?.message || 'Delete failed', 'error');
  }
}
</script>

<style>
  .btn-danger-soft { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
  .btn-danger-soft:hover { background:#fee2e2; }
</style>
` }) %>
