<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <a href="/employees" class="btn btn-ghost btn-sm">← Back to Employees</a>
</div>

<form action="/api/v1/employees" method="POST" id="empForm">
<div class="grid-2 mb-4">
  <div class="card">
    <div class="card-header"><h3>Personal Information</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Full Name <span class="required">*</span></label>
        <input class="form-control" name="fullName" required placeholder="e.g. James Okello">
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Date of Birth <span class="required">*</span></label>
          <input class="form-control" name="dateOfBirth" type="date" required>
        </div>
        <div class="form-group">
          <label class="form-label">Phone <span class="required">*</span></label>
          <input class="form-control" name="phone" placeholder="07700900000">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Email <span class="required">*</span></label>
        <input class="form-control" name="email" type="email" required placeholder="name@256logistics.co.uk">
      </div>
      <div class="form-group">
        <label class="form-label">Home Address <span class="required">*</span></label>
        <input class="form-control" name="homeAddress" required placeholder="Full address including postcode">
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Emergency Contact Name</label>
          <input class="form-control" name="emergencyContactName" placeholder="Contact name">
        </div>
        <div class="form-group">
          <label class="form-label">Emergency Contact Phone</label>
          <input class="form-control" name="emergencyContactPhone" placeholder="07700000000">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Next of Kin</label>
        <input class="form-control" name="nextOfKin" placeholder="e.g. Mary Okello (Wife)">
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Employment Details</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Job Title <span class="required">*</span></label>
        <input class="form-control" name="jobTitle" required placeholder="e.g. HGV Driver">
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Department <span class="required">*</span></label>
          <select class="form-control" name="department" required>
            <option value="Drivers">Drivers</option>
            <option value="Management">Management</option>
            <option value="HR">HR</option>
            <option value="Operations">Operations</option>
            <option value="Admin">Admin</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Start Date <span class="required">*</span></label>
          <input class="form-control" name="startDate" type="date" required>
        </div>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Contracted Hours/Week</label>
          <input class="form-control" name="contractedHours" type="number" step="0.5" placeholder="40">
        </div>
        <div class="form-group">
          <label class="form-label">Annual Salary (£)</label>
          <input class="form-control" name="salary" type="number" placeholder="32000">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Work Location</label>
        <input class="form-control" name="workLocation" placeholder="e.g. Birmingham Depot">
      </div>
      <div class="form-group">
        <label class="form-label">Line Manager</label>
        <select class="form-control" name="lineManagerId">
          <option value="">— Select manager —</option>
          ${managers.map(m => `<option value="${m.id}">${m.fullName} (${m.jobTitle})</option>`).join('')}
        </select>
      </div>
      <div style="display:flex;gap:20px;margin-top:8px">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
          <input type="checkbox" name="isDriver" value="true">
          <span style="font-size:13px;font-weight:600">Is an HGV Driver</span>
        </label>
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
          <input type="checkbox" name="isSponsored" value="true">
          <span style="font-size:13px;font-weight:600">Sponsored Worker</span>
        </label>
      </div>
    </div>
  </div>
</div>

<div class="flex justify-between">
  <a href="/employees" class="btn btn-ghost">Cancel</a>
  <button type="button" onclick="submitEmployee()" class="btn btn-primary" style="padding:12px 32px">Save Employee Record</button>
</div>
</form>

<script>
async function submitEmployee() {
  const form = document.getElementById('empForm');
  const fd = new FormData(form);
  const token = (document.cookie.match(/token=([^;]+)/)||[])[1];
  const body = Object.fromEntries(fd.entries());
  body.isDriver = form.querySelector('[name=isDriver]')?.checked || false;
  body.isSponsored = form.querySelector('[name=isSponsored]')?.checked || false;

  const res = await fetch('/api/v1/employees', {
    method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},
    body: JSON.stringify(body),
  });
  if (res.ok) {
    const data = await res.json();
    showToast('Employee record created','success');
    setTimeout(()=>window.location.href='/employees/'+data.data.id, 1200);
  } else {
    const err = await res.json();
    showToast(err.error?.message || 'Failed to save employee','error');
  }
}
</script>
` }) %>
