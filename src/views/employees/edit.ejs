<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <a href="/employees/${emp.id}" class="btn btn-ghost btn-sm">← Back to Profile</a>
  <span class="badge badge-blue" style="font-size:13px;padding:6px 12px">Editing Record</span>
</div>

<form id="editForm">
<div class="grid-2 mb-4">
  <!-- Personal Info -->
  <div class="card">
    <div class="card-header"><h3>Personal Information</h3></div>
    <div class="card-body">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--border)">
        <div id="empPhotoThumb">${avatar(emp, { size: 72 })}</div>
        <label class="btn btn-outline btn-sm" style="cursor:pointer;margin:0">
          <span id="empPhotoBtnLabel">${emp.photoStorageKey ? 'Change photo' : 'Add photo'}</span>
          <input type="file" id="empPhotoInput" accept="image/jpeg,image/png,image/webp" hidden>
        </label>
      </div>
      <div class="form-group">
        <label class="form-label">Full Name <span class="required">*</span></label>
        <input class="form-control" name="fullName" required value="${esc(emp.fullName)}">
      </div>
      <div class="form-group">
        <label class="form-label">Phone</label>
        <input class="form-control" name="phone" value="${emp.phone || ''}">
      </div>
      <div class="form-group">
        <label class="form-label">Email</label>
        <input class="form-control" name="email" type="email" value="${esc(emp.email || '')}">
      </div>
      <div class="form-group">
        <label class="form-label">Home Address</label>
        <input class="form-control" name="homeAddress" value="${emp.homeAddress || ''}">
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Emergency Contact Name</label>
          <input class="form-control" name="emergencyContactName" value="${emp.emergencyContactName || ''}">
        </div>
        <div class="form-group">
          <label class="form-label">Emergency Contact Phone</label>
          <input class="form-control" name="emergencyContactPhone" value="${emp.emergencyContactPhone || ''}">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Next of Kin</label>
        <input class="form-control" name="nextOfKin" value="${emp.nextOfKin || ''}">
      </div>
    </div>
  </div>

  <!-- Employment Details -->
  <div class="card">
    <div class="card-header"><h3>Employment Details</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Job Title</label>
        <input class="form-control" name="jobTitle" value="${esc(emp.jobTitle)}">
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Department</label>
          <select class="form-control" name="department">
            ${['Drivers','Management','HR','Operations','Admin'].map(d => `<option value="${d}" ${esc(emp.department === d ? 'selected' : '')}>${d}</option>`).join('')}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Employment Status</label>
          <select class="form-control" name="employmentStatus">
            ${[['active','Active'],['on_leave','On Leave'],['suspended','Suspended'],['terminated','Terminated']].map(([v,l]) => `<option value="${v}" ${emp.employmentStatus === v ? 'selected' : ''}>${l}</option>`).join('')}
          </select>
        </div>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Contracted Hours/Week</label>
          <input class="form-control" type="number" step="0.5" name="contractedHours" value="${emp.contractedHours}">
        </div>
        <div class="form-group">
          <label class="form-label">Annual Salary (£)</label>
          <input class="form-control" type="number" name="salary" value="${emp.salary}">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Work Location</label>
        <input class="form-control" name="workLocation" value="${esc(emp.workLocation || '')}">
      </div>
      <div class="form-group">
        <label class="form-label">Line Manager</label>
        <select class="form-control" name="lineManagerId">
          <option value="">— No Manager —</option>
          ${managers.map(m => `<option value="${m.id}" ${emp.lineManagerId === m.id ? 'selected' : ''}>${esc(m.fullName)} (${esc(m.jobTitle)})</option>`).join('')}
        </select>
      </div>
      <div class="form-grid">
        <label class="check-toggle">
          <input type="checkbox" name="isDriver" value="true" ${emp.isDriver ? 'checked' : ''}>
          <span>Driver record</span>
        </label>
        <label class="check-toggle">
          <input type="checkbox" name="isSponsored" value="true" ${emp.isSponsored ? 'checked' : ''}>
          <span>Sponsored worker</span>
        </label>
      </div>
    </div>
  </div>
</div>

<div class="flex justify-between">
  <a href="/employees/${emp.id}" class="btn btn-ghost">Cancel</a>
  <button type="button" id="saveEmployeeBtn" class="btn btn-primary" style="padding:10px 32px">Save Changes</button>
</div>
</form>

<script>
document.getElementById('saveEmployeeBtn').addEventListener('click', saveEmployee);

// Employee avatar upload
(function() {
  const photoInput = document.getElementById('empPhotoInput');
  if (!photoInput) return;
  photoInput.addEventListener('change', async function() {
    const file = photoInput.files && photoInput.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('image', file);
    const label = document.getElementById('empPhotoBtnLabel');
    const prev = label ? label.textContent : '';
    if (label) label.textContent = 'Uploading…';
    try {
      const res = await fetch('/employees/${emp.id}/photo', {
        method: 'POST', body: fd, credentials: 'same-origin',
        headers: { 'X-CSRF-Token': '${csrfToken}' }
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Upload failed');
      const thumb = document.getElementById('empPhotoThumb');
      if (thumb) thumb.innerHTML = '<span class="ui-avatar" style="width:72px;height:72px"><img class="ui-avatar-img" src="' + data.url + '" alt="" style="width:72px;height:72px"></span>';
      if (label) label.textContent = 'Change photo';
      showToast('Photo updated', 'success');
    } catch (err) {
      if (label) label.textContent = prev;
      showToast(err.message || 'Could not upload photo', 'error');
    }
    photoInput.value = '';
  });
})();

async function saveEmployee() {
  const form = document.getElementById('editForm');
  const fd = new FormData(form);
  const body = Object.fromEntries(fd.entries());
  body.isDriver = fd.has('isDriver');
  body.isSponsored = fd.has('isSponsored');
  const res = await fetch('/api/v1/employees/${emp.id}', {
    method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  if (res.ok) {
    showToast('Employee record updated', 'success');
    setTimeout(() => window.location.href = '/employees/${emp.id}', 1200);
  } else {
    const err = await res.json();
    showToast(err.error?.message || 'Update failed', 'error');
  }
}
</script>
<style>
  .check-toggle { display:flex;align-items:center;gap:8px;border:1px solid var(--border);border-radius:8px;padding:10px 12px;font-weight:700;color:var(--text-2); }
  .check-toggle input { width:16px;height:16px; }
</style>
` }) %>
