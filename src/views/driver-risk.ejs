<%- include('layouts/main', { body: `
<div class="card mb-4">
  <div class="card-body" style="padding:14px 20px">
    <div style="display:flex;gap:12px;align-items:end;justify-content:space-between;flex-wrap:wrap">
      <div style="flex:1;min-width:260px">
        <label class="form-label">Search driver risk</label>
        <input class="form-control" data-live-search="#driverRiskTableBody" data-live-count="#visibleDriverRiskCount" data-live-empty="#noDriverRiskFound" placeholder="Driver, vehicle, department, CPC, risk...">
      </div>
      <p class="text-sm text-muted" style="margin-bottom:10px"><span id="visibleDriverRiskCount">${drivers.length}</span> active drivers</p>
    </div>
  </div>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead><tr><th>Driver</th><th>Vehicle</th><th>CPC Expiry</th><th>Missed Checks</th><th>Risk Level</th></tr></thead>
      <tbody id="driverRiskTableBody">
        ${drivers.map(d => `
          <tr data-search-row data-search-text="${`${esc(d.fullName)} ${esc(d.department)} ${esc(d.drivingVehicle?.registration || '')} ${d.cpcExpiry ? formatDate(d.cpcExpiry) : 'not recorded'} ${d.missedChecks} ${d.riskLevel}`.toLowerCase()}">
            <td>
              <a href="/employees/${d.id}" style="font-weight:600">${esc(d.fullName)}</a>
              <div style="font-size:11px;color:var(--text-muted)">${esc(d.department)}</div>
            </td>
            <td>${d.drivingVehicle ? `<span class="badge badge-slate">${esc(d.drivingVehicle.registration)}</span>` : '<span style="color:var(--text-light)">—</span>'}</td>
            <td>
              ${d.cpcExpiry ? `
                <div style="font-weight:500;color:${d.cpcDays < 0 ? 'var(--danger)' : d.cpcDays <= 30 ? 'var(--warning)' : 'var(--text)'}">${formatDate(d.cpcExpiry)}</div>
                ${d.cpcDays <= 30 ? `<span class="badge ${d.cpcDays < 0 ? 'badge-red' : 'badge-amber'}">${d.cpcDays < 0 ? 'EXPIRED' : d.cpcDays + 'd'}</span>` : ''}
              ` : '<span style="color:var(--text-light)">Not recorded</span>'}
            </td>
            <td>
              <span class="badge ${d.missedChecks > 2 ? 'badge-red' : d.missedChecks > 0 ? 'badge-amber' : 'badge-green'}">${d.missedChecks}</span>
            </td>
            <td>
              <span class="badge ${d.riskLevel === 'high' ? 'badge-red' : d.riskLevel === 'medium' ? 'badge-amber' : 'badge-green'}">
                ${d.riskLevel.toUpperCase()}
              </span>
            </td>
          </tr>
        `).join('')}
        ${drivers.length === 0 ? '<tr><td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">No drivers found</td></tr>' : ''}
        <tr id="noDriverRiskFound" style="display:none"><td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">No drivers match your search</td></tr>
      </tbody>
    </table>
  </div>
</div>
` }) %>
