<%
  const bandBadge = { low: 'badge-green', medium: 'badge-amber', high: 'badge-red' };
  const bandLabel = { low: 'Low', medium: 'Medium', high: 'High' };
  const scoreColor = (s) => s >= 85 ? 'var(--success)' : s >= 70 ? 'var(--warning)' : 'var(--danger)';
%>
<%- include('layouts/main', { body: `
<div class="flex items-center justify-between mb-4">
  <p class="text-sm text-muted">${kpis.total} active driver${kpis.total === 1 ? '' : 's'} · avg score ${avgScore}</p>
</div>

<!-- KPI strip -->
<div class="dr-kpis mb-4">
  ${[
    { label: 'Total Drivers', value: kpis.total, tone: 'blue', sub: 'Active' },
    { label: 'High Risk', value: kpis.highRisk, tone: kpis.highRisk > 0 ? 'red' : 'green', sub: 'Score below 70' },
    { label: 'Active Infringements', value: kpis.activeInfringements, tone: kpis.activeInfringements > 0 ? 'amber' : 'green', sub: 'Open cases' },
    { label: 'Drivers w/ Points', value: kpis.withPoints, tone: kpis.withPoints > 0 ? 'amber' : 'green', sub: 'Licence points' },
    { label: 'Debriefs (30d)', value: kpis.debriefsMonth, tone: 'blue', sub: 'Last 30 days' },
    { label: 'Avg Score', value: kpis.avgScore, tone: kpis.avgScore >= 85 ? 'green' : kpis.avgScore >= 70 ? 'amber' : 'red', sub: 'Fleet average' },
  ].map(k => `
    <div class="dr-kpi ${k.tone}">
      <div class="dr-kpi-value">${k.value}</div>
      <div class="dr-kpi-label">${k.label}</div>
      <div class="dr-kpi-sub">${k.sub}</div>
    </div>`).join('')}
</div>

<div class="dr-main mb-4">
  <!-- Driver risk overview table -->
  <div class="card">
    <div class="card-header">
      <h3>Driver Risk Overview</h3>
      <input class="form-control" style="max-width:260px" data-live-search="#drTableBody" data-live-empty="#noDrivers" placeholder="Search driver...">
    </div>
    ${rows.length === 0 ? `
      <div class="empty-state" style="padding:48px 14px"><p>No active drivers</p><div class="empty-hint">Drivers appear here once added to the team.</div></div>
    ` : `
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Driver</th><th scope="col">Score</th><th scope="col">Risk</th><th scope="col">Infringements</th><th scope="col">Points</th><th scope="col">Last Debrief</th></tr></thead>
        <tbody id="drTableBody">
          ${rows.map(r => `
            <tr data-search-row data-search-text="${`${esc(r.fullName)} ${esc(r.vehicleReg || '')} ${r.band}`.toLowerCase()}" style="cursor:pointer" onclick="location.href='/driver-risk/${r.id}'">
              <td>${avatar(r, { size: 34, withName: true, sub: r.vehicleReg || r.jobTitle })}</td>
              <td><span class="dr-score" style="color:${scoreColor(r.score)};border-color:${scoreColor(r.score)}">${r.score}</span></td>
              <td><span class="badge ${bandBadge[r.band]}">${bandLabel[r.band]}</span></td>
              <td>${r.openInfringements > 0 ? `<span class="badge badge-amber">${r.openInfringements} open</span>` : '<span class="badge badge-green">None</span>'}</td>
              <td style="font-weight:700;${r.licencePoints > 0 ? 'color:var(--warning)' : ''}">${r.licencePoints}</td>
              <td class="cell-muted">${r.lastDebrief ? formatDate(r.lastDebrief) : '—'}</td>
            </tr>`).join('')}
          <tr id="noDrivers" style="display:none"><td colspan="6" style="text-align:center;padding:24px;color:var(--text-muted)">No drivers match your search</td></tr>
        </tbody>
      </table>
    </div>`}
  </div>

  <!-- Right rail: distribution + scorecard -->
  <div class="dr-rail">
    <div class="card">
      <div class="card-header"><h3>Risk Distribution</h3></div>
      <div class="card-body" style="display:flex;flex-direction:column;align-items:center;gap:10px">
        <div style="position:relative;width:150px;height:150px">
          <canvas id="distChart" width="150" height="150"></canvas>
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column">
            <span style="font-size:26px;font-weight:900">${kpis.total}</span>
            <span style="font-size:10px;color:var(--text-muted);font-weight:600">drivers</span>
          </div>
        </div>
        <div class="dr-legend">
          ${[['high','High Risk','#ef4444',distribution.high],['medium','Medium Risk','#f59e0b',distribution.medium],['low','Low Risk','#10b981',distribution.low]].map(([k,l,c,n]) => `
            <div class="dr-legend-row"><span class="dr-legend-dot" style="background:${c}"></span><span>${l}</span><strong>${n}</strong></div>
          `).join('')}
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3>Top Scorecard</h3></div>
      <div class="card-body">
        ${topScorecard.length === 0 ? '<div class="cell-muted" style="font-size:13px">No drivers yet</div>' : topScorecard.map((r, i) => `
          <a href="/driver-risk/${r.id}" class="dr-score-row">
            <span class="dr-rank">${i + 1}</span>
            ${avatar(r, { size: 30 })}
            <span class="dr-score-name">${esc(r.fullName)}</span>
            <span class="dr-score-bar"><span style="width:${r.score}%;background:${scoreColor(r.score)}"></span></span>
            <strong style="color:${scoreColor(r.score)}">${r.score}</strong>
          </a>`).join('')}
      </div>
    </div>
  </div>
</div>

<div class="dr-grid3 mb-4">
  <div class="card">
    <div class="card-header"><h3>Infringements This Month</h3></div>
    <div class="card-body">
      ${infTypeRows.length === 0 ? '<div class="cell-muted" style="font-size:13px;padding:8px 0">No infringements in the last 30 days.</div>' : infTypeRows.map(t => `
        <div class="dr-cat-row"><span>${esc(t.label)}</span><strong>${t.count}</strong></div>`).join('')}
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Recent Infringements</h3></div>
    <div class="card-body">
      ${recentInfringements.length === 0 ? '<div class="cell-muted" style="font-size:13px;padding:8px 0">None recorded yet.</div>' : recentInfringements.map(i => `
        <a href="/driver-risk/${i.driverId}" class="dr-list-item">
          <span class="dr-list-dot ${i.severity === 'serious' ? 'badge-red' : i.severity === 'major' ? 'badge-amber' : 'badge-slate'}"></span>
          <span class="dr-list-body"><strong>${esc(infringementTypeLabels[i.type] || i.type)}</strong><span>${esc(i.driverName)} · ${formatDate(i.infringementDate)}</span></span>
          <span class="badge ${i.status === 'open' ? 'badge-amber' : 'badge-green'}">${i.status}</span>
        </a>`).join('')}
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Recent Debriefs</h3></div>
    <div class="card-body">
      ${recentDebriefs.length === 0 ? '<div class="cell-muted" style="font-size:13px;padding:8px 0">None recorded yet.</div>' : recentDebriefs.map(b => `
        <a href="/driver-risk/${b.driverId}" class="dr-list-item">
          <span class="dr-list-dot ${b.outcome === 'positive' ? 'badge-green' : b.outcome === 'written_warning' ? 'badge-red' : 'badge-amber'}"></span>
          <span class="dr-list-body"><strong>${esc(b.driverName)}</strong><span>${esc(debriefOutcomeLabels[b.outcome] || b.outcome)} · ${formatDate(b.debriefDate)}</span></span>
        </a>`).join('')}
    </div>
  </div>
</div>

<div class="dr-main">
  <div class="card">
    <div class="card-header"><h3>Licence Points Overview</h3></div>
    <div class="card-body">
      ${pointsLeaders.length === 0 ? '<div class="cell-muted" style="font-size:13px;padding:8px 0">No drivers currently hold licence points.</div>' : pointsLeaders.map(r => `
        <a href="/driver-risk/${r.id}" class="dr-points-row">
          <span class="dr-points-name">${esc(r.fullName)}</span>
          <span class="dr-points-bar"><span style="width:${Math.min(100, r.licencePoints * 8)}%"></span></span>
          <strong>${r.licencePoints}</strong>
        </a>`).join('')}
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Risk Insights</h3></div>
    <div class="card-body">
      ${insights.map(ins => `
        <div class="dr-insight ${ins.tone}">
          <span class="dr-insight-dot"></span>
          <span>${esc(ins.text)}</span>
        </div>`).join('')}
    </div>
  </div>
</div>

<style>
  .dr-kpis { display:grid; grid-template-columns:repeat(6,1fr); gap:12px; }
  .dr-kpi { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:14px 16px; position:relative; overflow:hidden; box-shadow:var(--shadow-xs); }
  .dr-kpi::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--border-md); }
  .dr-kpi.blue::before { background:var(--primary); } .dr-kpi.green::before { background:var(--success); }
  .dr-kpi.amber::before { background:var(--warning); } .dr-kpi.red::before { background:var(--danger); }
  .dr-kpi-value { font-size:24px; font-weight:900; letter-spacing:-1px; line-height:1; }
  .dr-kpi.amber .dr-kpi-value { color:var(--warning); } .dr-kpi.red .dr-kpi-value { color:var(--danger); }
  .dr-kpi-label { font-size:12px; font-weight:700; margin-top:6px; }
  .dr-kpi-sub { font-size:11px; color:var(--text-muted); margin-top:2px; }
  .dr-main { display:grid; grid-template-columns:1fr 320px; gap:16px; align-items:start; }
  .dr-rail { display:flex; flex-direction:column; gap:16px; }
  .dr-grid3 { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .dr-score { display:inline-flex; align-items:center; justify-content:center; min-width:38px; height:30px; border:2px solid; border-radius:8px; font-weight:800; font-size:14px; }
  .dr-legend { width:100%; display:flex; flex-direction:column; gap:7px; }
  .dr-legend-row { display:flex; align-items:center; gap:8px; font-size:13px; }
  .dr-legend-row strong { margin-left:auto; }
  .dr-legend-dot { width:9px; height:9px; border-radius:50%; }
  .dr-score-row { display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); text-decoration:none; color:var(--text); }
  .dr-score-row:last-child { border-bottom:none; }
  .dr-rank { width:20px; font-weight:800; color:var(--text-muted); font-size:13px; }
  .dr-score-name { font-size:13px; font-weight:600; flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .dr-score-bar { width:70px; height:6px; background:var(--border); border-radius:3px; overflow:hidden; flex-shrink:0; }
  .dr-score-bar span { display:block; height:100%; }
  .dr-cat-row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--border); font-size:13px; }
  .dr-cat-row:last-child { border-bottom:none; }
  .dr-list-item { display:flex; align-items:center; gap:10px; padding:9px 4px; border-bottom:1px solid var(--border); text-decoration:none; color:var(--text); }
  .dr-list-item:last-child { border-bottom:none; } .dr-list-item:hover { background:var(--surface-2); }
  .dr-list-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .dr-list-dot.badge-green { background:var(--success); } .dr-list-dot.badge-amber { background:var(--warning); } .dr-list-dot.badge-red { background:var(--danger); } .dr-list-dot.badge-slate { background:var(--text-light); }
  .dr-list-body { flex:1; min-width:0; display:flex; flex-direction:column; }
  .dr-list-body strong { font-size:13px; }
  .dr-list-body span { font-size:11px; color:var(--text-muted); }
  .dr-points-row { display:flex; align-items:center; gap:12px; padding:8px 0; border-bottom:1px solid var(--border); text-decoration:none; color:var(--text); }
  .dr-points-row:last-child { border-bottom:none; }
  .dr-points-name { font-size:13px; font-weight:600; width:140px; flex-shrink:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .dr-points-bar { flex:1; height:8px; background:var(--border); border-radius:4px; overflow:hidden; }
  .dr-points-bar span { display:block; height:100%; background:var(--warning); }
  .dr-insight { display:flex; align-items:flex-start; gap:10px; padding:10px 12px; border-radius:10px; font-size:13px; margin-bottom:8px; }
  .dr-insight.red { background:var(--danger-bg); } .dr-insight.amber { background:var(--warning-bg); } .dr-insight.green { background:var(--success-bg); }
  .dr-insight-dot { width:8px; height:8px; border-radius:50%; margin-top:5px; flex-shrink:0; }
  .dr-insight.red .dr-insight-dot { background:var(--danger); } .dr-insight.amber .dr-insight-dot { background:var(--warning); } .dr-insight.green .dr-insight-dot { background:var(--success); }
  @media (max-width:1100px) { .dr-kpis { grid-template-columns:repeat(3,1fr); } .dr-main { grid-template-columns:1fr; } .dr-grid3 { grid-template-columns:1fr; } }
  @media (max-width:560px) { .dr-kpis { grid-template-columns:repeat(2,1fr); } }
</style>

<script>
(function() {
  var el = document.getElementById('distChart');
  if (!el || !window.Chart) return;
  var dist = ${JSON.stringify(distribution)};
  new Chart(el.getContext('2d'), {
    type: 'doughnut',
    data: { labels: ['High','Medium','Low'], datasets: [{ data: [dist.high, dist.medium, dist.low],
      backgroundColor: ['#ef4444','#f59e0b','#10b981'], borderWidth: 2,
      borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#0f1d35' : '#ffffff' }] },
    options: { cutout: '72%', plugins: { legend: { display: false } } }
  });
})();
</script>
` }) %>
