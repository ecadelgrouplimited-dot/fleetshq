<%- include('layouts/main', { body: `
<div class="card">
  <div class="table-wrap">
    <table>
      <thead><tr><th>Driver</th><th>Vehicle</th><th>CPC Expiry</th><th>Missed Checks</th><th>Risk Level</th></tr></thead>
      <tbody>
        ${drivers.map(d => `
          <tr>
            <td>
              <a href="/employees/${d.id}" style="font-weight:600">${d.fullName}</a>
              <div style="font-size:11px;color:#64748b">${d.department}</div>
            </td>
            <td>${d.drivingVehicle ? `<span class="badge badge-slate">${d.drivingVehicle.registration}</span>` : '<span style="color:#94a3b8">—</span>'}</td>
            <td>
              ${d.cpcExpiry ? `
                <div style="font-weight:500;color:${d.cpcDays < 0 ? '#dc2626' : d.cpcDays <= 30 ? '#d97706' : '#374151'}">${formatDate(d.cpcExpiry)}</div>
                ${d.cpcDays <= 30 ? `<span class="badge ${d.cpcDays < 0 ? 'badge-red' : 'badge-amber'}">${d.cpcDays < 0 ? 'EXPIRED' : d.cpcDays + 'd'}</span>` : ''}
              ` : '<span style="color:#94a3b8">Not recorded</span>'}
            </td>
            <td>
              <span class="badge ${d.missedChecks > 2 ? 'badge-red' : d.missedChecks > 0 ? 'badge-amber' : 'badge-green'}">${d.missedChecks}</span>
            </td>
            <td>
              <span class="badge ${d.riskLevel === 'high' ? 'badge-red' : d.riskLevel === 'medium' ? 'badge-amber' : 'badge-green'}">
                ${d.riskLevel.toUpperCase()}
              </span>
            </td>
          </tr>
        `).join('')}
        ${drivers.length === 0 ? '<tr><td colspan="5" style="text-align:center;padding:32px;color:#64748b">No drivers found</td></tr>' : ''}
      </tbody>
    </table>
  </div>
</div>
` }) %>
