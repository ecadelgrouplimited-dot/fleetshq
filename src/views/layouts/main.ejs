<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — 256 Logistics</title>
  <script>
    // Set theme before first paint (no flash). Order: saved pref → system → light.
    (function(){
      try {
        var m = document.cookie.match(/(?:^|; )theme=(light|dark)/);
        var t = m ? m[1] : (localStorage.getItem('theme'));
        if (t !== 'light' && t !== 'dark') {
          t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    // Theme-aware Chart.js defaults (axis text/grid) — set before page charts render.
    if (window.Chart) {
      var _dark = document.documentElement.getAttribute('data-theme') === 'dark';
      Chart.defaults.color = _dark ? '#93a4bd' : '#64748b';
      Chart.defaults.borderColor = _dark ? 'rgba(148,163,184,0.16)' : '#e2e8f0';
    }
  </script>
</head>
<body>

<!-- ── Sidebar ─────────────────────────────────────────── -->
