<!-- ── Main ─────────────────────────────────────────────── -->
<div class="main">
  <div class="topbar">
    <div class="topbar-left">
      <button type="button" class="nav-toggle" id="navToggle" aria-label="Open menu" aria-controls="appSidebar" aria-expanded="false">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <h2><%= title %></h2>
    </div>
    <div class="topbar-right">
      <% const availablePanels = Array.isArray(panels) ? panels : []; %>
      <% if (availablePanels.length > 1) { %>
      <label class="panel-switcher" title="Switch panel">
        <span>Panel</span>
        <select id="panelSwitcher" aria-label="Switch panel">
          <% availablePanels.forEach(panel => { %>
            <option value="<%= panel.href %>" <%= panel.href !== '/' && (typeof path !== 'undefined') && path === panel.href ? 'selected' : '' %>><%= panel.label %></option>
          <% }) %>
        </select>
      </label>
      <% } %>
      <label class="topbar-search">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 110-15 7.5 7.5 0 010 15z"/></svg>
        <input id="navSpotlight" type="search" placeholder="Search menu… (/)" autocomplete="off" aria-label="Search navigation">
      </label>
      <button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle light or dark theme" title="Toggle theme">
        <svg class="ic-sun" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36 6.36l-1.42-1.42M6.34 6.34L4.93 4.93m12.73 0l-1.41 1.41M6.34 17.66l-1.41 1.41M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg class="ic-moon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      </button>
      <div class="topbar-time" id="currentTime"></div>
    </div>
  </div>

  <div class="page-body">
    <%- body %>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<div id="confirmDialogHost"></div>

<script src="/js/app.js"></script>
<script>
  (function tick() {
    const el = document.getElementById('currentTime');
    if (el) {
      const now = new Date();
      el.textContent = now.toLocaleDateString('en-GB', {weekday:'short',day:'2-digit',month:'short'})
        + ' · ' + now.toLocaleTimeString('en-GB', {hour:'2-digit',minute:'2-digit'});
    }
    setTimeout(tick, 1000);
  })();

  // Theme toggle — persist to cookie (1yr) + localStorage; instant, no reload
  (function(){
    var btn = document.getElementById('themeToggle');
    if (!btn) return;
    btn.addEventListener('click', function(){
      var cur = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      var next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      document.cookie = 'theme=' + next + '; path=/; max-age=31536000; samesite=lax';
    });
  })();

  // Highlight active nav by current path
  const path = window.location.pathname;
  const panelSwitcher = document.getElementById('panelSwitcher');
  if (panelSwitcher) {
    Array.from(panelSwitcher.options).forEach(function(option) {
      var href = option.value;
      if (href === path || (href !== '/' && path.startsWith(href))) option.selected = true;
    });
    panelSwitcher.addEventListener('change', function(){ window.location.href = panelSwitcher.value; });
  }
  document.querySelectorAll('.sidebar nav a').forEach(a => {
    const href = a.getAttribute('href');
    if (href === path || (href !== '/' && path.startsWith(href))) {
      a.classList.add('active');
    }
  });

  // Spotlight-style nav filter
  (function() {
    const input = document.getElementById('navSpotlight');
    if (!input) return;
    const links = Array.from(document.querySelectorAll('.sidebar nav a'));
    const sections = Array.from(document.querySelectorAll('.sidebar .sidebar-section'));
    const apply = () => {
      const q = input.value.trim().toLowerCase();
      links.forEach(a => {
        const match = !q || a.textContent.toLowerCase().includes(q);
        a.style.display = match ? '' : 'none';
      });
      // hide section headers that have no visible links
      sections.forEach(sec => {
        const any = Array.from(sec.querySelectorAll('nav a')).some(a => a.style.display !== 'none');
        sec.style.display = any ? '' : 'none';
      });
    };
    input.addEventListener('input', apply);
    input.addEventListener('keydown', e => {
      if (e.key === 'Escape') { input.value = ''; apply(); input.blur(); }
      if (e.key === 'Enter') {
        const first = links.find(a => a.style.display !== 'none');
        if (first) window.location.href = first.getAttribute('href');
      }
    });
    // "/" focuses search, like macOS apps
    document.addEventListener('keydown', e => {
      if (e.key === '/' && document.activeElement !== input && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) {
        e.preventDefault(); input.focus();
      }
    });
  })();
</script>
</body>
</html>
