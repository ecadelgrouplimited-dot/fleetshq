<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <div>
    <span class="badge ${active.length > 0 ? 'badge-red' : 'badge-green'}" style="font-size:13px;padding:6px 12px">
      ${active.length} Vehicle${active.length !== 1 ? 's' : ''} Currently Off Road
    </span>
  </div>
  <a href="/defects" class="btn btn-outline">View Defects</a>
</div>

${active.length > 0 ? `
<div class="card mb-6">
  <div class="card-header" style="background:#fef2f2">
    <h3 style="color:#dc2626">Active VOR Records</h3>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Vehicle</th>
          <th>Off Road Since</th>
          <th>Days Off Road</th>
          <th>Reason</th>
          <th>Garage</th>
          <th>Est. Return</th>
          <th>Authorised By</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        ${active.map(r => `
          <tr>
            <td style="font-weight:700">${r.vehicle?.registration}</td>
            <td>${formatDate(r.takenOffRoadDate)}</td>
            <td>
              <span style="font-weight:700;color:${r.daysOffRoad > 7 ? '#dc2626' : '#d97706'}">${r.daysOffRoad} day${r.daysOffRoad !== 1 ? 's' : ''}</span>
            </td>
            <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${r.reason}</td>
            <td>${r.repairGarage || '—'}</td>
            <td>${formatDate(r.estimatedReturnDate)}</td>
            <td>${r.authorisedBy?.firstName} ${r.authorisedBy?.lastName}</td>
            <td>
              <button onclick="returnVehicle('${r.id}')" class="btn btn-success btn-sm">Return to Service</button>
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>
</div>
` : `
<div class="card mb-6">
  <div class="empty-state">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <p>No vehicles currently off road</p>
  </div>
</div>
`}

<div class="card">
  <div class="card-header"><h3>VOR History (Last 15 Records)</h3></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Vehicle</th><th>Off Road Date</th><th>Return Date</th><th>Duration</th><th>Authorised By</th></tr></thead>
      <tbody>
        ${history.length === 0 ? `<tr><td colspan="5" style="text-align:center;padding:24px;color:#64748b">No history</td></tr>` :
        history.map(r => {
          const days = r.actualReturnDate ? Math.floor((new Date(r.actualReturnDate) - new Date(r.takenOffRoadDate)) / 86400000) : '—';
          return `<tr>
            <td style="font-weight:600">${r.vehicle?.registration}</td>
            <td>${formatDate(r.takenOffRoadDate)}</td>
            <td>${formatDate(r.actualReturnDate)}</td>
            <td>${days !== '—' ? days + ' days' : '—'}</td>
            <td>${r.authorisedBy?.firstName} ${r.authorisedBy?.lastName}</td>
          </tr>`;
        }).join('')}
      </tbody>
    </table>
  </div>
</div>

<!-- Return to Service Modal -->
<div id="returnModal" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-header"><h3>Return Vehicle to Service</h3></div>
    <div class="modal-body">
      <p style="font-size:13px;color:#64748b;margin-bottom:16px">Confirm this vehicle is repaired and roadworthy. This action requires Transport Manager sign-off.</p>
      <div class="form-group">
        <label class="form-label">Sign-Off Notes</label>
        <textarea class="form-control" id="signoffNotes" rows="3" placeholder="Repair completed and verified. Vehicle returned to service."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button onclick="document.getElementById('returnModal').style.display='none'" class="btn btn-ghost">Cancel</button>
      <button onclick="confirmReturn()" class="btn btn-success">Confirm Return to Service</button>
    </div>
  </div>
</div>

<script>
let activeVorId = null;
function returnVehicle(id) { activeVorId = id; document.getElementById('returnModal').style.display='flex'; }
async function confirmReturn() {
  const token = (document.cookie.match(/token=([^;]+)/)||[])[1];
  const notes = document.getElementById('signoffNotes').value;
  const res = await fetch('/api/v1/vor/'+activeVorId+'/return', {
    method:'PATCH', headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},
    body: JSON.stringify({ signoffNotes: notes })
  });
  if (res.ok) { showToast('Vehicle returned to service','success'); setTimeout(()=>location.reload(),1200); }
  else { showToast('Failed to return vehicle','error'); }
  document.getElementById('returnModal').style.display='none';
}
</script>
` }) %>
