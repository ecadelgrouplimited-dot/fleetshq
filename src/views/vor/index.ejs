<%- include('../layouts/main', { body: `
<div class="flex items-center justify-between mb-6">
  <div>
    <span class="badge ${active.length > 0 ? 'badge-red' : 'badge-green'}" style="font-size:13px;padding:6px 12px">
      ${active.length} Vehicle${active.length !== 1 ? 's' : ''} Currently Off Road
    </span>
  </div>
  <a href="/defects" class="btn btn-outline">View Defects</a>
</div>

${active.length > 0 ? `
<div class="card mb-6">
  <div class="card-header" style="background:var(--danger-bg)">
    <h3 style="color:var(--danger-t)">Active VOR Records</h3>
    <input class="form-control" style="max-width:300px" data-live-search="#activeVorTableBody" data-live-empty="#noActiveVorFound" placeholder="Search active VOR...">
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Vehicle</th>
          <th scope="col">Off Road Since</th>
          <th scope="col">Days Off Road</th>
          <th scope="col">Reason</th>
          <th scope="col">Garage</th>
          <th scope="col">Est. Return</th>
          <th scope="col">Authorised By</th>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody id="activeVorTableBody">
        ${active.map(r => `
          <tr data-search-row data-search-text="${`${esc(r.vehicle?.registration || '')} ${esc(r.vehicle?.make || '')} ${esc(r.vehicle?.model || '')} ${esc(r.reason)} ${r.repairGarage || ''} ${esc(r.authorisedBy?.firstName || '')} ${esc(r.authorisedBy?.lastName || '')}`.toLowerCase()}">
            <td style="font-weight:700">${esc(r.vehicle?.registration)}</td>
            <td>${formatDate(r.takenOffRoadDate)}</td>
            <td>
              <span style="font-weight:700;color:${r.daysOffRoad > 7 ? 'var(--danger)' : 'var(--warning)'}">${r.daysOffRoad} day${r.daysOffRoad !== 1 ? 's' : ''}</span>
            </td>
            <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(r.reason)}</td>
            <td>${r.repairGarage || '—'}</td>
            <td>${formatDate(r.estimatedReturnDate)}</td>
            <td>${esc(r.authorisedBy?.firstName)} ${esc(r.authorisedBy?.lastName)}</td>
            <td>
              <button class="btn btn-success btn-sm" data-vor-return="${r.id}">Return to Service</button>
            </td>
          </tr>
        `).join('')}
        <tr id="noActiveVorFound" style="display:none"><td colspan="8" style="text-align:center;padding:24px;color:var(--text-muted)">No active VOR records match your search</td></tr>
      </tbody>
    </table>
  </div>
</div>
` : `
<div class="card mb-6">
  <div class="empty-state">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <p>No vehicles currently off road</p>
  </div>
</div>
`}

<div class="card">
  <div class="card-header">
    <h3>VOR History (Last 15 Records)</h3>
    <input class="form-control" style="max-width:300px" data-live-search="#vorHistoryTableBody" data-live-empty="#noVorHistoryFound" placeholder="Search VOR history...">
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Vehicle</th><th scope="col">Off Road Date</th><th scope="col">Return Date</th><th scope="col">Duration</th><th scope="col">Authorised By</th></tr></thead>
      <tbody id="vorHistoryTableBody">
        ${history.length === 0 ? `<tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">No history</td></tr>` :
        history.map(r => {
          const days = r.actualReturnDate ? Math.floor((new Date(r.actualReturnDate) - new Date(r.takenOffRoadDate)) / 86400000) : '—';
          return `<tr data-search-row data-search-text="${`${esc(r.vehicle?.registration || '')} ${formatDate(r.takenOffRoadDate)} ${formatDate(r.actualReturnDate)} ${esc(r.authorisedBy?.firstName || '')} ${esc(r.authorisedBy?.lastName || '')}`.toLowerCase()}">
            <td style="font-weight:600">${esc(r.vehicle?.registration)}</td>
            <td>${formatDate(r.takenOffRoadDate)}</td>
            <td>${formatDate(r.actualReturnDate)}</td>
            <td>${days !== '—' ? days + ' days' : '—'}</td>
            <td>${esc(r.authorisedBy?.firstName)} ${esc(r.authorisedBy?.lastName)}</td>
          </tr>`;
        }).join('')}
        <tr id="noVorHistoryFound" style="display:none"><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">No VOR history matches your search</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Return to Service Modal -->
<div id="returnModal" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-header"><h3>Return Vehicle to Service</h3></div>
    <div class="modal-body">
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px">Confirm this vehicle is repaired and roadworthy. This action requires Transport Manager sign-off.</p>
      <div class="form-group">
        <label class="form-label">Sign-Off Notes</label>
        <textarea class="form-control" id="signoffNotes" rows="3" placeholder="Repair completed and verified. Vehicle returned to service."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button id="cancelReturnBtn" class="btn btn-ghost">Cancel</button>
      <button id="confirmReturnBtn" class="btn btn-success">Confirm Return to Service</button>
    </div>
  </div>
</div>

<script>
(function() {
  let activeVorId = null;
  const modal = document.getElementById('returnModal');

  document.querySelectorAll('[data-vor-return]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activeVorId = btn.getAttribute('data-vor-return');
      modal.style.display = 'flex';
    });
  });

  document.getElementById('cancelReturnBtn').addEventListener('click', function() {
    modal.style.display = 'none';
  });

  document.getElementById('confirmReturnBtn').addEventListener('click', async function() {
    const notes = document.getElementById('signoffNotes').value;
    const res = await fetch('/api/v1/vor/' + activeVorId + '/return', {
      method: 'PATCH', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ signoffNotes: notes })
    });
    if (res.ok) { showToast('Vehicle returned to service', 'success'); setTimeout(function() { location.reload(); }, 1200); }
    else { showToast('Failed to return vehicle', 'error'); }
    modal.style.display = 'none';
  });
})();
</script>
` }) %>
