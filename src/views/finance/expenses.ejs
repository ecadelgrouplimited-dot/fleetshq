<%- include('../layouts/main', { body: `
<div class="page-head">
  <div class="page-head-main">
    <div class="page-eyebrow">Finance</div>
    <h1>Expenses</h1>
    <p class="page-sub">${totals.count} record${totals.count === 1 ? '' : 's'} · £${totals.amount.toLocaleString('en-GB', { minimumFractionDigits: 2 })} total${totals.vat > 0 ? ` · £${totals.vat.toFixed(2)} VAT` : ''}.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn btn-outline" href="/finance">Finance overview</a>
  </div>
</div>

<div class="grid-2">

  <div class="card">
    <div class="card-header"><h3>Log expense</h3></div>
    <div class="card-body">
      <form method="post" action="/finance/expenses">
        <input type="hidden" name="_csrf" value="${csrfToken}">
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Category</label>
            <select class="form-control" name="category">
              ${categories.map(c => `<option value="${esc(c)}">${esc(expenseLabels[c] || c)}</option>`).join('')}
            </select>
          </div>
          <div class="form-group"><label class="form-label">Date <span class="required">*</span></label>
            <input class="form-control" type="date" name="expenseDate" required value="${new Date().toISOString().split('T')[0]}">
          </div>
        </div>
        <div class="form-group"><label class="form-label">Description <span class="required">*</span></label>
          <input class="form-control" name="description" required placeholder="What was this expense for?">
        </div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Amount (£) <span class="required">*</span></label>
            <input class="form-control" type="number" min="0" step="0.01" name="amount" id="expAmount" required placeholder="0.00">
          </div>
          <div class="form-group"><label class="form-label">VAT (£) <span style="font-size:10px;font-weight:600;color:var(--text-light)">auto-fills 20%</span></label>
            <input class="form-control" type="number" min="0" step="0.01" name="vatAmount" id="expVat" placeholder="0.00">
          </div>
        </div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Supplier</label>
            <input class="form-control" name="supplier" placeholder="Supplier / vendor name">
          </div>
          <div class="form-group"><label class="form-label">Reference</label>
            <input class="form-control" name="reference" placeholder="Invoice / receipt ref">
          </div>
        </div>
        <button class="btn btn-primary">Log expense</button>
      </form>
    </div>
  </div>

  <div>
    <div class="card mb-4">
      <div class="card-header"><h3>Filter</h3></div>
      <div class="card-body">
        <form method="get" action="/finance/expenses">
          <div class="form-grid">
            <div class="form-group"><label class="form-label">Category</label>
              <select class="form-control" name="cat">
                <option value="">All categories</option>
                ${categories.map(c => `<option value="${esc(c)}" ${filter.cat === c ? 'selected' : ''}>${esc(expenseLabels[c] || c)}</option>`).join('')}
              </select>
            </div>
            <div class="form-group"><label class="form-label">From</label>
              <input class="form-control" type="date" name="from" value="${esc(filter.from || '')}">
            </div>
            <div class="form-group"><label class="form-label">To</label>
              <input class="form-control" type="date" name="to" value="${esc(filter.to || '')}">
            </div>
          </div>
          <div style="display:flex;gap:8px">
            <button class="btn btn-outline">Apply</button>
            <a class="btn btn-outline" href="/finance/expenses">Clear</a>
          </div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3>Expense log</h3></div>
      ${expenses.length === 0 ? `<div class="empty-state"><p>No expenses match this filter</p></div>` : `
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Category</th><th>Description</th><th>Supplier</th><th>Amount</th><th>VAT</th></tr></thead>
        <tbody>${expenses.map(e => `
          <tr>
            <td class="cell-muted">${formatDate(e.expenseDate)}</td>
            <td><span class="badge badge-slate">${esc(expenseLabels[e.category] || e.category)}</span></td>
            <td style="font-weight:600">${esc(e.description)}</td>
            <td class="cell-muted">${esc(e.supplier || '—')}</td>
            <td style="font-weight:700">£${Number(e.amount).toFixed(2)}</td>
            <td class="cell-muted">${Number(e.vatAmount) > 0 ? '£' + Number(e.vatAmount).toFixed(2) : '—'}</td>
          </tr>`).join('')}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" style="font-weight:700;text-align:right">Total</td>
            <td style="font-weight:800">£${totals.amount.toLocaleString('en-GB', { minimumFractionDigits: 2 })}</td>
            <td style="font-weight:700">${totals.vat > 0 ? '£' + totals.vat.toFixed(2) : '—'}</td>
          </tr>
        </tfoot>
      </table></div>`}
    </div>
  </div>

</div>

<script>
(function() {
  var amt = document.getElementById('expAmount');
  var vat = document.getElementById('expVat');
  if (!amt || !vat) return;
  amt.addEventListener('blur', function() {
    if (vat.value) return;
    var v = parseFloat(amt.value);
    if (!isNaN(v) && v > 0) vat.value = (v * 0.2).toFixed(2);
  });
})();
</script>
` }) %>
